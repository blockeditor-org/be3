# Checked-out line endings must stay LF everywhere, including on Windows
# runners (whose git defaults to converting to CRLF on checkout): scripts run
# through bash, and scripts/internal/ghostty-vt.patch is applied verbatim
# against an LF checkout of Ghostty, so a CRLF copy fails to apply.
* text=auto eol=lf


# Generated lockfiles, which a diff on GitHub collapses: //:buckify writes the
# first and //:lock-sysroot the second.
buck/cargo/crates.bzl linguist-generated=true
buck/sysroot/packages.bzl linguist-generated=true

# Paintings (snapshots/*.paint) are binary recordings. Git guesses that from the
# bytes, and a painting it guessed wrong would be line-merged into an invalid
# one without a conflict, or have its line endings rewritten. Marked binary, two
# branches that change one painting always conflict; ./scripts/verify repaints it.
*.paint binary

# A frozen server's files (crates/be-frozen/src/snapshots) are kept byte for
# byte: its objects are sealed bytes that git could take for text.
crates/be-frozen/src/snapshots/*/** binary
