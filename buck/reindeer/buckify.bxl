# Regenerates third-party/rust/BUCK on a worker, and prints where the result
# is. ./scripts/buckify copies it over the checked-in file.
#
# reindeer reads the workspace through `cargo metadata`, which reads every
# Cargo.toml, Cargo.lock and the layout of each crate: whether it has a
# src/lib.rs, a build.rs, an examples/ directory. It never reads a source file.
# So the manifests, the lockfile, reindeer.toml and the fixups are the action's
# real inputs, and every other file under crates/ is only a path, recreated
# empty where cargo will look for it. An edit to a source file therefore leaves
# the action's key alone and is answered from the cache; adding a file, a
# dependency or a crate is what runs reindeer again.
#
# A BXL script rather than a rule because the manifests belong to seventy-odd
# packages, and a rule can only take the files of its own; a script can take
# any file in the repository.

def _files(ctx, directory: str) -> list[str]:
    found = []
    for entry in ctx.fs.list(directory):
        path = str(entry).removeprefix("root//")
        if ctx.fs.is_dir(path):
            found.extend(_files(ctx, path))
        else:
            found.append(path)
    return found

def _output(ctx, target: str):
    configured = ctx.configured_targets(target)
    return ctx.analysis(configured).providers()[DefaultInfo].default_outputs[0]

def _impl(ctx):
    actions = ctx.bxl_actions().actions

    real = ["Cargo.toml", "Cargo.lock", "reindeer.toml"] + _files(ctx, "third-party/rust/fixups")
    placeholders = []
    for path in _files(ctx, "crates"):
        if path.endswith("/Cargo.toml"):
            real.append(path)
        else:
            placeholders.append(path)

    workspace = actions.copied_dir(
        "workspace",
        {path: ctx.fs.source(path) for path in sorted(real)},
    )
    layout = actions.write("placeholders.txt", sorted(placeholders))

    tools = _output(ctx, "root//buck/reindeer:reindeer")
    cargo = _output(ctx, "root//buck/reindeer:cargo")

    out = actions.declare_output("BUCK")
    script = """
set -eu
out="$(pwd)/$1"
workspace="$2"
layout="$(pwd)/$3"
reindeer="$(pwd)/$4"
toolchain="$(cd "$5" && pwd)"
scratch="$(mktemp -d)"
cp -RL "$workspace/." "$scratch/workspace"
cd "$scratch/workspace"
while IFS= read -r path || [ -n "$path" ]; do
    mkdir -p "$(dirname "$path")"
    : > "$path"
done < "$layout"
export PATH="$toolchain/bin:$PATH"
export CARGO_HOME="$scratch/cargo-home"
"$reindeer" --cargo-path "$toolchain/bin/cargo" --rustc-path "$toolchain/bin/rustc" \
    buckify --stdout > "$out"
rm -rf "$scratch"
"""
    actions.run(
        cmd_args("sh", "-c", script, "--", out.as_output(), workspace, layout, tools, cargo),
        category = "reindeer_buckify",
    )
    ctx.output.print(ctx.output.ensure(out).abs_path())

main = bxl_main(cli_args = {}, impl = _impl)
