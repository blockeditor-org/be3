load("//buck/tools:defs.bzl", "worker_properties")
load(":defs.bzl", "execution_platform")

# Where every action runs: a BuildBuddy worker. buck/tools/defs.bzl says what
# the container is, and it is Linux on x86_64 whatever the machine that asked
# for the build is.
#
# Nothing is uploaded from here. BuildBuddy writes the result of every action
# a worker ran to its own cache, and the few that run locally - the plugin
# tests, which are not cached anyway - have nothing a second machine would
# want.
execution_platform(
    name = "default",
    cpu_configuration = "prelude//cpu:x86_64",
    os_configuration = "prelude//os:linux",
    remote_execution_properties = worker_properties,
    visibility = ["PUBLIC"],
)

# Target platforms for WebAssembly, so that a plugin or a game can be asked for
# with --target-platforms. They are target platforms only: nothing executes
# here, and the execution platform above is still what runs the compiler.
#
# The constraints are the ones prelude//rust:cargo_package.bzl maps to
# reindeer's platform names, so this pair is reindeer's "wasi" and the pair
# below is its "wasm32". reindeer.toml has to agree with both.
platform(
    name = "wasi",
    constraint_values = [
        "prelude//cpu/constraints:cpu[wasm32]",
        "prelude//os/constraints:os[wasi]",
    ],
    visibility = ["PUBLIC"],
)

# The same triple as above, and what tells the two apart. A plugin is built for
# this one; block-app's web bundle is built for the one above.
platform(
    name = "wasi_guest",
    constraint_values = [
        "prelude//cpu/constraints:cpu[wasm32]",
        "prelude//os/constraints:os[wasi]",
        "root//buck/constraints:guest",
    ],
    visibility = ["PUBLIC"],
)

platform(
    name = "wasm32",
    constraint_values = [
        "prelude//cpu/constraints:cpu[wasm32]",
        "prelude//os/constraints:os[none]",
    ],
    visibility = ["PUBLIC"],
)

# The platforms that are cross-compiled from a Linux worker, and a
# config_setting for each: what the select()s buck/cargo/defs.bzl writes are
# keyed on, since a select key is one setting and these are two constraints.
[
    [
        platform(
            name = name,
            constraint_values = [
                "prelude//cpu/constraints:cpu[{}]".format(cpu),
                "prelude//os/constraints:os[{}]".format(os),
            ],
            visibility = ["PUBLIC"],
        ),
        config_setting(
            name = name + "_setting",
            constraint_values = [
                "prelude//cpu/constraints:cpu[{}]".format(cpu),
                "prelude//os/constraints:os[{}]".format(os),
            ],
            visibility = ["PUBLIC"],
        ),
    ]
    for name, cpu, os in [
        ("macos_arm64", "arm64", "macos"),
        ("macos_x86_64", "x86_64", "macos"),
    ]
]
