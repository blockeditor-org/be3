load("@root//buck/dev:verify.bzl", "package_fix")
load("@root//buck/tools:defs.bzl", "worker_properties")
load(":cross.bzl", "CROSS_PLATFORMS")
load(":defs.bzl", "execution_platform", "execution_platforms", "target_platform")

# Where every action runs: a worker of the build server ./scripts/buck picked,
# Linux on x86_64 whatever the machine that asked, in the image
# buck/tools/defs.bzl names. Nothing is uploaded from here; the server caches
# what its workers ran.
execution_platform(
    name = "default",
    cpu_configuration = "prelude//cpu:x86_64",
    os_configuration = "prelude//os:linux",
    remote_execution_properties = worker_properties(),
)

execution_platforms(
    name = "execution_platforms",
    platforms = [
        ":default",
    ],
)

# The same platform with every action run on this machine, for when no build
# server is reachable: a local build names this list instead of the one
# above (guides/running/local_buck2.md). It takes :default's label, so outputs
# land where a build server's would.
execution_platform(
    name = "default_local",
    cpu_configuration = "prelude//cpu:x86_64",
    label = ":default",
    os_configuration = "prelude//os:linux",
    remote = False,
    remote_execution_properties = worker_properties(),
)

execution_platforms(
    name = "execution_platforms_local",
    platforms = [
        ":default_local",
    ],
)

# What every build is for unless it says otherwise, whatever machine asks, so a
# Mac's or Windows machine's builds share CI's cache and its tests can run on a
# worker. buck2's own default would follow the machine. ./scripts/buck run
# builds for the machine instead.
target_platform(
    name = "linux_x86_64",
    constraint_values = [
        "prelude//cpu/constraints:cpu[x86_64]",
        "prelude//os/constraints:os[linux]",
    ],
)

# Target platforms for WebAssembly. The constraints are the ones
# prelude//rust:cargo_package.bzl maps to its platform names, "wasi" and
# "wasm32", which are what buck/cargo's plans are keyed by.
target_platform(
    name = "wasi",
    constraint_values = [
        "prelude//cpu/constraints:cpu[wasm32]",
        "prelude//os/constraints:os[wasi]",
    ],
)

# The same triple as above, and what tells the two apart. An app is built for
# this one; be-host's web bundle is built for the one above. Its setting is the
# one above's with one more constraint, so select() takes it as the more
# specific (cross.bzl's PLAN_SETTINGS).
target_platform(
    name = "wasi_guest",
    constraint_values = [
        "prelude//cpu/constraints:cpu[wasm32]",
        "prelude//os/constraints:os[wasi]",
        "root//buck/constraints:guest",
    ],
)

# The browser and the host again, for crates built on beui's HTML core
# (buck/constraints:html): its wasm module, and its server rendering and string
# tests. Each is the platform above it with one more constraint, as wasi_guest
# is, so select() takes its setting as the more specific one.
target_platform(
    name = "wasi_html",
    constraint_values = [
        "prelude//cpu/constraints:cpu[wasm32]",
        "prelude//os/constraints:os[wasi]",
        "root//buck/constraints:html",
    ],
)

target_platform(
    name = "linux_x86_64_html",
    constraint_values = [
        "prelude//cpu/constraints:cpu[x86_64]",
        "prelude//os/constraints:os[linux]",
        "root//buck/constraints:html",
    ],
)

target_platform(
    name = "wasm32",
    constraint_values = [
        "prelude//cpu/constraints:cpu[wasm32]",
        "prelude//os/constraints:os[none]",
    ],
)

# The platforms that are cross-compiled from a Linux worker, which cross.bzl
# lists.
[
    target_platform(
        name = name,
        constraint_values = [
            "prelude//cpu/constraints:cpu[{}]".format(cpu),
            "prelude//os/constraints:os[{}]".format(os),
        ],
    )
    for name, (cpu, os, _) in CROSS_PLATFORMS.items()
]

package_fix()
