load("//buck/tools:defs.bzl", "worker_properties")
load(":cross.bzl", "CROSS_PLATFORMS")
load(":defs.bzl", "execution_platform")

# Where every action runs: a BuildBuddy worker, Linux on x86_64 whatever the
# machine that asked (buck/tools/defs.bzl). Nothing is uploaded from here;
# BuildBuddy caches what its workers ran.
execution_platform(
    name = "default",
    cpu_configuration = "prelude//cpu:x86_64",
    os_configuration = "prelude//os:linux",
    remote_execution_properties = worker_properties,
    visibility = ["PUBLIC"],
)

# What every build is for unless it says otherwise, whatever machine asks, so a
# Mac's or Windows machine's builds share CI's cache and its tests can run on a
# worker. buck2's own default would follow the machine. ./scripts/buck run
# builds for the machine instead.
platform(
    name = "linux_x86_64",
    constraint_values = [
        "prelude//cpu/constraints:cpu[x86_64]",
        "prelude//os/constraints:os[linux]",
    ],
    visibility = ["PUBLIC"],
)

# Target platforms for WebAssembly. The constraints are the ones
# prelude//rust:cargo_package.bzl maps to reindeer's platform names, "wasi" and
# "wasm32", so reindeer.toml has to agree.
platform(
    name = "wasi",
    constraint_values = [
        "prelude//cpu/constraints:cpu[wasm32]",
        "prelude//os/constraints:os[wasi]",
    ],
    visibility = ["PUBLIC"],
)

# The same triple as above, and what tells the two apart. A plugin is built for
# this one; block-app's web bundle is built for the one above.
platform(
    name = "wasi_guest",
    constraint_values = [
        "prelude//cpu/constraints:cpu[wasm32]",
        "prelude//os/constraints:os[wasi]",
        "root//buck/constraints:guest",
    ],
    visibility = ["PUBLIC"],
)

# What buck/cargo/defs.bzl tells the two wasi plans apart by. The guest's is
# the app's with one more constraint, so a configuration that matches it is
# matched by the app's as well, and select() takes the guest's as the more
# specific of the two.
config_setting(
    name = "wasi_setting",
    constraint_values = [
        "prelude//cpu/constraints:cpu[wasm32]",
        "prelude//os/constraints:os[wasi]",
    ],
    visibility = ["PUBLIC"],
)

config_setting(
    name = "wasi_guest_setting",
    constraint_values = [
        "prelude//cpu/constraints:cpu[wasm32]",
        "prelude//os/constraints:os[wasi]",
        "root//buck/constraints:guest",
    ],
    visibility = ["PUBLIC"],
)

platform(
    name = "wasm32",
    constraint_values = [
        "prelude//cpu/constraints:cpu[wasm32]",
        "prelude//os/constraints:os[none]",
    ],
    visibility = ["PUBLIC"],
)

# The platforms that are cross-compiled from a Linux worker. cross.bzl lists
# them, and says why each has a config_setting beside it.
[
    [
        platform(
            name = name,
            constraint_values = [
                "prelude//cpu/constraints:cpu[{}]".format(cpu),
                "prelude//os/constraints:os[{}]".format(os),
            ],
            visibility = ["PUBLIC"],
        ),
        config_setting(
            name = name + "_setting",
            constraint_values = [
                "prelude//cpu/constraints:cpu[{}]".format(cpu),
                "prelude//os/constraints:os[{}]".format(os),
            ],
            visibility = ["PUBLIC"],
        ),
    ]
    for name, (cpu, os, _) in CROSS_PLATFORMS.items()
]
