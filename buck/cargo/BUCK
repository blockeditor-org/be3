load("@root//buck/dev:verify.bzl", "package_fix")
load("//buck/tools:defs.bzl", "configured_once", "rust_sysroot")

# The cargo and nightly buckify.bxl plans the workspace with (--unit-graph is
# nightly-only), pinned like buck/tools.

nightly = "2026-07-05"

host = "x86_64-unknown-linux-gnu"

nightly_components = {
    "cargo": ("f2ff375d36c15603dad26d70b4c353c167b43973692b1f057a598f726612dd84", 11167952),
    "rust-std": ("7fd733405f7aefac314398727c9a02c108fa003a37399f2f2421710810212435", 30648272),
    "rustc": ("f24c968957a924e1e3b43c81ef0a12d429fe8b5e5eac4c00b66b425c6c678a4d", 79631456),
}

[
    http_archive(
        name = "nightly-" + component,
        sha256 = sha256,
        size_bytes = size_bytes,
        strip_prefix = "{}-nightly-{}/{}".format(component, host, component if component != "rust-std" else "rust-std-" + host),
        urls = ["https://static.rust-lang.org/dist/{}/{}-nightly-{}.tar.xz".format(nightly, component, host)],
    )
    for component, (sha256, size_bytes) in nightly_components.items()
]

rust_sysroot(
    name = "nightly",
    components = [":nightly-" + component for component in sorted(nightly_components)],
)

# The cargo buckify's action checks Cargo.lock with, and builds be-tool-buck
# with when buck2 cannot (buck/cargo/buckify.bzl):
# rust-toolchain.toml's, the same one the workspace builds with and the
# bootstrap's lock step brings Cargo.lock up to date with.
configured_once(
    http_archive,
    name = "cargo-component",
    sha256 = "2f512d170d3dd23e16ababcda32ee2e6d5172d861a7af1f504e0b1e270cafab9",
    size_bytes = 11669560,
    strip_prefix = "cargo-1.98.0-{}/cargo".format(host),
    urls = ["https://static.rust-lang.org/dist/cargo-1.98.0-{}.tar.xz".format(host)],
)

rust_sysroot(
    name = "cargo",
    components = [
        ":cargo-component",
        "//buck/tools:rustc-component",
        "//buck/tools:rust-std-" + host,
    ],
    visibility = ["PUBLIC"],
)

# buck2's rust-project, which writes the rust-project.json rust-analyzer reads
# the workspace through: ./scripts/buck run //:rust-project runs it. It is the
# one released beside the buck2 scripts/internal/pins pins, so it and the
# prelude it queries agree. Like starlark_fmt (buck/tools), the release is a
# bare zstd stream that buck-tools unpacks.
configured_once(
    http_file,
    name = "rust-project.zst",
    sha256 = "d3300715308a7c2d686b82549e203db904a4bce351091c11e7bfec6059c6e83b",
    size_bytes = 1110551,
    urls = ["https://github.com/facebook/buck2/releases/download/2026-09-15/rust-project-x86_64-unknown-linux-gnu.zst"],
)

genrule(
    name = "rust-project",
    cmd = "$(exe //crates/be-tool-buck:bin) unzstd $(location :rust-project.zst) $OUT",
    executable = True,
    out = "rust-project",
    visibility = ["PUBLIC"],
)

# rust-analyzer's standard library, its sources and its proc-macro server, kept
# apart from buck/tools:rust so rust-src is not an input of every compile.
http_archive(
    name = "rust-src-component",
    sha256 = "0e977492aed5ff137815bf9b4b796e8a85b80fb2367ed64e82d5c5839870f2bf",
    size_bytes = 5741336,
    strip_prefix = "rust-src-1.98.0/rust-src",
    urls = ["https://static.rust-lang.org/dist/rust-src-1.98.0.tar.xz"],
)

rust_sysroot(
    name = "analyzer-sysroot",
    components = [
        ":rust-src-component",
        "//buck/tools:rustc-component",
        "//buck/tools:rust-std-" + host,
    ],
    visibility = ["PUBLIC"],
)

# wasm-bindgen, which writes the JavaScript the browser loads be-host's web
# bundle and the gpu shim through. The version has to be the one Cargo.lock has
# for the wasm-bindgen crate: the two agree on a schema that changes between
# releases, and the tool refuses a module built against any other.
# The project's own release of it, for Linux x86_64.
wasm_bindgen_version = "0.2.122"

configured_once(
    http_archive,
    name = "wasm-bindgen-release",
    sha256 = "122a3fe2ea9c6e3e89b50e42dd1a346e499f3f65a54aae0b4eaeb658139d1e0e",
    size_bytes = 11457701,
    strip_prefix = "wasm-bindgen-{}-x86_64-unknown-linux-musl".format(wasm_bindgen_version),
    urls = ["https://github.com/wasm-bindgen/wasm-bindgen/releases/download/{0}/wasm-bindgen-{0}-x86_64-unknown-linux-musl.tar.gz".format(wasm_bindgen_version)],
)

command_alias(
    name = "wasm-bindgen",
    args = ["$(location :wasm-bindgen-release)/wasm-bindgen"],
    visibility = ["PUBLIC"],
)

package_fix(exclude = ["members.bzl"])
