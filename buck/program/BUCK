load("@root//buck/dev:verify.bzl", "package_fix")

# The build-info.json file a program reads beside its executable: the hash of the
# tree it was built from, which ./scripts/buck writes here before each command
# (write_build_id in crates/be-tool-bootstrap) and git ignores. Only the
# bundles read it, so a new id rebuilds nothing else. A reference rather than a
# copy, so a program sees it as a source file and keeps it out of its archive
# (buck/program/defs.bzl).
export_file(
    name = "build-info.json",
    mode = "reference",
)

export_file(
    name = "web-dev.sh",
)

# The browser's side of drive: web-drive.mjs for web-dev.sh, web-test.mjs for
# web_drive_test, web-host-test.mjs for web_host_test and page-test.mjs for page_test
# (drive.bzl), and the command parsing, sign-in, Chromium and static server they share.
filegroup(
    name = "drive-browser",
    srcs = [
        "browser.mjs",
        "drive-words.mjs",
        "page-test.mjs",
        "web-drive.mjs",
        "web-host-test.mjs",
        "web-sign-in.mjs",
        "web-test.mjs",
    ],
)

# A web bundle served as it is, with Caddy: what `./scripts/buck run` of a
# web_program with serve (buck/wasm/defs.bzl) runs.
export_file(
    name = "serve-bundle.sh",
)

export_file(
    name = "bundle.Caddyfile",
)

package_fix()
