load("@root//buck/dev:verify.bzl", "package_fix")

# What a wasm build is for. be-host's web bundle and an app are both
# wasm32-wasip1-threads, but the app links a real wgpu backend and an app only
# the custom one, whose handles are neither Send nor Sync. cargo plans the two
# as separate builds, and a `guest` constraint makes wasi_guest a platform of
# its own for the rules made from those plans to select by.
constraint_setting(
    name = "wasm_role",
)

constraint_value(
    name = "guest",
    constraint_setting = ":wasm_role",
)

# Which of Cargo's profiles a build stands in for: dev without this value, and
# release with it. A constraint rather than a buckconfig value, so that one
# build can hold both: CI's asks for the shipped release artifacts and for the
# dev builds a person's machine asks for, in one command. `-m release` (the
# modifier the root PACKAGE names) adds it to a command's platform, and every
# transition keeps it.
constraint_setting(
    name = "profile",
)

constraint_value(
    name = "release",
    constraint_setting = ":profile",
)

# Whether be-host's binary is linked with fat LTO over one codegen unit
# (crates/be-host/BUCK): a constraint rather than a buckconfig value, so an LTO
# build has outputs of its own. `-m lto` (the root PACKAGE's modifier) adds it
# to a command's platform; ./scripts/deploy's native builds have it by their
# transition (crates/be-tool-local/defs.bzl). Transitions drop it otherwise
# (keep_profile in buck/platforms/profile.bzl), since nothing else selects on
# it and the apps would only be built again for nothing.
constraint_setting(
    name = "link_time_optimization",
)

constraint_value(
    name = "lto",
    constraint_setting = ":link_time_optimization",
)

# Which core beui's view layer builds on (guides/beui.md, Two cores): the native one,
# which lays out and paints itself, without this value, and the HTML one, which
# hands both to the browser, with it. A constraint rather than a cargo feature,
# since the wasi plan merges features across apps: wasi_html and
# linux_x86_64_html are the wasi and host platforms with it, the plans cargo is
# asked for under them are run with --cfg beui_html, and buck/cargo/defs.bzl
# passes that flag to every first-party crate built for them.
constraint_setting(
    name = "beui_core",
)

constraint_value(
    name = "html",
    constraint_setting = ":beui_core",
)

# What no platform has: buck/cargo/defs.bzl makes a workspace crate's targets
# need it on every platform cargo did not plan the crate for, so building one
# there is a configuration error that names this.
constraint_setting(
    name = "cargo_plan",
)

constraint_value(
    name = "planned_by_cargo",
    constraint_setting = ":cargo_plan",
)

package_fix()
