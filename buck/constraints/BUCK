# What a wasm build is for. block-app's web bundle and a plugin are both
# wasm32-wasip1-threads, but the app links a real wgpu backend and a plugin only
# the custom one, whose handles are neither Send nor Sync. cargo plans the two
# as separate builds, and a `guest` constraint makes wasi_guest a platform of
# its own for the rules made from those plans to select by.
constraint_setting(
    name = "wasm_role",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "guest",
    constraint_setting = ":wasm_role",
    visibility = ["PUBLIC"],
)

# What an action needs from its worker beyond the defaults. The signing
# platform in buck/platforms has this and the default one does not, so only
# a target that asks for it with exec_compatible_with runs there.
constraint_setting(
    name = "worker",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "android_keystore",
    constraint_setting = ":worker",
    visibility = ["PUBLIC"],
)

# Which of Cargo's profiles a build stands in for: dev without this value, and
# release with it. A constraint rather than a buckconfig value, so that one
# build can hold both: CI's asks for the shipped release artifacts and for the
# dev builds a person's machine asks for, in one command. The platforms named
# <name>_release in buck/platforms carry it, and every transition keeps it.
constraint_setting(
    name = "profile",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "release",
    constraint_setting = ":profile",
    visibility = ["PUBLIC"],
)
