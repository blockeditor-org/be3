# The build-info.json file a program reads beside its executable: the hash of the
# tree it was built from, which ./scripts/buck writes here before each command
# (write_build_id in crates/bootstrap) and git ignores. Only the
# bundles read it, so a new id rebuilds nothing else.
export_file(
    name = "build-info.json",
    visibility = ["PUBLIC"],
)

export_file(
    name = "stage.sh",
    visibility = ["PUBLIC"],
)

export_file(
    name = "web-dev.sh",
    visibility = ["PUBLIC"],
)

export_file(
    name = "web-drive.mjs",
    visibility = ["PUBLIC"],
)

export_file(
    name = "bundle.sh",
    visibility = ["PUBLIC"],
)
