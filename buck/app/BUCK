# The build-info.json file a program reads beside its executable: the hash of the
# tree it was built from, which ./scripts/buck writes here before each command
# (write_build_id in crates/bootstrap) and git ignores. Only the
# bundles read it, so a new id rebuilds nothing else.
export_file(
    name = "build-info.json",
    visibility = ["PUBLIC"],
)

export_file(
    name = "stage.sh",
    visibility = ["PUBLIC"],
)

export_file(
    name = "web-dev.sh",
    visibility = ["PUBLIC"],
)

# The browser's side of drive: web-drive.mjs for web-dev.sh, web-test.mjs for
# web_drive_test (drive.bzl), and the command parsing they share.
filegroup(
    name = "drive-browser",
    srcs = [
        "drive-words.mjs",
        "web-drive.mjs",
        "web-test.mjs",
    ],
    visibility = ["PUBLIC"],
)

export_file(
    name = "bundle.sh",
    visibility = ["PUBLIC"],
)

# A web bundle served as it is, with Caddy: beui-web-demo's and
# beui-html-spike's :web.
export_file(
    name = "serve-bundle.sh",
    visibility = ["PUBLIC"],
)

export_file(
    name = "bundle.Caddyfile",
    visibility = ["PUBLIC"],
)
