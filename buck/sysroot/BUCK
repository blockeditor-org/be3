load("@root//buck/dev:verify.bzl", "package_fix")
load("//buck/platforms:cross.bzl", "per_cross_platform")
load(":defs.bzl", "deb_downloads", "deb_indexes", "deb_lock", "pkg_config", "sysroot")
load(":packages.bzl", "packages")

# The Linux the build compiles and links against: Ubuntu 24.04's own packages -
# glibc, libstdc++ and every system library a crate links - unpacked into a
# sysroot the toolchain passes with --sysroot, so a worker's image is only what
# runs the tools. They come from a snapshot of the archive, which pins every
# index; ./scripts/buck run //:lock-sysroot resolves the list below into
# packages.bzl.

snapshot = "20260915T000000Z"

wanted = [
    # The C and C++ runtime and the gcc install clang takes them from.
    "libc6-dev",
    "libgcc-13-dev",
    "libstdc++-13-dev",
    # What third-party crates link.
    "libasound2-dev",
    "libxkbcommon-dev",
    # beui-platform-drm, which be-host's login session (BEUI_PLATFORM=drm) runs on: displays through GBM, input through
    # libinput, a seat through libseat, and devices found through udev.
    "libgbm-dev",
    "libinput-dev",
    "libseat-dev",
    "libudev-dev",
]

# What only tests load: the Vulkan loader, lavapipe, the XKB keymaps and a D-Bus
# daemon for a private bus. A set of its own, so that changing it leaves every
# compile's key alone.
test_runtime = [
    "dbus-daemon",
    "libvulkan1",
    "mesa-vulkan-drivers",
    "xkb-data",
]

# What beui-layer-xr's smoke test adds to that: the OpenXR loader, and Monado's
# runtime and service, which it runs with the null compositor on lavapipe.
# Armadillo, which Monado's OpenCV links, is the one library outside the
# multiarch directory.
xr_runtime = test_runtime + [
    "libopenxr-loader1",
    "libopenxr1-monado",
    "monado-service",
]

# The indexes :lock resolves against (deb_indexes in defs.bzl). A new snapshot
# needs these too: its dists/SUITE/InRelease lists each one's sha256 and size.
indexes = deb_indexes(
    snapshot,
    {
        "noble-security/main/amd64": ("b4a1a0de202d0d25fae2c30e5e8e8324a4d4f7736195fc6bf749cadeaa87a20b", 1242473),
        "noble-security/main/arm64": ("68a0aa1cf3eb0cc6759b3d18c706b70ae597b626bf32b832bf9882beed2bf2f2", 1312345),
        "noble-security/universe/amd64": ("00062bc4c32071615e860f3e8954031799a38b698e7ed2936bf2abf9a3a9f239", 1531124),
        "noble-security/universe/arm64": ("7de8946498b2af91b4baee3064edb63da1dc42a766157b07efccbad016a10472", 1617670),
        "noble-updates/main/amd64": ("a18cd6450a937dc349ef1f79536fe9e87a94f72bf0012a5686008cf6159f165a", 1565391),
        "noble-updates/main/arm64": ("7e9c208683f116294f97aa1635a545d5d9cc2817ce30d7931d6f5ae606326ef7", 1630310),
        "noble-updates/universe/amd64": ("6296a6cecd604dacb9f39593289d8bdb4978df9251263071fd6362f693e55221", 2151668),
        "noble-updates/universe/arm64": ("0d7cffac20dd44095ce3a501768e31b5eef84146a4a1ee0088f0da54ddf28ed4", 2195359),
        "noble/main/amd64": ("e0d7e4cbb09d2aa7f9e104a1488817417bc9d85f3e5d9a21156a52ec641ae531", 1808488),
        "noble/main/arm64": ("86d8c27108110e8ebceb4b8548e2995c422cff642666b4ca0307be7358c68b21", 1775784),
        "noble/universe/amd64": ("ce57756edcce0a5f7993ceb89057e1510148e04e3b85a066d780e4bc00485c8a", 19315644),
        "noble/universe/arm64": ("b8408fe3d33d80c5f9b958ae19dc20f2a19ff65b0d1522e1e86d44316f552307", 19026623),
    },
)

deb_lock(
    name = "lock",
    indexes = indexes,
    sets = {
        "amd64": ("amd64", wanted),
        "amd64-test": ("amd64", test_runtime),
        "amd64-xr": ("amd64", xr_runtime),
        "arm64": ("arm64", wanted),
    },
    snapshot = snapshot,
)

# One download for each package of each architecture, whichever sets name it
# (deb_downloads), and each set's sysroot configured once (sysroot).
deb_downloads(packages)

sysroot(name = "amd64", packages = packages, set_name = "amd64")

sysroot(
    name = "amd64-test",
    keep_xkb = True,
    packages = packages,
    programs = ["usr/bin/dbus-daemon"],
    set_name = "amd64-test",
)

sysroot(
    name = "amd64-xr",
    keep_xkb = True,
    packages = packages,
    programs = [
        "usr/bin/monado-service",
        "usr/lib/libarmadillo.so.12",
        "usr/lib/libarmadillo.so.12.6.7",
    ],
    set_name = "amd64-xr",
)

# Monado's runtime manifest, naming its library by file name, as
# lavapipe_icd.json does, so the smoke test loads it from :amd64-xr.
export_file(
    name = "monado_runtime.json",
    visibility = ["PUBLIC"],
)

# What a program run here from :amd64 loads, for `:dev` (buck/program/drive.bzl) to
# download: its shared libraries, without the headers, static libraries and
# sanitizer runtimes only a link needs: 258 MB of its 361.
genrule(
    name = "amd64-libraries",
    cmd = """
        set -eu
        cp -RP $(location :amd64)/usr/lib/x86_64-linux-gnu/. $OUT/
        find $OUT -name '*.a' -delete
        find $OUT -name '*.o' -delete
        rm -rf $OUT/pkgconfig
        rm -f $OUT/libasan.so* $OUT/libtsan.so* $OUT/liblsan.so* $OUT/libubsan.so* $OUT/libhwasan.so*
    """,
    out = "lib",
    visibility = ["PUBLIC"],
)

sysroot(name = "arm64", packages = packages, set_name = "arm64")

# What a -sys crate's build script asks, for the platform it is building for.
# The fixups name it with $(exe_target), which is that platform's, rather than
# with $(exe), which is the worker's.
pkg_config(
    name = "pkg-config",
    sysroot = per_cross_platform(":amd64", lambda name: ":arm64" if name == "linux_arm64" else None),
    triple = per_cross_platform("x86_64-linux-gnu", lambda name: "aarch64-linux-gnu" if name == "linux_arm64" else None),
    visibility = ["PUBLIC"],
)

# Lavapipe's Vulkan driver manifest, naming its library by file name rather than
# Mesa's absolute path, so a test with :amd64-test's libraries on
# LD_LIBRARY_PATH loads it from there.
export_file(
    name = "lavapipe_icd.json",
    visibility = ["PUBLIC"],
)

export_file(
    name = "lock.sh",
    visibility = ["PUBLIC"],
)


export_file(
    name = "deb_sysroot.sh",
    visibility = ["PUBLIC"],
)

package_fix(exclude = ["packages.bzl"])
