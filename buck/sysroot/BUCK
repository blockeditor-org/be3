load("//buck/platforms:cross.bzl", "per_cross_platform")
load(":defs.bzl", "deb_lock", "deb_sysroot", "pkg_config")
load(":packages.bzl", "packages")

# The Linux the build compiles and links against.
#
# A worker is a container of Ubuntu 24.04's buildpack-deps, and what it is for
# is running tools. What a program is built against - glibc and its headers,
# libstdc++, and every system library a crate links: ALSA, GTK, WebKitGTK -
# comes from here instead, as Ubuntu 24.04's own packages, unpacked into a
# sysroot the toolchain in buck/toolchains/BUCK hands the compiler and the
# linker with --sysroot. So nothing a build needs has to be installed anywhere,
# and the worker's image is not part of what a program is made of.
#
# The packages come from a snapshot of the archive, which pins every index for
# good. ./scripts/buck run //:buckify resolves what is asked for below into its dependency
# closure and writes packages.bzl; a new system library is a line here and a
# buckify.

snapshot = "20260915T000000Z"

wanted = [
    # The C and C++ runtime and the gcc install clang takes them from.
    "libc6-dev",
    "libgcc-13-dev",
    "libstdc++-13-dev",
    # What third-party crates link.
    "libasound2-dev",
    "libgtk-3-dev",
    "libwebkit2gtk-4.1-dev",
    # be-compositor's session backend: displays through GBM, input through
    # libinput, a seat through libseat, and devices found through udev.
    "libgbm-dev",
    "libinput-dev",
    "libseat-dev",
    "libudev-dev",
]

# What a test loads that nothing is compiled or linked against: the Vulkan
# loader and Mesa's software driver, lavapipe, which is the graphics device
# beui's renderer tests draw through on a worker, and the XKB keymaps
# libxkbcommon compiles a keyboard from, which be-compositor's tests need. A set
# of its own rather than part of the one above, whose sysroot is an input of
# every compile and link on the host, so that adding to it does not change their
# cache keys.
test_runtime = [
    "libvulkan1",
    "mesa-vulkan-drivers",
    "xkb-data",
]

deb_lock(
    name = "lock",
    resolver = "resolve.py",
    sets = {
        "amd64": ("amd64", wanted),
        "amd64-test": ("amd64", test_runtime),
        "arm64": ("arm64", wanted),
    },
    snapshot = snapshot,
)

# The amd64 packages keep the names they had before there was a second set;
# the others' are prefixed. A package two sets share is downloaded once,
# whichever name asks for it.
set_prefixes = {
    "amd64": "",
    "amd64-test": "test-",
    "arm64": "arm64-",
}

[
    http_file(
        name = set_prefixes[set_name] + name.replace("+", "p") + ".deb",
        sha256 = sha256,
        size_bytes = size_bytes,
        urls = [url],
    )
    for set_name in sorted(packages)
    for name, url, sha256, size_bytes in packages[set_name]
]

deb_sysroot(
    name = "amd64",
    packages = [":" + name.replace("+", "p") + ".deb" for name, _, _, _ in packages["amd64"]],
    visibility = ["PUBLIC"],
)

deb_sysroot(
    name = "amd64-test",
    keep_xkb = True,
    packages = [":test-" + name.replace("+", "p") + ".deb" for name, _, _, _ in packages.get("amd64-test", [])],
    visibility = ["PUBLIC"],
)

deb_sysroot(
    name = "arm64",
    packages = [":arm64-" + name.replace("+", "p") + ".deb" for name, _, _, _ in packages["arm64"]],
    visibility = ["PUBLIC"],
)

# What a -sys crate's build script asks, for the platform it is building for.
# The fixups name it with $(exe_target), which is that platform's, rather than
# with $(exe), which is the worker's.
pkg_config(
    name = "pkg-config",
    sysroot = per_cross_platform(":amd64", lambda name: ":arm64" if name == "linux_arm64" else None),
    triple = per_cross_platform("x86_64-linux-gnu", lambda name: "aarch64-linux-gnu" if name == "linux_arm64" else None),
    visibility = ["PUBLIC"],
)

# Lavapipe's Vulkan driver manifest, for a test to name with VK_ICD_FILENAMES.
# Mesa's own names its library by its absolute path on an installed system; this
# names it by file name, which the loader looks up the way the dynamic linker
# does, so a test that puts :amd64-test's libraries on LD_LIBRARY_PATH gets
# the driver from there.
export_file(
    name = "lavapipe_icd.json",
    visibility = ["PUBLIC"],
)
