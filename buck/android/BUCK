load(":sign-wasm.bzl", "apk_sign_command", "wasm_signer")

# What an APK is made with, pinned by hash and size: a JDK (javac, d8,
# apksigner for reference tests), the SDK build tools (aapt2, zipalign), and
# the platform (android.jar). Signing runs locally through WASI.

jdk_version = "21.0.12.1+1"

