    name = "jdk",
    sha256 = "ce79869e1307ed8ee1e2baa86a412b1eb5b75d10a01006d788a6f968bcfaee94",
    size_bytes = 207473347,
    strip_prefix = "jdk-" + jdk_version,
    urls = [
        "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-{}/OpenJDK21U-jdk_x64_linux_hotspot_{}.tar.gz".format(
            jdk_version.replace("+", "%2B"),
            jdk_version.replace("+", "_"),
