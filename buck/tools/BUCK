load("@toolchains//:defs.bzl", "script")
load(":defs.bzl", "llvm_tree", "rust_sysroot", "tool")

# The compilers the build runs, downloaded rather than taken from the machine.
#
# Every action runs on a BuildBuddy worker, which is a container with nothing
# of this project's in it, so the compilers come with the build: they are
# downloaded here, pinned by hash, and reach a worker the way a source file
# does, as inputs of the actions that run them. defs.bzl says what the
# container is. guides/buck2.md says why none of it is taken from the machine
# that asked for the build.
#
# The versions are the ones cargo uses: rust-toolchain.toml's Rust, and the
# clang-20 that newest_wasm_clang in scripts/internal/common.sh picks on Ubuntu
# 24.04, which is the distribution the container is.

# Each download is pinned by its size as well as its hash. With both, buck2
# knows the file's digest without asking the server anything, so a build whose
# workers already have the file never contacts the host that serves it. With
# only the hash it sends a HEAD request for the size on every new daemon, and
# the build fails whenever that host is slow to answer.
rust_version = "1.98.0"

rust_host = "x86_64-unknown-linux-gnu"

http_archive(
    name = "rustc-component",
    sha256 = "0e37cb339f447fc44d6d781073bacacebfdc5612f2600e4c7e84c266f5f3aced",
    size_bytes = 79745456,
    strip_prefix = "rustc-{}-{}/rustc".format(rust_version, rust_host),
    urls = ["https://static.rust-lang.org/dist/rustc-{}-{}.tar.xz".format(rust_version, rust_host)],
    visibility = ["//buck/cargo:"],
)

http_archive(
    name = "clippy-component",
    sha256 = "646c6bd2450ea4c32a3c78ad7a3727294eea1f1519718a3f1487424021695ffa",
    size_bytes = 5379668,
    strip_prefix = "clippy-{}-{}/clippy-preview".format(rust_version, rust_host),
    urls = ["https://static.rust-lang.org/dist/clippy-{}-{}.tar.xz".format(rust_version, rust_host)],
)

rust_std = {
    "wasm32-unknown-unknown": ("3bb537c09555b96020a38a3a8810c38908b194eff3c2cb6184a45dda5c6828de", 22441312),
    "wasm32-wasip1-threads": ("56002ff8232f0e82d446267b6d84dc394007e4b090b8f84b17124615802407f3", 23857356),
    "x86_64-unknown-linux-gnu": ("f5022e6c95a5ad23cca2513dc8281200f585fa188de6370aa37b128a43f876a3", 30715556),
}

[
    http_archive(
        name = "rust-std-" + target,
        sha256 = sha256,
        size_bytes = size_bytes,
        strip_prefix = "rust-std-{}-{}/rust-std-{}".format(rust_version, target, target),
        urls = ["https://static.rust-lang.org/dist/rust-std-{}-{}.tar.xz".format(rust_version, target)],
        visibility = ["//buck/cargo:"],
    )
    for target, (sha256, size_bytes) in rust_std.items()
]

rust_sysroot(
    name = "rust",
    components = [":rustc-component", ":clippy-component"] + [":rust-std-" + target for target in sorted(rust_std)],
)

# The targets that are cross-compiled, each with a sysroot of its own: the same
# rustc with only that target's standard library beside it. Adding one to the
# sysroot above would change the compiler every existing action names, and so
# every cache key the host build has.
cross_rust_std = {
    "aarch64-apple-darwin": ("48c05269ed36fb5f0a8438065156891fe59fcb868d90cfed9b7209540d54b2ce", 29740736),
    "aarch64-pc-windows-msvc": ("df28cbf39697dfbfac0633814b56c1ca6f07fd32a70ab2074cb095f3871ae338", 23048684),
    "aarch64-unknown-linux-gnu": ("a36f7ac98af20ef0ba6368aace0345efabbebaef7962eba99f47190fd256162d", 30768752),
    "x86_64-apple-darwin": ("8923fa9d0e0407b8a492e59d568e7aceff75949e1eee2e3e1b60e174373890cb", 29760212),
    "x86_64-pc-windows-msvc": ("81d123f834111ebeaf8b1eed0e93b0b66ea4bcf4cc1d3836d9a0314d4ea94a73", 23061408),
}

[
    http_archive(
        name = "rust-std-" + target,
        sha256 = sha256,
        size_bytes = size_bytes,
        strip_prefix = "rust-std-{}-{}/rust-std-{}".format(rust_version, target, target),
        urls = ["https://static.rust-lang.org/dist/rust-std-{}-{}.tar.xz".format(rust_version, target)],
    )
    for target, (sha256, size_bytes) in cross_rust_std.items()
]

[
    rust_sysroot(
        name = "rust-" + target,
        components = [":rustc-component", ":clippy-component", ":rust-std-" + target],
    )
    for target in sorted(cross_rust_std)
]

# An Apple target's rustc is told where the SDK is, which it otherwise asks
# xcrun, a program only a Mac has. It only takes an absolute path, and a path
# in a command line is relative to wherever the action runs.
[
    [
        tool(
            name = "{}-{}".format(program, target),
            command = (["sh", "-c", 'SDKROOT="$PWD/$0" exec "$@"', "$(location :macos-sdk)"] if "apple" in target else [])
            + ["$(location :rust-{})/bin/{}".format(target, program)],
            visibility = ["PUBLIC"],
        )
        for program in ["rustc", "rustdoc", "clippy-driver"]
    ]
    for target in sorted(cross_rust_std)
]

# Apple's SDK: the headers and the .tbd stubs a macOS binary is compiled and
# linked against. It is a repackaging of the one in Xcode, which Apple's licence
# only allows on Apple hardware; guides/buck2.md says where that leaves the
# macOS build.
http_archive(
    name = "macos-sdk",
    sha256 = "c15cf0f3f17d714d1aa5a642da8e118db53d79429eb015771ba816aa7c6c1cbd",
    size_bytes = 78401020,
    strip_prefix = "MacOSX15.5.sdk",
    urls = ["https://github.com/joseluisq/macosx-sdks/releases/download/15.5/MacOSX15.5.sdk.tar.xz"],
    visibility = ["PUBLIC"],
)

# Launchpad's copy of each package rather than the archive's: the archive drops
# a version once a newer one supersedes it, and Launchpad keeps every one.
llvm_version = "20.1.2-0ubuntu1~24.04.3"

llvm_packages = {
    "clang-20": ("d3fec854d8b998510a6f525ba397123563be091939d11131ce2dff02ed9368bc", 77674),
    "libclang-common-20-dev": ("1f50ed5cb36909b83e885e5e507ccb8a54c70816f4f6574d6190cfa5cf95a891", 782474),
    "libclang-cpp20": ("0dc8f6d4cc8588e963fa86414c93f6065766211064cdc766e588c9b882b0714b", 14244738),
    "libclang1-20": ("a5aed87546aa7b645f06a5269cf1cc190c1b70f6d212b4db49311d6cfc6398e2", 8317988),
    "libllvm20": ("f018e71c72c7a4742fb1aff9dc98b45586f42e6ea464d4918af7e3772b7f0658", 30574382),
    "lld-20": ("50d8db763d3e3526c050d01c2c8c9c94e3f94cca6f7dbdb8f9a4c65aefefcf83", 1488474),
    "llvm-20": ("b7ca50166943d94c786611ebe7a0dd8f5b9a9b1f81025620cf9dfcd8aac84563", 19772486),
}

[
    http_file(
        name = package + ".deb",
        sha256 = sha256,
        size_bytes = size_bytes,
        urls = ["https://launchpad.net/ubuntu/+archive/primary/+files/{}_{}_amd64.deb".format(package, llvm_version)],
    )
    for package, (sha256, size_bytes) in llvm_packages.items()
]

llvm_tree(
    name = "llvm",
    packages = [":{}.deb".format(package) for package in sorted(llvm_packages)],
    visibility = ["//third-party/rust/..."],
)

# What buck/toolchains/BUCK names.
tool(
    name = "rustc",
    command = ["$(location :rust)/bin/rustc"],
    visibility = ["PUBLIC"],
)

tool(
    name = "rustdoc",
    command = ["$(location :rust)/bin/rustdoc"],
    visibility = ["PUBLIC"],
)

tool(
    name = "clippy-driver",
    command = ["$(location :rust)/bin/clippy-driver"],
    visibility = ["PUBLIC"],
)

tool(
    name = "cc",
    command = ["$(location :llvm)/bin/clang"],
    visibility = ["PUBLIC"],
)

tool(
    name = "cxx",
    command = ["$(location :llvm)/bin/clang++"],
    visibility = ["PUBLIC"],
)

# llvm-ar under the name that makes it take lib.exe's flags, which is how cc-rs
# and the prelude archive for an MSVC target.
tool(
    name = "lib",
    command = ["$(location :llvm)/bin/llvm-lib"],
    visibility = ["PUBLIC"],
)

tool(
    name = "lld-link",
    command = ["$(location :llvm)/bin/lld-link"],
    visibility = ["PUBLIC"],
)

tool(
    name = "ar",
    command = ["$(location :llvm)/bin/llvm-ar"],
    visibility = ["PUBLIC"],
)

# The MSVC C runtime and the Windows SDK: headers and import libraries, which
# xwin downloads from Microsoft and lays out, one architecture per action. The
# channel manifest is pinned, and it pins every package xwin fetches by hash,
# so the result is the same wherever it is made; it is the one download here
# that happens inside an action, because the packages are MSIs and VSIXs xwin
# has to take apart. Downloading them means accepting Microsoft's licence for
# the Visual Studio Build Tools, which --accept-license does, and
# guides/buck2.md says so.
http_archive(
    name = "xwin",
    sha256 = "d870eb4b2f390878af6da1ccd3cf321d22fcb72720984853b4be732ae597fc88",
    size_bytes = 3416863,
    strip_prefix = "xwin-0.10.0-x86_64-unknown-linux-musl",
    urls = ["https://github.com/Jake-Shadle/xwin/releases/download/0.10.0/xwin-0.10.0-x86_64-unknown-linux-musl.tar.gz"],
)

# Visual Studio 17.14.41, September 2026.
http_file(
    name = "vs-channel-manifest",
    sha256 = "fca418ba94ffbcfb7a2b25f10f16f39dd09660568d21eef4bd3f274cb0b27b8c",
    size_bytes = 91781,
    urls = [
        "https://download.visualstudio.microsoft.com/download/pr/bc92e2cb-33de-4a0c-995d-efa817f16b16/0dbdfd40c17757e64fc9f72cd9954ec8471c04fd8461a77806e5291e23239ac0/VisualStudio.17.Release.chman"
    ],
)

[
    genrule(
        name = "windows-sdk-" + arch,
        # The cache is beside the output rather than in /tmp: xwin moves what
        # it unpacks into place, and a move cannot cross filesystems.
        cmd = " ".join([
            "$(location :xwin)/xwin",
            "--accept-license",
            "--manifest $(location :vs-channel-manifest)",
            "--arch " + arch,
            "--cache-dir $OUT.cache",
            "--http-retry 3",
            "--log-level warn",
            "splat --output $OUT",
            "&& rm -rf $OUT.cache",
        ]),
        out = "sdk",
        visibility = ["PUBLIC"],
    )
    for arch in ["x86_64", "aarch64"]
]

# clang for each cross-compiled platform. The target is part of the command
# rather than a toolchain flag because the prelude assembles a .S file with the
# bare compiler and none of the flags, and an assembly file that asks which
# platform it is for would otherwise be told Linux on x86_64. The macOS
# minimums are rustc's defaults for the two triples, so C and Rust agree.
clang_targets = {
    "linux_arm64": "aarch64-linux-gnu",
    "macos_arm64": "arm64-apple-macosx11.0",
    "macos_x86_64": "x86_64-apple-macosx10.12",
    "windows_arm64": "aarch64-pc-windows-msvc",
    "windows_x86_64": "x86_64-pc-windows-msvc",
}

[
    [
        tool(
            name = "{}-{}".format(program, name),
            command = [
                "$(location :llvm)/bin/" + driver,
                "--target=" + target,
            ],
            visibility = ["PUBLIC"],
        )
        for program, driver in [("cc", "clang"), ("cxx", "clang++")]
    ]
    for name, target in clang_targets.items()
]

tool(
    name = "wasm-cc",
    command = [
        "$(location :llvm)/bin/clang",
        "--target=wasm32-wasip1-threads",
    ],
    visibility = ["PUBLIC"],
)

tool(
    name = "wasm-cxx",
    command = [
        "$(location :llvm)/bin/clang++",
        "--target=wasm32-wasip1-threads",
    ],
    visibility = ["PUBLIC"],
)

tool(
    name = "wasm-ld",
    command = [
        "$(location :wasm-ld.sh)",
        "$(location :rust)/lib/rustlib/{}/bin/rust-lld".format(rust_host),
    ],
    visibility = ["PUBLIC"],
)

export_file(
    name = "wasm-ld.sh",
    src = "wasm-ld",
)

# The Python the prelude's own helpers run on. The one tool here that is not a
# download: it is a checked-in script that finds the container's Python when
# it runs, and the file says why that is safe to leave out of the cache key.
script(
    name = "python3",
    src = "python3",
    visibility = ["PUBLIC"],
)

script(
    name = "pkg-config-provided",
    src = "pkg-config-provided",
    visibility = ["PUBLIC"],
)
