# llvm-ar under the name that makes it take lib.exe's flags, which is how cc-rs
# and the prelude archive for an MSVC target.
tool(
    name = "lib",
    command = ["$(location :llvm)/bin/llvm-lib"],
    visibility = ["PUBLIC"],
)

tool(
    name = "lld-link",
    command = ["$(location :llvm)/bin/lld-link"],
    visibility = ["PUBLIC"],
)

tool(
    name = "ar",
    command = ["$(location :llvm)/bin/llvm-ar"],
    visibility = ["PUBLIC"],
)

# The MSVC C runtime and Windows SDK, laid out by xwin on a worker from a pinned
# channel manifest that pins every package by hash. Downloading them accepts
# Microsoft's Build Tools licence (--accept-license).
http_archive(
    name = "xwin",
    sha256 = "d870eb4b2f390878af6da1ccd3cf321d22fcb72720984853b4be732ae597fc88",
    size_bytes = 3416863,
    strip_prefix = "xwin-0.10.0-x86_64-unknown-linux-musl",
    urls = ["https://github.com/Jake-Shadle/xwin/releases/download/0.10.0/xwin-0.10.0-x86_64-unknown-linux-musl.tar.gz"],
)

# Visual Studio 17.14.41, September 2026.
http_file(
    name = "vs-channel-manifest",
    sha256 = "fca418ba94ffbcfb7a2b25f10f16f39dd09660568d21eef4bd3f274cb0b27b8c",
    size_bytes = 91781,
    urls = [
        "https://download.visualstudio.microsoft.com/download/pr/bc92e2cb-33de-4a0c-995d-efa817f16b16/0dbdfd40c17757e64fc9f72cd9954ec8471c04fd8461a77806e5291e23239ac0/VisualStudio.17.Release.chman"
    ],
)

[
    genrule(
        name = "windows-sdk-" + arch,
        # The cache is beside the output rather than in /tmp: xwin moves what
        # it unpacks into place, and a move cannot cross filesystems.
        cmd = " ".join([
            "$(location :xwin)/xwin",
            "--accept-license",
            "--manifest $(location :vs-channel-manifest)",
            "--arch " + arch,
            "--cache-dir $OUT.cache",
            "--http-retry 3",
            "--log-level warn",
            "splat --output $OUT",
            "&& rm -rf $OUT.cache",
        ]),
        out = "sdk",
        visibility = ["PUBLIC"],
    )
    for arch in ["x86_64", "aarch64"]
]

# Android's NDK r29, pruned on a worker to the aarch64 sysroot and the compiler
# runtime (86 of its 780 MB), so no action takes the whole zip as an input.
genrule(
    name = "android-ndk",
    cmd = "python3 $(location :android-ndk.py) "
    + "https://dl.google.com/android/repository/android-ndk-r29-linux.zip "
    + "4abbbcdc842f3d4879206e9695d52709603e52dd68d3c1fff04b3b5e7a308ecf $OUT",
    out = "ndk",
    visibility = ["PUBLIC"],
)

export_file(
    name = "android-ndk.py",
)

# clang for each cross-compiled platform, with the target in the command: the
# prelude assembles .S files with the bare compiler, without toolchain flags.
# The macOS minimums are rustc's defaults.
clang_targets = {
    "android_arm64": "aarch64-linux-android26",
    "linux_arm64": "aarch64-linux-gnu",
    "macos_arm64": "arm64-apple-macosx11.0",
    "macos_x86_64": "x86_64-apple-macosx10.12",
    "windows_arm64": "aarch64-pc-windows-msvc",
    "windows_x86_64": "x86_64-pc-windows-msvc",
}

[
    [
        tool(
            name = "{}-{}".format(program, name),
            command = [
                "$(location :llvm)/bin/" + driver,
                "--target=" + target,
            ],
            visibility = ["PUBLIC"],
        )
        for program, driver in [("cc", "clang"), ("cxx", "clang++")]
    ]
    for name, target in clang_targets.items()
]

tool(
    name = "wasm-cc",
    command = [
        "$(location :llvm)/bin/clang",
        "--target=wasm32-wasip1-threads",
    ],
    visibility = ["PUBLIC"],
)

tool(
    name = "wasm-cxx",
    command = [
        "$(location :llvm)/bin/clang++",
        "--target=wasm32-wasip1-threads",
    ],
    visibility = ["PUBLIC"],
)

tool(
    name = "wasm-ld",
    command = [
        "$(exe :wasm-ld.sh)",
        "$(location :rust)/lib/rustlib/{}/bin/rust-lld".format(rust_host),
    ],
    visibility = ["PUBLIC"],
)

script(
    name = "wasm-ld.sh",
    src = "wasm-ld",
)

# The Python the prelude's own helpers run on. The one tool here that is not a
# download: it is a checked-in script that finds the container's Python when
# it runs, and the file says why that is safe to leave out of the cache key.
script(
    name = "python3",
    src = "python3",
    visibility = ["PUBLIC"],
)

script(
    name = "pkg-config-provided",
    src = "pkg-config-provided",
    visibility = ["PUBLIC"],
)

# Caddy, which //crates/block-app:web-serve runs on this machine, so the release
# is this machine's. The same bytes as upstream's GitHub releases, mirrored.
caddy_version = "2.11.4"

caddy_releases = {
    "linux_amd64": ("527fbf917c39189a1e3b31d34fa955601680b2d5c8055d2a87b8b9588dec7bb9", 17238873, "tar.gz"),
    "linux_arm64": ("52d42ae12b3462097e9868da6dfed3c9648ae12edd3b3638102312af84cb6904", 15704974, "tar.gz"),
    "mac_amd64": ("34bc9e5cceee8d67844ef51da624f5b79e8d070f27236e050c3f0066a2dba534", 17631734, "tar.gz"),
    "mac_arm64": ("9efb0af2d6cf09cfb5053c0e51721b9b3d4956d346234f39368d943d25a3c9a7", 16448366, "tar.gz"),
    "windows_amd64": ("1708333f79e274c7697285afe6d592ab39314e0b131e9ec6bea08ad27df62ebf", 17559418, "zip"),
    "windows_arm64": ("c7f16da93728f61455f77c04eac1ff4de06a38da281ed6d3dcbfae795be2a936", 15748221, "zip"),
}

[
    http_archive(
        name = "caddy-" + release,
        sha256 = sha256,
        size_bytes = size_bytes,
        urls = ["https://lfs.pfg.pw/by-name/be3/caddy/caddy_{}_{}.{}".format(caddy_version, release, extension)],
    )
    for release, (sha256, size_bytes, extension) in caddy_releases.items()
]

_caddy_host = "{}_{}".format(
    "mac" if host_info().os.is_macos else "windows" if host_info().os.is_windows else "linux",
    "arm64" if host_info().arch.is_aarch64 else "amd64",
)

alias(
    name = "caddy",
    actual = ":caddy-" + _caddy_host,
    visibility = ["PUBLIC"],
)
