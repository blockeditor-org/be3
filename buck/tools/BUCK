# The host tool wrappers ./scripts/buck writes. They are not checked in: each
# one names the version of the tool it runs, which is what makes a cache entry
# belong to a compiler rather than to a machine, and that is a fact about the
# machine rather than about the repository.
#
# buck/toolchains/BUCK is what turns them into a toolchain.
export_file(
    name = "ar",
    src = "ar",
    visibility = ["PUBLIC"],
)

export_file(
    name = "cc",
    src = "cc",
    visibility = ["PUBLIC"],
)

