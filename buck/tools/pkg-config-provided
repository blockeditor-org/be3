#!/bin/sh
# A pkg-config that finds whatever it is asked for and needs no flags for it.
#
# For a -sys crate whose build script compiles a library it vendors unless
# pkg-config finds one, when buck2 compiles that library itself: this is what
# tells the build script there is nothing left for it to do. The pkg-config
# crate reads a version from --modversion, so that is answered; everything
# else is answered with nothing.
for argument in "$@"; do
    if [ "$argument" = --modversion ]; then
        echo 0
    fi
done
