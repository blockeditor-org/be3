#!/bin/sh
#
# The Python the prelude's own helpers run on: rustc_action, buildscript_run,
# from_any_dir and dep_file_processor, which start the real compiler and
# shuffle paths and diagnostics around it.
#
# It runs in the worker's container, whose Python is Ubuntu 24.04's 3.12. That
# is also the oldest one that works: one of the helpers uses
# Path.relative_to(walk_up=True), which arrived in 3.12, and an older one fails
# from inside an unrelated C compile as a TypeError nobody would connect to it.
exec python3 "$@"
