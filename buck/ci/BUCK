load(":defs.bzl", "bundle", "group")

# CI's build, in one command: `./scripts/buck build --materializations=none
# //buck/ci:everything //crates/...`, and then `build //buck/ci:artifacts --out
# dist`, which the first has built, for what it uploads. Each target here
# names the platform it is for, so one command holds every platform and both
# profiles. `-c be3.commit=SHA` is the commit the release apps report.

# The artifact name each platform's app and server upload under, and the
# platform in buck/platforms it is built for.
NATIVE = {
    "linux-aarch64": "linux_arm64",
    "linux-x86_64": "linux_x86_64",
    "macos-aarch64": "macos_arm64",
    "macos-x86_64": "macos_x86_64",
    "windows-aarch64": "windows_arm64",
    "windows-x86_64": "windows_x86_64",
}

# What ships: each platform's release app and server.
[
    configured_alias(
        name = "dist-" + name,
        actual = "//crates/block-app:dist",
        platform = "//buck/platforms:{}_release".format(platform),
    )
    for name, platform in NATIVE.items()
]

# The plugin modules every platform shares, and the web bundle without them.
configured_alias(
    name = "plugins",
    actual = "//crates/block-app:plugins",
    platform = "//buck/platforms:linux_x86_64_release",
)

configured_alias(
    name = "web",
    actual = "//crates/block-app:web-dist",
    platform = "//buck/platforms:linux_x86_64_release",
)

bundle(
    name = "artifacts",
    contents = {"block-" + name: ":dist-" + name for name in NATIVE}
    | {
        "be-launcher-android-aarch64/be-launcher.apk": "//crates/be-launcher:android-dist",
        "block-app-android-aarch64/block-app.apk": "//crates/block-app:android-dist",
        "block-plugins": ":plugins",
        "block-web": ":web",
    },
)

group(
    name = "everything",
    deps = [":artifacts"],
)
