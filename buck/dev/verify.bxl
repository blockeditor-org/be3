load("//buck/cargo/buckify.bxl", buckify = "generate")
load("//buck/dev:test.bzl", "TestRunInfo")
load("//buck/dev/workspace.bxl", "rust_targets")

# Everything ./scripts/verify and ./scripts/ci build, in one buck2 command: the
# generated rules and Cargo.lock, the sysroot's lockfile, every package's
# autofixes (:fix, buck/dev/verify.bzl), every test and app test ([run] of each
# be_test, buck/dev/test.bzl), rustc's check pass over each first-party Rust
# target on Linux and the apps' wasm (workspace.bxl) that no test builds, so
# that it still compiles, and nothing for any other platform
# (guides/build_server.md), for ./scripts/ci which of
# crates/be-tool-bootstrap's binaries scripts/internal/pins does not name
# (//scripts/internal:bootstrap-unpinned, and with --bootstrap those binaries),
# and on request the paint preview renderer; and crates/be-tool-verify, for the
# machine that asked (--host, a platform in buck/platforms), which reads the
# rest afterwards, running crates/be-tool-local for the previews. Only buckify
# is an action of its own here, since it reads files across every package. It
# prints what that reads, "kind<TAB>path" a line, or for a test's paintings
# "paintings<TAB>package<TAB>path", the package holding the snapshots/ they
# belong in; with --keep-going it prints them all even when some fail to
# build, and crates/be-tool-verify reads what was built. A path whose action
# failed can still hold an earlier run's output, so crates/be-tool-verify
# writes a fix or a painting only where the checkout still holds what it was
# made from.
#
#   ./scripts/buck bxl --keep-going //buck/dev/verify.bxl:main -- --host linux_x86_64 --lint true --tests true

# The packages every test is in, and those every :fix is in.
_TESTS = "//crates/... + //compile_fail/..."

_FIXES = "//crates/... + //compile_fail/... + //buck/... + //third-party/... + //: + toolchains//..."

def _output(ctx, target: str) -> Artifact:
    return ctx.analysis(ctx.configured_targets(target)).providers()[DefaultInfo].default_outputs[0]

def _host_output(ctx, target: str, host: str) -> Artifact:
    configured = ctx.cquery(target_platform = "root//buck/platforms:" + host).eval(target)
    return ctx.analysis(list(configured)[0]).providers()[DefaultInfo].default_outputs[0]

# Every test (be_test, buck/dev/test.bzl), by whether it paints, and each one's
# [run], the action that runs it.
def _tests(ctx) -> (list, list):
    targets = ctx.cquery().kind("^be_test$", ctx.cquery().eval(_TESTS))
    plain, painting = [], []
    for target in targets:
        providers = ctx.analysis(target).providers()
        run = providers[DefaultInfo].sub_targets.get("run")
        if run == None:
            continue
        output = run[DefaultInfo].default_outputs[0]
        if providers[TestRunInfo].paints:
            painting.append((target.label.package, output))
        else:
            plain.append(output)
    return plain, painting

# rustc's check pass over the first-party Rust targets no test compiles, such as
# binaries: a warning fails a compile, so a target a test builds is already
# checked, and checking it again would be a second rustc run for most crates.
def _workspace_checks(ctx) -> list[Artifact]:
    tests = ctx.cquery().kind("^be_test$", ctx.cquery().eval(_TESTS))
    built = {str(target.label): True for target in ctx.cquery().deps(tests)}
    checks = []
    for target in rust_targets(ctx):
        if str(target.label) in built:
            continue
        sub_targets = ctx.analysis(target).providers()[DefaultInfo].sub_targets
        if "check" in sub_targets:
            checks.append(sub_targets["check"][DefaultInfo].default_outputs[0])
    return checks

def _impl(ctx: bxl.Context):
    args = ctx.cli_args
    actions = ctx.bxl_actions().actions
    printed = [
        ("verify", _host_output(ctx, "root//crates/be-tool-verify:release", args.host)),
        ("buckify", buckify(ctx, actions)),
        ("sysroot", _output(ctx, "root//buck/sysroot:lock")),
    ]
    if args.release_bootstrap or args.bootstrap:
        unpinned = ctx.analysis(ctx.configured_targets("root//scripts/internal:bootstrap-unpinned")).providers()[DefaultInfo]
        if args.bootstrap:
            unpinned = unpinned.sub_targets["publish"][DefaultInfo]
        printed.append(("bootstrap", unpinned.default_outputs[0]))
    built = []
    if args.lint:
        fixes = ctx.uquery().kind("^source_fix$", ctx.uquery().eval(_FIXES))
        printed.extend([("fix", _output(ctx, str(fix.label))) for fix in fixes])
    if args.tests or args.app_tests:
        plain, painting = _tests(ctx)
        if args.tests:
            built.extend(plain)
            built.extend(_workspace_checks(ctx))
        if args.app_tests:
            printed.extend([("paintings\t" + package, output) for package, output in painting])
    if args.previews:
        printed.append(("local-tools", _host_output(ctx, "root//crates/be-tool-local:release", args.host)))
        printed.append(("browser-rasterizer", _host_output(ctx, "root//crates/be-tool-browser-rasterizer:release", args.host)))
        printed.append(("paint-review-site", _output(ctx, "root//crates/be-tool-paint-review-web:web-release")))
    paths = ctx.output.ensure_multiple([artifact for _, artifact in printed])
    ctx.output.ensure_multiple(built)
    for (kind, _), path in zip(printed, paths):
        ctx.output.print(kind, path.abs_path(), sep = "\t")

main = bxl_main(
    cli_args = {
        "app_tests": cli_args.bool(False),
        "bootstrap": cli_args.bool(False),
        "host": cli_args.string("linux_x86_64"),
        "lint": cli_args.bool(False),
        "previews": cli_args.bool(False),
        # crates/be-tool-bootstrap's release for six platforms, which ./scripts/ci builds
        # and ./scripts/verify leaves to it. True for a bootstrap older than this
        # argument, which passes neither.
        "release_bootstrap": cli_args.bool(True),
        "tests": cli_args.bool(False),
    },
    impl = _impl,
)
