load("//buck/cargo/buckify.bxl", buckify = "generate")

# Everything ./scripts/verify and ./scripts/ci build, in one buck2 command: the
# generated rules and Cargo.lock, the sysroot's lockfile, the autofixes
# (fix.sh), every test and plugin test, beui checked for Windows
# (_CROSS_CHECKS), which of crates/bootstrap's binaries scripts/internal/pins
# does not name (and with --bootstrap those binaries),
# and on request the paint preview renderer; and
# crates/verify, for the machine that asked (--host, a platform in
# buck/platforms), which reads the rest afterwards, running crates/local-tools
# for the previews. It prints what that reads,
# "kind<TAB>path" a line; with --keep-going it prints them all even when some
# fail to build, and crates/verify reads what was built. A path whose action
# failed can still hold an earlier run's output, so crates/verify writes a fix
# or a painting only where the checkout still holds what it was made from.
#
#   ./scripts/buck bxl --keep-going //buck/dev/verify.bxl:main -- --host linux_x86_64 --lint true --tests true

# Every file under directory, skipping what fix-rust-source skips: hidden
# directories and target/.
def _files(ctx, directory: str) -> list[str]:
    found = []
    for entry in ctx.fs.list(directory):
        path = str(entry).removeprefix("root//")
        name = path.split("/")[-1]
        if ctx.fs.is_dir(path):
            if not name.startswith(".") and name != "target":
                found.extend(_files(ctx, path))
        else:
            found.append(path)
    return found

def _output(ctx, target: str) -> Artifact:
    return ctx.analysis(ctx.configured_targets(target)).providers()[DefaultInfo].default_outputs[0]

def _host_output(ctx, target: str, host: str) -> Artifact:
    configured = ctx.cquery(target_platform = "root//buck/platforms:" + host).eval(target)
    return ctx.analysis(list(configured)[0]).providers()[DefaultInfo].default_outputs[0]

def _outputs(ctx, kind: str, universe: str) -> list[Artifact]:
    targets = ctx.cquery().kind(kind, ctx.cquery().eval(universe))
    return [ctx.analysis(target).providers()[DefaultInfo].default_outputs[0] for target in targets]

# rustc's check pass over beui for the platforms the build server's tests do not
# run on, so that beui-layer-xr's OpenXR and the rest of beui's native stack keep
# compiling there: Windows, where the first headset is.
_CROSS_CHECKS = {
    "root//crates/beui:beui": ["windows_x86_64"],
}

def _cross_checks(ctx) -> list[Artifact]:
    checks = []
    for target, platforms in _CROSS_CHECKS.items():
        for platform in platforms:
            for configured in ctx.cquery(target_platform = "root//buck/platforms:" + platform).eval(target):
                sub_targets = ctx.analysis(configured).providers()[DefaultInfo].sub_targets
                checks.append(sub_targets["check"][DefaultInfo].default_outputs[0])
    return checks

# The package that owns a file: the deepest crate directory above it.
def _owner(path: str, crate_dirs: list[str]) -> str:
    owner = "crates"
    for directory in crate_dirs:
        if path.startswith(directory + "/") and len(directory) > len(owner):
            owner = directory
    return owner

# One action a crate, so that a change to one crate leaves every other crate's
# fixes in the cache.
def _rust_fixes(ctx, actions) -> list[Artifact]:
    files = _files(ctx, "crates")
    crate_dirs = [path.removesuffix("/Cargo.toml") for path in files if path.endswith("/Cargo.toml")]
    sources = {}
    for path in files:
        if path.endswith(".rs"):
            sources.setdefault(_owner(path, crate_dirs), []).append(path)
    fix_rust_source = _output(ctx, "root//crates/fix-rust-source:bin")
    rustfmt = _output(ctx, "root//buck/tools:rustfmt-sysroot")
    script = ctx.fs.source("buck/dev/fix.sh")
    fixes = []
    for owner, paths in sorted(sources.items()):
        copied = actions.copied_dir("fix/rust/{}/sources".format(owner), {path: ctx.fs.source(path) for path in paths})
        out = actions.declare_output("fix/rust/{}/out".format(owner), dir = True)
        actions.run(
            cmd_args("sh", script, "rust", out.as_output(), copied, fix_rust_source, rustfmt),
            category = "fix_rust",
            identifier = owner,
        )
        fixes.append(out)
    return fixes

def _starlark_files(ctx) -> list[str]:
    found = ["BUCK.v2", "PACKAGE"]
    for directory in ["buck", "crates", "compile_fail", "third-party/system", "third-party/pdfium", "third-party/rust"]:
        for path in _files(ctx, directory):
            name = path.split("/")[-1]
            if name in ["BUCK", "PACKAGE"] or name.endswith(".bzl") or name.endswith(".bxl"):
                found.append(path)
    return [path for path in sorted(found) if path not in ["buck/cargo/crates.bzl", "buck/sysroot/packages.bzl"]]

def _starlark_fix(ctx, actions) -> Artifact:
    copied = actions.copied_dir("fix/starlark/sources", {path: ctx.fs.source(path) for path in _starlark_files(ctx)})
    out = actions.declare_output("fix/starlark/out", dir = True)
    actions.run(
        cmd_args(
            "sh",
            ctx.fs.source("buck/dev/fix.sh"),
            "starlark",
            out.as_output(),
            copied,
            _output(ctx, "root//buck/tools:starlark_fmt"),
            ctx.fs.source("buck/starlark_fmt.json"),
        ),
        category = "fix_starlark",
    )
    return out

# The binaries of crates/bootstrap's release, compared on a worker with the ones
# scripts/internal/pins names, so that nothing is downloaded while they match.
# unpinned lists "<pin>=<sha256>" for each that does not, and with publish each
# such binary is beside it, named by its SHA-256, for CI to upload and pin.
def _bootstrap_unpinned(ctx, actions, publish: bool) -> Artifact:
    out = actions.declare_output("bootstrap", dir = True)
    actions.run(
        cmd_args(
            "sh",
            "-c",
            """
            set -eu
            out="$1" dist="$2" pins="$3" publish="$4"
            mkdir -p "$out"
            : > "$out/unpinned"
            for binary in "$dist"/*/bootstrap "$dist"/*/bootstrap.exe; do
                [ -f "$binary" ] || continue
                triple="$(basename "$(dirname "$binary")")"
                name="bootstrap_sha256_$(echo "$triple" | tr - _)"
                sha256="$(sha256sum "$binary" | cut -c1-64)"
                grep -qx "$name='$sha256'" "$pins" && continue
                echo "$name=$sha256" >> "$out/unpinned"
                if [ "$publish" = true ]; then cp "$binary" "$out/$sha256"; fi
            done
            """,
            "sh",
            out.as_output(),
            _output(ctx, "root//crates/bootstrap:dist"),
            ctx.fs.source("scripts/internal/pins"),
            "true" if publish else "false",
        ),
        category = "bootstrap_unpinned",
    )
    return out

def _impl(ctx: bxl.Context):
    args = ctx.cli_args
    actions = ctx.bxl_actions().actions
    printed = [
        ("verify", _host_output(ctx, "root//crates/verify:release", args.host)),
        ("buckify", buckify(ctx, actions)),
        ("sysroot", _output(ctx, "root//buck/sysroot:lock")),
        ("bootstrap", _bootstrap_unpinned(ctx, actions, args.bootstrap)),
    ]
    built = []
    if args.lint:
        printed.extend([("fix", fix) for fix in _rust_fixes(ctx, actions)])
        printed.append(("fix", _starlark_fix(ctx, actions)))
    if args.tests:
        built.extend(_outputs(ctx, "^test_run$", "//crates/... + //compile_fail/..."))
        built.extend(_cross_checks(ctx))
    if args.plugin_tests:
        printed.extend([("paintings", paintings) for paintings in _outputs(ctx, "^(plugin_test_run|painting_test_run)$", "//crates/...")])
    if args.previews:
        printed.append(("local-tools", _host_output(ctx, "root//crates/local-tools:release", args.host)))
        printed.append(("browser-rasterizer", _host_output(ctx, "root//crates/browser-rasterizer:release", args.host)))
        printed.append(("paint-review-site", _output(ctx, "root//crates/paint-review-web:web-release")))
    paths = ctx.output.ensure_multiple([artifact for _, artifact in printed])
    ctx.output.ensure_multiple(built)
    for (kind, _), path in zip(printed, paths):
        ctx.output.print(kind, path.abs_path(), sep = "\t")

main = bxl_main(
    cli_args = {
        # Ignored: the bootstrap a pull request's CI runs is the one main pins,
        # which may be older than this file and still pass it.
        "android": cli_args.bool(False),
        "bootstrap": cli_args.bool(False),
        "host": cli_args.string("linux_x86_64"),
        "lint": cli_args.bool(False),
        "plugin_tests": cli_args.bool(False),
        "previews": cli_args.bool(False),
        "tests": cli_args.bool(False),
    },
    impl = _impl,
)
