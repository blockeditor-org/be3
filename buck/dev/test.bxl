load("//buck/dev:test.bzl", "TestRunInfo", "run_test")

# ./scripts/test --update, in one buck2 command (a plain ./scripts/test is
# buck2 test, crates/be-tool-bootstrap/src/test.rs): each test it names, run as
# run_test's "record" action (buck/dev/test.bzl) with libtest's --nocapture and
# the name to filter by, so that what comes back is the test's output and the
# paintings it accepted rather than its binary and everything it reads. A test
# whose inputs have not changed comes from the cache. Each prints
# "<name><TAB><directory>", the record, for crates/be-tool-bootstrap to print
# and to copy its paintings into the crate's snapshots/.
#
# A record is kept, and cached, when its test fails too. --again names the runs
# (as printed) whose last record was a failure, and --nonce goes into those
# runs' environment alone, so that they run again while every run that passed
# still comes from the cache.
#
#   ./scripts/buck bxl //buck/dev/test.bxl:main -- --target //crates/be-lib-geometry:test --name rotates
#
# A local test, such as a web_drive_test, which needs a browser, runs here. A
# run_apart test (crates/be-host-tests) runs each part, a file under
# src/tests/, whose test, tests::<file>::<file>, contains the name, or every
# part without one, as an action of its own with that file's environment,
# which names its own app.

def _impl(ctx: bxl.Context):
    args = ctx.cli_args
    actions = ctx.bxl_actions().actions
    filters = ["--nocapture"] + ([args.name] if args.name else [])
    ran = []
    for label in args.target:
        target = ctx.configured_targets(label)
        info = ctx.analysis(target).providers()[TestRunInfo]
        parts = [part for part in info.parts if not args.name or args.name in "tests::{}::{}".format(part, part)]
        runs = [("-" + part, info.parts[part], ["--nocapture"]) for part in parts]
        if not runs:
            runs = [("", info, filters)]
        for suffix, run, run_filters in runs:
            name = str(target.label.raw_target()) + suffix
            out = actions.declare_output("test/{}/{}{}".format(target.label.package, target.label.name, suffix), dir = True)
            run_test(
                actions,
                run,
                out,
                "record",
                env = {"BE3_TEST_NONCE": args.nonce} if name in args.again else {},
                filters = run_filters,
                identifier = name,
                update = args.update,
            )
            ran.append((name, out))
    paths = ctx.output.ensure_multiple([out for _, out in ran])
    for (name, _), path in zip(ran, paths):
        ctx.output.print(name, path.abs_path(), sep = "\t")

main = bxl_main(
    cli_args = {
        "again": cli_args.list(cli_args.string(), default = []),
        "name": cli_args.string(""),
        "nonce": cli_args.string(""),
        "target": cli_args.list(cli_args.string()),
        "update": cli_args.bool(False),
    },
    impl = _impl,
)
