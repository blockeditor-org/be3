load("@root//buck/tools:defs.bzl", "worker_properties")
load(":rust_std.bzl", "rust_std_crate", "rust_std_libs")
load(":defs.bzl", "cross_tool", "host_cxx_tools", "pinned_rust_toolchain", "remote_linking_cxx_toolchain", "wasm_cxx_tools")

# Every tool comes from buck/tools, which downloads them, because every action
# runs on a remote worker that has none of its own.
tools = "root//buck/tools"

host_cxx_tools(
    name = "cxx_tools",
    archiver = tools + ":ar",
    compiler = tools + ":cc",
    cxx_compiler = tools + ":cxx",
)

wasm_cxx_tools(
    name = "wasm_cxx_tools",
    archiver = tools + ":ar",
    compiler = tools + ":wasm-cc",
    cxx_compiler = tools + ":wasm-cxx",
    linker = tools + ":wasm-ld",
)

# Everything built for the host is compiled and linked against the sysroot in
# buck/sysroot, not against the worker it runs on: Ubuntu 24.04's glibc,
# libstdc++ and system libraries, from a pinned snapshot of the archive.
cxx_tools_info_toolchain(
    name = "host_cxx",
    c_flags = ["--sysroot=$(location root//buck/sysroot:amd64)"],
    cxx_flags = ["--sysroot=$(location root//buck/sysroot:amd64)"],
    cxx_tools_info = ":cxx_tools",
    link_flags = ["--sysroot=$(location root//buck/sysroot:amd64)"],
    visibility = ["PUBLIC"],
)

# The cross-compiled platforms: the same clang, for the target. Android against
# the NDK's sysroot (its compiler runtime named as the resource directory for
# the link alone), Linux on arm64 against buck/sysroot's arm64 packages, a Mac
# against Apple's SDK with ld64.lld, Windows against xwin's MSVC runtime and SDK
# with lld-link. Windows' headers go after clang's own (-idirafter), since
# MSVC's intrinsics headers only declare what clang's define. /Brepro has
# lld-link write a hash of the output where it would write the time, so that a
# binary built again is the same file, which the bootstrap's pins rely on
# (guides/bootstrap.md).
[
    [
        host_cxx_tools(
            name = name + "_cxx_tools",
            archiver = tools + (":lib" if name.startswith("windows") else ":ar"),
            archiver_type = "windows_clang" if name.startswith("windows") else "gnu",
            compiler = "{}:cc-{}".format(tools, name),
            cxx_compiler = "{}:cxx-{}".format(tools, name),
            linker = tools + ":lld-link" if name.startswith("windows") else None,
            linker_type = "darwin" if name.startswith("macos") else "windows" if name.startswith("windows") else "gnu",
        ),
        cxx_tools_info_toolchain(
            name = name + "_cxx",
            c_flags = flags,
            cxx_flags = flags,
            cxx_tools_info = ":{}_cxx_tools".format(name),
            link_flags = link_flags,
            visibility = ["PUBLIC"],
        ),
    ]
    for name, flags, link_flags in [
        (
            "android_arm64",
            ["--sysroot=$(location root//buck/tools:android-ndk)/sysroot"],
            [
                "--sysroot=$(location root//buck/tools:android-ndk)/sysroot",
                "-resource-dir=$(location root//buck/tools:android-ndk)/clang",
                "-fuse-ld=lld",
            ],
        ),
        (
            "linux_arm64",
            ["--sysroot=$(location root//buck/sysroot:arm64)"],
            ["--sysroot=$(location root//buck/sysroot:arm64)"],
        ),
        (
            "macos_arm64",
            ["-isysroot", "$(location root//buck/tools:macos-sdk)"],
            ["-isysroot", "$(location root//buck/tools:macos-sdk)", "-fuse-ld=lld"],
        ),
        (
            "macos_x86_64",
            ["-isysroot", "$(location root//buck/tools:macos-sdk)"],
            ["-isysroot", "$(location root//buck/tools:macos-sdk)", "-fuse-ld=lld"],
        ),
    ]
    + [
        (
            "windows_" + cpu,
            [
                "-idirafter$(location root//buck/tools:windows-sdk-{})/{}".format(arch, include)
                for include in ["crt/include", "sdk/include/ucrt", "sdk/include/um", "sdk/include/shared", "sdk/include/winrt"]
            ],
            ["/Brepro"]
            + ["/libpath:$(location root//buck/tools:windows-sdk-{})/{}/{}".format(arch, lib, arch) for lib in ["crt/lib", "sdk/lib/um", "sdk/lib/ucrt"]],
        )
        for cpu, arch in [("arm64", "aarch64"), ("x86_64", "x86_64")]
    ]
]

_wasi_flags = [
    "--target=wasm32-wasip1-threads",
    "--sysroot=$(location root//third-party/wasi:sysroot)",
    "-isystem",
    "$(location root//third-party/wasi:sysroot)/include/wasm32-wasip1-threads/noeh/c++/v1",
    "-pthread",
    "-mllvm",
    "-wasm-enable-sjlj",
    "-mllvm",
    "-wasm-use-legacy-eh=false",
    "-fno-exceptions",
    "-fno-rtti",
    "-DHB_NO_MT",
    "-msimd128",
    "-O2",
    "-w",
] + select({
    # An app's C and C++ is linked into position-independent modules
    # (guides/app_libraries.md), and cc-rs leaves -fPIC out on wasm, so the
    # build scripts' FreeType and HarfBuzz ask for it here.
    "DEFAULT": [],
    "root//buck/constraints:guest": ["-fPIC"],
})

# Two of them, because only one of the wasm platforms has C in it. An app's
# freetype and harfbuzz are compiled against the WASI sysroot; a game module is
# pure Rust on a target that has no libc to compile against at all.
cxx_tools_info_toolchain(
    name = "wasi_cxx",
    c_flags = _wasi_flags,
    cxx_flags = _wasi_flags,
    cxx_tools_info = ":wasm_cxx_tools",
    visibility = ["PUBLIC"],
)

cxx_tools_info_toolchain(
    name = "wasm32_cxx",
    cxx_tools_info = ":wasm_cxx_tools",
    visibility = ["PUBLIC"],
)

# Which of the two a target gets is decided by what it is being built for.
remote_linking_cxx_toolchain(
    name = "cxx",
    toolchain = ":cxx_for_target",
    visibility = ["PUBLIC"],
)

toolchain_alias(
    name = "cxx_for_target",
    actual = per_cross_platform(
        ":host_cxx",
        lambda name: ":{}_cxx".format(name),
        extra = {
            "prelude//os:none": ":wasm32_cxx",
            "prelude//os:wasi": ":wasi_cxx",
        },
    ),
    visibility = ["PUBLIC"],
)


# The Rust standard library for the Linux x86_64 toolchain below, which links Rust
# through the cxx toolchain (advanced_unstable_linking), so that outside a release a
# crate is a shared library of its own: the pinned rust-std component's rlibs, one
# hashed file name each, which change with rust_version in buck/tools/BUCK.
_std_hashes = {
    "addr2line": "9bf1503802f1fe1f",
    "adler2": "1855b06535e3a6dc",
    "alloc": "ca14532e0afe7a5d",
    "cfg_if": "380714c6ea67686e",
    "compiler_builtins": "b8411246c6de4c7a",
    "core": "a6075fd9c05de416",
    "getopts": "02c32a91bb4b14fa",
    "gimli": "b05ed1427e633af3",
    "hashbrown": "5616f5bf81fe0066",
    "libc": "f28c4264f0143d08",
    "memchr": "438369955a1aeb02",
    "miniz_oxide": "80dd92fda65ee391",
    "object": "539315557aa33d2a",
    "panic_abort": "0d311229c3300097",
    "panic_unwind": "b12739ac718ad94d",
    "proc_macro": "f5bcf216899e1faf",
    "rustc_demangle": "7e135abb3d08f85c",
    "rustc_literal_escaper": "12f46c3d6b9a3a65",
    "rustc_std_workspace_alloc": "4eb375f3ee2d977f",
    "rustc_std_workspace_core": "ae5f5e65a4426175",
    "rustc_std_workspace_std": "2f6cfb1d83a94e28",
    "std": "2e38004a9ef1deab",
    "std_detect": "8ebd82e261ed1599",
    "test": "f749e999e116a5ef",
    "unwind": "c548baaa1b36fffe",
}

rust_std_libs(
    name = "rust_std_libs",
    component = tools + ":rust-std-x86_64-unknown-linux-gnu",
    crates = {name: "lib{}-{}.rmeta".format(name, hash) for name, hash in _std_hashes.items()},
    rlibs = ["lib{}-{}.rlib".format(name, hash) for name, hash in _std_hashes.items()],
    triple = "x86_64-unknown-linux-gnu",
    visibility = ["PUBLIC"],
)

[
    rust_std_crate(
        name = "rust_std_" + name,
        crate = name,
        libs = ":rust_std_libs",
        visibility = ["PUBLIC"],
    )
    for name in _std_hashes
]

# Which toolchains link through cxx: Linux on x86_64, outside a release.
config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "prelude//cpu/constraints:cpu[x86_64]",
        "prelude//os/constraints:os[linux]",
    ],
    visibility = ["PUBLIC"],
)

config_setting(
    name = "linux_x86_64_release",
    constraint_values = [
        "prelude//cpu/constraints:cpu[x86_64]",
        "prelude//os/constraints:os[linux]",
        "root//buck/constraints:release",
    ],
    visibility = ["PUBLIC"],
)

_cxx_linked = select({
    ":linux_x86_64_release": False,
    ":linux_x86_64": True,
    "DEFAULT": False,
})

_std_sysroot = select({
    ":linux_x86_64_release": {},
    ":linux_x86_64": {
        name: ":rust_std_" + name
        for name in ["core", "proc_macro", "std", "panic_unwind", "panic_abort", "alloc", "test"]
    },
    "DEFAULT": {},
})

_host_opt, _wasm_opt, _release_opt = OPT_LEVELS["toolchain"]

_release = ["-Copt-level={}".format(_release_opt), "-Cdebuginfo=0", "-Cforce-frame-pointers=yes"]

pinned_rust_toolchain(
    name = "rust",
    advanced_unstable_linking = _cxx_linked,
    # What -Clink-arg passed, which a link through cxx drops.
    linker_flags = select({
        "DEFAULT": [],
        ":linux_x86_64": ["-Wl,--compress-debug-sections=zlib"],
    }),
    std = _std_sysroot,
    # What cargo reads out of Cargo.toml's [workspace.lints]. A warning fails
    # the build here the way `cargo clippy -- -D warnings` fails it there.
    allow_lints = ["clippy::too_many_arguments"],
    clippy_driver = cross_tool(tools, "clippy-driver"),
    clippy_toml = "root//:clippy.toml",
    compiler = cross_tool(tools, "rustc"),
    default_edition = "2024",
    deny_lints = ["warnings"],
    # Pipelining: a crate's dependents compile against its metadata from a
    # -Zno-codegen compile of its own rather than wait for its codegen, which
    # takes a chain of crates such as beui's off ./scripts/verify's critical
    # path. -Z needs RUSTC_BOOTSTRAP=1, which the prelude then sets for every
    # rustc. The two compiles must agree on the crate's hash, and a crate whose
    # compile takes in the absolute path of the directory it runs in (by
    # env!("CARGO_MANIFEST_DIR"), or an include_bytes! a macro writes) does not,
    # since every action runs in a directory of its own; the link of a dependent
    # then fails with E0460. third-party/rust/fixups.bzl overlays the crates that
    # did.
    nightly_features = True,
    # Cargo's dev profile on the host, and its app profile on wasm, at the opt
    # levels OPT_LEVELS in buck/platforms/profile.bzl gives, with why. rustc
    # turns debug assertions and overflow checks off above opt-level 0, so wasm
    # names them, as the app profile inherits them from dev.
    # buck/constraints:release, which `-m release` adds, is cargo's release
    # profile.
    # --extern noprelude:, which the standard library's crates are named with.
    extra_rustc_flags = select({
        ":linux_x86_64_release": [],
        ":linux_x86_64": ["-Zunstable-options"],
        "DEFAULT": [],
    }),
    rustc_flags = select({
        "DEFAULT": select({
            "DEFAULT": ["-Copt-level={}".format(_host_opt), "-Cdebuginfo=line-tables-only"],
            "prelude//cpu:wasm32": [
                "-Copt-level={}".format(_wasm_opt),
                "-Cdebuginfo=0",
                "-Cdebug-assertions=on",
                "-Coverflow-checks=on",
            ],
        }),
        "root//buck/constraints:release": _release,
    })
    + select({
        # rustc embeds LLVM bitcode in every object of an rlib for a later LTO
        # link, and only be-host's LTO link (buck/constraints:lto) reads it.
        # It was 86% of an object's bytes, which every worker that links or
        # compiles against the rlib downloads, so it is off elsewhere, as cargo
        # turns it off for a profile without LTO.
        "DEFAULT": ["-Cembed-bitcode=no"],
        "root//buck/constraints:lto": [],
    })
    + select({
        "DEFAULT": [],
        # Line tables were about half of a test binary's sections, and every
        # binary is fetched by the workers that run it. lld compresses them in
        # the linked file, and backtraces read them as they are. Compressing
        # them in each object too (-Zdebuginfo-compression) made rust-lld
        # crash linking the larger binaries.
        "prelude//os:linux": select({
            "DEFAULT": ["-Clink-arg=-Wl,--compress-debug-sections=zlib"],
            ":linux_x86_64": select({
                ":linux_x86_64_release": ["-Clink-arg=-Wl,--compress-debug-sections=zlib"],
                "DEFAULT": [],
            }),
        }),
    })
    + select({
        "DEFAULT": [],
        "prelude//cpu:wasm32": ["-Cstrip=debuginfo"],
        # Packed, macOS's default, runs dsymutil after the link, which is
        # Apple's and not something a Linux worker has.
        "prelude//os:macos": ["-Csplit-debuginfo=unpacked"],
        # rustc always has lld-link write a PDB, and a PDB names the
        # directory the link ran in and rustc's temporary one, which differ
        # on every link. /Brepro hashes it into the binary's timestamp and
        # PDB GUID, so a release linked again was a different file and the
        # bootstrap's pins changed whenever CI linked it (guides/bootstrap.md).
        # A release ships no PDB, so it writes none; the last /DEBUG wins.
        "prelude//os:windows": select({
            "DEFAULT": [],
            "root//buck/constraints:release": ["-Clink-arg=/DEBUG:NONE"],
        }),
    })
    + select({
        "DEFAULT": [],
        # Apps only: a game runs in wasmi, which takes no SIMD.
        "prelude//os:wasi": ["-Ctarget-feature=+simd128"],
    }),
    rustc_target_triple = per_cross_platform(
        "x86_64-unknown-linux-gnu",
        cross_triple,
        extra = {
            "prelude//os:none": "wasm32-unknown-unknown",
            "prelude//os:wasi": "wasm32-wasip1-threads",
        },
    ),
    rustdoc = cross_tool(tools, "rustdoc"),
    visibility = ["PUBLIC"],
)

python_bootstrap_toolchain(
    name = "python_bootstrap",
    # The Python the prelude's helpers run on, as a file rather than a name, which
    # would otherwise be in every action's command line.
    interpreter = "root//buck/tools:python3",
    visibility = ["PUBLIC"],
)

system_genrule_toolchain(name = "genrule", visibility = ["PUBLIC"])

noop_test_toolchain(name = "test", visibility = ["PUBLIC"])

# Tests run on a worker, in the container their binary was linked for, unless
# they ask to stay local; ./scripts/buck passes the flag that allows it.
remote_test_execution_toolchain(
    name = "remote_test_execution",
    default_profile = "remote",
    profiles = {
        "remote": {
            "capabilities": worker_properties(),
            "use_case": "buck2-default",
        },
    },
    visibility = ["PUBLIC"],
)

package_fix(directory = "buck/toolchains")
