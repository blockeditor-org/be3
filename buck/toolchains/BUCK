load("@prelude//tests:test_toolchain.bzl", "noop_test_toolchain")
load("@prelude//toolchains:cxx.bzl", "cxx_tools_info_toolchain")
load("@prelude//toolchains:genrule.bzl", "system_genrule_toolchain")
load("@prelude//toolchains:python.bzl", "python_bootstrap_toolchain")
load("@prelude//toolchains:remote_test_execution.bzl", "remote_test_execution_toolchain")
load(":defs.bzl", "host_cxx_tools", "pinned_rust_toolchain", "script")

# The Python the prelude's own helpers run on, as a file rather than as a name:
# a toolchain named by a string puts that string in the command line of every
# action that uses it, and this one is in all of them. defs.bzl says why that
# matters. ./scripts/buck writes the wrapper.
script(
    name = "python3",
    src = "root//buck/tools:python3",
)

host_cxx_tools(
    name = "cxx_tools",
    archiver = "root//buck/tools:ar",
    compiler = "root//buck/tools:cc",
    cxx_compiler = "root//buck/tools:cxx",
)

cxx_tools_info_toolchain(
    name = "cxx",
    cxx_tools_info = ":cxx_tools",
    visibility = ["PUBLIC"],
)

pinned_rust_toolchain(
    name = "rust",
    clippy_driver = "root//buck/tools:clippy-driver",
    compiler = "root//buck/tools:rustc",
    default_edition = "2024",
    # Cargo's dev profile, so a build script that asks cc-rs or libm what it is
    # compiling for gets an answer. The prelude only sets OPT_LEVEL for a build
    # script when it can read an opt level off these flags.
    rustc_flags = ["-Copt-level=0", "-Cdebuginfo=line-tables-only"],
    rustc_target_triple = "x86_64-unknown-linux-gnu",
    rustdoc = "root//buck/tools:rustdoc",
    visibility = ["PUBLIC"],
)

python_bootstrap_toolchain(
    name = "python_bootstrap",
    interpreter = ":python3",
    visibility = ["PUBLIC"],
)

system_genrule_toolchain(name = "genrule", visibility = ["PUBLIC"])

noop_test_toolchain(name = "test", visibility = ["PUBLIC"])

remote_test_execution_toolchain(name = "remote_test_execution", visibility = ["PUBLIC"])
