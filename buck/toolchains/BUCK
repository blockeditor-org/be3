load("@prelude//tests:test_toolchain.bzl", "noop_test_toolchain")
load("@prelude//toolchains:cxx.bzl", "cxx_tools_info_toolchain")
load("@prelude//toolchains:genrule.bzl", "system_genrule_toolchain")
load("@prelude//toolchains:python.bzl", "python_bootstrap_toolchain")
load("@prelude//toolchains:remote_test_execution.bzl", "remote_test_execution_toolchain")
load("@root//buck/platforms:cross.bzl", "cross_triple", "per_cross_platform")
load("@root//buck/tools:defs.bzl", "worker_properties")
load(":defs.bzl", "cross_tool", "host_cxx_tools", "pinned_rust_toolchain", "remote_linking_cxx_toolchain", "wasm_cxx_tools")

# Every tool comes from buck/tools, which downloads them, because every action
# runs on a remote worker that has none of its own.
tools = "root//buck/tools"

host_cxx_tools(
    name = "cxx_tools",
    archiver = tools + ":ar",
    compiler = tools + ":cc",
    cxx_compiler = tools + ":cxx",
)

wasm_cxx_tools(
    name = "wasm_cxx_tools",
    archiver = tools + ":ar",
    compiler = tools + ":wasm-cc",
    cxx_compiler = tools + ":wasm-cxx",
    linker = tools + ":wasm-ld",
)

# Everything built for the host is compiled and linked against the sysroot in
# buck/sysroot, not against the worker it runs on: Ubuntu 24.04's glibc,
# libstdc++ and system libraries, from a pinned snapshot of the archive.
cxx_tools_info_toolchain(
    name = "host_cxx",
    c_flags = ["--sysroot=$(location root//buck/sysroot:amd64)"],
    cxx_flags = ["--sysroot=$(location root//buck/sysroot:amd64)"],
    cxx_tools_info = ":cxx_tools",
    link_flags = ["--sysroot=$(location root//buck/sysroot:amd64)"],
    visibility = ["PUBLIC"],
)

# The cross-compiled platforms: the same clang, for the target (buck/tools
# says why that is part of the command). Android compiles against the NDK's
# sysroot, and links the NDK's compiler runtime, which is the NDK's clang's and
# so is named as the resource directory for the link alone. Linux on arm64 compiles and links
# against buck/sysroot's arm64 packages the way the host does against amd64's;
# a Mac against Apple's SDK, linked by lld's ld64.lld; Windows against the MSVC
# runtime and the Windows SDK that xwin lays out, linked by lld-link. Those go
# after clang's own headers rather than before, as -isystem would put them:
# MSVC's intrinsics headers declare what clang's define.
[
    [
        host_cxx_tools(
            name = name + "_cxx_tools",
            archiver = tools + (":lib" if name.startswith("windows") else ":ar"),
            archiver_type = "windows_clang" if name.startswith("windows") else "gnu",
            compiler = "{}:cc-{}".format(tools, name),
            cxx_compiler = "{}:cxx-{}".format(tools, name),
            linker = tools + ":lld-link" if name.startswith("windows") else None,
            linker_type = "darwin" if name.startswith("macos") else "windows" if name.startswith("windows") else "gnu",
        ),
        cxx_tools_info_toolchain(
            name = name + "_cxx",
            c_flags = flags,
            cxx_flags = flags,
            cxx_tools_info = ":{}_cxx_tools".format(name),
            link_flags = link_flags,
            visibility = ["PUBLIC"],
        ),
    ]
    for name, flags, link_flags in [
        (
            "android_arm64",
            ["--sysroot=$(location root//buck/tools:android-ndk)/sysroot"],
            [
                "--sysroot=$(location root//buck/tools:android-ndk)/sysroot",
                "-resource-dir=$(location root//buck/tools:android-ndk)/clang",
                "-fuse-ld=lld",
            ],
        ),
        (
            "linux_arm64",
            ["--sysroot=$(location root//buck/sysroot:arm64)"],
            ["--sysroot=$(location root//buck/sysroot:arm64)"],
        ),
        (
            "macos_arm64",
            ["-isysroot", "$(location root//buck/tools:macos-sdk)"],
            ["-isysroot", "$(location root//buck/tools:macos-sdk)", "-fuse-ld=lld"],
        ),
        (
            "macos_x86_64",
            ["-isysroot", "$(location root//buck/tools:macos-sdk)"],
            ["-isysroot", "$(location root//buck/tools:macos-sdk)", "-fuse-ld=lld"],
        ),
    ]
    + [
        (
            "windows_" + cpu,
            [
                "-idirafter$(location root//buck/tools:windows-sdk-{})/{}".format(arch, include)
                for include in ["crt/include", "sdk/include/ucrt", "sdk/include/um", "sdk/include/shared", "sdk/include/winrt"]
            ],
            ["/libpath:$(location root//buck/tools:windows-sdk-{})/{}/{}".format(arch, lib, arch) for lib in ["crt/lib", "sdk/lib/um", "sdk/lib/ucrt"]],
        )
        for cpu, arch in [("arm64", "aarch64"), ("x86_64", "x86_64")]
    ]
]

# Two of them, because only one of the wasm platforms has C in it. A plugin's
# freetype and harfbuzz are compiled against the WASI sysroot; a game module is
# pure Rust on a target that has no libc to compile against at all.
cxx_tools_info_toolchain(
    name = "wasi_cxx",
    c_flags = [
        "--target=wasm32-wasip1-threads",
        "--sysroot=$(location root//third-party/wasi:sysroot)",
        "-isystem",
        "$(location root//third-party/wasi:sysroot)/include/c++/v1",
        "-pthread",
        "-mllvm",
        "-wasm-enable-sjlj",
        "-mllvm",
        "-wasm-use-legacy-eh=false",
        "-fno-exceptions",
        "-fno-rtti",
        "-DHB_NO_MT",
        "-O2",
        "-w",
    ],
    cxx_flags = [
        "--target=wasm32-wasip1-threads",
        "--sysroot=$(location root//third-party/wasi:sysroot)",
        "-isystem",
        "$(location root//third-party/wasi:sysroot)/include/c++/v1",
        "-pthread",
        "-mllvm",
        "-wasm-enable-sjlj",
        "-mllvm",
        "-wasm-use-legacy-eh=false",
        "-fno-exceptions",
        "-fno-rtti",
        "-DHB_NO_MT",
        "-O2",
        "-w",
    ],
    cxx_tools_info = ":wasm_cxx_tools",
    visibility = ["PUBLIC"],
)

cxx_tools_info_toolchain(
    name = "wasm32_cxx",
    cxx_tools_info = ":wasm_cxx_tools",
    visibility = ["PUBLIC"],
)

# Which of the two a target gets is decided by what it is being built for.
remote_linking_cxx_toolchain(
    name = "cxx",
    toolchain = ":cxx_for_target",
    visibility = ["PUBLIC"],
)

toolchain_alias(
    name = "cxx_for_target",
    actual = per_cross_platform(
        ":host_cxx",
        lambda name: ":{}_cxx".format(name),
        extra = {
            "prelude//os:none": ":wasm32_cxx",
            "prelude//os:wasi": ":wasi_cxx",
        },
    ),
    visibility = ["PUBLIC"],
)

pinned_rust_toolchain(
    name = "rust",
    # What cargo reads out of Cargo.toml's [workspace.lints]. A warning fails
    # the build here the way `cargo clippy -- -D warnings` fails it there.
    allow_lints = ["clippy::too_many_arguments"],
    clippy_driver = cross_tool(tools, "clippy-driver"),
    clippy_toml = "root//:clippy.toml",
    compiler = cross_tool(tools, "rustc"),
    default_edition = "2024",
    deny_lints = ["warnings"],
    # This project builds on a stable rustc, and cargo builds it on that same
    # one. Left on, the prelude passes RUSTC_BOOTSTRAP=1 to every compile so it
    # can use -Z flags for pipelined builds - and rustc then behaves like a
    # nightly, which is not a difference that stays inside the build system.
    # cfg(target_feature) reports unstable target features under it, so on
    # wasm32-wasip1-threads a crate asking not(target_feature = "atomics") gets
    # the opposite answer from the one cargo gives it. wgpu-types is such a
    # crate: that cfg is what decides whether its handles are Send and Sync,
    # and it decided differently from the build script that had already emitted
    # --cfg=send_sync from the same question. A build script probing for
    # #![feature] would go the same way.
    #
    # What this costs is one layer of pipelining: a dependent that has to
    # generate code waits for the rlib rather than for a -Zno-codegen hollow
    # one. Nothing else here used the unstable paths - no doctests, no expand
    # or profiling subtargets, and the cwd is still remapped, by the action
    # wrapper rather than by -Zremap-cwd-prefix.
    nightly_features = False,
    # Cargo's dev profile on the host, and Cargo.toml's plugin profile on wasm:
    # a plugin is compiled once and loaded on every platform, and cranelift is
    # an order of magnitude slower at an unoptimised one.
    #
    # The opt level is also what makes the prelude tell a build script what
    # OPT_LEVEL it is building for, which cc-rs and libm both ask.
    rustc_flags = select({
        "DEFAULT": ["-Copt-level=0", "-Cdebuginfo=line-tables-only"],
        "prelude//cpu:wasm32": ["-Copt-level=2", "-Cdebuginfo=0", "-Cstrip=debuginfo"],
        # Packed, macOS's default, runs dsymutil after the link, which is
        # Apple's and not something a Linux worker has.
        "prelude//os:macos": ["-Copt-level=0", "-Cdebuginfo=line-tables-only", "-Csplit-debuginfo=unpacked"],
    }),
    rustc_target_triple = per_cross_platform(
        "x86_64-unknown-linux-gnu",
        cross_triple,
        extra = {
            "prelude//os:none": "wasm32-unknown-unknown",
            "prelude//os:wasi": "wasm32-wasip1-threads",
        },
    ),
    rustdoc = cross_tool(tools, "rustdoc"),
    visibility = ["PUBLIC"],
)

python_bootstrap_toolchain(
    name = "python_bootstrap",
    # The Python the prelude's own helpers run on, as a file rather than as a
    # name: a toolchain named by a string puts that string in the command line
    # of every action that uses it, and this one is in all of them. defs.bzl
    # says why that matters. It is the same file whichever tools are in use,
    # because it finds its interpreter when it runs.
    interpreter = "root//buck/tools:python3",
    visibility = ["PUBLIC"],
)

system_genrule_toolchain(name = "genrule", visibility = ["PUBLIC"])

noop_test_toolchain(name = "test", visibility = ["PUBLIC"])

# Where a Rust test runs: on a worker, in the same container its binary was
# linked for, so what it loads at run time is what it was linked against. A
# test can still ask to stay local, as beui's does. buck2 keeps every test
# local unless it is also given --unstable-allow-compatible-tests-on-re, which
# ./scripts/buck passes.
remote_test_execution_toolchain(
    name = "remote_test_execution",
    default_profile = "remote",
    profiles = {
        "remote": {
            "capabilities": worker_properties,
            "use_case": "buck2-default",
        },
    },
    visibility = ["PUBLIC"],
)
