#!/bin/sh
#
# The tests whose full names contain NAME, in every crate that has one, with all
# their output. --update accepts the paintings they make.
#
# Usage:
#   ./scripts/test NAME [--update]
#   ./scripts/test //crates/editors/checklist:test [NAME] [--update]
#
# guides/bootstrap.md says what runs it.

exec sh "$(dirname "$0")/internal/bootstrap.sh" test "$@"
