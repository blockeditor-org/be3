#!/usr/bin/env bash
#
# The web bundle and the Android APK, which are still cargo's. Everything else
# is a buck2 target; guides/buck2.md lists them:
#
#   ./scripts/buck run //crates/block-app:app
#   ./scripts/buck build //crates/block-app:dist --out dist
#   ./scripts/buck build //crates/block-app:plugins --out dist

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/internal/common.sh"

usage() {
    cat >&2 <<'USAGE'
Usage: ./scripts/build --target web|android [options...]

Web options:     [--release] [--wasi-sysroot DIRECTORY] [--no-plugins]
Android options: [--android-sdk DIRECTORY] [--application-id ID] [--label LABEL]
                 [--no-plugins]

The native app and the plugins are buck2 targets:
  ./scripts/buck run //crates/block-app:app
  ./scripts/buck build [--target-platforms root//buck/platforms:PLATFORM] \
      [-c be3.profile=release] //crates/block-app:dist --out DIRECTORY
  ./scripts/buck build //crates/block-app:plugins --out DIRECTORY
USAGE
}

target=''
arguments=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --target)
            target="$2"
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            arguments+=("$1")
            shift
            ;;
    esac
done

case "$target" in
    web) exec "$internal/build-web.sh" "${arguments[@]}" ;;
    android) exec "$internal/build-android.sh" "${arguments[@]}" ;;
    *)
        usage
        exit 1
        ;;
esac
