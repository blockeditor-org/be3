#!/bin/sh
#
# What CI runs: ./scripts/verify, and the Android builds, the paint previews and
# the bootstrap's release when asked.
#
# Usage:
#   ./scripts/ci [--check] [--android DIR] [--previews BASE OUT] [--bootstrap DIR]
#
# guides/bootstrap.md says what runs it.

exec sh "$(dirname "$0")/internal/bootstrap.sh" ci "$@"
