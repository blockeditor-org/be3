#!/bin/sh

usage() {
  echo "Usage: $0 <branch> [buck args...]"
  echo
  echo "Fetches from origin and checks out origin/<branch> in detached HEAD state."
  echo "Any arguments after <branch> are passed to ./scripts/buck once the checkout succeeds,"
  echo "e.g. $0 somebranch run //crates/beui:dock-example"
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 1
    ;;
esac

BRANCHNAME="$1"
shift

git fetch &&
  git -c advice.detachedHead=false checkout "origin/$BRANCHNAME" || exit $?

if [ "$#" -gt 0 ]; then
  exec "$(dirname "$0")/buck" "$@"
fi
