# The build server's front door, which boat's hosted port 8099 serves (`host 8099 --localhost --public`). Boat's edge and
# the HTTPS proxies clients sit behind carry gRPC only as HTTP/1.1, so scripts/internal/re-relay sends each call that way
# and this forwards it to NativeLink over cleartext HTTP/2.
#
# The port is public because boat takes its own token only as a cookie or a query and a Claude Code cloud session's
# proxy can add only a header; so this checks the token: `Authorization: Bearer NL_TUNNEL_TOKEN`, from the
# nl-scheduler environment's secret file ~/nl-tunnel.env, which nl-caddy.service reads. Anything else gets 401.
{
	admin off
	auto_https off
	servers {
		protocols h1 h2c
	}
}

http://:8099 {
	bind 127.0.0.1
	@authorized header Authorization "Bearer {env.NL_TUNNEL_TOKEN}"
	handle @authorized {
		reverse_proxy h2c://{$NL_TUNNEL_TARGET:10.100.0.1:50052} {
			header_up -Authorization
			flush_interval -1
		}
	}
	handle {
		respond "nl-caddy: the token is missing or wrong" 401
	}
}
