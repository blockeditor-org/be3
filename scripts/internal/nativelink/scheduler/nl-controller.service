[Unit]
Description=NativeLink build server controller: keeps workers alive while builds run
After=nativelink-server.service wg-quick@wg-sch.service
Wants=wg-quick@wg-sch.service
StartLimitIntervalSec=0

[Service]
ExecStartPre=/bin/sh -c 'touch /run/nl-peers; chmod 600 /run/nl-peers'
ExecStart=/usr/bin/python3 /usr/local/bin/nl-controller.py
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
