[Unit]
Description=OpenTelemetry collector: NativeLink's queue depth as Prometheus metrics for the controller
After=network-online.target

[Service]
ExecStart=/usr/local/bin/otelcol-contrib --config /etc/otelcol/config.yaml
DynamicUser=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
