[Unit]
Description=The build server's front door: checks the token and forwards calls to NativeLink (Caddyfile)
After=nativelink-server.service wg-quick@wg-sch.service
Wants=wg-quick@wg-sch.service
StartLimitIntervalSec=0

[Service]
# The token clients must send (NL_TUNNEL_TOKEN=...), a secret file of the nl-scheduler environment. systemd reads it
# as root, so it stays private to the user boat writes it as.
EnvironmentFile=/home/user/nl-tunnel.env
ExecStartPre=/bin/sh -c 'test -n "$NL_TUNNEL_TOKEN" || { echo "NL_TUNNEL_TOKEN is not set (~/nl-tunnel.env)" >&2; exit 1; }'
ExecStart=/usr/local/bin/caddy run --adapter caddyfile --config /etc/caddy/Caddyfile
DynamicUser=yes
Environment=XDG_DATA_HOME=/tmp XDG_CONFIG_HOME=/tmp
PrivateTmp=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
