[Unit]
Description=NativeLink worker (be3), in the pinned buildpack-deps image
After=network-online.target docker.service wg-quick@wg-sch.service
Requires=docker.service wg-quick@wg-sch.service

[Service]
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker rm -f nativelink-worker
ExecStart=/usr/bin/docker run --rm --name nativelink-worker --network host \
  --env-file /etc/nativelink/worker.env \
  -v /usr/local/bin/nativelink:/usr/local/bin/nativelink:ro \
  -v /etc/nativelink/worker.json5:/etc/nativelink/worker.json5:ro \
  -v /var/lib/nativelink-worker:/work \
  docker.io/library/buildpack-deps@sha256:2607512c685336a441eba9719ab17da07137ab3178ae8b7118dfe1dff7991549 \
  /usr/local/bin/nativelink /etc/nativelink/worker.json5
ExecStop=/usr/bin/docker stop nativelink-worker

[Install]
WantedBy=multi-user.target
