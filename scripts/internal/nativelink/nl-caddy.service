[Unit]
Description=The build server's front door: TLS, the token check, and forwarding to NativeLink (Caddyfile)
After=network-online.target nativelink.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
# NL_TUNNEL_TOKEN=..., NL_DASH_TOKEN=... and NL_HOST=..., readable by root only; systemd reads it before dropping to the dynamic user.
EnvironmentFile=/etc/nl-caddy.env
ExecStartPre=/bin/sh -c 'test -n "$NL_TUNNEL_TOKEN" && test -n "$NL_DASH_TOKEN" && test -n "$NL_HOST" || { echo "NL_TUNNEL_TOKEN, NL_DASH_TOKEN or NL_HOST is not set (/etc/nl-caddy.env)" >&2; exit 1; }'
ExecStart=/usr/local/bin/caddy run --adapter caddyfile --config /etc/caddy/Caddyfile
DynamicUser=yes
StateDirectory=caddy
Environment=XDG_DATA_HOME=/var/lib/caddy XDG_CONFIG_HOME=/var/lib/caddy
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
