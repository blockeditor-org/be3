  {
   "id": 2,
   "type": "timeseries",
   "title": "Build time",
   "description": "Minutes from buck2's start to its end for each ./scripts/verify and ./scripts/ci, by where it ran.",
   "datasource": {
    "type": "frser-sqlite-datasource",
    "uid": "builds"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "m",
     "custom": {
      "drawStyle": "points",
      "pointSize": 6,
      "fillOpacity": 0,
      "lineWidth": 1,
      "showPoints": "always"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "frser-sqlite-datasource",
      "uid": "builds"
     },
     "queryType": "time series",
     "queryText": "SELECT started AS time, seconds / 60.0 AS \"CI\" FROM builds WHERE kind LIKE 'ci%' AND started BETWEEN $__from / 1000.0 AND $__to / 1000.0 ORDER BY started",
     "rawQueryText": "SELECT started AS time, seconds / 60.0 AS \"CI\" FROM builds WHERE kind LIKE 'ci%' AND started BETWEEN $__from / 1000.0 AND $__to / 1000.0 ORDER BY started",
     "timeColumns": [
      "time"
     ]
    },
    {
     "refId": "B",
     "datasource": {
      "type": "frser-sqlite-datasource",
      "uid": "builds"
     },
     "queryType": "time series",
     "queryText": "SELECT started AS time, seconds / 60.0 AS \"verify, here\" FROM builds WHERE kind = 'verify' AND started BETWEEN $__from / 1000.0 AND $__to / 1000.0 ORDER BY started",
     "rawQueryText": "SELECT started AS time, seconds / 60.0 AS \"verify, here\" FROM builds WHERE kind = 'verify' AND started BETWEEN $__from / 1000.0 AND $__to / 1000.0 ORDER BY started",
     "timeColumns": [
      "time"
     ]
    },
    {
     "refId": "C",
     "datasource": {
      "type": "frser-sqlite-datasource",
      "uid": "builds"
     },
     "queryType": "time series",
     "queryText": "SELECT started AS time, seconds / 60.0 AS \"verify, cloud session\" FROM builds WHERE kind = 'verify-cloud' AND started BETWEEN $__from / 1000.0 AND $__to / 1000.0 ORDER BY started",
     "rawQueryText": "SELECT started AS time, seconds / 60.0 AS \"verify, cloud session\" FROM builds WHERE kind = 'verify-cloud' AND started BETWEEN $__from / 1000.0 AND $__to / 1000.0 ORDER BY started",
     "timeColumns": [
      "time"
     ]
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Actions each build ran on the server",
   "description": "Actions that ran on the server against those it found in the cache: a cold build runs thousands.",
   "datasource": {
    "type": "frser-sqlite-datasource",
    "uid": "builds"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "points",
      "pointSize": 6,
      "fillOpacity": 0,
      "lineWidth": 1,
      "showPoints": "always"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "frser-sqlite-datasource",
      "uid": "builds"
     },
     "queryType": "time series",
     "queryText": "SELECT started AS time, remote AS \"ran\" FROM builds WHERE started BETWEEN $__from / 1000.0 AND $__to / 1000.0 ORDER BY started",
     "rawQueryText": "SELECT started AS time, remote AS \"ran\" FROM builds WHERE started BETWEEN $__from / 1000.0 AND $__to / 1000.0 ORDER BY started",
     "timeColumns": [
      "time"
     ]
    },
    {
     "refId": "B",
     "datasource": {
      "type": "frser-sqlite-datasource",
      "uid": "builds"
     },
     "queryType": "time series",
     "queryText": "SELECT started AS time, cached AS \"cached\" FROM builds WHERE started BETWEEN $__from / 1000.0 AND $__to / 1000.0 ORDER BY started",
     "rawQueryText": "SELECT started AS time, cached AS \"cached\" FROM builds WHERE started BETWEEN $__from / 1000.0 AND $__to / 1000.0 ORDER BY started",
     "timeColumns": [
      "time"
     ]
    }
   ]
  },
  {
   "id": 4,
   "type": "table",
   "title": "Recent builds",
   "description": "Queued minutes add up every action's wait for a slot, so they exceed the build's time when many waited at once.",
   "datasource": {
    "type": "frser-sqlite-datasource",
    "uid": "builds"
   },
   "gridPos": {
    "h": 10,
    "w": 24,
    "x": 0,
    "y": 10
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "frser-sqlite-datasource",
      "uid": "builds"
     },
     "queryType": "table",
     "queryText": "SELECT started AS time, kind, branch, substr(commit_sha, 1, 9) AS \"commit\", parts, round(seconds / 60.0, 1) AS minutes, CASE passed WHEN 1 THEN 'passed' ELSE 'failed' END AS result, remote AS ran, cached, round(queue_seconds / 60.0, 1) AS \"queued minutes\", (SELECT what || ' (' || CAST(round(seconds) AS INTEGER) || ' s)' FROM critical_path c WHERE c.build_id = b.id ORDER BY seconds DESC LIMIT 1) AS \"longest critical step\" FROM builds b WHERE started BETWEEN $__from / 1000.0 AND $__to / 1000.0 ORDER BY started DESC LIMIT 200",
     "rawQueryText": "SELECT started AS time, kind, branch, substr(commit_sha, 1, 9) AS \"commit\", parts, round(seconds / 60.0, 1) AS minutes, CASE passed WHEN 1 THEN 'passed' ELSE 'failed' END AS result, remote AS ran, cached, round(queue_seconds / 60.0, 1) AS \"queued minutes\", (SELECT what || ' (' || CAST(round(seconds) AS INTEGER) || ' s)' FROM critical_path c WHERE c.build_id = b.id ORDER BY seconds DESC LIMIT 1) AS \"longest critical step\" FROM builds b WHERE started BETWEEN $__from / 1000.0 AND $__to / 1000.0 ORDER BY started DESC LIMIT 200",
     "timeColumns": [
      "time"
     ]
    }
   ]
  },
  {
   "id": 5,
   "type": "table",
   "title": "Slowest test runs",
   "description": "Each test binary's runs that were not cached, over the time range. A host test file runs as its own action.",
   "datasource": {
    "type": "frser-sqlite-datasource",
    "uid": "builds"
   },
   "gridPos": {
    "h": 12,
    "w": 12,
    "x": 0,
    "y": 20
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "frser-sqlite-datasource",
      "uid": "builds"
     },
     "queryType": "table",
     "queryText": "SELECT target, round(max(seconds), 1) AS \"slowest s\", round(avg(seconds), 1) AS \"average s\", round(avg(queue_seconds), 1) AS \"average queued s\", count(*) AS runs, sum(failed) AS failed FROM actions WHERE category = 'test_run' AND started BETWEEN $__from / 1000.0 AND $__to / 1000.0 GROUP BY target ORDER BY max(seconds) DESC LIMIT 40",
     "rawQueryText": "SELECT target, round(max(seconds), 1) AS \"slowest s\", round(avg(seconds), 1) AS \"average s\", round(avg(queue_seconds), 1) AS \"average queued s\", count(*) AS runs, sum(failed) AS failed FROM actions WHERE category = 'test_run' AND started BETWEEN $__from / 1000.0 AND $__to / 1000.0 GROUP BY target ORDER BY max(seconds) DESC LIMIT 40",
     "timeColumns": [
      "time"
     ]
    }
   ]
  },
  {
   "id": 6,
   "type": "table",
   "title": "Slowest other actions",
   "description": "Compiles, links and the rest that took over 10 s, over the time range.",
   "datasource": {
    "type": "frser-sqlite-datasource",
    "uid": "builds"
   },
   "gridPos": {
    "h": 12,
    "w": 12,
    "x": 12,
    "y": 20
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "frser-sqlite-datasource",
      "uid": "builds"
     },
     "queryType": "table",
     "queryText": "SELECT target, category, round(max(seconds), 1) AS \"slowest s\", round(avg(seconds), 1) AS \"average s\", count(*) AS runs FROM actions WHERE category != 'test_run' AND started BETWEEN $__from / 1000.0 AND $__to / 1000.0 GROUP BY target, category ORDER BY max(seconds) DESC LIMIT 40",
     "rawQueryText": "SELECT target, category, round(max(seconds), 1) AS \"slowest s\", round(avg(seconds), 1) AS \"average s\", count(*) AS runs FROM actions WHERE category != 'test_run' AND started BETWEEN $__from / 1000.0 AND $__to / 1000.0 GROUP BY target, category ORDER BY max(seconds) DESC LIMIT 40",
     "timeColumns": [
      "time"
     ]
    }
   ]
  },
  {
