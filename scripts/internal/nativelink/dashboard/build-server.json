    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(execution_peak_memory_bytes_bucket{le=\"4.294967296e+09\"}[1h])) - sum(increase(execution_peak_memory_bytes_bucket{le=\"1.073741824e+09\"}[1h]))",
     "legendFormat": "1-4 GiB"
    },
    {
     "refId": "B",
