[Unit]
Description=Prometheus, a year of the build server's metrics for the dashboard (prometheus.yml)
After=network-online.target docker.service
Requires=docker.service

[Service]
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker rm -f nl-prometheus
ExecStart=/usr/bin/docker run --rm --name nl-prometheus --network host --user 65534:65534 \
  -v /etc/nl-dashboard/prometheus.yml:/etc/prometheus/prometheus.yml:ro \
  -v /var/lib/nl-prometheus:/prometheus \
  docker.io/prom/prometheus@sha256:fa3302279710be2f21a8301ec17a8b4f2301fd829bd113839b3b6b02b6f191a2 \
  --config.file=/etc/prometheus/prometheus.yml --storage.tsdb.path=/prometheus \
  --storage.tsdb.retention.time=400d --storage.tsdb.retention.size=20GB --web.listen-address=127.0.0.1:9090
ExecStop=/usr/bin/docker stop nl-prometheus

[Install]
WantedBy=multi-user.target
