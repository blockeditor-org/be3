#!/bin/sh
#
# Bazel's credential helper for BuildBuddy (.bazelrc names it): the API key as
# the header BuildBuddy reads, from BUILDBUDDY_API_KEY, .buildbuddy-api-key at
# the root of the checkout, or ~/.config/be3/buildbuddy-api-key, whichever has
# it first. With none, no header: ./scripts/bazel asks for the key before
# Bazel starts, and a build without one reads as a build with no cache.
#
# Bazel runs it as `buildbuddy-credentials get` with the request on stdin,
# which says nothing this needs.
cat > /dev/null
key="${BUILDBUDDY_API_KEY:-}"
if [ -z "$key" ]; then
    for file in "$(dirname "$0")/../../.buildbuddy-api-key" "${XDG_CONFIG_HOME:-$HOME/.config}/be3/buildbuddy-api-key"; do
        if [ -f "$file" ]; then
            key="$(tr -d '[:space:]' < "$file")"
            break
        fi
    done
fi
if [ -z "$key" ]; then
    echo '{"headers":{}}'
else
    printf '{"headers":{"x-buildbuddy-api-key":["%s"]}}\n' "$key"
fi
