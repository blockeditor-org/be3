#!/usr/bin/env bash
#
# The web bundle, hosted, and the Android APK, installed on the attached device
# and launched: what is still cargo's. The native app is a buck2 target:
#
#   ./scripts/buck run //crates/block-app:app
#   ./scripts/buck run //crates/block-app:smoke

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/internal/common.sh"

usage() {
    cat >&2 <<'USAGE'
Usage: ./scripts/run --target web|android [options...]

Web options:     [--release]
Android options: [--android-sdk DIRECTORY] [--application-id ID] [--label LABEL]

The native app is a buck2 target:
  ./scripts/buck run //crates/block-app:app
  ./scripts/buck run //crates/block-app:smoke    (ten seconds in a virtual display)
USAGE
}

target=''
arguments=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --target)
            target="$2"
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            arguments+=("$1")
            shift
            ;;
    esac
done

case "$target" in
    web) exec "$internal/run-web.sh" "${arguments[@]}" ;;
    android) exec "$internal/run-android.sh" "${arguments[@]}" ;;
    *)
        usage
        exit 1
        ;;
esac
