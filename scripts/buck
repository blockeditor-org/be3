#!/usr/bin/env bash
#
# buck2, run against BuildBuddy.
#
# Every action runs on BuildBuddy's workers, so what this machine needs is
# buck2 and the key; the compilers are downloads the workers are handed.
# .buckconfig says how buck2 reaches BuildBuddy and guides/buck2.md says why
# there is no other way to run it.
#
# Everything after the script name is handed to buck2 unchanged, except that a
# test run is allowed to put its tests on the workers.
#
# Usage:
#   ./scripts/buck build //crates/...
#   ./scripts/buck test //crates/...

set -euo pipefail

# Sourcing common.sh turns sccache on for the cargo build: RUSTC_WRAPPER, CC and
# CXX pointed at it, and its store's credentials. Whatever is exported here is
# in the environment of the daemon this starts and so of every test it runs
# locally, and none of it is anything buck2 should see.
export BE3_NO_SCCACHE=1
source "$(dirname "${BASH_SOURCE[0]}")/internal/common.sh"
cd "$repository"

assert_command buck2 'Run ./scripts/internal/install-buck2.sh.'
assert_buildbuddy_key
remove_generated_buck_config_local

# buck2 runs every test locally, whatever its executor says, until it is told
# otherwise. This tells it to send the ones it calls compatible: a test that
# runs from the project root with project-relative paths, which is every Rust
# test and none of the plugin tests. guides/buck2.md says why those stay here.
if [[ "${1:-}" == 'test' ]]; then
    shift
    exec buck2 test --unstable-allow-compatible-tests-on-re "$@"
fi

exec buck2 "$@"
