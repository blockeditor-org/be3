#!/usr/bin/env bash
#
# buck2, run against our build server, on Linux, macOS or Git Bash on Windows.
# Before starting it, this installs the pinned buck2 if it is missing, wakes
# the remote execution cluster with nsc and points buck2 at it
# (scripts/internal/common.sh). Arguments go to
# buck2 unchanged, except that tests may run on the workers, on anything but
# Linux x86_64 `run` builds for this machine unless it names
# --target-platforms, and a command that fails with an infrastructure error is
# tried once more.
#
# Usage:
#   ./scripts/buck build //crates/...
#   ./scripts/buck test //crates/...
#   ./scripts/buck run //crates/block-app:app

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/internal/common.sh"
cd "$repository"

buck2="$(buck2_path)"
if [[ ! -x "$buck2" ]]; then
    "$internal/install-buck2.sh" >&2
fi
mkdir -p "$repository/target"
configure_build_server "$buck2"

command="${1:-}"

# buck2 exits with 2 for an infrastructure error and with other statuses for a
# build that is wrong. A connection to the build server sometimes resets
# partway through a download, which buck2 does not retry itself, and the
# cluster may have shut down since nsc was last asked; the second attempt
# wakes it if it has, and finds the actions cached.
retrying() {
    local status=0
    "$@" || status=$?
    if [[ $status -eq 2 ]]; then
        echo 'buck2 failed with an infrastructure error; trying once more.' >&2
        namespace_recheck=true
        configure_build_server "$buck2"
        status=0
        "$@" || status=$?
    fi
    return $status
}

quietly() {
    local live=0 width=80
    if [[ -t 1 ]]; then
        live=1
        width="$(tput cols 2> /dev/null || echo 80)"
    fi
    "$@" 2>&1 | awk -v live="$live" -v width="$width" -f "$internal/quiet.awk"
    return "${PIPESTATUS[0]}"
}

# buck2 runs every test locally, whatever its executor says, until it is told
# otherwise. This tells it to send the ones it calls compatible: a test that
# runs from the project root with project-relative paths, which is every Rust
# test and none of the plugin tests. guides/buck2.md says why those stay here.
#
# Outside CI, and unless BE3_VERBOSE is set, its output is cut down by
# quiet.awk to the failures, with buck2's progress kept on one line at a
# terminal.
if [[ "$command" == 'test' ]]; then
    shift
    if [[ -n "${BE3_VERBOSE:-}" || (-n "${CI:-}" && "${CI:-}" != false) ]]; then
        retrying "$buck2" test --unstable-allow-compatible-tests-on-re "$@"
        exit
    fi
    retrying quietly "$buck2" test --unstable-allow-compatible-tests-on-re "$@"
    exit
fi

if [[ "$command" == 'run' ]]; then
    host="$(host_target_platform || true)"
    if [[ -n "$host" && "$host" != 'linux_x86_64' ]]; then
        named=false
        for argument in "$@"; do
            case "$argument" in
                --) break ;;
                --target-platforms | --target-platforms=*) named=true ;;
            esac
        done
        if ! $named; then
            shift
            set -- run --target-platforms "root//buck/platforms:$host" "$@"
        fi
    fi
    # The program's own exit status is run's, so only the build is retried:
    # --command-args-file builds and downloads everything without running it.
    # (--emit-shell would too, but buck2 refuses it on Windows.)
    prebuild=true
    for argument in "$@"; do
        case "$argument" in
            --) break ;;
            --emit-shell | --command-args-file | --command-args-file=*) prebuild=false ;;
        esac
    done
    if $prebuild; then
        shift
        retrying "$buck2" run --command-args-file "$repository/target/run-command-args" "$@"
        set -- run "$@"
    fi
    exec "$buck2" "$@"
fi

retrying "$buck2" "$@"
