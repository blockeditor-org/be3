#!/bin/sh
#
# buck2, run against the build server (guides/buck2.md, guides/build_server.md).
#
# Usage:
#   ./scripts/buck build //crates/...
#   ./scripts/buck test //crates/...
#   ./scripts/buck run //crates/be-host:native
#
# guides/bootstrap.md says what runs it.

exec sh "$(dirname "$0")/internal/bootstrap.sh" buck "$@"
