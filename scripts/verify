#!/usr/bin/env bash
#
# Fixes Rust source layout, strips comments, lints, formats and tests.
#
# Runs the Rust source fixer, clippy, rustfmt and the test suite over the whole
# workspace. This is the one command to run after making changes.
#
# By default source layout and comments are fixed, clippy applies the fixes it
# can, rustfmt rewrites the sources and the tests accept whatever painting they
# produce. With --check nothing is written and each tool only reports, which is
# what CI wants. Either way the run fails if a Rust source violation or clippy
# warning survives.
#
# A run that writes is a person's, and it is quiet: what they want out of it is
# the failures, and they can see their own machine working. --check is CI's,
# and it is loud, because the only thing left of that run is its log and the
# question asked of it afterwards is where the time went. Every step says what
# it is doing and what it cost either way.
#
# The work splits into three parts that need nothing from one another: the lint
# pass, the native test run, and the plugin tests that run in wasm. Naming one
# or more of them runs only those, which is how CI gets them onto three runners
# at once instead of one runner in sequence. Naming none runs all three, so the
# command a person types is unchanged.
#
# Usage:
#   ./scripts/verify
#   ./scripts/verify --check
#   ./scripts/verify --full
#   ./scripts/verify --check --lint
#   ./scripts/verify --check --tests
#   ./scripts/verify --check --plugin-tests

set -uo pipefail

check=false
lint=false
tests=false
plugin_tests=false
selected=false
for argument in "$@"; do
    case "$argument" in
        --check) check=true ;;
        --full) export BE3_FULL=1 ;;
        --lint)
            lint=true
            selected=true
            ;;
        --tests)
            tests=true
            selected=true
            ;;
        --plugin-tests)
            plugin_tests=true
            selected=true
            ;;
        *)
            echo "Unknown argument: $argument" >&2
            echo 'Usage: ./scripts/verify [--check] [--full] [--lint] [--tests] [--plugin-tests]' >&2
            exit 1
            ;;
    esac
done

if ! $selected; then
    lint=true
    tests=true
    plugin_tests=true
fi

source "$(dirname "${BASH_SOURCE[0]}")/internal/common.sh"
cd "$repository"

# A plugin's tests run in wasm rather than natively, so the workspace run skips
# them and internal/test-plugins.sh runs them afterwards. What a default build
# leaves out is skipped here as well; --full puts it back.
native_selection
native=("${selection[@]}")

failed=false

# block-app links libghostty-vt, the terminal emulator behind the debug
# terminal window. It is Zig rather than Rust, so nothing cargo does builds it,
# and clippy and the tests cannot link the app without it. A default build does
# not compile the terminal at all, so this is a full build's cost alone.
host_triple="$(rustc --version --verbose | sed -n 's/^host: //p')"
if ! ensure_ghostty_vt "$host_triple"; then
    echo 'Verification failed.'
    exit 1
fi

# Every command announces itself and says what it cost, the way the build
# scripts do. A person reads a local run for the failures and already knows
# what their machine is like; a CI run is read weeks later by whoever is asking
# where the eleven minutes went, and these lines are the only account of that a
# finished run leaves behind. The run continues after a failure either way, so
# this reports whatever the command did rather than only what succeeded.
t() {
    if ! run_step "$@"; then
        failed=true
    fi
}

if $lint; then
    if $check; then
        t 'cargo fmt' cargo fmt --all --check
    else
        t 'cargo fmt' cargo fmt --all
    fi

    if $check; then
        t 'crates/fix-rust-source' cargo run -p fix-rust-source -- --check
    else
        t 'crates/fix-rust-source' cargo run --quiet -p fix-rust-source
    fi

    # The BUCK files, formatted the way the Rust is.
    #
    # Nothing here needs buck2 itself, only the formatter, and a checkout
    # without one says so rather than failing: the BUCK files are a small part
    # of a build cargo does not use yet.
    if command -v starlark_fmt > /dev/null 2>&1; then
        if $check; then
            t 'starlark_fmt' check_starlark_formatting
        else
            t 'starlark_fmt' starlark_fmt --config buck/starlark_fmt.json fmt $(starlark_files)
        fi
    else
        echo 'Skipping starlark_fmt: it is not installed (scripts/internal/install-starlark-fmt.sh).'
    fi

    # Tests and examples are linted too, so a warning cannot hide in them. The
    # plugins are in, because linting them natively is the only lint they get
    # from this run. What is out is --all-features: the one workspace feature it
    # turned on that is not on already is block-wasm-host/all-arch, which builds
    # Cranelift for every architecture instead of this one and has no
    # first-party code behind it to lint.
    workspace_selection
    clippy_targets=("${selection[@]}" --all-targets)

    if $check; then
        t 'cargo clippy' cargo clippy "${clippy_targets[@]}" -- -D warnings
    else
        # Fix mode forces every target to be checked even when nothing changed,
        # so only pay for it when the cacheable check finds something it can fix.
        if ! run_step 'cargo clippy' cargo clippy --quiet "${clippy_targets[@]}" -- -D warnings; then
            # The tree is expected to be mid-change; fixing only a pristine
            # checkout would make the script useless during development.
            t 'applying clippy fixes' cargo clippy --quiet --fix --allow-dirty --allow-staged "${clippy_targets[@]}" -- -D warnings
            # cargo clippy --fix caps lints while applying suggestions, so run
            # clippy again to make any warnings that remain fail verification.
            t 'cargo clippy' cargo clippy --quiet "${clippy_targets[@]}" -- -D warnings
        fi
    fi
fi

if $tests; then
    # The merge queue in .github/merge-queue is the one part of this repository
    # that is not Rust, so nothing else in this script compiles it and cargo
    # nextest does not run it. It decides whether a pull request merges, so it
    # is worth the second it costs here.
    #
    # Node is not otherwise needed to build or test anything in this project,
    # and asking every contributor to install one for this would be a poor
    # trade. CI runs these in a job of their own where Node is always present,
    # so a local checkout without it loses nothing but the early warning.
    if command -v node > /dev/null 2>&1; then
        t 'merge queue tests' node --test --test-reporter=dot '.github/merge-queue/*.test.js'
    else
        echo 'Skipping the merge queue tests: node is not installed.'
    fi

    if $check; then
        t 'cargo nextest run' cargo nextest run --profile ci "${native[@]}"
    else
        # A changed painting is not a failure to fix here: the accepted files
        # are rewritten, and it is the diff a person reviews.
        t 'cargo nextest run' env UPDATE_SNAPSHOTS=1 cargo nextest run --cargo-quiet --show-progress=none "${native[@]}"
    fi
fi

if $plugin_tests; then
    # The plugin run builds its test runner the way the native run builds its
    # own tests, so that everything that run compiled is reused rather than
    # resolved again with different features. When the native run is not part
    # of this one there is nothing to reuse, and asking for it that way is a
    # second build of every test binary in the workspace for the sake of one.
    alone=()
    if ! $tests; then
        alone=(--runner-only)
    fi
    if $check; then
        t 'plugin tests' "$internal/test-plugins.sh" --check "${alone[@]}" --profile ci
    else
        t 'plugin tests' "$internal/test-plugins.sh" "${alone[@]}" --cargo-quiet --show-progress=none
    fi
fi

# in case one of the previous commands leaves stuff unformatted. It belongs to
# the lint pass, which is where the commands that rewrite sources are.
if $lint; then
    if $check; then
        t 'format one more time' cargo fmt --all --check
    else
        t 'format one more time' cargo fmt --all
    fi
fi

echo ''
if $failed; then
    echo 'Verification failed.'
    exit 1
fi

echo 'All checks passed.'
