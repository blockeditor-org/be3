#!/usr/bin/env bash
#
# Fixes Rust source layout, strips comments, lints, formats and tests.
#
# Runs the Rust source fixer, clippy and rustfmt over the whole workspace, and
# the test suite, all through buck2 on BuildBuddy.
#
# By default source layout and comments are fixed, clippy applies the fixes it
# can, rustfmt rewrites the sources and the plugin tests accept whatever
# painting they produce. With --check nothing is written and each tool only
# reports, which is what CI wants. Either way the run fails if a Rust source
# violation or clippy warning survives.
#
# Everything is buck2's, so it needs BUILDBUDDY_API_KEY: clippy runs and every
# test binary is built on BuildBuddy's workers, most tests run there too, and
# the formatters are downloads buck2 makes. Nothing here needs cargo.
#
# A run that writes is a person's, and it is quiet: what they want out of it is
# the failures, and they can see their own machine working. --check is CI's,
# and it is loud, because the only thing left of that run is its log and the
# question asked of it afterwards is where the time went. Every step says what
# it is doing and what it cost either way.
#
# --ci is the loud half of --check without the read-only half: every tool
# writes its fixes and the tests accept what they paint, but the output is the
# one CI keeps. A pull request's run is this, so that what the fixes changed can
# be pushed back to its branch rather than left for its author to go and find.
#
# The work splits into three parts that need nothing from one another: the lint
# pass, the tests buck2 runs on BuildBuddy's workers, and the plugin tests,
# which run here because they read and write the accepted paintings in
# snapshots/. Naming one or more of them runs only those, which is how CI gets
# them onto three runners at once instead of one runner in sequence. Naming
# none runs all three, so the command a person types is unchanged.
#
# Usage:
#   ./scripts/verify
#   ./scripts/verify --check
#   ./scripts/verify --check --lint
#   ./scripts/verify --check --tests
#   ./scripts/verify --check --plugin-tests
#   ./scripts/verify --ci --lint

set -uo pipefail

check=false
ci=false
lint=false
tests=false
plugin_tests=false
selected=false
for argument in "$@"; do
    case "$argument" in
        --check)
            check=true
            ci=true
            ;;
        --ci) ci=true ;;
        --lint)
            lint=true
            selected=true
            ;;
        --tests)
            tests=true
            selected=true
            ;;
        --plugin-tests)
            plugin_tests=true
            selected=true
            ;;
        *)
            echo "Unknown argument: $argument" >&2
            echo 'Usage: ./scripts/verify [--check] [--ci] [--lint] [--tests] [--plugin-tests]' >&2
            exit 1
            ;;
    esac
done

if ! $selected; then
    lint=true
    tests=true
    plugin_tests=true
fi

source "$(dirname "${BASH_SOURCE[0]}")/internal/common.sh"
cd "$repository"

failed=false

# Every command announces itself and says what it cost, the way the build
# scripts do. A person reads a local run for the failures and already knows
# what their machine is like; a CI run is read weeks later by whoever is asking
# where the eleven minutes went, and these lines are the only account of that a
# finished run leaves behind. The run continues after a failure either way, so
# this reports whatever the command did rather than only what succeeded.
t() {
    if ! run_step "$@"; then
        failed=true
    fi
}

if $lint; then
    # Every tool here is one buck2 builds or downloads: rustfmt and
    # starlark_fmt from their pinned releases, fix-rust-source from the
    # workspace, and clippy on BuildBuddy's workers. They run on this checkout,
    # because what they rewrite is its sources.
    mapfile -t rust_sources < <(rust_files)
    if $check; then
        t 'rustfmt' rustfmt --check "${rust_sources[@]}"
    else
        t 'rustfmt' rustfmt "${rust_sources[@]}"
    fi

    if $check; then
        t 'crates/fix-rust-source' "$repository/scripts/buck" run --console=none \
            //crates/fix-rust-source:fix-rust-source-bin -- --check
    else
        t 'crates/fix-rust-source' "$repository/scripts/buck" run --console=none \
            //crates/fix-rust-source:fix-rust-source-bin
    fi

    # The BUCK files, formatted the way the Rust is.
    if $check; then
        t 'starlark_fmt' check_starlark_formatting
    else
        format_starlark() {
            "$(buck_output //buck/tools:starlark_fmt)" --config buck/starlark_fmt.json fmt $(starlark_files)
        }
        t 'starlark_fmt' format_starlark
    fi

    # clippy over every first-party target, tests included, in every
    # configuration it is built in: the host's and the plugins' and games'
    # wasm, whose wasm-only code a native cargo clippy never saw.
    # buck/lint/clippy.py says how --fix works without cargo.
    if $check; then
        t 'clippy' python3 buck/lint/clippy.py "$repository/scripts/buck"
    else
        t 'clippy' python3 buck/lint/clippy.py "$repository/scripts/buck" --fix
    fi
fi

if $tests; then
    # The merge queue in .github/merge-queue is the one part of this repository
    # that is not Rust, so nothing else in this script compiles it and buck2
    # does not run it. It decides whether a pull request merges, so it
    # is worth the second it costs here.
    #
    # Node is not otherwise needed to build or test anything in this project,
    # and asking every contributor to install one for this would be a poor
    # trade. CI runs these in a job of their own where Node is always present,
    # so a local checkout without it loses nothing but the early warning.
    if command -v node > /dev/null 2>&1; then
        t 'merge queue tests' node --test --test-reporter=dot '.github/merge-queue/*.test.js'
    else
        echo 'Skipping the merge queue tests: node is not installed.'
    fi

    # Everything but the plugin tests, which are labelled plugin. Most of it
    # runs on BuildBuddy's workers; guides/buck2.md says which tests stay here.
    t 'buck2 test' "$repository/scripts/buck" test //crates/... --exclude plugin
fi

if $plugin_tests; then
    # The plugin tests run here rather than on a worker, and a changed painting
    # is not a failure to fix in a run that writes: the accepted file is
    # rewritten, and it is the diff a person reviews. The runner passes the
    # variable on to the guest, which is where the comparison happens.
    if $check; then
        t 'plugin tests' "$repository/scripts/buck" test //crates/... --include plugin
    else
        t 'plugin tests' "$repository/scripts/buck" test //crates/... --include plugin -- --env UPDATE_SNAPSHOTS=1
    fi
fi

# in case one of the previous commands leaves stuff unformatted. It belongs to
# the lint pass, which is where the commands that rewrite sources are.
if $lint; then
    mapfile -t rust_sources < <(rust_files)
    if $check; then
        t 'format one more time' rustfmt --check "${rust_sources[@]}"
    else
        t 'format one more time' rustfmt "${rust_sources[@]}"
    fi
fi

echo ''
if $failed; then
    echo 'Verification failed.'
    exit 1
fi

echo 'All checks passed.'
