#!/usr/bin/env bash
#
# Fixes Rust source layout, strips comments, lints and formats.
#
# Runs the Rust source fixer, clippy and rustfmt over the whole workspace.
# This is the one command to run after making changes, before committing.
#
# By default source layout and comments are fixed, clippy applies the fixes it
# can, and rustfmt rewrites the sources. The test suite is not run in this
# mode: CI runs it in full on every push and pull request, so a local run only
# needs to cover the autofixes and lints. With --check nothing is written,
# each tool only reports, and the full test suite runs too, which is what CI
# wants. Either way the run fails if a Rust source violation or clippy warning
# survives.
#
# Usage:
#   ./scripts/verify
#   ./scripts/verify --check

set -uo pipefail

check=false
if [[ "${1:-}" == "--check" ]]; then
    check=true
fi

source "$(dirname "${BASH_SOURCE[0]}")/internal/common.sh"
cd "$repository"

# A plugin's tests run in wasm rather than natively, so the workspace run skips
# them and internal/test-plugins.sh runs them afterwards.
load_plugins
native=(--workspace)
for plugin in "${plugins[@]}"; do
    native+=(--exclude "$plugin")
done

failed=false

# block-app links libghostty-vt, the terminal emulator behind the debug
# terminal window. It is Zig rather than Rust, so nothing cargo does builds it,
# and clippy and the tests cannot link the app without it.
echo 'libghostty-vt...'
host_triple="$(rustc --version --verbose | sed -n 's/^host: //p')"
if ! "$repository/scripts/internal/build-ghostty-vt.sh" --triple "$host_triple" > /dev/null; then
    echo 'Verification failed.'
    exit 1
fi

timed() {
    if which time >/dev/null 2>&1; then
        TIME="Took %E" time "$@"
    else
        # git bash only has the builtin, no executable
        time "$@"
    fi
}

t() {
    if ! timed "$@"; then
        failed=true
    fi
}

echo 'cargo fmt...'
if $check; then
    t cargo fmt --all --check
else
    t cargo fmt --all
fi

echo 'crates/fix-rust-source...'
if $check; then
    t cargo run -p fix-rust-source -- --check
else
    t cargo run --quiet -p fix-rust-source
fi

# Tests and examples are linted too, so a warning cannot hide in them.
clippy_targets=(--workspace --all-targets --all-features)

echo 'cargo clippy...'
if $check; then
    t cargo clippy "${clippy_targets[@]}" -- -D warnings
else
    # Fix mode forces every target to be checked even when nothing changed, so
    # only pay for it when the cacheable check finds something it can fix.
    if ! timed cargo clippy --quiet "${clippy_targets[@]}" -- -D warnings; then
        echo 'Applying clippy fixes...'
        # The tree is expected to be mid-change; fixing only a pristine checkout
        # would make the script useless during development.
        t cargo clippy --quiet --fix --allow-dirty --allow-staged "${clippy_targets[@]}" -- -D warnings
        # cargo clippy --fix caps lints while applying suggestions, so run clippy
        # again to make any warnings that remain fail verification.
        t cargo clippy --quiet "${clippy_targets[@]}" -- -D warnings
    fi
fi

if $check; then
    echo 'cargo nextest run...'
    t cargo nextest run --profile ci "${native[@]}"

    echo 'plugin tests...'
    t "$internal/test-plugins.sh" --check --profile ci
else
    # CI runs the full test suite with --check on every push and pull request,
    # so a local run does not pay for it too. Run ./scripts/verify --check, or
    # cargo nextest run / test-plugins.sh directly, to run tests locally.
    echo 'skipping tests (CI runs the full suite; use --check to run it locally)...'
fi

# in case one of the previous commands leaves stuff unformatted
echo 'format one more time...'
if $check; then
    t cargo fmt --all --check
else
    t cargo fmt --all
fi

echo ''
if $failed; then
    echo 'Verification failed.'
    exit 1
fi

echo 'All checks passed.'
