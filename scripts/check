#!/usr/bin/env bash
#
# Fast compile feedback: rustc's check pass - type checking and borrow checking
# with no code generated - over every first-party target, tests included, in
# every configuration the workspace builds it in: the host's, and the plugins'
# and games' wasm. It runs on BuildBuddy's workers through buck2, so it needs
# BUILDBUDDY_API_KEY, and fails with the compiler's errors on the first target
# that has any.
#
# Usage:
#   ./scripts/check

set -euo pipefail

if [[ $# -ne 0 ]]; then
    echo 'Usage: ./scripts/check' >&2
    exit 1
fi

exec "$(dirname "${BASH_SOURCE[0]}")/buck" bxl //buck/lint/workspace.bxl:subtarget -- --subtarget check > /dev/null
