#!/usr/bin/env bash
#
# Regenerates the two files buck2 reads the workspace's Cargo.toml files
# through: third-party/rust/BUCK, the rules for every third-party crate, and
# buck/cargo/crates.bzl, what each workspace crate's Cargo.toml says, which the
# BUCK file beside each crate reads through buck/cargo/defs.bzl. cargo stays
# the single place a dependency is declared. Run this after changing any
# Cargo.toml or Cargo.lock; CI fails if either file is stale.
#
# Both are checked in, because a build should not have to run cargo and
# because the diff is what says what a dependency change did.
#
# Both are generated on a BuildBuddy worker, through buck/cargo/buckify.bxl,
# which builds reindeer there too, so nothing is installed here and nothing but
# buck2 and BUILDBUDDY_API_KEY is needed. The action is keyed on the manifests,
# the lockfile, the fixups and the layout of each crate, so a checkout whose
# dependencies have not changed gets the answer from the cache in seconds, and
# only a change to one of those runs cargo again.
#
# Usage:
#   ./scripts/buckify

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/internal/common.sh"
cd "$repository"

if [[ $# -ne 0 ]]; then
    echo 'Usage: ./scripts/buckify' >&2
    exit 1
fi

time_script 'Buckifying'

step 'Generating third-party/rust/BUCK and buck/cargo/crates.bzl on BuildBuddy'
log="$(mktemp)"
trap 'rm -f "$log"' EXIT
if ! "$repository/scripts/buck" bxl //buck/cargo/buckify.bxl:main > "$log" 2>&1; then
    cat "$log" >&2
    exit 1
fi
generated="$(grep -o '/.*/buckify\.bxl/.*/generated$' "$log" | tail -1)"
cp "$generated/BUCK" third-party/rust/BUCK
cp "$generated/crates.bzl" buck/cargo/crates.bzl
end_step
