#!/usr/bin/env bash
#
# Regenerates the three files buck2 reads generated data from:
#
#   - third-party/rust/BUCK, the rules for every third-party crate;
#   - buck/cargo/crates.bzl, what each workspace crate's Cargo.toml says, which
#     the BUCK file beside each crate reads through buck/cargo/defs.bzl;
#   - buck/sysroot/packages.bzl, every Ubuntu package the sysroot is made of,
#     resolved from what buck/sysroot/BUCK asks for.
#
# cargo stays the single place a dependency is declared, and buck/sysroot/BUCK
# the single place a system library is. Run this after changing any
# Cargo.toml, Cargo.lock or that list; CI fails if any of the three is stale.
# They are checked in, because a build should not have to run cargo or apt, and
# because the diff is what says what a change did.
#
# All three are generated on a BuildBuddy worker - the first two through
# buck/cargo/buckify.bxl, which builds reindeer there too - so nothing is
# installed here and nothing but buck2 and BUILDBUDDY_API_KEY is needed. Each is
# keyed on what it reads, so a checkout where none of that has changed gets the
# answers from the cache in seconds.
#
# Usage:
#   ./scripts/buckify

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/internal/common.sh"
cd "$repository"

if [[ $# -ne 0 ]]; then
    echo 'Usage: ./scripts/buckify' >&2
    exit 1
fi

time_script 'Buckifying'

step 'Generating third-party/rust/BUCK and buck/cargo/crates.bzl on BuildBuddy'
log="$(mktemp)"
trap 'rm -f "$log"' EXIT
if ! "$repository/scripts/buck" bxl //buck/cargo/buckify.bxl:main > "$log" 2>&1; then
    cat "$log" >&2
    exit 1
fi
generated="$(grep -o '/.*/buckify\.bxl/.*/generated$' "$log" | tail -1)"
cp "$generated/BUCK" third-party/rust/BUCK
cp "$generated/crates.bzl" buck/cargo/crates.bzl
end_step

step 'Resolving the sysroot packages on BuildBuddy'
if ! "$repository/scripts/buck" build //buck/sysroot:lock --show-full-output > "$log" 2>&1; then
    cat "$log" >&2
    exit 1
fi
cp "$(grep '^root//buck/sysroot:lock ' "$log" | awk '{print $2}')" buck/sysroot/packages.bzl
end_step
