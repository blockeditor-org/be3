#!/usr/bin/env bash
#
# Regenerates third-party/rust/BUCK from the workspace's Cargo.toml.
#
# reindeer reads the same manifests and the same Cargo.lock cargo does and
# writes one Buck rule per crate, so cargo stays the single place a dependency
# is declared. Run this after changing any Cargo.toml or Cargo.lock; a build
# against a stale file fails with a target that does not exist.
#
# The generated file is checked in, because a build should not need reindeer
# and because the diff is what says what a dependency change did.
#
# reindeer runs on a BuildBuddy worker, through buck/reindeer/buckify.bxl, which
# builds it there too, so nothing is installed here and nothing but buck2 and
# BUILDBUDDY_API_KEY is needed. The action is keyed on the manifests, the
# lockfile, the fixups and the layout of each crate, so a checkout whose
# dependencies have not changed gets the answer from the cache in seconds, and
# only a change to one of those runs reindeer again.
#
# What it does not generate is the BUCK file beside each crate in crates/.
# Those are written by hand: guides/buck2.md says what goes in one.
#
# Usage:
#   ./scripts/buckify

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/internal/common.sh"
cd "$repository"

if [[ $# -ne 0 ]]; then
    echo 'Usage: ./scripts/buckify' >&2
    exit 1
fi

time_script 'Buckifying'

step 'Generating third-party/rust/BUCK on BuildBuddy'
log="$(mktemp)"
trap 'rm -f "$log"' EXIT
if ! "$repository/scripts/buck" bxl //buck/reindeer/buckify.bxl:main > "$log" 2>&1; then
    cat "$log" >&2
    exit 1
fi
generated="$(grep -o '/.*/buckify\.bxl/.*/BUCK$' "$log" | tail -1)"
cp "$generated" third-party/rust/BUCK
end_step
