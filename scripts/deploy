#!/usr/bin/env bash
#
# Deploys be-server and the tracker's be from this checkout, in one buck2
# command: it builds both in release for the platforms they run on, then runs
# crates/deploy, which uploads each be to the mirror and reads it back, stops
# the server's units, copies be-server and its build-id over with scp, starts
# them again, and pins the uploaded be in scripts/internal/common.sh to commit.
# `./scripts/deploy --help` lists its options and the environment it reads.
#
# Usage:
#   BUNNY_STORAGE_KEY=... ./scripts/deploy [--dry-run] [--allow-dirty] [--skip-server] [--skip-be]

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/internal/common.sh"

exec "$repository/scripts/buck" run -m release //crates/deploy:deploy -- --repository "$repository" "$@"
