#!/bin/sh
#
# Deploys be-server, the tracker's be and the app's downloads from this checkout,
# in one buck2 command; ./scripts/deploy --help lists the options.
#
# Usage:
#   ./scripts/deploy [--dry-run] [--allow-dirty] [--skip-server] [--skip-be] [--skip-web]
#                    [--skip-downloads] [--skip-android] [--android-id ID] [--android-label LABEL]
#
# guides/bootstrap.md says what runs it.

exec sh "$(dirname "$0")/internal/bootstrap.sh" deploy "$@"
