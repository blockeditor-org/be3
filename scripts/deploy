#!/usr/bin/env bash
#
# Deploys be-server, the tracker's be and the app's downloads from this
# checkout, in one buck2 command: it builds them in release for the platforms
# they run on (the app for Linux, macOS and Windows on x86_64 and arm64, Android
# and the web), then runs local-tools deploy, which uploads each be and each
# download to the mirror and reads it back, stops the server's units, copies
# be-server and its build-id over with scp, starts them again, points the
# mirror's download page at the build, and pins the uploaded be in
# scripts/internal/common.sh to commit.
# `./scripts/deploy --help` lists its options and the environment it reads.
#
# Usage:
#   BUNNY_STORAGE_KEY=... ./scripts/deploy [--dry-run] [--allow-dirty] [--skip-server] [--skip-be] [--skip-web] [--skip-downloads]

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/internal/common.sh"

exec "$repository/scripts/buck" run -m release //crates/local-tools:deploy -- --repository "$repository" "$@"
