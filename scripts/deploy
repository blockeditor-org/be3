#!/usr/bin/env bash
#
# Deploys be-server, the tracker's be and the app's downloads from this
# checkout, in one buck2 command: it builds them in release for the platforms
# they run on (the app for Linux, macOS and Windows on x86_64 and arm64, Android
# and the web), then runs local-tools deploy, which uploads each be and each
# download to the mirror and reads it back, stops the server's units, copies
# be-server and its build-id over with scp, starts them again, points the
# mirror's download page at the build, and pins the uploaded be in
# scripts/internal/common.sh to commit.
#
# Before building, it finds what it needs beyond the build server's key, asking
# at a terminal for whatever is missing and saving it in ~/.config/be3:
# Bunny's storage zone password (BUNNY_STORAGE_KEY, or bunny-storage-key), its
# API key for purging the download page (BUNNY_API_KEY, or bunny-api-key,
# which may be left empty), and the keystore the APK is signed with
# (android-release-keystore.base64), which it can make anew and copies to
# buck/android/release-keystore.base64 for the build. --android-id and
# --android-label name the APK, com.be3.block and Block unless given, so that
# it installs beside CI's com.be3.block.ci. `./scripts/deploy --help` lists
# the other options and the environment it reads.
#
# Usage:
#   ./scripts/deploy [--dry-run] [--allow-dirty] [--skip-server] [--skip-be] [--skip-web]
#                    [--skip-downloads] [--android-id ID] [--android-label LABEL]

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/internal/common.sh"

config="${XDG_CONFIG_HOME:-$HOME/.config}/be3"
android_id='com.be3.block'
android_label='Block'
dry_run=false
uploads=2
help=false
arguments=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --android-id | --android-label)
            if [[ $# -lt 2 ]]; then
                echo "deploy: $1 needs a value" >&2
                exit 1
            fi
            if [[ "$1" == '--android-id' ]]; then android_id="$2"; else android_label="$2"; fi
            shift 2
            continue
            ;;
        --dry-run) dry_run=true ;;
        --skip-be | --skip-downloads) uploads=$((uploads - 1)) ;;
        --help | -h) help=true ;;
    esac
    arguments+=("$1")
    shift
done
if [[ ! "$android_id" =~ ^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+$ ]]; then
    echo "deploy: --android-id takes an Android application id such as com.be3.block, not '$android_id'" >&2
    exit 1
fi

# A secret from the environment or the file saved under ~/.config/be3, or else
# asked for at a terminal and saved there. An empty answer is saved too when
# the secret is optional, so it is not asked for again.
secret() {
    local variable="$1" name="$2" what="$3" optional="$4" saved="$config/$2" value
    if [[ -n "${!variable:-}" ]]; then
        return 0
    fi
    if [[ ! -f "$saved" ]]; then
        if [[ ! -t 0 || ! -t 2 ]]; then
            $optional && return 0
            echo "deploy: set $variable, or write $what to $saved, or run ./scripts/deploy at a terminal to be asked for it." >&2
            exit 1
        fi
        echo "./scripts/deploy needs $what (guides/hosting.md)." >&2
        $optional && echo 'Leave it empty to go without; delete the file below to be asked again.' >&2
        read -r -s -p "$variable: " value
        echo '' >&2
        value="$(printf '%s' "$value" | tr -d '[:space:]')"
        if [[ -z "$value" ]] && ! $optional; then
            echo "deploy: $variable is needed." >&2
            exit 1
        fi
        mkdir -p "$config"
        (umask 077 && printf '%s\n' "$value" > "$saved")
        echo "Saved it to $saved." >&2
    fi
    value="$(tr -d '[:space:]' < "$saved")"
    [[ -z "$value" ]] || export "$variable=$value"
}

# A new keystore, base64, signed the way the build's signing expects:
# store and key password `android`. keytool where there is one, else openssl.
new_keystore() {
    local scratch
    scratch="$(mktemp -d)"
    if command -v keytool > /dev/null; then
        keytool -genkeypair -keystore "$scratch/keystore" -storetype PKCS12 -storepass android \
            -alias release -keypass android -dname 'CN=Block' -keyalg RSA -keysize 4096 \
            -validity 36500 > /dev/null 2>&1
    elif command -v openssl > /dev/null; then
        openssl req -x509 -newkey rsa:4096 -nodes -keyout "$scratch/key.pem" -out "$scratch/cert.pem" \
            -days 36500 -subj '/CN=Block' > /dev/null 2>&1
        openssl pkcs12 -export -inkey "$scratch/key.pem" -in "$scratch/cert.pem" -name release \
            -passout pass:android -out "$scratch/keystore"
    else
        echo 'deploy: making a keystore needs keytool (a JDK) or openssl.' >&2
        rm -rf "$scratch"
        exit 1
    fi
    base64 < "$scratch/keystore" | tr -d '\n'
    rm -rf "$scratch"
}

# The keystore the APK is signed with, kept in ~/.config/be3 and copied into
# the checkout, where the signing action reads it.
keystore() {
    local saved="$config/android-release-keystore.base64" choice path
    if [[ ! -f "$saved" ]]; then
        if [[ ! -t 0 || ! -t 2 ]]; then
            echo "deploy: there is no keystore to sign the APK with at $saved; run ./scripts/deploy at a terminal to make or give one." >&2
            exit 1
        fi
        echo "./scripts/deploy signs the APK with a keystore of its own. Android installs an" >&2
        echo 'update only when it is signed with the same key, so keep it: a new one means' >&2
        echo 'everyone uninstalls the app once.' >&2
        echo '  1) make a new one' >&2
        echo '  2) use a keystore file (PKCS12 or JKS, password android, or base64 of one)' >&2
        read -r -p 'Keystore [1-2]: ' choice
        mkdir -p "$config"
        case "$choice" in
            1)
                (umask 077 && new_keystore > "$saved")
                echo "Made one and saved it to $saved. Keep a copy somewhere safe." >&2
                ;;
            2)
                read -r -p 'Keystore file: ' path
                path="${path/#\~/$HOME}"
                if [[ ! -f "$path" ]]; then
                    echo "deploy: there is no file $path" >&2
                    exit 1
                fi
                if LC_ALL=C grep -q '[^A-Za-z0-9+/=[:space:]]' "$path"; then
                    (umask 077 && base64 < "$path" | tr -d '\n' > "$saved")
                else
                    (umask 077 && tr -d '[:space:]' < "$path" > "$saved")
                fi
                echo "Saved it to $saved." >&2
                ;;
            *)
                echo 'deploy: pick 1 or 2.' >&2
                exit 1
                ;;
        esac
    fi
    (umask 077 && cp "$saved" "$repository/buck/android/release-keystore.base64")
}

if ! $help; then
    if ! $dry_run && [[ $uploads -gt 0 ]]; then
        secret BUNNY_STORAGE_KEY bunny-storage-key "the Bunny storage zone's password" false
        secret BUNNY_API_KEY bunny-api-key "the Bunny account's API key, to purge the download page from the CDN" true
    fi
    keystore
fi

exec "$repository/scripts/buck" run -m release \
    -c "be3.android_id=$android_id" -c "be3.android_label=$android_label" \
    //crates/local-tools:deploy -- --repository "$repository" ${arguments[@]+"${arguments[@]}"}
