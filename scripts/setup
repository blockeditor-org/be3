#!/usr/bin/env bash
#
# Installs what a fresh Ubuntu machine needs to build, test and run the project.
#
# Everything here is idempotent, so running it again on a machine that is
# already set up only reports what is already there. It assumes apt.
#
# Everything the project builds, buck2 builds, on BuildBuddy's workers with
# compilers it brings itself, so what this machine needs is buck2, Python for
# the commands that run as buck2 targets, and the libraries the app and the
# plugin tests load when they run here.
#
# Usage:
#   ./scripts/setup

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/internal/common.sh"

if [[ $# -ne 0 ]]; then
    echo 'Usage: ./scripts/setup' >&2
    exit 1
fi

cd "$repository"
time_script 'Setup'

if [[ "$(uname -s)" != 'Linux' ]] || ! command -v apt-get > /dev/null; then
    echo 'This script only knows how to set up Ubuntu. Install the equivalents of' >&2
    echo 'the packages it lists by hand, then run ./scripts/internal/install-buck2.sh.' >&2
    exit 1
fi

sudo=''
if [[ "$(id -u)" != '0' ]]; then
    assert_command sudo 'Run this script as root instead.'
    sudo='sudo'
fi

# What each group is for, since none of it is obvious from the names:
#
# Fetching buck2, which is a zstd stream, and the checkout itself.
packages=(curl git zstd)
# What `./scripts/buck run` starts: //:verify, //:check and the rest are
# Python, and so is what signs an APK and serves the web bundle.
packages+=(python3)
# What the app loads when it runs here: ALSA for audio, GTK for the native file
# dialog, and WebKitGTK for the embedded browser. buck2 compiles and links
# against its own copies of them, in buck/sysroot, so only the libraries are
# needed, not their headers.
packages+=(libasound2t64 libgtk-3-0t64 libwebkit2gtk-4.1-0)
# wgpu opens libvulkan at runtime rather than linking it, and lavapipe out of
# mesa-vulkan-drivers is the only adapter a machine with no GPU has. The plugin
# tests draw through it here, so this is not optional on a server.
packages+=(libvulkan1 mesa-vulkan-drivers)
# winit opens these the same way, when the app actually has a display to draw on.
packages+=(
    libx11-6
    libxcursor1
    libxrandr2
    libxi6
    libxkbcommon0
    libxkbcommon-x11-0
    libwayland-client0
)
# Nothing the workspace builds reads a system font any more - beui and egui both
# carry theirs - but the GTK dialogs and the window manager the app runs under
# still want one, and a machine with no font at all is a confusing one to debug.
packages+=(fonts-dejavu-core fonts-dejavu-mono)
# ./scripts/buck run //crates/block-app:smoke starts the app against a virtual
# display.
packages+=(xvfb)

missing=()
for package in "${packages[@]}"; do
    if ! dpkg-query --show --showformat='${db:Status-Status}\n' "$package" 2> /dev/null | grep -qx 'installed'; then
        missing+=("$package")
    fi
done

if [[ ${#missing[@]} -eq 0 ]]; then
    echo "All ${#packages[@]} system packages are already installed."
else
    step "Installing ${#missing[@]} system packages"
    $sudo apt-get update
    DEBIAN_FRONTEND=noninteractive $sudo apt-get install -y "${missing[@]}"
fi

# buck2 builds and tests the workspace on BuildBuddy's workers;
# guides/buck2.md says what it covers. It is a download of a pinned release, so
# it costs seconds.
step 'Installing buck2'
"$internal/install-buck2.sh"

end_step
echo ''
echo 'Setup finished. Every build runs on BuildBuddy, so put its API key in'
echo 'BUILDBUDDY_API_KEY or in ~/.config/be3/buildbuddy-api-key - guides/buck2.md'
echo 'says more - then check the workspace compiles with'
echo './scripts/buck run //:check, and run ./scripts/buck run //:verify before committing.'
