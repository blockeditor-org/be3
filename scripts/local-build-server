#!/usr/bin/env bash
#
# A remote execution server on this machine, for when BuildBuddy is down or out
# of reach. It is NativeLink (CAS, action cache, scheduler and one worker in
# one process), and each action runs where a BuildBuddy worker would run it: as
# root, in the container image buck/tools/defs.bzl names, which is unpacked
# once and entered with a user namespace and chroot rather than Docker, so an
# action costs a few milliseconds more than it would on the host. Builds are
# slower than on BuildBuddy, since there is one machine and an empty cache.
#
# Usage:
#   ./scripts/local-build-server start   point ./scripts/buck at a server here, starting it
#   ./scripts/local-build-server stop    stop the server, leaving ./scripts/buck pointed at it
#   ./scripts/local-build-server off     stop it and point ./scripts/buck back at BuildBuddy
#   ./scripts/local-build-server status
#
# While .buckconfig.local is the one this writes, ./scripts/buck starts the
# server whenever it is not running. Its cache, the unpacked image and its log
# live in ~/.cache/be3/build-server.

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/internal/common.sh"
cd "$repository"

nativelink_version='1.7.3'
nativelink_sha256='5b35a3296d91c12eac6fd4253f52c8890dd0e3ea079ac3694aa8f2c524c80f0b'
# Outside the checkout, so that every checkout on the machine shares the one
# server and its cache, and so that buck2's file watcher, which descends into
# target/ for all that it ignores it, never meets the image's private
# directories.
server="${XDG_CACHE_HOME:-$HOME/.cache}/be3/build-server"
nativelink="$server/nativelink-$nativelink_version/nativelink"
address='127.0.0.1:50052'
worker_address='127.0.0.1:50062'
marker='# @generated by ./scripts/local-build-server: buck2 builds on this machine.'

# Ubuntu lets only programs AppArmor names create user namespaces. This
# unshare is one: a copy of the system's, owned by root, which a profile
# allows them, so the permission reaches nothing else on the machine.
privileged_unshare='/usr/local/libexec/be3-build-server/unshare'
apparmor_profile='/etc/apparmor.d/be3-build-server'

unshare_path() {
    if [[ "$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns 2> /dev/null || echo 0)" == 1 ]]; then
        echo "$privileged_unshare"
    else
        command -v unshare
    fi
}

# Root in the namespace is this user outside it, and every group is one of the
# user's subordinate groups, so an action can chown a file to any group, as
# dpkg-deb does, and the server can still read and delete all it leaves.
as_root() {
    "$(unshare_path)" --map-user=0 --map-group=0 --map-groups=auto "$@"
}

ensure_user_namespaces() {
    assert_command newgidmap 'Install the uidmap package.'
    if ! grep -q "^$(id -un):" /etc/subgid; then
        echo "$(id -un) has no subordinate groups in /etc/subgid. Add some with" >&2
        echo "  sudo usermod --add-subgids 100000-165535 $(id -un)" >&2
        exit 1
    fi
    if [[ "$(unshare_path)" == "$privileged_unshare" ]] &&
        ! { [[ -x "$privileged_unshare" ]] && cmp -s "$privileged_unshare" "$(command -v unshare)" && [[ -f "$apparmor_profile" ]]; }; then
        step 'Allowing the build server user namespaces (sudo)'
        sudo install -D -o root -g root -m 0755 "$(command -v unshare)" "$privileged_unshare"
        printf '%s\n' \
            'abi <abi/4.0>,' \
            'include <tunables/global>' \
            '' \
            "profile be3-build-server $privileged_unshare flags=(unconfined) {" \
            '  userns,' \
            '}' | sudo tee "$apparmor_profile" > /dev/null
        sudo apparmor_parser -r "$apparmor_profile"
    fi
    if ! as_root true; then
        echo 'This machine does not allow the user namespace every action runs in.' >&2
        exit 1
    fi
}

ensure_nativelink() {
    [[ -x "$nativelink" ]] && return 0
    step "Installing NativeLink $nativelink_version"
    local directory archive
    directory="$(dirname "$nativelink")"
    archive="$directory.tar.gz"
    mkdir -p "$directory"
    download_verified \
        "https://github.com/TraceMachina/nativelink/releases/download/v$nativelink_version/nativelink-$nativelink_version-x86_64-unknown-linux-musl.tar.gz" \
        "$archive" "$nativelink_sha256"
    tar -xzf "$archive" -C "$directory" nativelink
    rm "$archive"
}

# The image BuildBuddy runs every action in, as buck/tools/defs.bzl pins it:
# an index digest, whose linux/amd64 manifest and layers are each checked
# against the digest that names them.
image_digest() {
    sed -n 's|.*"container-image": "docker://docker.io/library/[^@]*@\(sha256:[0-9a-f]*\)".*|\1|p' buck/tools/defs.bzl
}

image_repository() {
    sed -n 's|.*"container-image": "docker://docker.io/\([^@]*\)@sha256:.*|\1|p' buck/tools/defs.bzl
}

registry_fetch() {
    local token="$1" path="$2" digest="$3" destination="$4"
    curl --fail --location --silent --show-error --retry 4 \
        -H "Authorization: Bearer $token" \
        -H 'Accept: application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.v2+json' \
        --output "$destination" "https://registry-1.docker.io/v2/$(image_repository)/$path/$digest"
    if [[ "sha256:$(sha256_of "$destination")" != "$digest" ]]; then
        echo "The registry's $digest is not the file that digest names." >&2
        rm -f "$destination"
        exit 1
    fi
}

ensure_rootfs() {
    local digest rootfs
    digest="$(image_digest)"
    rootfs="$server/rootfs"
    [[ "$(cat "$rootfs.digest" 2> /dev/null)" == "$digest" ]] && return 0
    step "Unpacking the workers' image $(image_repository)@$digest"
    local download="$server/image" token manifest layer
    rm -rf "$download"
    mkdir -p "$download"
    token="$(curl --fail --silent --show-error "https://auth.docker.io/token?service=registry.docker.io&scope=repository:$(image_repository):pull" |
        python3 -c 'import json, sys; print(json.load(sys.stdin)["token"])')"
    registry_fetch "$token" manifests "$digest" "$download/index.json"
    manifest="$(python3 -c '
import json, sys
index = json.load(open(sys.argv[1]))
print(next(m["digest"] for m in index["manifests"] if m.get("platform") == {"architecture": "amd64", "os": "linux"}))
' "$download/index.json")"
    registry_fetch "$token" manifests "$manifest" "$download/manifest.json"

    if [[ -d "$rootfs" ]]; then
        as_root rm -rf "$rootfs"
    fi
    mkdir -p "$rootfs"
    for layer in $(python3 -c 'import json, sys; print("\n".join(l["digest"] for l in json.load(open(sys.argv[1]))["layers"]))' "$download/manifest.json"); do
        registry_fetch "$token" blobs "$layer" "$download/layer.tar.gz"
        # A layer deletes what the layers under it hold with whiteouts: .wh.NAME
        # removes NAME, and .wh..wh..opq empties its directory.
        as_root sh -c '
            set -e
            rootfs="$1"; layer="$2"
            tar -tzf "$layer" | grep -E "(^|/)\.wh\." | while IFS= read -r whiteout; do
                directory="$rootfs/$(dirname "$whiteout")"
                name="$(basename "$whiteout")"
                if [ "$name" = .wh..wh..opq ]; then
                    find "$directory" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
                else
                    rm -rf "$directory/${name#.wh.}"
                fi
            done
            tar -xzf "$layer" -C "$rootfs" --no-same-owner --exclude=".wh.*"
        ' sh "$rootfs" "$download/layer.tar.gz"
    done
    rm -rf "$download"
    cp -L /etc/resolv.conf "$rootfs/etc/resolv.conf"
    mkdir -p "$rootfs$server/work"
    echo "$digest" > "$rootfs.digest"
}

write_config() {
    mkdir -p "$server/work"
    cp "$internal/build-server-action.sh" "$server/action.sh"
    cat > "$server/run-action" << EOF
#!/bin/sh
exec "$(unshare_path)" --map-user=0 --map-group=0 --map-groups=auto --mount --pid --fork --kill-child -- \\
    /bin/sh "$server/action.sh" "$server/rootfs" "$server/work" "\$@"
EOF
    chmod +x "$server/run-action"
    cat > "$server/nativelink.json5" << EOF
{
  stores: [
    {
      name: "AC",
      filesystem: {
        content_path: "$server/ac",
        temp_path: "$server/ac-tmp",
        eviction_policy: { max_bytes: 1000000000 },
      },
    },
    {
      name: "CAS",
      fast_slow: {
        fast: {
          filesystem: {
            content_path: "$server/cas",
            temp_path: "$server/cas-tmp",
            eviction_policy: { max_bytes: 10000000000 },
          },
        },
        slow: { noop: {} },
      },
    },
  ],
  schedulers: [
    {
      name: "MAIN",
      simple: {
        supported_platform_properties: {
          OSFamily: "ignore",
          "container-image": "ignore",
          "env-secrets": "ignore",
        },
      },
    },
  ],
  workers: [
    {
      local: {
        worker_api_endpoint: { uri: "grpc://$worker_address" },
        cas_fast_slow_store: "CAS",
        upload_action_result: { ac_store: "AC" },
        work_directory: "$server/work",
        entrypoint: "$server/run-action",
        max_inflight_tasks: $(nproc),
        platform_properties: {},
      },
    },
  ],
  servers: [
    {
      name: "public",
      listener: { http: { socket_address: "$address" } },
      services: {
        cas: [{ instance_name: "", cas_store: "CAS" }],
        ac: [{ instance_name: "", ac_store: "AC" }],
        execution: [{ instance_name: "", cas_store: "CAS", scheduler: "MAIN" }],
        capabilities: [{ instance_name: "", remote_execution: { scheduler: "MAIN" } }],
        bytestream: [{ instance_name: "", cas_store: "CAS" }],
      },
    },
    {
      name: "workers",
      listener: { http: { socket_address: "$worker_address" } },
      services: { worker_api: { scheduler: "MAIN" }, health: {} },
    },
  ],
  global: { max_open_files: 24576 },
}
EOF
}

running() {
    local pid
    pid="$(cat "$server/nativelink.pid" 2> /dev/null)" || return 1
    [[ "$(readlink "/proc/$pid/exe" 2> /dev/null)" == "$nativelink" ]]
}

stop_server() {
    if running; then
        kill "$(cat "$server/nativelink.pid")"
    fi
    rm -f "$server/nativelink.pid"
}

start_server() {
    ensure_user_namespaces
    ensure_nativelink
    mkdir -p "$server"
    ensure_rootfs
    end_step
    write_config
    if running && cmp -s "$server/nativelink.json5" "$server/nativelink.json5.running"; then
        return 0
    fi
    stop_server
    cp "$server/nativelink.json5" "$server/nativelink.json5.running"
    setsid "$nativelink" "$server/nativelink.json5" >> "$server/nativelink.log" 2>&1 < /dev/null &
    echo $! > "$server/nativelink.pid"
    local attempt
    for attempt in $(seq 100); do
        if (: < "/dev/tcp/${address%:*}/${address#*:}") 2> /dev/null; then
            echo "The build server is running on $address; its log is $server/nativelink.log." >&2
            return 0
        fi
        running || break
        read -r -t 0.1 < /dev/zero || true
    done
    tail -20 "$server/nativelink.log" >&2
    echo 'The build server did not start.' >&2
    exit 1
}

buck2_kill() {
    local buck2
    buck2="$(buck2_path)"
    [[ -x "$buck2" ]] && "$buck2" kill > /dev/null 2>&1 || true
}

point_buck_here() {
    local path="$repository/.buckconfig.local" config="$repository/target/buckconfig.local.partial"
    if [[ -f "$path" ]] && ! head -1 "$path" | grep -qF "$marker"; then
        echo '.buckconfig.local was written by someone else; move it aside first.' >&2
        exit 1
    fi
    {
        echo "$marker"
        echo '[buck2_re_client]'
        echo "action_cache_address = $address"
        echo "cas_address = $address"
        echo "engine_address = $address"
        echo 'tls = false'
    } > "$config"
    if cmp -s "$config" "$path"; then
        rm "$config"
    else
        mv -f "$config" "$path"
        buck2_kill
    fi
}

case "${1:-}" in
    start)
        point_buck_here
        start_server
        ;;
    ensure)
        running || start_server
        ;;
    stop)
        stop_server
        ;;
    off)
        stop_server
        if [[ -f .buckconfig.local ]] && head -1 .buckconfig.local | grep -qF "$marker"; then
            rm .buckconfig.local
            buck2_kill
        fi
        echo './scripts/buck builds on BuildBuddy again.' >&2
        ;;
    status)
        if running; then
            echo "running on $address"
        else
            echo 'stopped'
        fi
        ;;
    *)
        sed -n '/^# Usage:/,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
        exit 1
        ;;
esac
