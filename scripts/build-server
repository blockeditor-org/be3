#!/usr/bin/env bash
#
# Our remote execution server, which runs every buck2 action: one machine runs
# it behind Caddy at https://DOMAIN, and every machine, CI included, builds on
# it with the key. .buckconfig names the domain; guides/build_server.md says
# how to set up a new server.
#
# Usage:
#   ./scripts/build-server install DOMAIN
#   ./scripts/build-server status
#
# install sets the server up on this machine, using sudo, and can run again:
# it changes only what differs. The server is NativeLink (CAS, action cache,
# scheduler and one worker in one process), a systemd service running as the
# unprivileged user be3-build, with its cache in /var/lib/be3-build-server.
# Caddy terminates TLS and turns away any call without `Authorization: Bearer
# KEY`. Each action runs as root in the container image buck/tools/defs.bzl
# names, which is unpacked once and entered with a user namespace and chroot
# rather than Docker. The key is a shell on this machine as be3-build, so keep
# it to people who could have one.

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/internal/common.sh"
cd "$repository"

nativelink_version='1.7.3'
nativelink_sha256='5b35a3296d91c12eac6fd4253f52c8890dd0e3ea079ac3694aa8f2c524c80f0b'

service_user='be3-build'
server='/var/lib/be3-build-server'
nativelink="$server/nativelink-$nativelink_version/nativelink"
key_file='/etc/be3-build-server/key'
address='127.0.0.1:50052'
worker_address='127.0.0.1:50062'
caddy_site='/etc/caddy/Caddyfile'
caddy_marker='# @generated by ./scripts/build-server'

# Ubuntu lets only programs AppArmor names create user namespaces. This
# unshare is one: a copy of the system's, owned by root, which a profile
# allows them, so the permission reaches nothing else on the machine.
privileged_unshare='/usr/local/libexec/be3-build-server/unshare'
apparmor_profile='/etc/apparmor.d/be3-build-server'

action_loader_variables='LD_LIBRARY_PATH LD_PRELOAD LD_AUDIT'

unshare_path() {
    if [[ "$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns 2> /dev/null || echo 0)" == 1 ]]; then
        echo "$privileged_unshare"
    else
        command -v unshare
    fi
}

# Root in the namespace is be3-build outside it, and every group is one of its
# subordinate groups, so an action can chown a file to any group, as dpkg-deb
# does, and the server can still read and delete all it leaves.
as_service_root() {
    sudo -u "$service_user" "$(unshare_path)" --map-user=0 --map-group=0 --map-groups=auto "$@"
}

ensure_packages() {
    local missing=()
    [[ -x /bin/busybox ]] || missing+=(busybox-static)
    command -v newgidmap > /dev/null || missing+=(uidmap)
    command -v caddy > /dev/null || missing+=(caddy)
    if [[ ${#missing[@]} -gt 0 ]]; then
        step "Installing ${missing[*]}"
        sudo apt-get install -y "${missing[@]}"
    fi
}

ensure_service_user() {
    if ! id "$service_user" > /dev/null 2>&1; then
        step "Adding the user $service_user"
        sudo useradd --system --home-dir "$server" --create-home --shell /usr/sbin/nologin "$service_user"
    fi
    sudo mkdir -p "$server"
    sudo chown "$service_user:$service_user" "$server"
    if ! grep -q "^$service_user:" /etc/subgid; then
        local start
        start="$(awk -F: '{ end = $2 + $3; if (end > top) top = end } END { print (top > 100000 ? top : 100000) }' /etc/subgid)"
        sudo usermod --add-subgids "$start-$((start + 65535))" "$service_user"
    fi
}

ensure_user_namespaces() {
    if [[ "$(unshare_path)" == "$privileged_unshare" ]] &&
        ! { [[ -x "$privileged_unshare" ]] && cmp -s "$privileged_unshare" "$(command -v unshare)" && [[ -f "$apparmor_profile" ]]; }; then
        step 'Allowing the build server user namespaces'
        sudo install -D -o root -g root -m 0755 "$(command -v unshare)" "$privileged_unshare"
        printf '%s\n' \
            'abi <abi/4.0>,' \
            'include <tunables/global>' \
            '' \
            "profile be3-build-server $privileged_unshare flags=(unconfined) {" \
            '  userns,' \
            '}' | sudo tee "$apparmor_profile" > /dev/null
        sudo apparmor_parser -r "$apparmor_profile"
    fi
    if ! as_service_root true; then
        echo 'This machine does not allow the user namespace every action runs in.' >&2
        exit 1
    fi
}

ensure_nativelink() {
    sudo test -x "$nativelink" && return 0
    step "Installing NativeLink $nativelink_version"
    local archive
    archive="$(mktemp)"
    download_verified \
        "https://github.com/TraceMachina/nativelink/releases/download/v$nativelink_version/nativelink-$nativelink_version-x86_64-unknown-linux-musl.tar.gz" \
        "$archive" "$nativelink_sha256"
    sudo mkdir -p "$(dirname "$nativelink")"
    sudo tar -xzf "$archive" -C "$(dirname "$nativelink")" --no-same-owner nativelink
    rm "$archive"
}

# The image every action runs in, as buck/tools/defs.bzl pins it:
# an index digest, whose linux/amd64 manifest and layers are each checked
# against the digest that names them.
image_digest() {
    sed -n 's|.*"container-image": "docker://docker.io/[^@]*@\(sha256:[0-9a-f]*\)".*|\1|p' buck/tools/defs.bzl
}

image_repository() {
    sed -n 's|.*"container-image": "docker://docker.io/\([^@]*\)@sha256:.*|\1|p' buck/tools/defs.bzl
}

registry_fetch() {
    local token="$1" path="$2" digest="$3" destination="$4"
    curl --fail --location --silent --show-error --retry 4 \
        -H "Authorization: Bearer $token" \
        -H 'Accept: application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.v2+json' \
        --output "$destination" "https://registry-1.docker.io/v2/$(image_repository)/$path/$digest"
    if [[ "sha256:$(sha256_of "$destination")" != "$digest" ]]; then
        echo "The registry's $digest is not the file that digest names." >&2
        rm -f "$destination"
        exit 1
    fi
}

ensure_rootfs() {
    local digest rootfs="$server/rootfs"
    digest="$(image_digest)"
    [[ "$(sudo cat "$rootfs.digest" 2> /dev/null)" == "$digest" ]] && return 0
    step "Unpacking the workers' image $(image_repository)@$digest"
    local download token manifest layer
    download="$(mktemp -d)"
    chmod 755 "$download"
    token="$(curl --fail --silent --show-error "https://auth.docker.io/token?service=registry.docker.io&scope=repository:$(image_repository):pull" |
        python3 -c 'import json, sys; print(json.load(sys.stdin)["token"])')"
    registry_fetch "$token" manifests "$digest" "$download/index.json"
    manifest="$(python3 -c '
import json, sys
index = json.load(open(sys.argv[1]))
print(next(m["digest"] for m in index["manifests"] if m.get("platform") == {"architecture": "amd64", "os": "linux"}))
' "$download/index.json")"
    registry_fetch "$token" manifests "$manifest" "$download/manifest.json"

    if sudo test -d "$rootfs"; then
        as_service_root rm -rf "$rootfs"
    fi
    sudo -u "$service_user" mkdir -p "$rootfs"
    for layer in $(python3 -c 'import json, sys; print("\n".join(l["digest"] for l in json.load(open(sys.argv[1]))["layers"]))' "$download/manifest.json"); do
        registry_fetch "$token" blobs "$layer" "$download/layer.tar.gz"
        chmod 644 "$download/layer.tar.gz"
        # A layer deletes what the layers under it hold with whiteouts: .wh.NAME
        # removes NAME, and .wh..wh..opq empties its directory.
        as_service_root sh -c '
            set -e
            rootfs="$1"; layer="$2"
            tar -tzf "$layer" | grep -E "(^|/)\.wh\." | while IFS= read -r whiteout; do
                directory="$rootfs/$(dirname "$whiteout")"
                name="$(basename "$whiteout")"
                if [ "$name" = .wh..wh..opq ]; then
                    find "$directory" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
                else
                    rm -rf "$directory/${name#.wh.}"
                fi
            done
            tar -xzf "$layer" -C "$rootfs" --no-same-owner --exclude=".wh.*"
        ' sh "$rootfs" "$download/layer.tar.gz"
    done
    rm -rf "$download"
    sudo -u "$service_user" cp -L /etc/resolv.conf "$rootfs/etc/resolv.conf"
    sudo -u "$service_user" mkdir -p "$rootfs$server/work"
    echo "$digest" | sudo -u "$service_user" tee "$rootfs.digest" > /dev/null
}

# What changed among the files below, so that the service restarts only for a
# change, and buck2 forgets the blobs a restarted server may have evicted.
changed=false

install_file() {
    local destination="$1" mode="$2" owner="${3:-root:root}" staged
    staged="$(mktemp)"
    cat > "$staged"
    if ! sudo cmp -s "$staged" "$destination"; then
        sudo install -D -m "$mode" -o "${owner%:*}" -g "${owner#*:}" "$staged" "$destination"
        changed=true
    fi
    rm "$staged"
}

write_server_files() {
    sudo -u "$service_user" mkdir -p "$server/work"
    install_file "$server/action.sh" 0644 < "$internal/build-server-action.sh"

    # The action's environment arrives with it, and a test's LD_LIBRARY_PATH
    # names the sysroot's glibc, which no program on the way into the image
    # can load. So the first is static, and puts LD_* aside until the action.
    install_file "$server/run-action" 0755 << EOF
#!/bin/busybox sh
for name in $action_loader_variables; do
    eval "if [ -n \"\\\${\$name+x}\" ]; then export BE3_ACTION_\$name=\"\\\$\$name\"; unset \$name; fi"
done
exec "$(unshare_path)" --map-user=0 --map-group=0 --map-groups=auto --mount --pid --fork --kill-child -- \\
    /bin/sh "$server/action.sh" "$server/rootfs" "$server/work" "\$@"
EOF

    install_file "$server/nativelink.json5" 0644 << EOF
{
  stores: [
    {
      name: "CAS",
      fast_slow: {
        fast: {
          filesystem: {
            content_path: "$server/cas",
            temp_path: "$server/cas-tmp",
            eviction_policy: { max_bytes: 35000000000 },
          },
        },
        slow: { noop: {} },
      },
    },
    // A cached result whose outputs the CAS has since evicted is a miss
    // rather than an action buck2 cannot download.
    {
      name: "AC",
      completeness_checking: {
        backend: {
          filesystem: {
            content_path: "$server/ac",
            temp_path: "$server/ac-tmp",
            eviction_policy: { max_bytes: 1000000000 },
          },
        },
        cas_store: { ref_store: { name: "CAS" } },
      },
    },
  ],
  schedulers: [
    {
      name: "MAIN",
      simple: {
        supported_platform_properties: {
          OSFamily: "ignore",
          "container-image": "ignore",
        },
      },
    },
  ],
  workers: [
    {
      local: {
        worker_api_endpoint: { uri: "grpc://$worker_address" },
        cas_fast_slow_store: "CAS",
        upload_action_result: { ac_store: "AC" },
        work_directory: "$server/work",
        entrypoint: "$server/run-action",
        max_inflight_tasks: $(nproc),
        platform_properties: {},
      },
    },
  ],
  servers: [
    {
      name: "public",
      listener: { http: { socket_address: "$address" } },
      services: {
        cas: [{ instance_name: "", cas_store: "CAS" }],
        ac: [{ instance_name: "", ac_store: "AC" }],
        execution: [{ instance_name: "", cas_store: "CAS", scheduler: "MAIN" }],
        capabilities: [{ instance_name: "", remote_execution: { scheduler: "MAIN" } }],
        bytestream: [{ instance_name: "", cas_store: "CAS" }],
      },
    },
    {
      name: "workers",
      listener: { http: { socket_address: "$worker_address" } },
      services: { worker_api: { scheduler: "MAIN" }, health: {} },
    },
  ],
  global: { max_open_files: 24576 },
}
EOF

    install_file /etc/systemd/system/be3-build-server.service 0644 << EOF
[Unit]
Description=be3's remote execution server (./scripts/build-server)
After=network.target

[Service]
User=$service_user
ExecStart=$nativelink $server/nativelink.json5
Restart=on-failure
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
EOF
}

ensure_key() {
    if ! sudo test -s "$key_file"; then
        sudo install -d -m 0700 "$(dirname "$key_file")"
        head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' | sudo tee "$key_file" > /dev/null
        sudo chmod 600 "$key_file"
    fi
}

# Caddy's whole site is the server. A call without the key is answered the
# way a gRPC server refuses one, so buck2 says why rather than what HTTP
# status it did not expect.
write_caddy_site() {
    local domain="$1" key
    key="$(sudo cat "$key_file")"
    if sudo test -f "$caddy_site" && ! sudo head -1 "$caddy_site" | grep -qF "$caddy_marker" &&
        ! sudo test -e "$caddy_site.before-build-server"; then
        sudo cp "$caddy_site" "$caddy_site.before-build-server"
        echo "Caddy's old configuration is in $caddy_site.before-build-server." >&2
    fi
    local before="$changed"
    changed=false
    install_file "$caddy_site" 0640 << EOF
$caddy_marker install $domain
$domain {
	@authorized header Authorization "Bearer $key"
	handle @authorized {
		reverse_proxy h2c://$address {
			flush_interval -1
		}
	}
	handle {
		header Content-Type application/grpc
		header Grpc-Status 16
		header Grpc-Message "This build server needs its key: guides/build_server.md"
		respond 200
	}
}
EOF
    sudo chgrp caddy "$caddy_site"
    sudo systemctl enable --quiet caddy
    if $changed || ! systemctl is-active --quiet caddy; then
        sudo systemctl restart caddy
    fi
    changed="$before"
}

install_server() {
    local domain="$1"
    ensure_packages
    ensure_service_user
    ensure_user_namespaces
    ensure_nativelink
    ensure_rootfs
    end_step
    write_server_files
    ensure_key
    sudo systemctl daemon-reload
    sudo systemctl enable --quiet be3-build-server
    if $changed || ! systemctl is-active --quiet be3-build-server; then
        sudo systemctl restart be3-build-server
    fi
    write_caddy_site "$domain"
    echo "The build server is running; its log is journalctl -u be3-build-server." >&2

    # This machine builds on it too, with the key where ./scripts/buck looks.
    local saved="${XDG_CONFIG_HOME:-$HOME/.config}/be3/build-server-key"
    mkdir -p "$(dirname "$saved")"
    (umask 077 && sudo cat "$key_file" > "$saved")
    echo "Its key is in $key_file, and in $saved for this user." >&2
    if [[ "$(build_server_host)" != "$domain" ]]; then
        echo "Point .buckconfig's [buck2_re_client] addresses at $domain:443 so builds use it." >&2
    fi
}

case "${1:-}" in
    install)
        if [[ -z "${2:-}" || -n "${3:-}" ]]; then
            echo 'Usage: ./scripts/build-server install DOMAIN' >&2
            exit 1
        fi
        install_server "$2"
        ;;
    status)
        echo "./scripts/buck builds on $(build_server_host)."
        if systemctl list-unit-files be3-build-server.service > /dev/null 2>&1; then
            echo "This machine's server is $(systemctl is-active be3-build-server)."
        fi
        ;;
    *)
        sed -n '/^# Usage:/,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
        exit 1
        ;;
esac
