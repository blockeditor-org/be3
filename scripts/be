#!/usr/bin/env bash
#
# The tracker's command line tool (guides/tracker.md), as the release pinned in
# scripts/internal/common.sh, which is built from the same commit as the server
# the tracker lives on. Arguments go to be unchanged.
#
# The credentials are read from external/.tracker-credentials, which git
# ignores and ./scripts/setup fetches, and handed to this one process as the BE3_*
# variables be reads. be itself never reads that file, so a be built from a
# checkout to test a change cannot reach the real server by accident; point
# one of those at a dev server with the BE3_* variables instead. The file holds
# one KEY=VALUE per line:
#
#   server=https://blocks.pfg.pw
#   workspace=<the tracker workspace's id>
#   token=<the agent's token>
#   recovery_phrase=<the agent's recovery phrase>
#   authorization=<an Authorization header a gateway in front of the server wants>
#
# Usage:
#   ./scripts/be ls
#   ./scripts/be BE-7K3Q2M

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/internal/common.sh"

credentials="$repository/external/.tracker-credentials"
if [[ ! -f "$credentials" ]]; then
    echo "No tracker credentials at $credentials." >&2
    echo 'An administrator adds an agent from the app menu (Agents), and the four values it' >&2
    echo 'shows go there as server=, workspace=, token= and recovery_phrase= lines.' >&2
    exit 1
fi

server='' workspace='' token='' recovery_phrase='' authorization=''
while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ -z "${line//[[:space:]]/}" || "$line" == \#* ]] && continue
    key="${line%%=*}"
    value="${line#*=}"
    case "$key" in
        server) server="$value" ;;
        workspace) workspace="$value" ;;
        token) token="$value" ;;
        recovery_phrase) recovery_phrase="$value" ;;
        authorization) authorization="$value" ;;
        *)
            echo "$credentials has a line for $key, which is not server, workspace, token, recovery_phrase or authorization." >&2
            exit 1
            ;;
    esac
done < "$credentials"

if [[ -z "$token" || -z "$recovery_phrase" ]]; then
    echo "$credentials needs token= and recovery_phrase= lines." >&2
    exit 1
fi

be="$(be_path)"
if [[ -z "$be_release" ]]; then
    echo 'No be release is pinned yet (be_release in scripts/internal/common.sh).' >&2
    exit 1
fi
if [[ ! -x "$be" || ! -f "$(dirname "$be")/build-id" ]]; then
    "$internal/install-be.sh" >&2
fi

exec env -u BE3_SERVER -u BE3_WORKSPACE -u BE3_TOKEN -u BE3_RECOVERY_PHRASE -u BE3_AUTHORIZATION \
    ${server:+BE3_SERVER="$server"} \
    ${workspace:+BE3_WORKSPACE="$workspace"} \
    ${authorization:+BE3_AUTHORIZATION="$authorization"} \
    BE3_TOKEN="$token" \
    BE3_RECOVERY_PHRASE="$recovery_phrase" \
    "$be" "$@"
