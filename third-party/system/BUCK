# System libraries, named so that a third-party crate that needs one can depend
# on it rather than on a flag somewhere in the toolchain.

# What the C++ a build script compiles for wasm needs at the link beyond the
# -lc++ cc-rs names: the WASI sysroot's no-exceptions libc++ and its ABI
# library, since the wasm C++ is compiled with -fno-exceptions, and libsetjmp
# for FreeType. Everywhere else the runtime cc-rs names is all there is.
prebuilt_cxx_library(
    name = "stdc++",
    exported_linker_flags = select({
        "DEFAULT": [],
        "prelude//os:wasi": [
            "-L$(location root//third-party/wasi:sysroot)/lib/wasm32-wasip1-threads/noeh",
            "-lc++abi",
            "$(location root//third-party/wasi:sysroot)/lib/wasm32-wasip1-threads/libsetjmp.a",
        ],
    }),
    visibility = ["PUBLIC"],
)
