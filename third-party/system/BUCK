# System libraries, named so that a third-party crate that needs
# one can depend on it rather than on a flag somewhere in the toolchain.

# harfbuzz and the embedded browser are C++; a Rust binary linking them brings
# no C++ runtime of its own.
#
# On wasm there is no machine to take one from, so it comes out of the same WASI
# sysroot the C was compiled against - the noeh variant, because the wasm build
# compiles with -fno-exceptions. libsetjmp is beside it and is what FreeType's
# setjmp lowering resolves against; the cargo build adds both through RUSTFLAGS
# in scripts/internal/common.sh.
prebuilt_cxx_library(
    name = "stdc++",
    exported_linker_flags = select({
        "DEFAULT": ["-lstdc++"],
        "prelude//os:macos": ["-lc++"],
        "prelude//os:wasi": [
            "-L$(location root//third-party/wasi:sysroot)/lib/wasm32-wasip1-threads/noeh",
            "-lc++",
            "-lc++abi",
            "$(location root//third-party/wasi:sysroot)/lib/wasm32-wasip1-threads/libsetjmp.a",
        ],
        # MSVC's objects name the C++ runtime they need themselves.
        "prelude//os:windows": [],
    }),
    visibility = ["PUBLIC"],
)
