load(":sources.bzl", "libraries", "repositories")

# PDFium, which the PDF plugin renders pages with, built from source for the
# plugins' platform like the rest of their C and C++, so it is position-
# independent and the plugin links against the plugin SDK. sources.bzl is
# PDFium's GN build read into data, from `./scripts/buck run //:pdfium --
# REVISION` (crates/buck-tools/src/pdfium.rs): the repositories PDFium's DEPS
# pins, and one library per GN target under //:pdfium that compiles anything,
# with its sources, defines and include directories. Everything else about how
# they compile is the plugins' toolchain's.
#
# Googlesource makes its tarballs afresh on every download, so no hash can pin
# them: :source fetches each repository by commit on a worker, the one action
# here that needs the network, and keeps only what compiles or is included.

_KEPT = ["c", "cc", "cpp", "def", "h", "hh", "hpp", "inc", "inl", "ipp"]

genrule(
    name = "source",
    cmd = """
        set -eu
        fetch() {
            mkdir -p "$OUT/$1"
            git -C "$OUT/$1" init --quiet
            for attempt in 1 2 3; do
                if git -C "$OUT/$1" fetch --quiet --depth 1 "$2" "$3"; then
                    git -C "$OUT/$1" checkout --quiet FETCH_HEAD
                    rm -rf "$OUT/$1/.git"
                    return
                fi
                sleep "$attempt"
            done
            echo "could not fetch $2 at $3" >&2
            exit 1
        }
    """
    + "".join(["fetch './{}' '{}' '{}'\n".format(path, repository["url"], repository["commit"]) for path, repository in repositories.items()])
    + """
        find "$OUT" -type f ! \\( {} \\) -delete
        find "$OUT" -type d -empty -delete
    """.format(" -o ".join(["-name '*.{}'".format(extension) for extension in _KEPT])),
    default_outs = ["."],
    outs = {source: [source] for library in libraries.values() for source in library["srcs"]},
)

# What WASI lacks that PDFium's dependencies reach for: mmap and signals, which
# wasi-libc emulates, and ICU's time zone globals.
_WASI_FLAGS = [
    "-D_WASI_EMULATED_MMAN",
    "-D_WASI_EMULATED_SIGNAL",
    "-DU_HAVE_TZSET=0",
    "-DU_HAVE_TIMEZONE=0",
    "-DU_HAVE_TZNAME=0",
]

[
    cxx_library(
        name = name,
        lang_compiler_flags = {
            "c_cpp_output": library["c_flags"],
            "cxx_cpp_output": library["cxx_flags"],
        },
        preferred_linkage = "static",
        preprocessor_flags = _WASI_FLAGS
        + ["-D" + define for define in library["defines"]]
        + ["-I$(location :source)" + ("/" + directory if directory else "") for directory in library["include_dirs"]],
        srcs = [":source[{}]".format(source) for source in library["srcs"]],
        target_compatible_with = ["prelude//os/constraints:os[wasi]"],
    )
    for name, library in libraries.items()
]

cxx_library(
    name = "pdfium",
    exported_deps = [":" + name for name in libraries] + ["root//third-party/system:stdc++"],
    exported_linker_flags = ["-lc++"]
    + [
        "$(location root//third-party/wasi:sysroot)/lib/wasm32-wasip1-threads/libwasi-emulated-{}.a".format(library) for library in ["getpid", "mman", "signal"]
    ],
    preferred_linkage = "static",
    target_compatible_with = ["prelude//os/constraints:os[wasi]"],
    visibility = ["PUBLIC"],
)
