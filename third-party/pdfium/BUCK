load("@root//buck/dev:verify.bzl", "package_fix")
load("@root//buck/tools:defs.bzl", "configured_once")
load(":sources.bzl", "libraries", "repositories")

# PDFium, which the PDF app renders pages with, built from source for the
# apps' platform like the rest of their C and C++, so it is position-
# independent and the app links against the app SDK. sources.bzl is
# PDFium's GN build read into data, from `./scripts/buck run //:pdfium --
# REVISION` (crates/be-tool-buck/src/pdfium.rs): the repositories PDFium's DEPS
# pins, and one library per GN target under //:pdfium that compiles anything,
# with its sources, defines and include directories. Everything else about how
# they compile is the apps' toolchain's.
#
# Each repository is a GitHub archive of its commit, pinned by hash and size
# (pdfium.rs says why GitHub's), and :source lays them out as PDFium's
# checkout does, keeping only what compiles or is included. Both are configured
# once: every configuration that builds PDFium reads the same files.
_KEPT = ["c", "cc", "cpp", "def", "h", "hh", "hpp", "inc", "inl", "ipp"]

_ARCHIVES = {path: "archive-" + (path.replace("/", "-") if path else "pdfium") for path in repositories}

[
    configured_once(
        http_archive,
        name = _ARCHIVES[path],
        sha256 = repository["sha256"],
        size_bytes = repository["size_bytes"],
        strip_prefix = repository["strip_prefix"],
        urls = [repository["archive"]],
    )
    for path, repository in repositories.items()
]

configured_once(
    genrule,
    name = "source",
    cmd = """
        set -eu
        lay() {
            mkdir -p "$OUT/$2"
            (cd "$1" && find . -type f \\( %s \\) -print0 | tar --null -cf - -T -) | tar -xf - -C "$OUT/$2"
        }
    """
    % " -o ".join(["-name '*.{}'".format(extension) for extension in _KEPT])
    + "".join(["lay $(location :{}) './{}'\n".format(_ARCHIVES[path], path) for path in repositories]),
    default_outs = ["."],
    outs = {source: [source] for library in libraries.values() for source in library["srcs"]},
)

# What WASI lacks that PDFium's dependencies reach for: mmap and signals, which
# wasi-libc emulates, and ICU's time zone globals.
_WASI_FLAGS = [
    "-D_WASI_EMULATED_MMAN",
    "-D_WASI_EMULATED_SIGNAL",
    "-DU_HAVE_TZSET=0",
    "-DU_HAVE_TIMEZONE=0",
    "-DU_HAVE_TZNAME=0",
]

[
    cxx_library(
        name = name,
        lang_compiler_flags = {
            "c_cpp_output": library["c_flags"],
            "cxx_cpp_output": library["cxx_flags"],
        },
        preferred_linkage = "static",
        preprocessor_flags = _WASI_FLAGS
        + ["-D" + define for define in library["defines"]]
        + ["-I$(location :source)" + ("/" + directory if directory else "") for directory in library["include_dirs"]],
        srcs = [":source[{}]".format(source) for source in library["srcs"]],
        target_compatible_with = ["prelude//os/constraints:os[wasi]"],
    )
    for name, library in libraries.items()
]

cxx_library(
    name = "pdfium",
    exported_deps = [":" + name for name in libraries] + ["root//third-party/system:stdc++"],
    exported_linker_flags = ["-lc++"]
    + [
        "$(location root//third-party/wasi:sysroot)/lib/wasm32-wasip1-threads/libwasi-emulated-{}.a".format(library) for library in ["getpid", "mman", "signal"]
    ],
    preferred_linkage = "static",
    target_compatible_with = ["prelude//os/constraints:os[wasi]"],
)

package_fix()
