load("//bazel/tools:defs.bzl", "fetch_archive")

exports_files(
    ["sign.sh"],
    visibility = ["//visibility:public"],
)

# What an APK is made with, pinned by hash: a JDK (javac, d8, apksigner), the
# SDK build tools (aapt2, zipalign), the platform (android.jar) and the
# platform tools (adb, for installing).
JDK_VERSION = "21.0.12.1+1"

fetch_archive(
    name = "jdk",
    sha256 = "ce79869e1307ed8ee1e2baa86a412b1eb5b75d10a01006d788a6f968bcfaee94",
    strip_prefix = "jdk-" + JDK_VERSION,
    url = "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-{}/OpenJDK21U-jdk_x64_linux_hotspot_{}.tar.gz".format(
        JDK_VERSION.replace("+", "%2B"),
        JDK_VERSION.replace("+", "_"),
    ),
    visibility = ["//visibility:public"],
)

fetch_archive(
    name = "build-tools",
    sha256 = "bd3a4966912eb8b30ed0d00b0cda6b6543b949d5ffe00bea54c04c81e1561d88",
    strip_prefix = "android-15",
    url = "https://dl.google.com/android/repository/build-tools_r35_linux.zip",
    visibility = ["//visibility:public"],
)

fetch_archive(
    name = "platform",
    sha256 = "0988cacad01b38a18a47bac14a0695f246bc76c1b06c0eeb8eb0dc825ab0c8e0",
    strip_prefix = "android-35",
    url = "https://dl.google.com/android/repository/platform-35_r02.zip",
    visibility = ["//visibility:public"],
)

fetch_archive(
    name = "platform-tools",
    sha256 = "d230f13842f60f782a8645f9c813f8f845bf36089ea7289f28c48f17979313f1",
    strip_prefix = "platform-tools",
    url = "https://dl.google.com/android/repository/platform-tools_r37.0.1-linux.zip",
    visibility = ["//visibility:public"],
)
