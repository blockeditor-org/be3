load("@root//buck/cargo:defs.bzl", "cargo_library", "cargo_package", "cargo_test")
load("@root//buck/platforms:cross.bzl", "cross_triple", "per_cross_platform")
load("@root//buck/tools:defs.bzl", "configured_once")

cargo_package()

# Zig 0.17.1, the release Ghostty's build.zig.zon asks for: Zig breaks its
# build API between releases.
configured_once(
    http_archive,
    name = "zig",
    sha256 = "3581863e3cbcfd0fce0efc682ce7e9e93da96668a977791d356a26d2a7e9b17a",
    size_bytes = 57411036,
    strip_prefix = "zig-x86_64-linux-0.17.1",
    urls = ["https://ziglang.org/download/0.17.1/zig-x86_64-linux-0.17.1.tar.xz"],
)

# Ghostty's source, at the commit libghostty-vt is built from: GitHub's
# archive of it (github.com/ghostty-org/ghostty/archive/COMMIT.tar.gz),
# mirrored to lfs.pfg.pw because cloud sessions cannot fetch GitHub archives,
# and http_file takes a single URL. To pick up a newer terminal emulator, ask
# the maintainer to upload the new commit's GitHub archive to
# lfs.pfg.pw/by-name/be3/zig/ first (agents cannot upload there), then bump
# this and the hash and size below.
ghostty_commit = "7a8ff4d992edd2aad7537e5bef73ec911aa126bf"

configured_once(
    http_file,
    name = "ghostty.tar.gz",
    out = "ghostty.tar.gz",
    sha256 = "45fa2695920d1e513d4c070b7424c3de7e28e9d0d257d1ebb824c431866011ce",
    size_bytes = 40275030,
    urls = ["https://lfs.pfg.pw/by-name/be3/zig/ghostty-{}.tar.gz".format(ghostty_commit)],
)

# The Zig packages that build asks for, for every platform here, each pinned by
# the hash of the bytes at its URL (its .zon manifest pins it again by its
# contents): Ghostty's deps/libghostty-vt.txt lists them, less highway, which
# only the SIMD build this one turns off reads. Each is named after its URL's
# basename, which is how the build finds its Zig hash in deps/packages.json. A
# newer Ghostty that asks for another fails its build naming the package.
zig_packages = [
    (
        "https://deps.files.ghostty.org/aro-d0c8c4d9c55daa7ef6e40cf0f630a5b5e900989b.tar.gz",
        "cbe70387fdec7ba9bdaea4c28f1ea4a09a771eec03fd8165bff1f9ae9f604daa",
        459925,
    ),
    (
        "https://deps.files.ghostty.org/translate_c-02ff0c523fb92a38939b04d0145c4a9602a74d56.tar.gz",
        "e344433bcce14759529e58ea600e67d7c39846b1775b122f88db7cb4dad58591",
        155199,
    ),
    (
        "https://deps.files.ghostty.org/uucode-1fb73433bba5d93366c57f23ff2e9d7939746500.tar.gz",
        "9e574f5b72c07f426eb31e2604860f22ba0fc5f9ccb44ef44e3212a5e9001828",
        2237452,
    ),
    (
        "https://deps.files.ghostty.org/wuffs-7411f488fe2e2c205c3d3b3d28638b7356522930.tar.gz",
        "17877d346f7988651d6c62e45b2e3b05c86809a6442c5e34612374b2a9719a1c",
        771698,
    ),
]

zig_package_names = [url.split("/")[-1] for url, _, _ in zig_packages]

[
    configured_once(
        http_file,
        name = "zig-package-" + name,
        out = name,
        sha256 = sha256,
        size_bytes = size_bytes,
        urls = [url],
    )
    for name, (url, sha256, size_bytes) in zip(zig_package_names, zig_packages)
]

# libghostty-vt, be-launcher's terminal emulator: Zig, built by
# scripts/internal/build-ghostty-vt.sh from the downloads above, with no
# network. Zig cross-compiles, so every platform's archive comes from the same
# worker; Windows gets buck/tools' MSVC runtime and SDK through a libc file,
# and Android buck/tools' NDK.
genrule(
    name = "libghostty-vt.a",
    cmd = "triple="
    + per_cross_platform(
        "x86_64-unknown-linux-gnu",
        cross_triple,
        {"root//buck/platforms:wasi_guest_setting": "wasm32-wasip1"},
    )
    + "\nwindows_sdk="
    + per_cross_platform(
        "",
        lambda name: (
            "$(location //buck/tools:windows-sdk-{})".format("aarch64" if name == "windows_arm64" else "x86_64") if name.startswith("windows") else None
        ),
    )
    + "\nandroid_ndk="
    + per_cross_platform("", lambda name: "$(location //buck/tools:android-ndk)" if name.startswith("android") else None)
    + """
        set -eu
        PATH="`cd $(location :zig) && pwd`:$PATH"
        export PATH
        if [ -n "$android_ndk" ]; then
            ANDROID_NDK_HOME="$TMP/ndk"
            export ANDROID_NDK_HOME
            mkdir -p "$ANDROID_NDK_HOME/toolchains/llvm/prebuilt/linux-x86_64"
            ln -s "`cd "$android_ndk" && pwd`/sysroot" "$ANDROID_NDK_HOME/toolchains/llvm/prebuilt/linux-x86_64/sysroot"
        fi
        if [ -n "$windows_sdk" ]; then
            sdk=`cd "$windows_sdk" && pwd`
            arch="${triple%%-*}"
            GHOSTTY_ZIG_LIBC="$TMP/libc.txt"
            export GHOSTTY_ZIG_LIBC
            {
                echo "include_dir=$sdk/sdk/include/ucrt"
                echo "sys_include_dir=$sdk/crt/include"
                echo "crt_dir=$sdk/sdk/lib/ucrt/$arch"
                echo "msvc_lib_dir=$sdk/crt/lib/$arch"
                echo "kernel32_lib_dir=$sdk/sdk/lib/um/$arch"
                # Zig 0.17 also checks the file against the host, Linux,
                # which must name a cc_dir. Nothing in this build reads it:
                # the build runner and the tools it runs on Linux link no
                # libc, so any existing directory serves as a placeholder.
                echo "cc_dir=$sdk/crt/lib/$arch"
                echo "darwin_sdk_dir="
            } > "$GHOSTTY_ZIG_LIBC"
        fi
        bash $(location //scripts/internal:build-ghostty-vt.sh) --triple "$triple" \\
            --source $(location :ghostty.tar.gz) \\
            --patch $(location //scripts/internal:ghostty-vt.patch) \\
            --out "$OUT" \\
    """
    + " ".join(["$(location :zig-package-{})".format(name) for name in zig_package_names]),
    out = "libghostty-vt.a",
)

prebuilt_cxx_library(
    name = "libghostty-vt",
    preferred_linkage = "static",
    static_lib = ":libghostty-vt.a",
)

cargo_library(extra_deps = [":libghostty-vt"])

cargo_test(extra_deps = [":libghostty-vt"])
