load("@root//buck/wasm:defs.bzl", "wasm32_module")

# The rules of one game, twice: once as a WebAssembly module, which is the only
# form the app ever loads, and once natively so the tests can drive it through
# the host. Cargo builds the module from a build script that shells out to a
# second cargo; here it is a target, and the test names it as a dependency.
rust_library(
    name = "tic_tac_toe",
    crate = "tic_tac_toe",
    crate_root = "src/lib.rs",
    deps = [
        "//crates/tabletop_games/api:game-api",
        "//third-party/rust:uuid",
    ],
    edition = "2024",
    env = {
        "CARGO_CRATE_NAME": "tic_tac_toe",
        "CARGO_MANIFEST_DIR": "crates/tabletop_games/rules/tic_tac_toe",
        "CARGO_PKG_NAME": "tic_tac_toe",
        "CARGO_PKG_VERSION": "0.1.0",
    },
    srcs = glob(["src/**/*.rs"]),
    visibility = ["PUBLIC"],
)

# The module the host loads. It is only ever built for wasm32, which is what
# target_compatible_with says: asking for it on the host is a configuration
# error rather than a link failure.
rust_library(
    name = "tic_tac_toe_wasm",
    crate = "tic_tac_toe",
    crate_root = "src/lib.rs",
    deps = [
        "//crates/tabletop_games/api:game-api",
        "//third-party/rust:uuid",
    ],
    edition = "2024",
    env = {
        "CARGO_CRATE_NAME": "tic_tac_toe",
        "CARGO_MANIFEST_DIR": "crates/tabletop_games/rules/tic_tac_toe",
        "CARGO_PKG_NAME": "tic_tac_toe",
        "CARGO_PKG_VERSION": "0.1.0",
    },
    preferred_linkage = "shared",
    srcs = glob(["src/**/*.rs"]),
    target_compatible_with = ["prelude//cpu/constraints:cpu[wasm32]"],
    visibility = ["PUBLIC"],
)

# The module as the host loads it, built for wasm32 whatever the thing asking
# for it is built for.
wasm32_module(
    name = "module",
    library = ":tic_tac_toe_wasm",
    visibility = ["PUBLIC"],
)

# The rules driven through the host, which is what the tests do. GAME_WASM is
# the module above: under cargo a build script compiles it with a second cargo
# call and prints where it landed, and here it is named as a dependency.
rust_test(
    name = "test",
    crate = "tic_tac_toe",
    crate_root = "src/lib.rs",
    deps = [
        "//crates/tabletop_games/api:game-api",
        "//crates/tabletop_games/host:game-host",
        "//third-party/rust:bincode",
        "//third-party/rust:uuid",
    ],
    edition = "2024",
    env = {
        "CARGO_CRATE_NAME": "tic_tac_toe",
        "CARGO_MANIFEST_DIR": "crates/tabletop_games/rules/tic_tac_toe",
        "CARGO_PKG_NAME": "tic_tac_toe",
        "CARGO_PKG_VERSION": "0.1.0",
        "GAME_WASM": "$(location :module)",
    },
    srcs = glob(["src/**/*.rs"]),
)
