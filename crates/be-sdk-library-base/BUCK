load("@root//buck/cargo:defs.bzl", "cargo_package")
load("@root//buck/wasm:defs.bzl", "wasm_library")

cargo_package()

# The root of every Rust app's closure (guides/app_libraries.md): std,
# wasi-libc, wgpu and the framework-neutral editor crates. It holds the C++
# runtime and setjmp too, though nothing in it uses them, so that every C and
# C++ library above it (beui's FreeType and HarfBuzz, an app's PDFium) shares
# one copy: libc++ and libc++abi whole (WHOLE_LIBRARIES in crates/be-wasm-link),
# and setjmp's three functions, the ones LLVM's -wasm-enable-sjlj calls.
_sysroot = "$(location root//third-party/wasi:sysroot)/lib/wasm32-wasip1-threads"

wasm_library(
    module = "base",
    rustc_flags = [
        "-Clink-arg=-L{}/noeh".format(_sysroot),
        "-Clink-arg=-lc++",
        "-Clink-arg=-lc++abi",
        "-Clink-arg={}/libsetjmp.a".format(_sysroot),
        "-Clink-arg=--undefined=__wasm_setjmp",
        "-Clink-arg=--undefined=__wasm_setjmp_test",
        "-Clink-arg=--undefined=__wasm_longjmp",
    ],
)
