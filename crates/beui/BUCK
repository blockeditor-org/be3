load("@root//buck/cargo:defs.bzl", "cargo_library", "cargo_test")

beui_srcs = glob(["src/**/*.rs", "assets/**/*", "examples/**/*.rs", "src/**/*.wgsl"])

cargo_library(srcs = beui_srcs)

cargo_test(
    # The renderer's tests draw through a real graphics adapter, and a remote
    # worker's container has none, so these stay on the machine that asked.
    remote_execution = "disabled",
    srcs = beui_srcs,
)
