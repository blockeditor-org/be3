        ],
    }),
    edition = "2024",
    env = {
        "CARGO_CRATE_NAME": "beui",
        "CARGO_MANIFEST_DIR": "crates/beui",
        "CARGO_PKG_NAME": "beui",
        "CARGO_PKG_VERSION": "0.1.0",
    },
    features = select({
        "DEFAULT": [
            "default",
            "render",
            "window",
        ],
        "prelude//cpu:wasm32": ["render"],
    }),
    srcs = glob(["src/**/*.rs", "assets/**/*", "examples/**/*.rs", "src/**/*.wgsl"]),
    visibility = ["PUBLIC"],
)

