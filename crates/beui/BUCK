load("@root//buck/cargo:defs.bzl", "cargo_example", "cargo_library", "cargo_test")

beui_srcs = glob(["src/**/*.rs", "examples/**/*.rs"])

cargo_library(srcs = beui_srcs)

cargo_test(srcs = beui_srcs)

# The examples: `./scripts/buck run //crates/beui:<example>-example`.

cargo_example("demo", srcs = beui_srcs)

cargo_example("survey", srcs = beui_srcs)

# The demo for crates/beui-web-demo, which shows it in a browser drawn with DOM
# elements, and for crates/beui-demo-snapshots, which paints its pages.
export_file(
    name = "demo.rs",
    src = "examples/demo.rs",
    visibility = [
        "//crates/beui-demo-snapshots:",
        "//crates/beui-web-demo:",
    ],
)
