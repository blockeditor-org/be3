  "document": [
    "<!doctype html>",
    "<html>",
    "<head>",
    "<meta charset=\"utf-8\">",
    "<style>",
    ".beui-root { display: grid; grid-template-columns: minmax(0, 1fr); width: 100%; min-height: 100%; }\n.beui-root, .beui-root * { box-sizing: border-box; margin: 0; }\n.beui-break::after { content: \"\\A\"; white-space: pre; }\n.beui-glyph { position: relative; }\n.beui-glyph::before { content: attr(data-glyph); position: absolute; top: 0; left: 0; right: 0; display: flex; justify-content: center; white-space: pre; line-height: normal; font: var(--beui-glyph-font); color: var(--beui-glyph-color); pointer-events: none; }\n.beui-text-decor { position: absolute; inset: 0; pointer-events: none; }\n.beui-text-decor >",
    " * { position: absolute; }\n.beui-mark { z-index: -1; }\n.beui-caret-blink { animation: beui-caret-blink 1060ms steps(1, end) infinite; }\n@keyframes beui-caret-blink { 50% { opacity: 0; } }\n@media (prefers-reduced-motion: reduce) { .beui-caret-blink { animation: none; } }\n.beui-layers >",
    " * + * { pointer-events: none; }\n.beui-stand-in { outline: 2px dashed #ff69b4; outline-offset: -2px; }\n.beui-overlay { position: fixed; inset: auto; margin: 0; padding: 0; border: 0; background: transparent; color: inherit; pointer-events: auto; max-width: none; max-height: none; overflow: visible; }\n.beui-overlay::backdrop { background: var(--beui-scrim, transparent); }\n.beui-beak { position: absolute; z-index: -1; width: var(--beui-beak); height: var(--beui-beak); top: calc(var(--beui-beak) / -2); left: calc(50% - var(--beui-beak) / 2); transform: rotate(45deg); }\n.beui-beak[hidden] { display: none; }\n@container anchored(fallback: flip-block) { .beui-beak { top: auto; bottom: calc(var(--beui-beak) / -2); } }\nbody { margin: 0; height: 100vh; font: 14px sans-serif; }</style>",
    "</head>",
    "<body>",
    "<div class=\"beui-root\" style=\"background-color: #0e1117;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); padding: 12px 12px 12px 12px; justify-items: stretch; align-items: stretch;\">",
    "<div style=\"display: flex; flex-direction: column; align-items: stretch; gap: 8px;\">",
    "<div style=\"display: flex; flex-direction: row; align-items: stretch; gap: 6px; flex: 0 0 auto;\">",
    "<div style=\"display: flex; flex-direction: column; align-items: stretch; pointer-events: auto; cursor: pointer; flex: 0 0 auto;\" tabindex=\"0\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); justify-items: stretch; align-items: stretch; border-radius: 8px 8px 8px 8px; flex: 0 0 auto;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); padding: 8px 16px 8px 16px; justify-items: stretch; align-items: stretch; background-color: #5289ff; border-radius: 6px 6px 6px 6px;\">",
    "<div style=\"display: flex; flex-direction: row; align-items: center; gap: 6px;\">",
