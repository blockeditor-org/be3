  "document": [
    "<!doctype html>",
    "<html>",
    "<head>",
    "<meta charset=\"utf-8\">",
    "<style>",
    ".beui-root { display: grid; grid-template-columns: minmax(0, 1fr); width: 100%; min-height: 100%; }\n.beui-root, .beui-root * { box-sizing: border-box; margin: 0; }\n.beui-break::after { content: \"\\A\"; white-space: pre; }\n.beui-layers >",
    " * + * { pointer-events: none; }\n.beui-stand-in { outline: 2px dashed #ff69b4; outline-offset: -2px; }\n.beui-overlay { position: fixed; inset: auto; margin: 0; padding: 0; border: 0; background: transparent; color: inherit; pointer-events: auto; max-width: none; max-height: none; overflow: visible; }\n.beui-overlay::backdrop { background: var(--beui-scrim, transparent); }\n.beui-beak { position: absolute; z-index: -1; width: var(--beui-beak); height: var(--beui-beak); top: calc(var(--beui-beak) / -2); left: calc(50% - var(--beui-beak) / 2); transform: rotate(45deg); }\n.beui-beak[hidden] { display: none; }\n@container anchored(fallback: flip-block) { .beui-beak { top: auto; bottom: calc(var(--beui-beak) / -2); } }\nbody { margin: 0; height: 100vh; font: 14px sans-serif; }</style>",
    "</head>",
    "<body>",
    "<div class=\"beui-root\" style=\"background-color: #0e1117;\">",
    "<div style=\"display: flex; flex-direction: column; align-items: stretch;\">",
    "<div style=\"display: contents; flex: 0 0 auto;\">",
    "<div style=\"position: fixed; visibility: hidden; pointer-events: none; anchor-name: --beui-overlay-4; left: 0px; top: 0px; width: 0px; height: 0px;\">",
    "</div>",
    "<dialog class=\"beui-overlay\" style=\"--beui-scrim: rgba(0, 0, 0, 0.588); top: 50%; left: 50%; translate: -50% -50%; max-width: 100vw; max-height: 100vh;\" open=\"\">",
    "<!--[-->",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); justify-items: stretch; align-items: stretch;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); padding: 12px 12px 12px 12px; justify-items: stretch; align-items: stretch;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); width: 100%; max-width: 360px; justify-items: stretch; align-items: stretch; background-color: #1f2530; border-radius: 10px 10px 10px 10px; outline: 1px solid #2a3240; outline-offset: 0px;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr);\">",
    "<!--[-->",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); justify-items: stretch; align-items: stretch;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); padding: 16px 20px 16px 20px; justify-items: stretch; align-items: stretch;\">",
    "<div style=\"display: flex; flex-direction: column; align-items: stretch; gap: 12px;\">",
    "<!--[-->",
    "<div style=\"display: flex; flex-direction: row; align-items: center; gap: 12px; flex: 0 0 auto;\">",
    "<div style=\"font: 20px Inter, system-ui, sans-serif; color: #e6ebf3; white-space: pre-wrap; overflow-wrap: break-word; flex: 100 0 0px;\">",
    "Delete the block?</div>",
    "<!--[-->",
    "<!--]-->",
    "</div>",
    "<!--]-->",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); padding: -12px -19px -12px -19px; justify-items: stretch; align-items: stretch; flex: 0 1 auto;\">",
    "<div class=\"beui-layers\" style=\"display: grid; grid-template-columns: minmax(0, 1fr);\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); justify-items: stretch; align-items: stretch; pointer-events: auto; grid-area: 1 / 1;\" tabindex=\"-1\">",
    "<div style=\"display: flex; flex-direction: column; align-items: stretch;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); justify-items: stretch; align-items: stretch; flex: 0 1 auto;\">",
    "<div style=\"display: flex; overflow: hidden; overflow-anchor: none; flex-direction: column;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); padding: 12px 19px 12px 19px; justify-items: stretch; align-items: stretch; flex-shrink: 0; min-height: 100%;\">",
    "<div style=\"display: flex; flex-direction: column; align-items: stretch;\">",
    "<div style=\"display: flex; flex-direction: column; align-items: stretch; gap: 12px; flex: 0 0 auto;\">",
    "<div style=\"font: 14px Inter, system-ui, sans-serif; color: #e6ebf3; white-space: pre-wrap; overflow-wrap: break-word; flex: 0 0 auto;\">",
