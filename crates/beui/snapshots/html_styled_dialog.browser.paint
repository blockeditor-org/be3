    "<!doctype html>",
    "<html>",
    "<head>",
    "<meta charset=\"utf-8\">",
    "<style>",
    ".beui-root[data-scheme=light] { color-scheme: light; }\n.beui-root[data-scheme=dark] { color-scheme: dark; }\n:root { overscroll-behavior: none; }\n.beui-root { color-scheme: light dark; display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); position: fixed; inset: 0; overflow: clip; overscroll-behavior: none; }\n.beui-root, .beui-root * { box-sizing: border-box; margin: 0; }\n.beui-root [tabindex], .beui-overlay { outline: none; }\n.beui-root { -webkit-user-select: none; user-select: none; }\n.beui-root :is(input, textarea, [contenteditable]) { -webkit-user-select: text; user-select: text; }\n.beui-root :is(input, button) { font: inherit; color: inherit; text-align: inherit; background: none; border: 0; border-radius: 0; padding: 0; outline: none; -webkit-appearance: none; appearance: none; min-width: 0; cursor: inherit; }\n.beui-root a { color: inherit; text-decoration: none; }\n.beui-root input::placeholder { color: var(--beui-placeholder, GrayText); opacity: 1; }\n.beui-root input::selection { background-color: var(--beui-selection, Highlight); }\n.beui-root input:autofill { -webkit-text-fill-color: currentColor; transition: background-color 86400s; }\n.beui-root input::-webkit-search-cancel-button { display: none; }\n.beui-break::after { content: \"\\A\"; white-space: pre; }\n.beui-icon { display: inline-block; vertical-align: top; }\n.beui-icon:not(:first-child) { margin-inline-start: var(--beui-icon-spacing, 0); }\n.beui-icon:not(:last-child) { margin-inline-end: var(--beui-icon-spacing, 0); }\n.beui-icon + .beui-icon { margin-inline-start: 0; }\n.beui-glyph { position: relative; }\n.beui-glyph::before { content: attr(data-glyph); position: absolute; top: 0; left: 0; right: 0; display: flex; justify-content: center; white-space: pre; line-height: normal; font: var(--beui-glyph-font); color: var(--beui-glyph-color); pointer-events: none; }\n.beui-text-decor { position: absolute; inset: 0; pointer-events: none; }\n.beui-text-decor >",
    " * { position: absolute; }\n.beui-mark { z-index: -1; }\n.beui-caret-blink { animation: beui-caret-blink 1060ms steps(1, end) infinite; }\n@keyframes beui-caret-blink { 50% { opacity: 0; } }\n@media (prefers-reduced-motion: reduce) { .beui-caret-blink { animation: none; } }\n.beui-layers >",
    " * + * { pointer-events: none; }\n.beui-stand-in { outline: 2px dashed #ff69b4; outline-offset: -2px; }\n.beui-overlay { position: fixed; inset: auto; margin: 0; padding: 0; border: 0; background: transparent; color: inherit; pointer-events: auto; max-width: none; max-height: none; overflow: visible; }\n.beui-overlay:is([open], :popover-open) { display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); }\n.beui-overlay::backdrop { background: var(--beui-scrim, transparent); }\n.beui-beak { position: absolute; z-index: -1; width: var(--beui-beak); height: var(--beui-beak); top: calc(var(--beui-beak) / -2); left: calc(50% - var(--beui-beak) / 2); transform: rotate(45deg); }\n.beui-beak[hidden] { display: none; }\n@container anchored(fallback: flip-block) { .beui-beak { top: auto; bottom: calc(var(--beui-beak) / -2); } }\n@font-face { font-family: Inter; src: url(\"./Inter-Regular.ttf\") format(\"truetype\"); font-display: block; }\n@font-face { font-family: Hack; src: url(\"./Hack-Regular.ttf\") format(\"truetype\"); font-display: block; }\n@font-face { font-family: NotoEmoji; src: url(\"./NotoEmoji-Regular.ttf\") format(\"truetype\"); font-display: block; unicode-range: U+200D, U+20E3, U+2100-2BFF, U+3030, U+303D, U+3297, U+3299, U+FE0F, U+1F000-1FAFF; }\n@font-face { font-family: lucide; src: url(\"./lucide.ttf\") format(\"truetype\"); font-display: block; }\nbody { margin: 0; height: 100vh; font: 14px sans-serif; }</style>",
