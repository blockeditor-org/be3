  "document": [
    "<!doctype html>",
    "<html>",
    "<head>",
    "<meta charset=\"utf-8\">",
    "<style>",
    ".beui-root { display: grid; grid-template-columns: minmax(0, 1fr); width: 100%; min-height: 100%; }\n.beui-root, .beui-root * { box-sizing: border-box; margin: 0; }\n.beui-break::after { content: \"\\A\"; white-space: pre; }\n.beui-stand-in { outline: 2px dashed #ff69b4; outline-offset: -2px; }\nbody { margin: 0; height: 100vh; font: 14px sans-serif; }</style>",
    "</head>",
    "<body>",
    "<div class=\"beui-root\" style=\"background-color: #0e1117;\">",
    "<div style=\"display: flex; flex-direction: column; align-items: stretch;\">",
    "<div style=\"position: relative; flex: 0 0 auto;\">",
    "<!--[-->",
    "<div class=\"beui-stand-in\" title=\"TODO: OverlayContent\" style=\"position: absolute; top: 100%; left: 0; z-index: 1000;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); justify-items: stretch; align-items: stretch;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); padding: 12px 12px 12px 12px; justify-items: stretch; align-items: stretch;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); width: 100%; max-width: 360px; justify-items: stretch; align-items: stretch; background-color: #1f2530; border-radius: 10px 10px 10px 10px; outline: 1px solid #2a3240; outline-offset: 0px;\">",
    "<div class=\"beui-stand-in\" title=\"TODO: Portal\" style=\"min-width: 16px; min-height: 16px; background-color: #ff69b4;\">",
    "</div>",
    "</div>",
    "</div>",
    "</div>",
    "</div>",
    "<!--]-->",
    "</div>",
    "<div style=\"position: relative; flex: 0 0 auto;\">",
    "<!--[-->",
    "<!--]-->",
    "</div>",
    "</div>",
    "</div>",
    "</body>",
    "</html>"
  ],
  "files": {}
