load("@root//buck/cargo:defs.bzl", "cargo_binary")
load(":defs.bzl", "deploy")

# What runs on this machine once a buck2 command has built what it needs,
# built for this machine in that same command: `verify` for ./scripts/verify
# and ./scripts/ci after buck/dev/verify.bxl, `deploy` for ./scripts/deploy, and
# `fuzz` for a fuzz target and //:fuzz (cargo_fuzz in buck/cargo/defs.bzl).

cargo_binary()

deploy(
    name = "deploy",
    app_android = "//crates/block-app:android-release",
    app_linux_arm64 = "//crates/block-app:native",
    app_linux_x86_64 = "//crates/block-app:native",
    app_macos_arm64 = "//crates/block-app:native",
    app_macos_x86_64 = "//crates/block-app:native",
    app_windows_arm64 = "//crates/block-app:native",
    app_windows_x86_64 = "//crates/block-app:native",
    be_linux_arm64 = "//crates/be-cli:native",
    be_linux_x86_64 = "//crates/be-cli:native",
    server = "//crates/be-server:bin",
    tool = ":bin",
    web = "//crates/block-app:web",
)
