package be3:block-type@0.1.0;

/// What a type module asks of its host. A call made for a replica has that
/// replica as its parent, so the host knows which block it is about, and it is
/// canceled when the replica ends. A call made while serving a stateless
/// request has that request as its parent (only `read-part`).
interface host {
    use types.{
        byte-range, commit-id, description, journal-base, journal-entry, loaded, undo-state, merging,
        part-ref, recipients, resume, status, written,
    };

    /// The frame clock in milliseconds. The module starts it once; the host
    /// yields the time whenever it moved, ahead of any other frame. The module
    /// never reads a clock of its own, so a test moves time by yielding.
    clock: func() -> stream<u64>;

    /// Resolves once the clock reached `at`, after the host yielded that time.
    /// The module cancels it when it wants to wake at another time.
    sleep-until: async func(at: u64);

    /// A commit's stored form; with `first-part`, only the bytes of its root's
    /// first part (`be_block::Loads::FirstPart`).
    load: async func(commit: commit-id, first-part: bool) -> result<loaded, string>;

    /// A range of the bytes of a saved part, which a replica that loaded only
    /// its first part reads on demand. Under a stateless request, only a part
    /// of the `loaded` content that request was handed; any other is refused.
    read-part: async func(part: part-ref, range: byte-range) -> result<list<u8>, string>;

    /// Seals `bytes` under the block's current key as a part, uploads it and has
    /// the server hold it for the block until a commit that uses it publishes
    /// or the upload grace runs out; answers once the upload is done. An
    /// operation then names the part by putting the answer in its own payload,
    /// and so travels without the bytes: each replica that applies it keeps the
    /// part as `written-part.reused`, using bytes it rebuilt itself (checked
    /// against a hash of them the operation carries) or reading the part with
    /// `read-part`. Fails offline, and for a block the server does not have yet.
    put-part: async func(bytes: list<u8>) -> result<part-ref, string>;

    /// A compare-and-swap on `expected`, whose commit is the first parent. An
    /// unchanged save answers `published` with the same head; one sealed on
    /// this device alone, offline or behind others in its outbox, answers
    /// `kept`, and the replica hears `drained` once it reaches the server.
    publish: async func(
        expected: option<commit-id>,
        merging: option<merging>,
        content: written,
    ) -> result<publish-outcome, string>;

    variant publish-outcome {
        published(commit-id),
        kept(commit-id),
        rejected(option<commit-id>),
    }

    /// Writes a commit that moves no head.
    stash: async func(parent: option<commit-id>, content: written) -> result<commit-id, string>;

    /// The host fetches both histories and runs `be_session::resume`.
    resume-session: async func(local: option<commit-id>) -> result<resume, string>;

    /// Sent once per generation when the owner is gone from the participants.
    claim-lease: async func(generation: u64);

    /// The owner's heartbeat.
    report-clean: async func(generation: u64, clean-at: option<commit-id>);

    /// The owner of `generation` appends what it sequenced to the block's
    /// journal, on the device and on the server, and with `relay` the server
    /// relays each entry to every other participant as `send` to peers would.
    /// True once the server holds the entries; false when only the device
    /// does (offline, or the server did not take them).
    append: async func(generation: u64, entries: list<journal-entry>, relay: bool) -> bool;

    /// The owner of `generation` starts the journal from `base`: after each
    /// commit, and before its first append when the journal it opened with
    /// was not its base.
    rebase-journal: async func(generation: u64, base: journal-base);

    /// Opaque bytes for a peer, every peer, an editor or the host.
    send: async func(to: recipients, bytes: list<u8>);

    report-status: async func(status: status);

    /// After the visible content changed, for the graph mirror.
    described: async func(description: description);

    history: async func(history: undo-state);

    /// A merge kept both sides.
    conflict: async func(ours: commit-id, theirs: commit-id, count: u32);

    error: async func(message: string);

    /// Tells the block's members who are not connected, with `text`, naming the block and the
    /// signed-in account, and the accounts it mentions, each as the text of its uuid (`announcements` of a `live-edit`): dropped when
    /// the server cannot be reached.
    notify: async func(text: string, mentions: list<string>);
}
