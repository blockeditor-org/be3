package be3:block-type@0.1.0;

/// The shapes a host and a type module share.
interface types {
    use be3:shared/ids@0.1.0.{uuid, hash, account-id, block-id, content-type-id, organization-id, commit-id};

    /// The type module's hash: two builds of a type never edit one session.
    type session-tag = hash;

    /// A participant of a block's session, numbered by the server.
    type client-id = u64;

    /// An editor attached to a replica, numbered by the host.
    type editor-id = u64;

    /// A metadata entry, keyed by the uuid of its kind.
    record entry {
        key: uuid,
        value: list<u8>,
    }

    /// Derived metadata, by key.
    type entries = list<entry>;

    /// One connection in a block's session (be-block-protocol's
    /// `participant`).
    record participant {
        client: client-id,
        tag: session-tag,
        may-edit: bool,
        claimed: option<u64>,
    }

    /// Who is in a block's session as of its `index`-th membership entry,
    /// in the order they joined (be-block-protocol's `session-state`): the
    /// lease holder and the build the session speaks follow from it
    /// (`be_block_session::Membership`).
    record session-state {
        index: u64,
        after: u64,
        participants: list<participant>,
    }

    record resume-merge {
        base: option<commit-id>,
        ours: commit-id,
        theirs: commit-id,
    }

    /// A remote head that seals this session's order through `through`, made
    /// on the replica's local head.
    record resume-sealed {
        commit: commit-id,
        through: u64,
        /// The run of the order it seals (`status.restarts`).
        restarts: u64,
    }

    /// How a replica's local head relates to the remote one.
    variant resume {
        empty,
        up-to-date,
        fast-forward(commit-id),
        publish(commit-id),
        merge(resume-merge),
        /// The remote head is a seal of this session made on the local one:
        /// news of the seal, taken once the replica applied as far, not a
        /// head to merge, which would count what both hold twice.
        sealed(resume-sealed),
    }

    /// The plain form a type has outside the host.
    enum plain {
        none,
        file,
        directory,
    }

    record type-info {
        content-type: content-type-id,
        frozen: bool,
        schema: string,
        undo: bool,
        plain: plain,
        /// The type loads only its first part (`be_block::Loads::FirstPart`), so a
        /// request handed `loaded` content gets only that part's bytes.
        first-part: bool,
        /// The type merges by parts (`replicas.merge-parts`) rather than whole bytes
        /// (`replicas.merge3`). Only a type with `first-part` does.
        merges-parts: bool,
        /// The stored form read whole decodes to the content (`be_block::BlockContent::WHOLE_BYTES`),
        /// so a copy of its bytes loses nothing.
        whole-bytes: bool,
        /// The type keeps a signed log beside its content (plans/signed_logs.md):
        /// its replicas read it with `host.read-log`, hear it with
        /// `replica.logged`, append with `host.append`, and fold it into what
        /// they describe (`be_block_content::LogFold`).
        log: bool,
        /// The type's default content (`Default`), encoded.
        blank: list<u8>,
        /// `blank` described, with no organization.
        blank-description: description,
        /// The owner-only settings kind holding where the account read blocks of this
        /// type up to, for a type that counts what is unread (`replicas.unread`); none
        /// for one that does not.
        reads: option<content-type-id>,
    }

    /// An entry of a block's signed log as the host read and verified it.
    record log-item {
        /// Its place in the log.
        seq: u64,
        id: uuid,
        /// The account that appended it, as the server recorded it.
        author: account-id,
        /// When the server took it, by the server's clock.
        arrival: s64,
        /// The bytes the app appended; none once redacted, or while no key
        /// this device holds opens them.
        payload: option<list<u8>>,
        /// Who of `author` signed it as this app's, as far as the device can tell.
        signer: signer,
    }

    /// Who signed a log entry (`be_block_client::Signer`), `unknown` when it
    /// could not be told (offline, or its payload unopened), or `redacted` when
    /// its payload is gone and with it what was signed.
    enum signer {
        verified,
        unverified,
        changed,
        replaced,
        bad,
        unknown,
        redacted,
    }

    /// A run of a block's signed log from where it was asked: `size` is the
    /// log's length as the host verified it.
    record log-page {
        size: u64,
        items: list<log-item>,
        /// The entries this device appended that the server has not taken
        /// yet, in order: they wait in its outbox, and reach the log later.
        kept: list<kept-entry>,
    }

    /// An entry this device appended that waits for the server: its id and
    /// the bytes the app appended.
    record kept-entry {
        id: uuid,
        payload: list<u8>,
    }

    record description {
        derived: entries,
        references: list<block-id>,
    }

    record plain-file {
        bytes: list<u8>,
        name: option<string>,
        extension: string,
        media-type: string,
    }

    /// Content to write as a commit: references unresolved, derived metadata
    /// computed. The host resolves, seals and uploads.
    record written {
        bytes: list<u8>,
        /// The parts `bytes` is saved in, so a save uploads only the parts
        /// that changed; empty saves it as one part.
        parts: list<written-part>,
        references: list<block-id>,
        derived: entries,
    }

    /// One part of `written.bytes`, in pre-order: a part of the next
    /// this-many bytes, a node, or a saved part kept as it is, whose bytes
    /// `written.bytes` leaves out (`be_block::Loads::FirstPart`).
    variant written-part {
        bytes(u32),
        node(written-node),
        reused(part-ref),
    }

    /// A node holding the next this-many parts, and the blocks it references
    /// itself (not its parts').
    record written-node {
        parts: u32,
        references: list<block-id>,
    }

    /// A publish that merges: `ours` becomes the second parent.
    record merging {
        base: option<commit-id>,
        ours: commit-id,
    }

    record byte-range {
        offset: u64,
        length: u64,
    }

    record chunk-ref {
        hash: hash,
        length: u32,
    }

    record node-ref {
        hash: hash,
        length: u64,
    }

    /// A saved part of a block's stored form (`be_block_store::PartRef`).
    variant part-ref {
        chunk(chunk-ref),
        chunks(node-ref),
        node(node-ref),
    }

    /// One part of a loaded stored form, in pre-order: the part, how many
    /// child parts follow it, and the blocks it references itself.
    record loaded-part {
        part: part-ref,
        children: u32,
        references: list<block-id>,
    }

    /// A commit's stored form as a replica loads it (`be_block_store::Stored`):
    /// its bytes from the start, all of them or only its first part, and the
    /// parts it was saved in.
    record loaded {
        bytes: list<u8>,
        parts: list<loaded-part>,
    }

    record status {
        head: option<commit-id>,
        /// Holds the lease, so seals.
        holder: bool,
        /// How many times the session started over (a restart, or the last
        /// one out leaving) before what this replica applied: local edits made
        /// before a later one cannot be applied, since what they were made on
        /// is gone.
        restarts: u64,
        clean: bool,
        /// Every local edit is in the order: none waits to be submitted or
        /// numbered.
        journaled: bool,
        /// While `journaled` is false, what keeps the replica's edits out of the
        /// journal, for a host to name when it waits on them.
        unjournaled: option<unjournaled>,
        owes-seal: bool,
        incompatible: bool,
        diverged: bool,
        unreadable: option<string>,
        /// None until the replica has loaded, and once it was released.
        undo: option<undo-state>,
        /// How many local edits (an editor's messages and the host's changes)
        /// the replica has taken since it was opened or reopened, in the order
        /// the host sent them: what this status reflects of them.
        taken: u64,
        /// How many of those the host need not give the replica again when it
        /// opens it on `head`: those `head` holds.
        sealed-taken: u64,
        /// How many of those the order holds (at least `sealed-taken`): the
        /// host need not give them again when it opens the replica on the
        /// journal.
        journaled-taken: u64,
        /// The `opening.epoch` the replica was opened with, which `taken`
        /// counts from.
        epoch: u64,
    }

    variant endpoint {
        peer(client-id),
        editor(editor-id),
        host,
    }

    variant recipients {
        one(endpoint),
        /// Every other participant of the session.
        peers,
    }

    record replace-child {
        old: block-id,
        new: block-id,
    }

    /// Moves a child among its siblings: after the child `after`, or first
    /// when it is none.
    record reorder-child {
        block: block-id,
        after: option<block-id>,
    }

    variant child-change {
        add(block-id),
        delete(block-id),
        replace(replace-child),
        reorder(reorder-child),
    }

    record file-change {
        name: string,
        bytes: list<u8>,
    }

    variant change {
        child(child-change),
        from-file(file-change),
        replace(list<u8>),
        undo,
        redo,
    }

    /// Why a stateless request has no answer.
    variant failure {
        unknown-type,
        malformed(string),
    }

    /// What keeps a replica's edits out of the journal (`status.unjournaled`),
    /// with the timers that may bring them in, on the replica's clock.
    record unjournaled {
        loaded: bool,
        /// Edits submitted that the server has not yet numbered.
        pending: u32,
        /// Edits waiting to be submitted, behind a seal or a part being put.
        unsent: u32,
        /// Edits an earlier opening may have submitted, shown but held until
        /// the replica joins.
        doubtful: u32,
        /// A part of one of its operations is being put.
        putting: bool,
        put-retry-at: option<u64>,
        merge-retry-at: option<u64>,
        seal-retry-at: option<u64>,
        merge-failures: u8,
        /// The next edit to submit holds what an earlier opening submitted,
        /// which goes again once the replica has taken the local edits through
        /// this number.
        resubmits-through: option<u64>,
    }

    /// What undo and redo can do on this device, and why they cannot.
    record undo-state {
        can-undo: bool,
        can-redo: bool,
        /// Undo and redo stopped at the session restart that committed this:
        /// steps made before it no longer apply.
        restarted-at: option<commit-id>,
        /// Edits written by another build of this type were dropped when the
        /// block opened, since this build cannot replay them.
        lost-edits: bool,
    }

    /// What a replica hands its session's order: its id (`origin`,
    /// `counter`), the last sequence number it had applied (`base`), whether
    /// nothing based before it applies once it is numbered (`barrier`), and
    /// the entry the module wrote.
    record submission {
        origin: u64,
        counter: u64,
        base: u64,
        barrier: bool,
        payload: list<u8>,
    }

    /// One submission the order numbered, its payload opened: its place, its
    /// id, its base, the last barrier (`floor`): one based below it is passed over, and when the
    /// server took it (none for an order kept offline).
    record journal-entry {
        sequence: u64,
        origin: u64,
        counter: u64,
        base: u64,
        floor: u64,
        received: option<s64>,
        payload: list<u8>,
    }

    /// What an edit made on this device tells the block's other members once
    /// the server holds it (`be_block::Announcement`): `key` names what it
    /// announces, unique in the block, `several` is the text for several sent
    /// together, with `{count}` for how many, and `mentions` the accounts it
    /// mentions.
    record announcement {
        key: string,
        text: string,
        several: string,
        mentions: list<account-id>,
    }

    /// What goes with an entry appended to a block's signed log
    /// (`be_block_content::Along`): the push the server sends once it takes the
    /// entry, and the place of an entry the new one takes back, redacted then.
    record along {
        announcement: option<announcement>,
        redacts: option<u64>,
    }

    /// Where a journal starts: a commit (none for no content), the last
    /// sequence number it holds and the session state as of it.
    record journal-base {
        commit: option<commit-id>,
        sequence: u64,
        state: list<u8>,
    }

    /// The session's order since `base`, which no commit holds yet, by this
    /// module's build.
    record journal {
        base: journal-base,
        entries: list<journal-entry>,
    }

    record merged {
        bytes: list<u8>,
        /// Zero is a clean merge.
        conflicts: u32,
    }

    /// Where the account read one block up to (`be_block_content::Unread::places`),
    /// in bytes only the type reads.
    record block-place {
        block: block-id,
        place: list<u8>,
    }

    /// A searchable document of a block (`be_block::SearchDocument`).
    record search-document {
        /// Stable across edits: empty for a block that is one document.
        key: string,
        /// The part the document's text came from, if it is one part.
        source: option<part-ref>,
        /// The document's own name, such as a section's title.
        name: option<string>,
        /// None when `source` is in the request's `indexed`.
        body: option<string>,
    }

    /// A merge over parts: the commit to write, which reuses the parts the merge kept as
    /// they were.
    record merged-parts {
        content: written,
        /// Zero is a clean merge.
        conflicts: u32,
    }
}
