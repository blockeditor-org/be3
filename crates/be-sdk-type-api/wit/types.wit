package be3:block-type@0.1.0;

/// The shapes a host and a type module share.
interface types {
    use be3:shared/ids@0.1.0.{uuid, hash, account-id, block-id, content-type-id, organization-id, commit-id};

    /// The type module's hash: two builds of a type never edit one session.
    type session-tag = hash;

    /// A participant of a block's session, numbered by the server.
    type client-id = u64;

    /// An editor attached to a replica, numbered by the host.
    type editor-id = u64;

    /// A metadata entry, keyed by the uuid of its kind.
    record entry {
        key: uuid,
        value: list<u8>,
    }

    /// Derived metadata, by key.
    type entries = list<entry>;

    /// The server's state of a block's session: its lease.
    record session-state {
        generation: u64,
        owner: option<client-id>,
        participants: list<client-id>,
        clean-at: option<commit-id>,
    }

    record resume-merge {
        base: option<commit-id>,
        ours: commit-id,
        theirs: commit-id,
    }

    /// How a replica's local head relates to the remote one.
    variant resume {
        empty,
        up-to-date,
        fast-forward(commit-id),
        publish(commit-id),
        merge(resume-merge),
    }

    /// The plain form a type has outside the host.
    enum plain {
        none,
        file,
        directory,
    }

    record type-info {
        content-type: content-type-id,
        frozen: bool,
        schema: string,
        undo: bool,
        plain: plain,
        /// The type loads only its first part (`be_block::Loads::FirstPart`), so a
        /// request handed `loaded` content gets only that part's bytes.
        first-part: bool,
        /// The type merges by parts (`replicas.merge-parts`) rather than whole bytes
        /// (`replicas.merge3`). Only a type with `first-part` does.
        merges-parts: bool,
        /// The stored form read whole decodes to the content (`be_block::BlockContent::WHOLE_BYTES`),
        /// so a copy of its bytes loses nothing.
        whole-bytes: bool,
        /// The type's default content (`Default`), encoded.
        blank: list<u8>,
        /// `blank` described, with no organization.
        blank-description: description,
    }

    record description {
        derived: entries,
        references: list<block-id>,
    }

    record plain-file {
        bytes: list<u8>,
        name: option<string>,
        extension: string,
        media-type: string,
    }

    /// Content to write as a commit: references unresolved, derived metadata
    /// computed. The host resolves, seals and uploads.
    record written {
        bytes: list<u8>,
        /// The parts `bytes` is saved in, so a save uploads only the parts
        /// that changed; empty saves it as one part.
        parts: list<written-part>,
        references: list<block-id>,
        derived: entries,
    }

    /// One part of `written.bytes`, in pre-order: a part of the next
    /// this-many bytes, a node, or a saved part kept as it is, whose bytes
    /// `written.bytes` leaves out (`be_block::Loads::FirstPart`).
    variant written-part {
        bytes(u32),
        node(written-node),
        reused(part-ref),
    }

    /// A node holding the next this-many parts, and the blocks it references
    /// itself (not its parts').
    record written-node {
        parts: u32,
        references: list<block-id>,
    }

    /// A publish that merges: `ours` becomes the second parent.
    record merging {
        base: option<commit-id>,
        ours: commit-id,
    }

    record byte-range {
        offset: u64,
        length: u64,
    }

    record chunk-ref {
        hash: hash,
        length: u32,
    }

    record node-ref {
        hash: hash,
        length: u64,
    }

    /// A saved part of a block's stored form (`be_block_store::PartRef`).
    variant part-ref {
        chunk(chunk-ref),
        chunks(node-ref),
        node(node-ref),
    }

    /// One part of a loaded stored form, in pre-order: the part, how many
    /// child parts follow it, and the blocks it references itself.
    record loaded-part {
        part: part-ref,
        children: u32,
        references: list<block-id>,
    }

    /// A commit's stored form as a replica loads it (`be_block_store::Stored`):
    /// its bytes from the start, all of them or only its first part, and the
    /// parts it was saved in.
    record loaded {
        bytes: list<u8>,
        parts: list<loaded-part>,
    }

    record status {
        head: option<commit-id>,
        owner: bool,
        clean: bool,
        /// Whatever is not clean is in the journal: an owner appended all it
        /// sequenced.
        journaled: bool,
        owes-seal: bool,
        why: string,
        incompatible: bool,
        diverged: bool,
        unreadable: option<string>,
        /// None until the replica has loaded, and once it was released.
        undo: option<undo-state>,
    }

    variant endpoint {
        peer(client-id),
        editor(editor-id),
        host,
    }

    /// What a message to peers carries, which the server checks against its
    /// sender: `peer` for presence, channel messages and asking to catch up,
    /// which any participant sends; `edit` for operations and session state,
    /// only from a participant with edit access. The host passes it to the
    /// server and ignores it for an editor or itself.
    enum relay-kind {
        peer,
        edit,
    }

    /// What the server says of a peer's message it relayed.
    record delivery {
        /// What the server checked its sender may send: the replica drops a
        /// message that asks for more (`Wire::kind`).
        kind: relay-kind,
    }

    variant recipients {
        one(endpoint),
        /// Every other participant of the session.
        peers,
    }

    record replace-child {
        old: block-id,
        new: block-id,
    }

    /// Moves a child among its siblings: after the child `after`, or first
    /// when it is none.
    record reorder-child {
        block: block-id,
        after: option<block-id>,
    }

    variant child-change {
        add(block-id),
        delete(block-id),
        replace(replace-child),
        reorder(reorder-child),
    }

    record file-change {
        name: string,
        bytes: list<u8>,
    }

    variant change {
        child(child-change),
        from-file(file-change),
        replace(list<u8>),
        undo,
        redo,
    }

    /// Why a stateless request has no answer.
    variant failure {
        unknown-type,
        malformed(string),
    }

    /// What undo and redo can do on this device, and why they cannot.
    record undo-state {
        can-undo: bool,
        can-redo: bool,
        /// Undo and redo stopped at the session restart that committed this:
        /// steps made before it no longer apply.
        restarted-at: option<commit-id>,
        /// Edits written by another build of this type were dropped when the
        /// block opened, since this build cannot replay them.
        lost-edits: bool,
    }

    /// One operation the owner sequenced: a session message the module wrote,
    /// the same bytes a peer hears relayed.
    record journal-entry {
        sequence: u64,
        payload: list<u8>,
    }

    /// What an edit made on this device tells the block's other members once
    /// the server holds it (`be_block::Announcement`): `key` names what it
    /// announces, unique in the block, `several` is the text for several sent
    /// together, with `{count}` for how many, and `mentions` the accounts it
    /// mentions.
    record announcement {
        key: string,
        text: string,
        several: string,
        mentions: list<account-id>,
    }

    /// An announcement of the edit an owner sequenced as `sequence`.
    record announced {
        sequence: u64,
        announcement: announcement,
    }

    /// Where a journal starts: a commit (none for no content), the last
    /// sequence number it holds and the session state as of it.
    record journal-base {
        commit: option<commit-id>,
        sequence: u64,
        state: list<u8>,
    }

    /// What a block's session owners sequenced since `base` and did not
    /// commit, by this module's build.
    record journal {
        base: journal-base,
        entries: list<journal-entry>,
    }

    record merged {
        bytes: list<u8>,
        /// Zero is a clean merge.
        conflicts: u32,
    }

    /// A searchable document of a block (`be_block::SearchDocument`).
    record search-document {
        /// Stable across edits: empty for a block that is one document.
        key: string,
        /// The part the document's text came from, if it is one part.
        source: option<part-ref>,
        /// The document's own name, such as a section's title.
        name: option<string>,
        /// None when `source` is in the request's `indexed`.
        body: option<string>,
    }

    /// A merge over parts: the commit to write, which reuses the parts the merge kept as
    /// they were.
    record merged-parts {
        content: written,
        /// Zero is a clean merge.
        conflicts: u32,
    }
}
