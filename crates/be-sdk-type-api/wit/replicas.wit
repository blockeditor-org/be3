package be3:block-type@0.1.0;

/// What a type module offers: a replica for each open block, and requests
/// that need none. A call the module makes under a stateless request has the
/// request as its parent; the host serves only `read-part` there, and only of
/// the parts of the `loaded` content the request was handed.
interface replicas {
    use types.{
        block-id, change, client-id, commit-id, content-type-id, description, editor-id,
        endpoint, failure, journal, loaded, merged, merged-parts, organization-id, part-ref, plain-file,
        search-document, session-state, session-tag, type-info,
    };

    record opening {
        block: block-id,
        content-type: content-type-id,
        organization: organization-id,
        client: client-id,
        tag: session-tag,
        /// The head the host just read; the replica reads it itself.
        head: option<commit-id>,
        session: session-state,
        /// The block's journal by this module's build, when its base is
        /// `head`: the replica loads the base and replays it.
        journal: option<journal>,
        /// Edits of this block made with another build were lost: its journal
        /// on `head` holds some this module cannot replay, or the server
        /// marked them lost since the last commit.
        lost-edits: bool,
    }

    /// The device's one replica of a block. Dropping it closes it: it seals
    /// what it owes and then ends, and the host leaves the session once it has.
    /// Until then calls still reach it.
    resource replica {
        constructor(opening: opening);

        /// Starts over as if just opened, dropping what it holds, as after the
        /// host reconnected. The host replays what it kept.
        reopen: async func(opening: opening);

        /// `at` is the module's clock when the host sent it, which the replica
        /// reads the message at even when the clock's stream has yet to say so.
        message: async func(%from: endpoint, bytes: list<u8>, at: u64);

        /// An editor instance starts following the block, or its `editable`
        /// changed. The replica drops edits from an editor attached read-only.
        attach: async func(editor: editor-id, editable: bool);

        detach: async func(editor: editor-id);

        /// A head landed after the one the replica opened at. The host calls it
        /// for every such head, including the remote head when the replica
        /// opened at a local head that differs: the replica does not reconcile
        /// on opening.
        head-moved: async func(head: commit-id, from-this-device: bool);

        /// The session's state changed, or the host fell behind the broadcast.
        lease: async func(session: session-state, resynchronize: bool);

        /// Claim a lapsed lease once the replica has caught up, as a terminal host does.
        claim: async func();

        /// False when it did not apply.
        change: async func(change: change) -> bool;

        /// The visible bytes, for export and duplication; none while unreadable.
        content: async func() -> option<list<u8>>;

        /// `force` is a rekey: publish even when clean.
        seal: async func(force: bool);
    }

    /// Seeds the module's entropy, starts its clock and lists its types.
    start: async func(entropy: list<u8>) -> list<type-info>;

    blank: async func(content-type: content-type-id) -> result<list<u8>, failure>;

    /// Content bytes (none for the type's default) with a journal of this
    /// build replayed on top, for a reader outside the session.
    replay: async func(
        content-type: content-type-id,
        bytes: option<list<u8>>,
        journal: journal,
    ) -> result<list<u8>, failure>;

    /// A side that is none is the type's default.
    merge3: async func(
        content-type: content-type-id,
        base: option<list<u8>>,
        ours: option<list<u8>>,
        theirs: option<list<u8>>,
    ) -> result<merged, failure>;

    /// `merge3` for a type that merges by parts (`type-info.merges-parts`): each side as
    /// `host.load` with `first-part` answers it, or for content not saved yet, its bytes and
    /// no parts. The module reads the other parts it needs with `read-part` under this
    /// request.
    merge-parts: async func(
        content-type: content-type-id,
        base: option<loaded>,
        ours: option<loaded>,
        theirs: option<loaded>,
        organization: organization-id,
    ) -> result<merged-parts, failure>;

    describe: async func(content-type: content-type-id, bytes: list<u8>, organization: organization-id) -> result<description, failure>;

    to-file: async func(content-type: content-type-id, bytes: list<u8>) -> result<option<plain-file>, failure>;

    /// The content's searchable text (`be_block::BlockContent::search_text`); empty for a
    /// type that is not content-searchable. `content` is a commit as `host.load` answers it,
    /// only its first part for a type that loads only that (`type-info.first-part`), which
    /// reads the others with `read-part` under this request. `keys` asks for those documents
    /// only, none for every one. A document whose `source` is in `indexed` comes back
    /// without a body, and its part is not read.
    search-text: async func(
        content-type: content-type-id,
        content: loaded,
        keys: option<list<string>>,
        indexed: list<part-ref>,
    ) -> result<list<search-document>, failure>;

    /// Which of the module's types takes a file, by name and first bytes, or
    /// with `directory` a new directory.
    claims: async func(name: string, first: list<u8>, directory: bool, fallback: bool) -> option<content-type-id>;

    /// A child or file change made to content bytes, or to the type's default
    /// for none. None when it does not apply.
    apply: async func(
        content-type: content-type-id,
        bytes: option<list<u8>>,
        client: client-id,
        change: change,
    ) -> result<option<list<u8>>, failure>;
}

world type-module {
    import host;
    export replicas;
}
