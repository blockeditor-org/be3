package be3:block-type@0.1.0;

/// What a type module offers: a replica for each open block, and requests
/// that need none. A call the module makes under a stateless request has the
/// request as its parent; the host serves only `read-part` there, and only of
/// the parts of the `loaded` content the request was handed.
interface replicas {
    use types.{
        account-id, block-id, block-place, change, client-id, commit-id, content-type-id, description, editor-id,
        endpoint, failure, journal, loaded, merged, merged-parts, organization-id, part-ref, plain-file,
        journal-entry, log-item, search-document, session-state, session-tag, type-info,
    };

    record opening {
        block: block-id,
        content-type: content-type-id,
        organization: organization-id,
        /// The account this device signs in as: what it added is what a restart
        /// shows as still sending (`server-head`).
        account: account-id,
        client: client-id,
        tag: session-tag,
        /// The replica's submissions name it, kept across its reopenings, so a
        /// reopened replica knows its own in the journal.
        origin: u64,
        /// How many local edits the host gave earlier openings of this replica
        /// and gives this one no more: the first edit it is given is the next.
        taken-before: u64,
        /// The last of the local edits it is given again that an earlier
        /// opening submitted to the server without hearing it ordered, when it
        /// opens before joining its session (after the host stopped): it shows
        /// them, but neither numbers nor submits them, since the server may
        /// hold them already. Once joined, the server's order says which.
        doubtful-through: u64,
        /// For local edits the host kept across a stop: the most times the
        /// session had started over that the host saw of its replicas
        /// (`status.restarts`), under which they and `kept-submissions` were
        /// made, and the number of the last of them. Opened on an order
        /// restarted since, those edits are dropped, each told to its editor
        /// as not sent, and the kept submissions with them.
        kept-restart: u64,
        kept-through: u64,
        /// The last local edit the host submitted to the server for this
        /// block's origin, which the server may hold: when the order's base no
        /// longer names the origin (only the most recent are kept), those not
        /// seen in the order fail as possibly sent rather than be sent again.
        kept-submitted: u64,
        /// The submissions earlier openings made online of the local edits it
        /// is given again, oldest first. Once joined, the replica submits the
        /// edits each holds as exactly that submission, under its id, so a
        /// server that holds it already answers it held rather than number
        /// those edits a second time.
        kept-submissions: list<kept-submission>,
        /// The head the host just read; the replica reads it itself.
        head: option<commit-id>,
        session: session-state,
        /// The block's journal by this module's build, when its base is
        /// `head`: the replica loads the base and replays it.
        journal: option<journal>,
        /// Edits of this block made with another build were lost: its journal
        /// on `head` holds some this module cannot replay, or the server
        /// marked them lost since the last commit.
        lost-edits: bool,
        /// `journal` is this device's, numbered offline: the server lacks it.
        journal-kept: bool,
        /// Whether this device keeps commits of the block the server lacks: an
        /// edit an earlier replica kept for one is sending, failed, or held.
        commits-kept: kept-commits,
        /// The head this device last heard the server hold, none when it never
        /// heard of one. With commits kept, what `head` adds over it is still
        /// sending (`LiveEdit::unsent_over`), which a replica of a restarted host
        /// or module, with no earlier replica's edits to carry, shows so.
        server-head: option<commit-id>,
        /// Commits of the block the server refused that this device still holds, set
        /// aside in the unsent area. They stay there after the edit that sent them is
        /// let go, so a replica applies the refusal of each commit once.
        refused-commits: list<commit-id>,
        /// The block's head when it is a seal made on `head`, which the journal
        /// is still on: its holder stopped after the server took the seal and
        /// before it trimmed the journal. The replica replays the journal on
        /// `head`, then takes `sealed-head.commit` as its head, holding the
        /// order through `sealed-head.through`.
        sealed-head: option<sealed-head>,
        /// Which opening of this replica this is: the host counts each
        /// `reopen`, and the replica says it with every `status`, so a status
        /// an earlier opening made that reaches the host after it reopened is
        /// told apart and ignored.
        epoch: u64,
    }

    /// A submission an earlier opening of a replica made: its counter under
    /// the replica's origin, the last local edit it holds (`through`), and its
    /// payload as the module wrote it.
    record kept-submission {
        counter: u64,
        through: u64,
        payload: list<u8>,
    }

    record sealed-head {
        commit: commit-id,
        through: u64,
    }

    enum kept-commits {
        /// None: what an earlier replica kept reached the server.
        none,
        /// In the outbox, still to be sent.
        outbox,
    }

    /// The device's one replica of a block. Dropping it closes it: it seals
    /// what it owes and then ends, and the host leaves the session once it has.
    /// Until then calls still reach it.
    resource replica {
        constructor(opening: opening);

        /// Starts over as if just opened, dropping what it holds, as after the
        /// host reconnected. The host replays what it kept.
        reopen: async func(opening: opening);

        /// `at` is the module's clock when the host sent it, which the replica
        /// reads the message at even when the clock's stream has yet to say so.
        message: async func(%from: endpoint, bytes: list<u8>, at: u64);

        /// An editor instance starts following the block, or its `editable`
        /// changed. The replica drops edits from an editor attached read-only.
        /// `acknowledged` is how many of the editor's operations the content
        /// the replica opened on already holds, in the editor's own count: every
        /// `operate` it sent, taken or refused, less those the host still keeps
        /// to give again. Zero for an editor new to the block. The replica sends
        /// the editor nothing but peers' presence until `resent`.
        attach: async func(editor: editor-id, editable: bool, acknowledged: u64);

        /// The host gave the replica again what it kept of the editor's edits
        /// (right after `attach` when it kept none): the replica sends the
        /// editor its snapshot, which holds them all.
        resent: async func(editor: editor-id);

        /// The editor stops following the block; the replica forgets its count.
        detach: async func(editor: editor-id);

        /// A head landed after the one the replica opened at. The host calls it
        /// for every such head, including the remote head when the replica
        /// opened at a local head that differs (the replica does not reconcile
        /// on opening), and those this device publishes outside the session.
        head-moved: async func(head: commit-id);

        /// The session's membership changed: the lease follows from it.
        lease: async func(session: session-state);

        /// The server took a seal: `commit` holds the order through
        /// `through` in the run `restarts` (`status.restarts`), and the
        /// server's journal starts from it. A replica that does not hold the
        /// lease takes it as its base once it applied that far in that run; the
        /// head still reaches it as the block's too (`head-moved`).
        sealed: async func(commit: commit-id, through: u64, restarts: u64);

        /// The order numbered these submissions, in order, this replica's own
        /// among them: the host hands on every one it hears, and reopens the
        /// replica when it missed some.
        sequenced: async func(entries: list<journal-entry>);

        /// Claim the lease once the replica has loaded, as a terminal host does.
        claim: async func();

        /// False when it did not apply.
        change: async func(change: change) -> bool;

        /// Entries appended to the block's signed log since the replica read it,
        /// in order: those the device heard of from the server, its own too.
        logged: async func(items: list<log-item>);

        /// The visible bytes, for export and duplication; none while unreadable.
        content: async func() -> option<list<u8>>;

        /// `force` is a rekey: publish even when clean.
        seal: async func(force: bool);

        /// Commits of the block this device kept (`publish-outcome.kept`) reached
        /// the server: `commits` names the heads that were published, and every
        /// kept commit up to one of them has drained. With `refused` the server
        /// refused them and they will not reach it: `commits` then lists the
        /// commits that were refused, whether set aside in the unsent area or
        /// still in the outbox.
        drained: async func(refused: bool, commits: list<commit-id>);
    }

    /// Seeds the module's entropy, starts its clock and lists its types, each with
    /// its blank content and that content's description.
    start: async func(entropy: list<u8>) -> list<type-info>;

    /// Content bytes (none for the type's default) with a journal of this
    /// build replayed on top, for a reader outside the session.
    replay: async func(
        content-type: content-type-id,
        bytes: option<list<u8>>,
        journal: journal,
    ) -> result<list<u8>, failure>;

    /// A side that is none is the type's default.
    merge3: async func(
        content-type: content-type-id,
        base: option<list<u8>>,
        ours: option<list<u8>>,
        theirs: option<list<u8>>,
    ) -> result<merged, failure>;

    /// `merge3` for a type that merges by parts (`type-info.merges-parts`): each side as
    /// `host.load` with `first-part` answers it, or for content not saved yet, its bytes and
    /// no parts. The module reads the other parts it needs with `read-part` under this
    /// request.
    merge-parts: async func(
        content-type: content-type-id,
        base: option<loaded>,
        ours: option<loaded>,
        theirs: option<loaded>,
        organization: organization-id,
    ) -> result<merged-parts, failure>;

    describe: async func(content-type: content-type-id, bytes: list<u8>, organization: organization-id) -> result<description, failure>;

    to-file: async func(content-type: content-type-id, bytes: list<u8>) -> result<option<plain-file>, failure>;

    /// The content's searchable text (`be_block::BlockContent::search_text`); empty for a
    /// type that is not content-searchable. `content` is a commit as `host.load` answers it,
    /// only its first part for a type that loads only that (`type-info.first-part`), which
    /// reads the others with `read-part` under this request. `keys` (none for every
    /// document) and `indexed` (parts whose text the index holds) let the type spare work:
    /// it need not answer other documents nor read those parts. The host checks the answer
    /// itself: it drops documents outside `keys`, sources that are no part of `content` and
    /// bodies whose source is in `indexed`, and refuses a key answered twice.
    search-text: async func(
        content-type: content-type-id,
        content: loaded,
        keys: option<list<string>>,
        indexed: list<part-ref>,
    ) -> result<list<search-document>, failure>;

    /// Each block's place in the account's reads (`be_block_content::Unread`), for a
    /// type with `type-info.reads`: `reads` is the account's layers of the `reads`
    /// kind, each its content's bytes, lowest first. A block left out has the type's
    /// default place; a block is counted again only when its place's bytes change.
    places: async func(
        content-type: content-type-id,
        reads: list<list<u8>>,
    ) -> result<list<block-place>, failure>;

    /// How many things in `content` and `log` the account has not read, by its
    /// `place` from `places` (none: the default place). `content` is a commit of
    /// the block as `host.load` answers it (only its first part for a type with
    /// `first-part`), and `log` its signed log's latest entries for a type with
    /// `type-info.log` (`be_block_content::UNREAD_ENTRIES` at most; who signed
    /// each is not told, `unknown`).
    unread: async func(
        content-type: content-type-id,
        content: loaded,
        place: option<list<u8>>,
        log: list<log-item>,
        account: account-id,
    ) -> result<u32, failure>;

    /// Which of the module's types takes a file, by name and first bytes, or
    /// with `directory` a new directory.
    claims: async func(name: string, first: list<u8>, directory: bool, fallback: bool) -> option<content-type-id>;

    /// A child or file change made to content bytes, or to the type's default
    /// for none. None when it does not apply.
    apply: async func(
        content-type: content-type-id,
        bytes: option<list<u8>>,
        client: client-id,
        change: change,
    ) -> result<option<list<u8>>, failure>;
}

world type-module {
    import host;
    export replicas;
}
