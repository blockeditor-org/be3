cargo_package()

# be-sdk-test and everything under it that base and beui do not hold, above
# them: what every app test needs and no app ships, which app tests link
# rather than each compiling it again (guides/app_libraries.md, Tests).
wasm_library(
    libraries = [
        "//crates/be-sdk-library-base:module",
        "//crates/be-sdk-library-beui:module",
    ],
    module = "test",
)
