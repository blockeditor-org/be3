load("@root//buck/cargo:defs.bzl", "cargo_library", "cargo_package")
load("@root//buck/wasm:defs.bzl", "worker")

cargo_package()

# The smallest worker (be_sdk_worker::Work), for be-wasm-sandbox-host's tests:
# the library, whose constants they read, and :module, worker.rs linked as an
# app stages it, against the base library, which they spawn as the echo app's
# worker.
cargo_library()

worker(
    libraries = ["//crates/be-sdk-library-base:module"],
    module = "echo-worker",
)
