load("@root//buck/cargo:defs.bzl", "cargo_library")
load("@root//buck/wasm:defs.bzl", "wasm32_module")

# The browser's half of the plugin protocol's gpu abi: a real wgpu device in the
# plugin's worker, which draws what the plugin shows into canvases the page
# transferred to the worker and positions behind the app. It only exists in the
# browser, so it is only ever built for wasm32-unknown-unknown, and the web
# bundle in crates/block-app has wasm-bindgen write its JavaScript.
cargo_library(
    srcs = glob(["src/**/*.rs", "src/**/*.wgsl"]),
    target_compatible_with = ["prelude//cpu/constraints:cpu[wasm32]"],
)

wasm32_module(
    name = "module",
    library = ":block-gpu-shim",
    module = "block_gpu_shim",
    visibility = ["PUBLIC"],
)
