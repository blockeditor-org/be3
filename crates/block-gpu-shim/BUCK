load("@root//buck/cargo:defs.bzl", "cargo_library")
load("@root//buck/wasm:defs.bzl", "wasm32_module")

# The browser's half of the plugin protocol's gpu abi: it records a plugin's gpu
# calls in the plugin's worker, and the app replays them on its own device, so a
# plugin's surface is the app's texture as it is natively. It only exists in the
# browser, so it is only ever built for
# wasm32-unknown-unknown, and the web bundle in crates/block-app has wasm-bindgen
# write its JavaScript.
cargo_library(target_compatible_with = ["prelude//cpu/constraints:cpu[wasm32]"])

wasm32_module(
    name = "module",
    library = ":block-gpu-shim",
    module = "block_gpu_shim",
    visibility = ["PUBLIC"],
)
