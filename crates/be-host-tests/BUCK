# To reproduce a flake that shows only under load, run
# `./scripts/buck run //crates/be-tool-local:bin -- stress NAME`
# (crates/be-tool-local/src/stress.rs, guides/testing_a_gui.md, 6): it builds
# :test-harness, :host-with-all, //crates/be-host:bin and the sysroot targets
# run_env names, then runs the harness many times at once with each run_env
# variable set to its output. Keep its environment in step with run_env below.
cargo_test(
    apart_env = host_test_apps(APPS),
    paints = True,
    run_apart = True,
    run_env = {
        "BE_BUNDLE": "$(location :host-with-all)",
        "BE_HOST": "$(location //crates/be-host:bin)",
        "HOST_LIBRARIES": "$(location //buck/sysroot:amd64-test)/usr/lib/x86_64-linux-gnu:$(location //buck/sysroot:amd64)/usr/lib/x86_64-linux-gnu",
        "VK_ICD_FILENAMES": "$(location //buck/sysroot:lavapipe_icd.json)",
        "XKB_CONFIG_ROOT": "$(location //buck/sysroot:amd64-test)/usr/share/X11/xkb",
    },
    target_compatible_with = ["prelude//os:linux", "prelude//cpu:x86_64"],
)
