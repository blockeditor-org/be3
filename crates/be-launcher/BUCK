load("@root//buck/android:defs.bzl", "android_apk")
load("@root//buck/app:drive.bzl", "headless")
load("@root//buck/cargo:defs.bzl", "cargo_binary", "cargo_library", "cargo_test")

# On Android the launcher is this library, loaded by LauncherActivity under
# cargo's name for it.
cargo_library(soname = "libbe_launcher.so")

cargo_test()

# `./scripts/buck run //crates/be-launcher:native`
cargo_binary(name = "native")

# The launcher on Android installs the APKs the build helper builds and signs
# with CI's keystore: block-app's `:android-dist` (`com.be3.block.ci`), and the
# launcher's own. As with the app, that APK has an id and label of its own, so
# that it installs beside a local build rather than colliding with it.
# `./scripts/buck run //crates/be-launcher:android -- --install` signs the
# local one here and installs it.
[
    android_apk(
        name = name,
        activity = "com.be3.launcher.LauncherActivity",
        application_id = application_id,
        java = glob(["android/java/**/*.java"]) + ["//crates/beui-platform-android:android-java"],
        label = label,
        library = ":be-launcher",
        manifest = "android/AndroidManifest.xml",
        min_sdk = 24,
        package = "com.be3.launcher",
        resources = "//crates/block-app:android-res",
        signing = signing,
        target_sdk = 35,
        version_code = 1,
        version_name = "0.1.0",
    )
    for name, application_id, label, signing in [
        ("android", "com.be3.launcher", "be3 launcher", "dev"),
        ("android-dist", "com.be3.launcher.ci", "be3 launcher (CI)", "ci"),
    ]
]

# Headless for an agent to drive: guides/running/drive.md.
headless(
    name = "dev",
    app_name = "be-launcher",
    program = "$(location :native)",
)
