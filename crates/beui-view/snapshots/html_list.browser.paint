    "</div>",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); height: 30px; justify-items: stretch; align-items: stretch; background-color: #3caa6e; flex: 2 0 0px;\">",
    "</div>",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); height: 30px; justify-items: stretch; align-items: stretch; background-color: #ebaa32; flex: 0 0 50px;\">",
    "</div>",
    "</div>",
    "<div style=\"display: flex; flex-direction: row; align-items: end; justify-content: space-between; flex: 0 0 auto;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); width: 30px; height: 50px; justify-items: stretch; align-items: stretch; background-color: #1e1e28; flex: 0 0 auto;\">",
    "</div>",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); width: 30px; height: 20px; justify-items: stretch; align-items: stretch; background-color: #466edc; flex: 0 0 auto;\">",
    "</div>",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); width: 30px; height: 35px; justify-items: stretch; align-items: stretch; background-color: #3caa6e; flex: 0 0 auto;\">",
    "</div>",
    "</div>",
    "<div style=\"display: flex; flex-direction: row; align-items: stretch; flex-wrap: wrap; gap: 6px; flex: 0 0 auto;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); width: 90px; height: 20px; justify-items: stretch; align-items: stretch; background-color: #ebaa32; flex: 0 0 auto;\">",
