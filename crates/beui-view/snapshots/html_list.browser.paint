    "<!doctype html>",
    "<html>",
    "<head>",
    "<meta charset=\"utf-8\">",
    "<style>",
    ".beui-root { display: grid; grid-template-columns: minmax(0, 1fr); width: 100%; min-height: 100%; }\n.beui-root, .beui-root * { box-sizing: border-box; margin: 0; }\n.beui-break::after { content: \"\\A\"; white-space: pre; }\n.beui-stand-in { outline: 2px dashed #ff69b4; outline-offset: -2px; }\nbody { margin: 0; height: 100vh; font: 14px sans-serif; }</style>",
    "</head>",
    "<body>",
    "<div class=\"beui-root\" style=\"background-color: #fafaf7;\">",
    "<div style=\"display: flex; flex-direction: column; align-items: stretch; gap: 10px;\">",
    "<div style=\"display: flex; flex-direction: row; align-items: stretch; gap: 8px; flex: 0 0 auto;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); width: 40px; height: 30px; justify-items: stretch; align-items: stretch; background-color: #466edc; flex: 0 0 auto;\">",
    "</div>",
    "<div style=\"flex: 1 0 0px;\">",
    "</div>",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); width: 40px; height: 30px; justify-items: stretch; align-items: stretch; background-color: #3caa6e; flex: 0 0 auto;\">",
    "</div>",
