  ],
  "document": [
    "<!doctype html>",
    "<html>",
    "<head>",
    "<meta charset=\"utf-8\">",
    "<style>",
    ".beui-root[data-scheme=light] { color-scheme: light; }\n.beui-root[data-scheme=dark] { color-scheme: dark; }\n:root { overscroll-behavior: none; }\n.beui-root { color-scheme: light dark; display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); position: fixed; inset: 0; overflow: clip; overscroll-behavior: none; }\n.beui-root, .beui-root * { box-sizing: border-box; margin: 0; }\n.beui-root [tabindex], .beui-overlay { outline: none; }\n.beui-break::after { content: \"\\A\"; white-space: pre; }\n.beui-icon { display: inline-block; vertical-align: top; }\n.beui-icon:not(:first-child) { margin-inline-start: var(--beui-icon-spacing, 0); }\n.beui-icon:not(:last-child) { margin-inline-end: var(--beui-icon-spacing, 0); }\n.beui-icon + .beui-icon { margin-inline-start: 0; }\n.beui-glyph { position: relative; }\n.beui-glyph::before { content: attr(data-glyph); position: absolute; top: 0; left: 0; right: 0; display: flex; justify-content: center; white-space: pre; line-height: normal; font: var(--beui-glyph-font); color: var(--beui-glyph-color); pointer-events: none; }\n.beui-text-decor { position: absolute; inset: 0; pointer-events: none; }\n.beui-text-decor >",
    " * { position: absolute; }\n.beui-mark { z-index: -1; }\n.beui-caret-blink { animation: beui-caret-blink 1060ms steps(1, end) infinite; }\n@keyframes beui-caret-blink { 50% { opacity: 0; } }\n@media (prefers-reduced-motion: reduce) { .beui-caret-blink { animation: none; } }\n.beui-layers >",
    " * + * { pointer-events: none; }\n.beui-stand-in { outline: 2px dashed #ff69b4; outline-offset: -2px; }\n.beui-overlay { position: fixed; inset: auto; margin: 0; padding: 0; border: 0; background: transparent; color: inherit; pointer-events: auto; max-width: none; max-height: none; overflow: visible; }\n.beui-overlay:is([open], :popover-open) { display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); }\n.beui-overlay::backdrop { background: var(--beui-scrim, transparent); }\n.beui-beak { position: absolute; z-index: -1; width: var(--beui-beak); height: var(--beui-beak); top: calc(var(--beui-beak) / -2); left: calc(50% - var(--beui-beak) / 2); transform: rotate(45deg); }\n.beui-beak[hidden] { display: none; }\n@container anchored(fallback: flip-block) { .beui-beak { top: auto; bottom: calc(var(--beui-beak) / -2); } }\n@font-face { font-family: Inter; src: url(\"./Inter-Regular.ttf\") format(\"truetype\"); font-display: block; }\n@font-face { font-family: Hack; src: url(\"./Hack-Regular.ttf\") format(\"truetype\"); font-display: block; }\n@font-face { font-family: NotoEmoji; src: url(\"./NotoEmoji-Regular.ttf\") format(\"truetype\"); font-display: block; unicode-range: U+200D, U+20E3, U+2100-2BFF, U+3030, U+303D, U+3297, U+3299, U+FE0F, U+1F000-1FAFF; }\n@font-face { font-family: lucide; src: url(\"./lucide.ttf\") format(\"truetype\"); font-display: block; }\nbody { margin: 0; height: 100vh; font: 14px sans-serif; }</style>",
    "</head>",
    "<body>",
    "<div class=\"beui-root\" style=\"background-color: #fafaf7;\">",
    "<div style=\"display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); padding: 20px 20px 20px 20px; justify-items: start; align-items: start;\">",
    "<div style=\"display: flex; flex-direction: column; align-items: start; gap: 80px;\">",
    "<div style=\"display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); width: 80px; height: 30px; justify-items: stretch; align-items: stretch; background-color: #466edc; anchor-name: --beui-anchor-0-0; flex: 0 0 auto;\">",
    "</div>",
    "<div style=\"display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); width: 60px; height: 30px; justify-items: stretch; align-items: stretch; background-color: #3caa6e; anchor-name: --beui-anchor-1-0; flex: 0 0 auto;\">",
    "</div>",
    "<div style=\"display: contents; flex: 0 0 auto;\">",
    "<div style=\"position: fixed; visibility: hidden; pointer-events: none;\">",
    "</div>",
    "<dialog class=\"beui-overlay\" popover=\"manual\" open=\"\" style=\"position-anchor: --beui-anchor-0-0; position-area: bottom span-right; position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;\">",
    "<!--[-->",
    "<div style=\"display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); width: 100px; height: 60px; justify-items: stretch; align-items: stretch; background-color: #ebaa32;\">",
    "</div>",
    "<!--]-->",
    "<div class=\"beui-beak\" hidden=\"\">",
    "</div>",
    "</dialog>",
    "</div>",
    "<div style=\"display: contents; flex: 0 0 auto;\">",
    "<div style=\"position: fixed; visibility: hidden; pointer-events: none;\">",
    "</div>",
    "<dialog class=\"beui-overlay\" popover=\"manual\" open=\"\" style=\"position-anchor: --beui-anchor-1-0; position-area: bottom; position-try-fallbacks: flip-block; margin-top: 12px; max-width: calc(100vw - 16px);\">",
    "<!--[-->",
    "<div style=\"display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); padding: 8px 8px 8px 8px; justify-items: stretch; align-items: stretch; background-color: #1e1e28; border-radius: 6px 6px 6px 6px;\">",
    "<div style=\"font: 14px Inter, NotoEmoji, system-ui, sans-serif; line-height: 16px; color: #fafaf7; white-space: pre-wrap; overflow-wrap: break-word;\">",
    "Pointing up</div>",
    "</div>",
    "<!--]-->",
    "<div class=\"beui-beak\" style=\"--beui-beak: 11.314px; background-color: #1e1e28;\">",
    "</div>",
    "</dialog>",
    "</div>",
    "</div>",
    "</div>",
    "<style>",
    ".beui-root { }\n@media (prefers-color-scheme: dark) { .beui-root:not([data-scheme=light]) { } }\n.beui-root[data-scheme=light] { }\n.beui-root[data-scheme=dark] { }\n</style>",
    "</div>",
    "</body>",
    "</html>"
  ],
