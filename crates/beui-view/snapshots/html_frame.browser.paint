BE3BROWSER 1
{
  "size": [
    320,
    240
  ],
  "document": [
    "<!doctype html>",
    "<html>",
    "<head>",
    "<meta charset=\"utf-8\">",
    "<style>",
    ".beui-root { display: grid; grid-template-columns: minmax(0, 1fr); width: 100%; min-height: 100%; }\n.beui-root, .beui-root * { box-sizing: border-box; margin: 0; }\n.beui-break::after { content: \"\\A\"; white-space: pre; }\n.beui-stand-in { outline: 2px dashed #ff69b4; outline-offset: -2px; }\nbody { margin: 0; height: 100vh; font: 14px sans-serif; }</style>",
    "</head>",
    "<body>",
    "<div class=\"beui-root\" style=\"background-color: #fafaf7;\">",
    "<div style=\"display: flex; flex-direction: row; align-items: start; gap: 12px;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); width: 120px; height: 120px; padding: 12px 12px 12px 12px; justify-items: center; align-items: center; background-color: #466edc; border-radius: 16px 16px 16px 16px; flex: 0 0 auto;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); width: 40px; height: 40px; justify-items: stretch; align-items: stretch; background-color: #ebaa32;\">",
    "</div>",
    "</div>",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); width: 120px; aspect-ratio: 2; justify-items: end; align-items: start; background-color: #3caa6e; outline: 3px solid #1e1e28; outline-offset: 2px; flex: 0 0 auto;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); width: 20px; height: 20px; justify-items: stretch; align-items: stretch; background-color: #1e1e28;\">",
    "</div>",
    "</div>",
    "</div>",
    "</div>",
    "</body>",
    "</html>"
  ],
  "files": {}
}
