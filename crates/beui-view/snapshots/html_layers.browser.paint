  "document": [
    "<!doctype html>",
    "<html>",
    "<head>",
    "<meta charset=\"utf-8\">",
    "<style>",
    ".beui-root { display: grid; grid-template-columns: minmax(0, 1fr); width: 100%; min-height: 100%; }\n.beui-root, .beui-root * { box-sizing: border-box; margin: 0; }\n.beui-break::after { content: \"\\A\"; white-space: pre; }\n.beui-stand-in { outline: 2px dashed #ff69b4; outline-offset: -2px; }\nbody { margin: 0; height: 100vh; font: 14px sans-serif; }</style>",
    "</head>",
    "<body>",
    "<div class=\"beui-root\" style=\"background-color: #fafaf7;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); justify-items: start; align-items: start;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr);\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); width: 120px; height: 100px; justify-items: stretch; align-items: stretch; background-color: #466edc; grid-area: 1 / 1;\">",
    "</div>",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; align-items: center; grid-area: 1 / 1;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); width: 40px; height: 40px; justify-items: stretch; align-items: stretch; background-color: #ebaa32;\">",
    "</div>",
    "</div>",
    "</div>",
    "</div>",
    "</div>",
    "</body>",
    "</html>"
  ],
  "files": {}
}
