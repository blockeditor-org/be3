    "<image width=\"8\" height=\"8\" preserveAspectRatio=\"none\" href=\"data:image/png;base64,\" filter=\"url(#beui-drawing0-0-f2)\" style=\"image-rendering: pixelated;\"/>",
    "</svg>",
    "</svg>",
    "</div>",
