  "document": [
    "<!doctype html>",
    "<html>",
    "<head>",
    "<meta charset=\"utf-8\">",
    "<style>",
    ".beui-root { display: grid; grid-template-columns: minmax(0, 1fr); width: 100%; min-height: 100%; }\n.beui-root, .beui-root * { box-sizing: border-box; margin: 0; }\n.beui-break::after { content: \"\\A\"; white-space: pre; }\n.beui-stand-in { outline: 2px dashed #ff69b4; outline-offset: -2px; }\nbody { margin: 0; height: 100vh; font: 14px sans-serif; }</style>",
    "</head>",
    "<body>",
    "<div class=\"beui-root\" style=\"background-color: #fafaf7;\">",
    "<div style=\"display: flex; flex-direction: column; align-items: start; gap: 12px;\">",
    "<div class=\"beui-stand-in\" title=\"TODO: Canvas\" style=\"position: relative; overflow: hidden; min-width: 200px; min-height: 60px; flex: 0 0 auto;\">",
    "<div style=\"position: absolute; left: 10px; top: 10px; width: 40px; height: 40px; overflow: hidden;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); width: 40px; height: 40px; justify-items: stretch; align-items: stretch; background-color: #466edc;\">",
    "</div>",
    "</div>",
    "<div style=\"position: absolute; left: 60px; top: 20px; width: 40px; height: 30px; overflow: hidden;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); width: 40px; height: 30px; justify-items: stretch; align-items: stretch; background-color: #3caa6e;\">",
    "</div>",
    "</div>",
    "</div>",
    "<div class=\"beui-stand-in\" title=\"TODO: VirtualList\" style=\"display: flex; flex-direction: column; flex: 0 0 auto;\">",
    "<!--[-->",
    "<div style=\"font: 14px Inter, system-ui, sans-serif; color: #1e1e28; white-space: pre-wrap; overflow-wrap: break-word;\">",
    "Row 1</div>",
    "<div style=\"font: 14px Inter, system-ui, sans-serif; color: #1e1e28; white-space: pre-wrap; overflow-wrap: break-word;\">",
    "Row 2</div>",
    "<div style=\"font: 14px Inter, system-ui, sans-serif; color: #1e1e28; white-space: pre-wrap; overflow-wrap: break-word;\">",
    "Row 3</div>",
    "<!--]-->",
    "</div>",
    "<div class=\"beui-stand-in\" title=\"TODO: Portal\" style=\"min-width: 16px; min-height: 16px; background-color: #ff69b4; flex: 0 0 auto;\">",
    "</div>",
    "<div style=\"position: relative; flex: 0 0 auto;\">",
    "<!--[-->",
    "<div class=\"beui-stand-in\" title=\"TODO: OverlayContent\" style=\"position: absolute; top: 100%; left: 0; z-index: 1000;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); width: 60px; height: 20px; justify-items: stretch; align-items: stretch; background-color: #ebaa32;\">",
    "</div>",
    "</div>",
    "<!--]-->",
    "</div>",
    "</div>",
    "</div>",
    "</body>",
    "</html>"
  ],
  "files": {}
}
