BE3BROWSER 1
{
  "size": [
    320,
    260
  ],
  "document": [
    "<!doctype html>",
    "<html>",
    "<head>",
    "<meta charset=\"utf-8\">",
    "<style>",
    ".beui-root { display: grid; grid-template-columns: minmax(0, 1fr); width: 100%; min-height: 100%; }\n.beui-root, .beui-root * { box-sizing: border-box; margin: 0; }\n.beui-break::after { content: \"\\A\"; white-space: pre; }\n.beui-layers >",
    " * + * { pointer-events: none; }\n.beui-stand-in { outline: 2px dashed #ff69b4; outline-offset: -2px; }\n.beui-overlay { position: fixed; inset: auto; margin: 0; padding: 0; border: 0; background: transparent; color: inherit; pointer-events: auto; max-width: none; max-height: none; overflow: visible; }\n.beui-overlay::backdrop { background: var(--beui-scrim, transparent); }\n.beui-beak { position: absolute; z-index: -1; width: var(--beui-beak); height: var(--beui-beak); top: calc(var(--beui-beak) / -2); left: calc(50% - var(--beui-beak) / 2); transform: rotate(45deg); }\n.beui-beak[hidden] { display: none; }\n@container anchored(fallback: flip-block) { .beui-beak { top: auto; bottom: calc(var(--beui-beak) / -2); } }\nbody { margin: 0; height: 100vh; font: 14px sans-serif; }</style>",
    "</head>",
    "<body>",
    "<div class=\"beui-root\" style=\"background-color: #fafaf7;\">",
    "<div style=\"display: flex; flex-direction: column; align-items: stretch; gap: 12px;\">",
    "<div style=\"font: 14px Inter, system-ui, sans-serif; color: #1e1e28; white-space: pre-wrap; overflow-wrap: break-word; flex: 0 0 auto;\">",
    "A paragraph long enough to wrap onto a second line in a narrow window.</div>",
    "<div style=\"font: 14px Inter, system-ui, sans-serif; color: #1e1e28; white-space: pre; overflow: hidden; text-overflow: ellipsis; flex: 0 0 auto;\">",
    "A line too long for its box is cut with an ellipsis at its end.</div>",
    "<div style=\"font: 18px Inter, system-ui, sans-serif; color: #1e1e28; text-align: center; align-content: center; white-space: pre-wrap; overflow-wrap: break-word; flex: 0 0 auto;\">",
    "Centred and larger</div>",
    "<div style=\"font: 14px Inter, system-ui, sans-serif; color: #1e1e28; white-space: pre-wrap; overflow-wrap: break-word; flex: 0 0 auto;\">",
    "<span>",
    "Plain, </span>",
    "<span style=\"font-weight: bold;\">",
    "bold</span>",
    "<span>",
    ", </span>",
    "<span style=\"font-style: italic; color: #466edc;\">",
    "blue italic</span>",
    "<span>",
    ", </span>",
    "<span style=\"text-decoration-line: underline;\">",
    "underlined</span>",
    "<span style=\"display: inline-block; user-select: none; width: 24px;\">",
    "</span>",
    "<span style=\"background-color: #ebaa32; border-radius: 3px; box-decoration-break: clone; -webkit-box-decoration-break: clone;\">",
    "marked</span>",
    "<span class=\"beui-break\">",
    "</span>",
    "<span>",
    "and a line after a break.</span>",
    "</div>",
    "<div style=\"font: 14px Inter, system-ui, sans-serif; color: #1e1e28; white-space: pre-wrap; overflow-wrap: break-word; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; flex: 0 0 auto;\">",
    "At most two lines are shown of this text, which would otherwise run on to a third and a fourth line in this box.</div>",
    "</div>",
    "</div>",
    "</body>",
    "</html>"
  ],
  "files": {}
}
