BE3BROWSER 1
{
  "size": [
    320,
    160
  ],
  "document": [
    "<!doctype html>",
    "<html>",
    "<head>",
    "<meta charset=\"utf-8\">",
    "<style>",
    ".beui-root { display: grid; grid-template-columns: minmax(0, 1fr); width: 100%; min-height: 100%; }\n.beui-root, .beui-root * { box-sizing: border-box; margin: 0; }\n.beui-break::after { content: \"\\A\"; white-space: pre; }\n.beui-stand-in { outline: 2px dashed #ff69b4; outline-offset: -2px; }\nbody { margin: 0; height: 100vh; font: 14px sans-serif; }</style>",
    "</head>",
    "<body>",
    "<div class=\"beui-root\" style=\"background-color: #fafaf7;\">",
    "<div style=\"display: flex; flex-direction: row; align-items: center; gap: 24px;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); justify-items: stretch; align-items: stretch; transform: translate(10px, 20px); flex: 0 0 auto;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); width: 60px; height: 60px; justify-items: stretch; align-items: stretch; background-color: #466edc;\">",
    "</div>",
    "</div>",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); justify-items: stretch; align-items: stretch; transform: rotate(0.785rad); flex: 0 0 auto;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); width: 60px; height: 60px; justify-items: stretch; align-items: stretch; background-color: #3caa6e;\">",
    "</div>",
    "</div>",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); justify-items: stretch; align-items: stretch; opacity: 0.4; flex: 0 0 auto;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); width: 60px; height: 60px; justify-items: stretch; align-items: stretch; background-color: #1e1e28;\">",
    "</div>",
    "</div>",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); justify-items: stretch; align-items: stretch; mask-image: linear-gradient(to right, transparent 0px, #000 20px, #000 calc(100% - 20px), transparent 100%); -webkit-mask-image: linear-gradient(to right, transparent 0px, #000 20px, #000 calc(100% - 20px), transparent 100%); flex: 0 0 auto;\">",
    "<div style=\"display: grid; grid-template-columns: minmax(0, 1fr); width: 80px; height: 60px; justify-items: stretch; align-items: stretch; background-color: #ebaa32;\">",
    "</div>",
    "</div>",
    "</div>",
    "</div>",
    "</body>",
    "</html>"
  ],
  "files": {}
}
