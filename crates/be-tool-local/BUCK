load("@root//buck/cargo:defs.bzl", "cargo_binary", "cargo_library", "cargo_test")
load("@root//buck/platforms:profile.bzl", "released")
load(":defs.bzl", "deploy")

# What runs on this machine once a buck2 command has built what it needs,
# built for this machine in that same command: `verify` for ./scripts/verify
# and ./scripts/ci after buck/dev/verify.bxl, `deploy` for ./scripts/deploy, and
# `fuzz` for a fuzz target and //:fuzz (cargo_fuzz in buck/cargo/defs.bzl).

cargo_library()

cargo_test(
    env = {
        "APK_SIGN_JDK": "$(location //buck/android:jdk)",
        "APK_SIGN_TOOLS": "$(location //buck/android:build-tools)",
    },
)

cargo_binary()

# What CI downloads for its Android builds and paint previews
# (the previews part of buck/dev/verify.bxl), a quarter the size of :bin.
released(
    name = "release",
    actual = ":bin",
)

# What ./scripts/deploy runs: :deploy, or with --skip-android
# :deploy-without-android, or with --skip-downloads :deploy-without-downloads,
# each leaving those downloads out of the build.
[
    deploy(
        name = name,
        app_android = "//crates/be-host:android-release" if android else None,
        app_linux_arm64 = native_app,
        app_linux_x86_64 = native_app,
        app_macos_arm64 = native_app,
        app_macos_x86_64 = native_app,
        app_windows_arm64 = native_app,
        app_windows_x86_64 = native_app,
        be_linux_arm64 = "//crates/be-tool-cli:native",
        be_linux_x86_64 = "//crates/be-tool-cli:native",
        server = "//crates/be-server-bin:bin",
        tool = ":bin",
        web = "//crates/be-host:web",
        web_download = native_app != None,
    )
    for name, native_app, android in [
        ("deploy", "//crates/be-host:native", True),
        ("deploy-without-android", "//crates/be-host:native", False),
        ("deploy-without-downloads", None, False),
    ]
]

[
    genrule(
        name = name + "-index",
        cmd = "$(exe :bin) web-page " + name + " $OUT",
        out = "index.html",
    )
    for name in ["host", "demo", "paint-review"]
]
