load("@root//buck/app:defs.bzl", "app")
load("@root//buck/cargo:defs.bzl", "cargo_binary", "cargo_library", "cargo_test")

cargo_library()

cargo_test()

# be carries the first-party type module in its executable, so a release is one
# file (guides/type_modules.md, "Hosts").
cargo_binary(
    env = {
        "BUILTIN_TYPES_WASM": "$(location //crates/builtin-types:module)",
    },
)

# be with its build-info.json file beside it, which it greets the server with:
# `./scripts/buck run //crates/be-cli:native -- ARGS`.
app(
    name = "native",
    binary = ":bin",
    executable_name = "be",
    files = ["//buck/app:build-info.json"],
    manifests = [],
    modules = [],
    visibility = ["//crates/local-tools:"],
)
