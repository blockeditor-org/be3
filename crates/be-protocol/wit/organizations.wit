package be3:server@0.1.0;

/// An account's organizations, and invitations into them.
interface organizations {
    use types.{
        account-id, error, escrow-key, invitation-id, organization-id, organization-kind,
        organization-role, public-key,
    };

    record organization {
        id: organization-id,
        name: string,
        kind: organization-kind,
        role: organization-role,
    }

    record organization-invitation {
        id: invitation-id,
        organization: organization-id,
        organization-name: string,
        email: string,
        role: organization-role,
        invited-by: account-id,
        sealed: list<u8>,
        escrow: list<u8>,
    }

    /// The server's own account, which blocks shared with the server are
    /// sealed to.
    record server-account {
        account: account-id,
        public: public-key,
    }

    /// An organization this connection now works in: the caller's role, the
    /// escrow chain, and the escrow key the caller pinned, sealed to itself
    /// (empty when none).
    record organization-opened {
        organization: organization-id,
        role: organization-role,
        kind: organization-kind,
        escrows: list<escrow-key>,
        pinned: list<u8>,
        server: server-account,
    }

    /// Replaces `ListOrganizations` and its `Organizations` answer.
    list-organizations: async func() -> result<list<organization>, error>;

    /// Makes a company organization with the caller as its administrator.
    /// Replaces `CreateOrganization`, which answered `Organizations` with the
    /// one it made.
    create-organization: async func(name: string) -> result<organization, error>;

    /// Makes `organization` the one every later block, key and member call
    /// of this connection works in, and starts over what the connection
    /// listed. Replaces `OpenOrganization` and its `OrganizationOpened`.
    open-organization: async func(organization: organization-id) -> result<organization-opened, error>;

    /// Invites `email` into `organization` with `role`; `sealed` and
    /// `escrow` are sealed with the invite code, which `code` names.
    /// Replaces `Invite`.
    invite: async func(
        invitation: invitation-id,
        organization: organization-id,
        email: string,
        role: organization-role,
        sealed: list<u8>,
        code: list<u8>,
        escrow: list<u8>,
    ) -> result<_, error>;

    /// Replaces `GetInvitation` and its `Invitation` answer.
    get-invitation: async func(invitation: invitation-id) -> result<organization-invitation, error>;

    /// Joins the organization an invitation is for, leaving the caller's
    /// card, its contact card for the inviter, and the escrow key it pins.
    /// Replaces `AcceptInvitation`.
    accept-invitation: async func(
        invitation: invitation-id,
        card: list<u8>,
        contact: list<u8>,
        escrow: list<u8>,
    ) -> result<_, error>;
}

/// The members and agents of the organization this connection opened, or of
/// the one named.
interface members {
    use types.{account-id, error, organization-id, organization-role, public-key};

    record member {
        account: account-id,
        email: string,
        display-name: string,
        role: organization-role,
        agent: bool,
        contact: bool,
    }

    record agent {
        account: account-id,
        name: string,
        email: string,
    }

    /// An agent just made, with the token it signs in with.
    record created-agent {
        agent: agent,
        token: string,
    }

    /// Replaces `ListMembers` and its `Members` answer.
    list-members: async func() -> result<list<member>, error>;

    /// Replaces `SetRole`.
    set-role: async func(account: account-id, role: organization-role) -> result<_, error>;

    /// Replaces `RemoveMember`.
    remove-member: async func(account: account-id) -> result<_, error>;

    /// Makes an agent account in `organization` with the recovery key
    /// `recovery`, a contact card for the caller, and its escrow key sealed
    /// for it. Replaces `CreateAgent` and its `AgentCreated` answer.
    create-agent: async func(
        organization: organization-id,
        name: string,
        recovery: public-key,
        contact: list<u8>,
        escrow: list<u8>,
    ) -> result<created-agent, error>;

    /// Replaces `ListAgents` and its `Agents` answer.
    list-agents: async func(organization: organization-id) -> result<list<agent>, error>;

    /// Replaces `RemoveAgent`.
    remove-agent: async func(organization: organization-id, account: account-id) -> result<_, error>;
}
