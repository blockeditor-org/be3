package be3:server@0.1.0;

/// The keys of the organization this connection opened, and the account's
/// own recovery key.
interface keys {
    use types.{
        account-id, block-id, error, escrow-key, key-change, key-id, key-set, own-sealed,
        public-key, sealed-key,
    };

    /// An account's signing key as the server has it, which nothing verified
    /// (plans/authorship.md).
    record signing-key {
        account: account-id,
        key: public-key,
    }

    record recovery-key {
        public: option<public-key>,
        sealed: list<sealed-key>,
        %own: list<own-sealed>,
    }

    /// A scope or escrow key not yet sealed to an account that should hold
    /// it.
    record unsealed {
        key: key-id,
        account: account-id,
    }

    /// A page of `get-keys`, and the last key it holds when more follow.
    record key-page {
        keys: key-set,
        next: option<key-id>,
    }

    /// What an organization's keys wait for that the caller may do: blocks
    /// whose keys to rotate, whether to rotate the escrow key, keys to seal
    /// to accounts, scope keys not yet wrapped under the escrow key, and the
    /// escrow chain.
    record key-work {
        rotations: list<block-id>,
        escrow-rotation: bool,
        unsealed: list<unsealed>,
        unescrowed: list<key-id>,
        escrows: list<escrow-key>,
    }

    /// One page of the keys of `blocks`, or of every key the caller holds
    /// with none: the keys after `after` in the order of their ids, as many
    /// as fit in half a frame with the wraps of each, and at least one. A
    /// client asks again from `next` until it is none.
    get-keys: async func(blocks: option<list<block-id>>, after: option<key-id>) -> result<key-page, error>;

    /// Stores rows, and tells `keys-changed` to every other connection of an
    /// account a key in them is sealed to or that may view a block they are
    /// of.
    put-keys: async func(keys: key-set) -> result<_, error>;

    get-recovery-key: async func() -> result<recovery-key, error>;

    /// Moves the account to a new recovery key and the signing key derived
    /// with it, with everything sealed to the old one sealed again and a key
    /// change for each contact.
    set-recovery-key: async func(
        public: public-key,
        signing: public-key,
        sealed: list<sealed-key>,
        %own: list<own-sealed>,
        changes: list<key-change>,
    ) -> result<_, error>;

    /// The signing keys of those of `accounts` that are the caller, its
    /// contacts or members of the organization open (in the personal
    /// organization, every account), leaving out any other and any account
    /// with none.
    get-signing-keys: async func(accounts: list<account-id>) -> result<list<signing-key>, error>;

    reseal-keys: async func(keys: list<sealed-key>) -> result<_, error>;

    /// The organization's key work for the caller: its value as the stream
    /// opens, then each new value as it may have changed through another
    /// connection, or as the connection opens an organization. Opened before
    /// any is, it waits for one to open, unlike `storage-changed`, which ends
    /// denied. A latest-value stream, so values the client has not taken yet
    /// are one item; a connection may hold several, each starting with the
    /// current value, and one whose first value cannot be read ends with the
    /// failure.
    key-work-changed: func() -> stream<key-work>;

    /// An item whenever `put-keys` stored rows the account may open through
    /// another connection, so the client asks again for keys it found
    /// missing; a latest-value stream, so changes the client has not taken
    /// yet are one item.
    keys-changed: func() -> stream;

    /// Gives every block below `roots` a new key.
    rotate: async func(roots: list<block-id>, keys: key-set) -> result<_, error>;

    /// Adds the next epoch of the escrow chain.
    create-escrow: async func(escrow: escrow-key, keys: key-set) -> result<_, error>;

    /// Keeps the escrow key the caller pinned, sealed to itself.
    pin-escrow: async func(sealed: list<u8>) -> result<_, error>;
}

/// What a client imports from the server.
world client {
    import connection;
    import account;
    import organizations;
    import members;
    import contacts;
    import objects;
    import blocks;
    import sessions;
    import keys;
    import notifications;
}
