package be3:server@0.1.0;

/// An account's organizations; invitations into them are links (`contacts`).
interface organizations {
    use types.{
        account-id, client-id, error, escrow-key, organization-id, organization-kind,
        organization-role, public-key,
    };

    /// An organization the account is a member of: its role there, and the
    /// organization's escrow chain.
    record organization {
        id: organization-id,
        name: string,
        kind: organization-kind,
        role: organization-role,
        escrows: list<escrow-key>,
    }

    /// The server's own account, which blocks shared with the server are
    /// sealed to.
    record server-account {
        account: account-id,
        public: public-key,
    }

    /// What `server-info` answers: the server's own account, its VAPID public
    /// key (RFC 8292, uncompressed P-256) a browser subscribes to pushes with,
    /// whether it sends pushes through FCM (it was started with credentials;
    /// without, a device registers only a Web Push endpoint), and its clock
    /// when it answered, in milliseconds since the epoch: a client stamps its
    /// commits no later than it plus a little, so the server takes them however
    /// fast the client's own clock runs.
    record server-info {
        server: server-account,
        push-key: list<u8>,
        offers-fcm: bool,
        time: s64,
    }

}

/// The members and agents of the organization this connection opened, or of
/// the one named.
interface members {
    use types.{account-id, block-id, error, organization-id, organization-role, public-key};

    record member {
        account: account-id,
        email: string,
        display-name: string,
        role: organization-role,
        /// For an agent, the account that made it; none for a person.
        created-by: option<account-id>,
        /// For a block's agent, its block (`create-agent`'s `bound-to`).
        bound-to: option<block-id>,
        contact: bool,
    }

    record agent {
        account: account-id,
        name: string,
        email: string,
    }

    /// An agent just made, with the token it signs in with.
    record created-agent {
        agent: agent,
        token: string,
    }

    /// A block's agent's block, and the grant of Edit on it to the agent
    /// that its creator signed (be_block_keys::Grant).
    record bound-agent {
        block: block-id,
        signed: list<u8>,
    }

}
