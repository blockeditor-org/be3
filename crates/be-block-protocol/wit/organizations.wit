package be3:server@0.1.0;

/// An account's organizations; invitations into them are links (`contacts`).
interface organizations {
    use types.{
        account-id, client-id, error, escrow-key, organization-id, organization-kind,
        organization-role, public-key,
    };

    record organization {
        id: organization-id,
        name: string,
        kind: organization-kind,
        role: organization-role,
    }

    /// The server's own account, which blocks shared with the server are
    /// sealed to.
    record server-account {
        account: account-id,
        public: public-key,
    }

    /// An organization this connection now works in: the caller's role, the
    /// escrow chain, and the escrow key the caller pinned, sealed to itself
    /// (empty when none).
    record organization-opened {
        organization: organization-id,
        /// This connection, as `block-changed.from`, pairing and sessions name
        /// it.
        client: client-id,
        role: organization-role,
        kind: organization-kind,
        escrows: list<escrow-key>,
        pinned: list<u8>,
        server: server-account,
        /// The server's clock when it answered, in milliseconds since the epoch: a client
        /// stamps its commits no later than it plus a little, so the server takes them
        /// however fast the client's own clock runs.
        time: s64,
    }

    list-organizations: async func() -> result<list<organization>, error>;

    /// Makes company organization `id`, chosen by the caller, with the caller
    /// as its administrator. `root` is the root of its access log
    /// (`be_block_keys::Entry::root`), signed by the caller with its current
    /// keys (plans/signed_access.md); `pinned` is what the caller pins for it,
    /// sealed to itself, as `pin-escrow` keeps it.
    create-organization: async func(
        id: organization-id,
        name: string,
        root: list<u8>,
        pinned: list<u8>,
    ) -> result<organization, error>;

    /// The opened organization's access log, root first, each entry as
    /// `be_block_keys::Entry::encode` wrote it. Empty for the personal
    /// organization, which has none.
    get-organization-log: async func() -> result<list<list<u8>>, error>;

    /// Makes `organization` the one every later block, key and member call
    /// of this connection works in, and starts over what the connection
    /// listed.
    open-organization: async func(organization: organization-id) -> result<organization-opened, error>;
}

/// The members and agents of the organization this connection opened, or of
/// the one named.
interface members {
    use types.{account-id, block-id, error, organization-id, organization-role, public-key};

    record member {
        account: account-id,
        email: string,
        display-name: string,
        role: organization-role,
        /// For an agent, the account that made it; none for a person.
        created-by: option<account-id>,
        /// For a block's agent, its block (`create-agent`'s `bound-to`).
        bound-to: option<block-id>,
        contact: bool,
    }

    record agent {
        account: account-id,
        name: string,
        email: string,
    }

    /// An agent just made, with the token it signs in with.
    record created-agent {
        agent: agent,
        token: string,
    }

    /// The members of the organization open: every one, to an
    /// administrator; to anyone else, the agents it made.
    list-members: async func() -> result<list<member>, error>;

    /// Sets a member's role. Making or unmaking an administrator of a company
    /// organization takes `signed`, the administrator record
    /// (be_block_keys::Administrator) the caller signed, which the server
    /// appends to the organization's log once it checks there.
    set-role: async func(account: account-id, role: organization-role, signed: option<list<u8>>) -> result<_, error>;

    /// Removes a member of the organization open: any, by an administrator;
    /// an agent, by the account that made it (a block's agent, only while it
    /// manages the block). An agent removed is deleted, with what it was
    /// granted and what was sealed to it.
    /// In a company organization, `signed` is the member record
    /// (be_block_keys::Member) signing them out, needed when its log names
    /// them.
    remove-member: async func(account: account-id, signed: option<list<u8>>) -> result<_, error>;

    /// Appends `signed`, a member record (be_block_keys::Member) signing a
    /// member of the organization open in (a person, by an administrator,
    /// from the invitation it made; an agent, by its maker), or signing out
    /// an agent the server removed on its own, by its maker.
    sign-member: async func(signed: list<u8>) -> result<_, error>;

    /// A block's agent's block, and the grant of Edit on it to the agent
    /// that its creator signed (be_block_keys::Grant).
    record bound-agent {
        block: block-id,
        signed: list<u8>,
    }

    /// Makes the agent account `account`, the id derived from the caller and
    /// the agent's keys (be_block_keys::agent_account), in `organization` with the recovery key
    /// `recovery` and the signing key `signing` derived with it, a contact card for the caller, and its escrow key sealed
    /// for it. With `bound-to`, which needs Manage on that block, the agent
    /// is granted Edit on it by the signed grant and reaches nothing else: it
    /// is a block's agent (`member.bound-to`), removed with its grant or its
    /// block.
    create-agent: async func(
        organization: organization-id,
        account: account-id,
        name: string,
        recovery: public-key,
        signing: public-key,
        contact: list<u8>,
        escrow: list<u8>,
        bound-to: option<bound-agent>,
        /// In a company organization, the member record signing the agent
        /// in, by the caller, its maker.
        member: option<list<u8>>,
    ) -> result<created-agent, error>;

    /// A new token for an agent the caller made; every older one stops
    /// signing it in, and its connections close.
    rotate-agent-token: async func(organization: organization-id, account: account-id) -> result<string, error>;
}
