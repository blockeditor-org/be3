package be3:server@0.1.0;

/// An account's contacts, and the links that make them.
///
/// A link is a card sealed with a code its owner sends out of band, found by
/// the id derived from the code (`link-id`). Accepting one makes its owner and
/// accepter contacts, which is how every relationship starts; what else it
/// does is its `link-kind`.
interface contacts {
    use types.{
        access-level, account-id, block-id, entry-hash, error, link-admits, link-id,
        organization-id, public-key,
    };

    /// An invitation into an organization. Its link is a bearer secret: any
    /// account on the server that opens it may accept it, once, before it
    /// expires, and joins as an editor, never as an administrator, signing
    /// itself into the organization's log with the key the code derives.
    record invitation {
        organization: organization-id,
        /// The organization's escrow key sealed with the code, which the
        /// accepter pins; empty while it has none.
        escrow: list<u8>,
    }

    /// Where an invitation stands.
    enum invitation-state {
        /// Made, and nobody read it yet.
        waiting,
        /// The server answered a read of it: its link arrived.
        opened,
        accepted,
        expired,
        revoked,
    }

    /// An invitation as anyone holding its link reads it, before signing in.
    record invitation-preview {
        organization-name: string,
        /// The inviter's card, sealed with the code.
        card: list<u8>,
        state: invitation-state,
    }

    /// An invitation in its organization's invite list.
    record invitation-row {
        id: link-id,
        inviter: account-id,
        inviter-name: string,
        state: invitation-state,
        accepter: option<account-id>,
        accepter-name: string,
        /// The key its record in the organization's log names, which an
        /// administrator's record revoking it names too.
        key: public-key,
        /// When it was made, expires, was first read, and was accepted or
        /// revoked (0 for not yet), in milliseconds since the epoch.
        created: s64,
        expires: s64,
        opened: s64,
        ended: s64,
    }

    /// What accepting a link does beyond making two contacts.
    variant link-kind {
        /// Only the two contacts. An invitation to a block carries a share link
        /// with the same code instead (guides/blocks/keys.md, "An invitation").
        contact,
        /// The accepter joins the organization as an editor. Only its
        /// administrator makes one.
        invitation(invitation),
    }

    /// A share link as the holder of its code reads it to open it.
    record share-link {
        id: link-id,
        organization: organization-id,
        organization-name: string,
        block: block-id,
        access: access-level,
        admits: link-admits,
        /// What the link hands its opener, sealed with the code: the
        /// block's scope key and the roots of its organization's log.
        sealed: list<u8>,
        /// The head of the block's log, which the record opening it follows.
        head: entry-hash,
        /// Whether opening it makes the caller a guest of the organization.
        guest: bool,
    }

    /// A share link open on a block, as its managers see it.
    record share-link-row {
        id: link-id,
        access: access-level,
        admits: link-admits,
        maker: account-id,
        maker-name: string,
        /// When it was made, in milliseconds since the epoch.
        created: s64,
        /// The key its record in the block's log names.
        key: public-key,
        /// For a link that admits one, the account it admitted, once it
        /// opened, and that account's display name.
        opened-by: option<account-id>,
        opened-by-name: string,
    }

    /// A link as the holder of its code reads it.
    record link {
        id: link-id,
        owner: account-id,
        card: list<u8>,
        kind: link-kind,
        /// The name of the organization an invitation is into; empty for a
        /// contact link.
        organization-name: string,
        /// For an invitation, the head of its organization's log, which the
        /// member record accepting it follows; none for a contact link.
        head: option<entry-hash>,
    }

}
