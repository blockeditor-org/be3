package be3:server@0.1.0;

/// An account's contacts, and the links that make them.
///
/// A link is a card sealed with a code its owner sends out of band, found by
/// the id derived from the code (`link-id`). Accepting one makes its owner and
/// accepter contacts, which is how every relationship starts; what else it
/// does is its `link-kind`.
interface contacts {
    use types.{
        account-id, error, link-id, organization-id, pending-grant,
    };

    /// An invitation into an organization. Its link is a bearer secret: any
    /// account on the server that opens it may accept it, once, before it
    /// expires, and joins as an editor, never as an administrator.
    record invitation {
        organization: organization-id,
        /// The organization's escrow key sealed with the code, which the
        /// accepter pins; empty while it has none.
        escrow: list<u8>,
    }

    /// Where an invitation stands.
    enum invitation-state {
        /// Made, and nobody read it yet.
        waiting,
        /// The server answered a read of it: its link arrived.
        opened,
        accepted,
        expired,
        revoked,
    }

    /// An invitation as anyone holding its link reads it, before signing in.
    record invitation-preview {
        organization-name: string,
        /// The inviter's card, sealed with the code.
        card: list<u8>,
        state: invitation-state,
    }

    /// An invitation in its organization's invite list.
    record invitation-row {
        id: link-id,
        inviter: account-id,
        inviter-name: string,
        /// The code sealed to its inviter, as `own-link.code`; empty in
        /// another administrator's list.
        code: list<u8>,
        state: invitation-state,
        accepter: option<account-id>,
        accepter-name: string,
        /// When it was made, expires, was first read, and was accepted or
        /// revoked (0 for not yet), in milliseconds since the epoch.
        created: s64,
        expires: s64,
        opened: s64,
        ended: s64,
    }

    /// What accepting a link does beyond making two contacts.
    variant link-kind {
        /// With a grant, the accepter is also given access to its block.
        contact(option<pending-grant>),
        /// The accepter joins the organization as an editor. Only its
        /// administrator makes one.
        invitation(invitation),
    }

    /// A link as the holder of its code reads it.
    record link {
        id: link-id,
        owner: account-id,
        card: list<u8>,
        kind: link-kind,
        /// The name of the organization an invitation is into; empty for a
        /// contact link.
        organization-name: string,
    }

    /// A link of the caller's own, and who accepted it.
    record own-link {
        id: link-id,
        code: list<u8>,
        kind: link-kind,
        accepter: option<account-id>,
        /// The accepter's card, sealed with the code.
        card: list<u8>,
    }

    record contact-row {
        account: account-id,
        email: string,
        display-name: string,
        sealed: list<u8>,
        changes: list<list<u8>>,
    }

    /// Makes a link: `card` is sealed with the code, and `code` is the code
    /// sealed to the caller, which `own-link.code` gives back. A contact link
    /// any account makes; an invitation needs an administrator of its
    /// organization, which has a bounded number outstanding.
    create-link: async func(
        link: link-id,
        card: list<u8>,
        code: list<u8>,
        kind: link-kind,
    ) -> result<_, error>;

    /// A link not yet accepted; an invitation only while it is neither
    /// expired nor revoked, and not for an account already a member. Reading
    /// an invitation marks it opened.
    get-link: async func(link: link-id) -> result<link, error>;

    /// An invitation as anyone holding its link reads it, signed in or not:
    /// a one-shot call, rate-limited per address. Marks it opened while it
    /// waits. Any other link reads as no link.
    read-invitation: async func(link: link-id) -> result<invitation-preview, error>;

    /// The organization's invitations, outstanding and ended, newest first,
    /// for its administrators. Ended ones are kept for a while, then go.
    list-invitations: async func(
        organization: organization-id,
    ) -> result<list<invitation-row>, error>;

    /// Accepts a link, leaving the caller's `card` for its owner and its
    /// contact card for the owner sealed to itself (`contact`). `key` is,
    /// for a contact link with a grant, the granted key sealed to the
    /// caller; for an invitation, the escrow key it pins sealed to itself;
    /// otherwise empty.
    accept-link: async func(
        link: link-id,
        card: list<u8>,
        contact: list<u8>,
        key: list<u8>,
    ) -> result<_, error>;

    /// The caller's links, outstanding or accepted and not yet finished; an
    /// invitation expired or revoked is not one.
    list-links: async func() -> result<list<own-link>, error>;

    /// Ends a link: revokes one outstanding, or finishes one accepted. A
    /// contact link goes; an invitation's row stays in its organization's
    /// list. The caller's own, or an invitation into an organization the
    /// caller administers.
    delete-link: async func(link: link-id) -> result<_, error>;

    put-contact: async func(contact: account-id, sealed: list<u8>) -> result<_, error>;

    list-contacts: async func() -> result<list<contact-row>, error>;

    remove-contact: async func(account: account-id) -> result<_, error>;

    /// An item whenever the account's contacts, links or key changes
    /// changed through another connection, so the client reads them again; a
    /// latest-value stream, so changes the client has not taken yet are one
    /// item.
    contacts-changed: func() -> stream;
}
