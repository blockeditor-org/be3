package be3:server@0.1.0;

/// An account's contacts, and the links that make them.
///
/// A link is a card sealed with a code its owner sends out of band, found by
/// the id derived from the code (`link-id`). Accepting one makes its owner and
/// accepter contacts, which is how every relationship starts; what else it
/// does is its `link-kind`.
interface contacts {
    use types.{
        account-id, error, link-id, organization-id, organization-role, pending-grant,
    };

    /// An invitation into an organization, for the account with `email`.
    record invitation {
        organization: organization-id,
        email: string,
        /// The role the accepter joins with.
        role: organization-role,
        /// The organization's escrow key sealed with the code, which the
        /// accepter pins; empty while it has none.
        escrow: list<u8>,
    }

    /// What accepting a link does beyond making two contacts.
    variant link-kind {
        /// With a grant, the accepter is also given access to its block.
        contact(option<pending-grant>),
        /// The accepter joins the organization. Only its administrator makes
        /// one, and only the account with its email reads or accepts it.
        invitation(invitation),
    }

    /// A link as the holder of its code reads it.
    record link {
        id: link-id,
        owner: account-id,
        card: list<u8>,
        kind: link-kind,
        /// The name of the organization an invitation is into; empty for a
        /// contact link.
        organization-name: string,
    }

    /// A link of the caller's own, and who accepted it.
    record own-link {
        id: link-id,
        code: list<u8>,
        kind: link-kind,
        accepter: option<account-id>,
        /// The accepter's card, sealed with the code.
        card: list<u8>,
    }

    record contact-row {
        account: account-id,
        email: string,
        display-name: string,
        sealed: list<u8>,
        changes: list<list<u8>>,
    }

    /// Makes a link: `card` is sealed with the code, and `code` is the code
    /// sealed to the caller, which `own-link.code` gives back. A contact link
    /// any account makes; an invitation needs an administrator of its
    /// organization, and replaces any outstanding one for the same email.
    create-link: async func(
        link: link-id,
        card: list<u8>,
        code: list<u8>,
        kind: link-kind,
    ) -> result<_, error>;

    /// A link not yet accepted; an invitation only for the account with its
    /// email, and not one already a member.
    get-link: async func(link: link-id) -> result<link, error>;

    /// Accepts a link, leaving the caller's `card` for its owner and its
    /// contact card for the owner sealed to itself (`contact`). `key` is,
    /// for a contact link with a grant, the granted key sealed to the
    /// caller; for an invitation, the escrow key it pins sealed to itself;
    /// otherwise empty.
    accept-link: async func(
        link: link-id,
        card: list<u8>,
        contact: list<u8>,
        key: list<u8>,
    ) -> result<_, error>;

    /// The caller's links, outstanding or accepted and not yet finished.
    list-links: async func() -> result<list<own-link>, error>;

    /// Deletes a link of the caller's: revokes one outstanding, or finishes
    /// one accepted.
    delete-link: async func(link: link-id) -> result<_, error>;

    put-contact: async func(contact: account-id, sealed: list<u8>) -> result<_, error>;

    list-contacts: async func() -> result<list<contact-row>, error>;

    remove-contact: async func(account: account-id) -> result<_, error>;

    /// An item whenever the account's contacts, links or key changes
    /// changed through another connection, so the client reads them again; a
    /// latest-value stream, so changes the client has not taken yet are one
    /// item.
    contacts-changed: func() -> stream;
}
