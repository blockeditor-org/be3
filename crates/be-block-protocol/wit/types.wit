package be3:server@0.1.0;

/// The types `server` and its records share.
interface types {
    use be3:shared/ids@0.1.0.{uuid, hash, block-id, account-id, organization-id, commit-id, content-type-id};
    use be3:shared/access@0.1.0.{access-level};

    /// Why the server refused a call.
    record error {
        code: error-code,
        message: string,
    }

    enum error-code {
        not-authenticated,
        invalid-credentials,
        email-already-registered,
        invalid-request,
        permission-denied,
        block-not-found,
        block-already-exists,
        object-not-found,
        object-too-large,
        parent-cycle,
        storage,
        organization-not-found,
        login-disabled,
        key-missing,
        not-a-contact,
        link-not-found,
        last-administrator,
        policy-unreadable,
        policy-refused,
        over-quota,
        /// A sign-in was polled sooner than its interval allows.
        slow-down,
        /// No member the caller may remove has that account: it was removed,
        /// an agent collected with its block, or never a member.
        member-not-found,
        /// A commit's time is more than `MAX_COMMIT_AHEAD` past the server's
        /// clock: its device stamped it by a clock running fast.
        commit-ahead,
    }

    /// A connection, as the server numbers them; a session's participants and
    /// pairing messages name connections by it.
    type client-id = u64;

    /// A key a client minted: a data, scope or escrow key.
    type key-id = uuid;

    type link-id = uuid;

    /// A 32-byte public key: an account's recovery key, an escrow key's
    /// public and signing halves, the server's own account key.
    type public-key = tuple<u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8>;

    /// The hash of an access log entry (`be_block_keys::EntryHash`): the head of a log as of
    /// some entry.
    type entry-hash = tuple<u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8>;

    enum organization-role {
        administrator,
        editor,
    }

    enum organization-kind {
        company,
        personal,
    }

    /// Where a block sits: nowhere yet, at the organization's root, or inside
    /// another block. The same cases as `be_block_graph::BlockParent`.
    variant block-parent {
        detached,
        root,
        block(block-id),
    }

    /// A query for blocks (`query.list`), answered as of the sequence it was
    /// read at.
    variant listing {
        children(block-parent),
        deleted,
        shared,
        backrefs(block-id),
        references(block-id),
        open-settings(block-id),
    }

    /// What a connection may know of a block. One it may only know exists
    /// carries only its id, type and access, with `held` set.
    record block-summary {
        id: block-id,
        content-type: content-type-id,
        access: access-level,
        author: option<account-id>,
        parent: option<block-parent>,
        head: option<commit-id>,
        references: list<block-id>,
        metadata: list<u8>,
        version: option<u64>,
        key: option<key-id>,
        scope: option<block-id>,
        /// The organization's change sequence at the block's last change to what it holds,
        /// where it lies or who may view it (`organizations.change_sequence`): of two summaries
        /// of one block, the one with the larger `changed` is the newer. A block the reader
        /// only knows exists carries its own too, so it orders after one read while viewed.
        changed: u64,
        /// The entry point whose tree a reader follows to hear of this block's changes
        /// (`query.tree`): the top of its tree (a top-level block, or the block at the top
        /// of what lies in the trash), or the block where the reader's view starts, below a
        /// parent it may not view. None for a block the reader may not view.
        entry: option<block-id>,
        held: bool,
        opens-inside: bool,
        sets-access: bool,
        /// Bytes of the distinct objects this block holds: every version it
        /// keeps and every object it holds. Zero for a block the reader only
        /// knows exists.
        size: u64,
        /// `size` plus the `tree-size` of each child (blocks whose parent is
        /// this one), not deduplicated across blocks.
        tree-size: u64,
        /// Readable by its author alone, and never escrowed: made with
        /// `create-block`'s `owner-only`. Set only when the reader may view it.
        owner-only: bool,
    }

    enum key-kind {
        data,
        scope,
        escrow,
    }

    record key-row {
        id: key-id,
        block: block-id,
        kind: key-kind,
        epoch: u64,
    }

    variant wrapped-by {
        key(key-id),
        account(account-id),
    }

    record wrapped-key {
        key: key-id,
        wrapped-by: wrapped-by,
        sender: account-id,
        sealed: list<u8>,
    }

    record key-set {
        keys: list<key-row>,
        wrapped: list<wrapped-key>,
    }

    /// One epoch of an organization's escrow key, signed by the epoch before
    /// over `EscrowKey::chained`. Its fields, their order and their types are
    /// those of `be_block_protocol::EscrowKey`, whose postcard bytes clients seal and
    /// the server stores (a pinned escrow key, an invitation's or link's
    /// escrow): the two encode alike, which a test of this crate holds.
    /// An organization's escrow key at `epoch`, made by the administrator
    /// `maker` under the organization log's `head`, whose identity key signs
    /// both chained to the epoch before (`EscrowKey::chained`): a device takes
    /// it only from an administrator its checked organization log names, once
    /// that log reaches `head`.
    record escrow-key {
        id: key-id,
        epoch: u64,
        public: public-key,
        signing: public-key,
        head: entry-hash,
        maker: account-id,
        signature: list<u8>,
    }

    /// A key sealed to an account by a sender, within an organization.
    record sealed-key {
        organization: organization-id,
        key: key-id,
        sender: account-id,
        sealed: list<u8>,
    }

    enum own-kind {
        contact,
        link,
        escrow,
    }

    /// What an account sealed for itself: a contact's card, a link's code, a
    /// pinned escrow key.
    record own-sealed {
        kind: own-kind,
        id: uuid,
        sealed: list<u8>,
    }

    /// A key change sealed for one contact, after an account took a new
    /// recovery phrase.
    record key-change {
        contact: account-id,
        sealed: list<u8>,
    }

    /// A grant waiting in a contact link until its accepter is known.
    record pending-grant {
        organization: organization-id,
        block: block-id,
        access: access-level,
        key: key-id,
        sealed: list<u8>,
    }

    /// One connection in a block's live session: the build of the block's
    /// type it runs, whether it may edit the block, and the index of the
    /// membership entry of its last claim since it joined.
    record participant {
        client: client-id,
        tag: hash,
        may-edit: bool,
        claimed: option<u64>,
    }

    /// Who is in a block's live session, in the order they joined, as of its
    /// `index`-th membership entry, written when the order's last number was
    /// `after`. The lease holder and the build the session speaks follow from
    /// it (`be_block_session::Membership`): the build is the first
    /// participant's, and the holder, of the participants with edit access
    /// that run it, the last claimant, else the earliest joined.
    record session-state {
        index: u64,
        after: u64,
        participants: list<participant>,
    }

    /// A change of who is in a session, which only the server writes.
    variant membership-change {
        /// Joined, running the build `tag`.
        joined(joined-participant),
        left,
        /// Its edit access changed while joined: a grant, or a move.
        access(bool),
        /// It claimed the lease.
        claimed,
    }

    record joined-participant {
        tag: hash,
        may-edit: bool,
    }

    /// A membership entry: the session's `index`-th, about `client`, stamped
    /// with the order's last number when written (`after`), so it falls
    /// between that submission and the next. Kept in memory only, never in
    /// the journal.
    record membership-entry {
        index: u64,
        after: u64,
        client: client-id,
        change: membership-change,
    }

    /// One submission the session's order numbered: its place (`sequence`),
    /// the replica that made it (`origin`, `counter`), the last number that
    /// replica had applied (`base`), the last barrier (`floor`): one based below it is passed over,
    /// when the server took it by its clock (none for an order a device kept
    /// offline), and its payload, sealed with the block's key.
    record journal-entry {
        sequence: u64,
        origin: u64,
        counter: u64,
        base: u64,
        floor: u64,
        received: option<s64>,
        payload: list<u8>,
    }

    /// Where a journal starts: a commit (none for no content), the last
    /// sequence number it holds and the session state as of it, sealed with
    /// the block's key.
    record journal-base {
        commit: option<commit-id>,
        sequence: u64,
        state: list<u8>,
    }

    /// A seal of a block's live session, which a publish carries: the base the
    /// journal starts from, the build of the block's type that sealed it, and
    /// the run of the order it seals (how many times the session had started
    /// over, which reuses sequence numbers). The server trims only with a seal
    /// of the journal's build and run or a later run, at or past its base.
    record journal-seal {
        tag: hash,
        run: u64,
        base: journal-base,
    }

    /// A block's session's order since its base, which no commit holds yet,
    /// written by the build of the block's type that `tag` names.
    record journal {
        tag: hash,
        base: journal-base,
        entries: list<journal-entry>,
        /// A rebase by another build dropped entries since the base's commit:
        /// edits made with the build before were lost, which every device
        /// opening the block is told until the next commit.
        lost: bool,
    }
}
