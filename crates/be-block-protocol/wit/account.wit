package be3:server@0.1.0;

/// The connection itself.
interface connection {
    /// Answers at once, so a client learns its socket is alive; the server
    /// answers it ahead of anything else it is doing.
    ping: async func();
}

/// Signing in, and the account's other devices.
interface account {
    use types.{account-id, client-id, error};

    /// A browser sign-in waiting for approval: the code a person approves in
    /// the browser, and the secret that proves this client began it.
    record browser-login {
        code: string,
        secret: string,
    }

    /// A signed-in connection. `token` is empty when the token came in the
    /// request's Authorization header.
    record authenticated {
        account: account-id,
        email: string,
        display-name: string,
        token: string,
    }

    /// A message from another connection of the same account.
    record pairing-message {
        %from: client-id,
        payload: list<u8>,
    }

    /// Starts a browser sign-in.
    begin-browser-login: async func() -> result<browser-login, error>;

    /// Waits until the browser approved the sign-in begun with `code` and
    /// `secret`, then signs this connection in. Fails at once with a wrong
    /// secret, and once the browser denied the sign-in or it expired. A client
    /// that lost its connection calls it again on the next one, which then
    /// waits in its place.
    finish-browser-login: async func(code: string, secret: string) -> result<authenticated, error>;

    /// Makes a profile on this device's own server and signs in to it.
    create-local-profile: async func(display-name: string) -> result<authenticated, error>;

    /// Signs this connection in with an account token, or with none, the token
    /// of the request's Authorization header.
    authenticate: async func(token: option<string>) -> result<authenticated, error>;

    /// Ends the session the token named and signs this connection out.
    logout: async func() -> result<_, error>;

    /// Sends a pairing message to one of the account's other connections, or
    /// to all of them with no `to`. Fails when `to` is no longer connected.
    pair: async func(to: option<client-id>, payload: list<u8>) -> result<_, error>;

    /// The pairing messages the account's other connections send this one,
    /// for as long as it is open.
    paired: func() -> stream<pairing-message>;
}
