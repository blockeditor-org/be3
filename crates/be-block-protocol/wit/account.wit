package be3:server@0.1.0;

/// Signing in, and the account's other devices.
interface account {
    use types.{account-id, client-id, error, link-id};

    /// A browser sign-in waiting for approval: the code a person approves in
    /// the browser, the secret that proves this client began it, the fewest
    /// seconds between two polls of it, and the seconds until it expires.
    record browser-login {
        code: string,
        secret: string,
        interval: u32,
        expires: u32,
    }

    /// Where a browser sign-in stands, as a poll finds it.
    variant browser-login-state {
        /// Not yet approved or denied.
        pending,
        /// Approved: the account and a token for it, handed out to this one
        /// poll; the sign-in is then gone.
        approved(authenticated),
        /// Denied in the browser.
        denied,
        /// Expired, already handed out, or never begun with this secret.
        expired,
    }

    /// A signed-in connection, as the server's greeting tells it (`Welcome`).
    /// `token` is empty when the token came in the request's Authorization
    /// header, and in a sign-in a poll approved, which signs no connection in,
    /// `client` is 0.
    record authenticated {
        account: account-id,
        email: string,
        display-name: string,
        token: string,
        /// This connection, as sessions, pairing and `session-happened` name
        /// it.
        client: client-id,
    }

    /// A message from another connection of the same account.
    record pairing-message {
        %from: client-id,
        payload: list<u8>,
    }

    /// What this account's storage holds against its quota.
    record account-storage {
        /// Bytes of the distinct objects held by the blocks this account pays
        /// for: the blocks it authored, and those of the agents it created.
        held: u64,
        /// Bytes it uploaded that no block holds yet; collected once they
        /// have waited `ServerConfig::upload_grace`.
        pending: u64,
        /// At most `held + pending`; none when there is no limit.
        quota: option<u64>,
    }

    /// One message in an account's mailbox (`query.mailbox`), kept until a device of the
    /// account deletes it (`delete-message`).
    record message {
        id: u64,
        /// Who it is from: the account that caused it, or none for the server's own notice.
        %from: option<account-id>,
        letter: letter,
        /// When the server took it, in milliseconds since the epoch.
        created: s64,
    }

    /// What a message says. The server writes each in the transaction of the change it tells,
    /// so none is lost between a change and its telling.
    variant letter {
        /// The server's notice: a way to sign in added or removed, or the email changing. In its
        /// first `NOTICE_HOLD` (a week) no device deletes it, since whoever it warns about may
        /// hold a session too; a device hides it for itself meanwhile.
        notice(string),
        /// A link of the account's was accepted (`accept-link`), by the message's sender.
        accepted(accepted-link),
        /// A contact took a new recovery phrase (`set-recovery-key`): its key change, sealed with
        /// its old key for this account (`RecoverySecret::seal_key_change`).
        key-change(list<u8>),
    }

    record accepted-link {
        link: link-id,
        /// The accepter's card, sealed with the link's code.
        card: list<u8>,
    }

}
