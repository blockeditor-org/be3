package be3:server@0.1.0;

/// The content-addressed objects of the organization this connection opened.
interface objects {
    use types.{block-id, error, hash};

    /// Stores objects, each named by its SHA-256; answers their hashes in
    /// order.
    put-objects: async func(objects: list<list<u8>>) -> result<list<hash>, error>;

    /// An object the caller may read, or none.
    get-object: async func(hash: hash) -> result<option<list<u8>>, error>;

    /// Which of `hashes` the server lacks.
    missing-objects: async func(hashes: list<hash>) -> result<list<hash>, error>;

    /// Keeps stored objects alive for `block` until a commit takes them.
    hold-objects: async func(block: block-id, objects: list<hash>) -> result<_, error>;
}

/// The blocks of the organization this connection opened.
interface blocks {
    use types.{
        access-level, account-id, block-id, block-parent, block-summary, commit-id,
        content-type-id, error, hash, journal, key-id, key-set, listing, organization-role,
    };

    variant publish-outcome {
        /// The head moved to this commit.
        published(commit-id),
        /// `expected` was not the head; this is.
        rejected(option<commit-id>),
    }

    /// The objects a commit holds besides itself, as a change from those
    /// its expected head holds: those in `removed` go, then `added` join.
    record object-change {
        added: list<hash>,
        removed: list<hash>,
    }

    /// A reference that joins a list at `index` of the new list.
    record placed-reference {
        index: u32,
        block: block-id,
    }

    /// A commit's references as a change from its expected head's: those
    /// in `removed` go, then each of `added`, in order, goes in at its index.
    /// A reference that moves is removed and added.
    record reference-change {
        removed: list<block-id>,
        added: list<placed-reference>,
    }

    record history-entry {
        commit: commit-id,
        parents: list<commit-id>,
        time: s64,
        pinned: bool,
        /// The block's head when the history was read: read in the same step,
        /// so a publish that prunes the head before can't leave none marked.
        head: bool,
    }

    /// The summaries asked for, and as many of the objects of their heads as
    /// fit in half a frame, in order; a client asks again for the rest.
    record contents {
        blocks: list<block-summary>,
        objects: list<list<u8>>,
        /// Each block's journal, in the order of `blocks`; none when it has
        /// nothing past its base.
        journals: list<option<journal>>,
    }

    /// What `collect-detached` deleted and freed.
    record collected {
        blocks: list<block-id>,
        objects: u64,
    }

    record access-entry {
        account: account-id,
        email: string,
        display-name: string,
        role: organization-role,
        author: bool,
        granted: option<access-level>,
        inherited: access-level,
        effective: access-level,
        source: option<block-id>,
        contact: bool,
        waiting: bool,
    }

    record access-list {
        entries: list<access-entry>,
        company: bool,
        set-inside: u32,
    }

    record block-removed {
        block: block-id,
        revision: u64,
    }

    /// What a connection's `changes` stream tells of the blocks it listed.
    variant block-change {
        /// A block it listed, or one that now matches a listing, changed.
        changed(block-summary),
        /// A block it was told of matches none of its listings any more.
        removed(block-removed),
    }

    record head-moved {
        head: commit-id,
        author: account-id,
    }

    /// What a `watch` stream tells of its block.
    variant block-event {
        /// Another connection published a new head.
        moved(head-moved),
        /// The block was deleted; the stream then ends.
        deleted,
    }

    create-block: async func(
        block: block-id,
        content-type: content-type-id,
        parent: block-parent,
        metadata: list<u8>,
        references: list<block-id>,
        key: key-id,
        keys: key-set,
    ) -> result<block-summary, error>;

    set-metadata: async func(block: block-id, metadata: list<u8>, references: list<block-id>) -> result<block-summary, error>;

    /// Stores `objects` and moves the head to `commit` if it is `expected`.
    /// `held` and `references` are changes from what `expected` holds and
    /// references, so a commit that changes little sends little.
    publish: async func(
        block: block-id,
        commit: commit-id,
        expected: option<commit-id>,
        parents: list<commit-id>,
        held: object-change,
        time: s64,
        pinned: bool,
        references: reference-change,
        metadata: list<u8>,
        objects: list<list<u8>>,
    ) -> result<publish-outcome, error>;

    /// One block's summary, which lists it as `listing.block` would.
    read-block: async func(block: block-id) -> result<block-summary, error>;

    /// Summaries of `blocks`, their journals, and the objects of their heads
    /// the caller does not hold, those of the commits in `held` left out.
    read-contents: async func(blocks: list<block-id>, held: list<commit-id>) -> result<contents, error>;

    /// Moves a block, with the keys it needs under its new parent.
    set-parent: async func(block: block-id, parent: block-parent, keys: key-set) -> result<_, error>;

    /// The blocks of a listing, which the connection's `changes` stream then
    /// follows until `unlist`.
    list-blocks: async func(listing: listing) -> result<list<block-summary>, error>;

    /// Stops following a listing.
    unlist: async func(listing: listing) -> result<_, error>;

    /// Changes to the blocks of everything this connection listed, each
    /// block told once however many listings hold it, from the next listing
    /// on; `open-organization` starts the listings over.
    changes: func() -> stream<block-change>;

    list-history: async func(block: block-id) -> result<list<history-entry>, error>;

    delete-block: async func(block: block-id) -> result<_, error>;

    /// Deletes the detached blocks nothing reaches any more.
    collect-detached: async func() -> result<collected, error>;

    set-access: async func(block: block-id, account: account-id, access: access-level) -> result<_, error>;

    list-access: async func(block: block-id) -> result<access-list, error>;

    /// Head moves of a block made by other connections, until it is deleted
    /// or the stream dropped. Each stream is its own: two on one block both
    /// hear, and dropping one leaves the other.
    watch: func(block: block-id) -> stream<block-event>;
}

/// Live sessions on blocks, whose connections relay edits to each other and
/// share one lease.
interface sessions {
    use types.{block-id, client-id, commit-id, error, hash, journal, journal-base, journal-entry, session-state};

    record joined {
        /// This connection, as the session's participants name it.
        client: client-id,
        state: session-state,
        /// The block's journal as of joining; what is appended after reaches
        /// this connection as relays.
        journal: option<journal>,
    }

    record relayed {
        %from: client-id,
        payload: list<u8>,
    }

    /// What a session's `join` stream tells.
    variant session-event {
        /// First, once joined.
        joined(joined),
        /// First and last, when the caller may not join.
        refused(error),
        /// Another participant changed the session.
        changed(session-state),
        /// A participant relayed a message to this one, or to all.
        relayed(relayed),
    }

    /// This connection in a block's session. Dropping it leaves the session.
    resource session {
        /// Names the block; `join` joins it.
        constructor(block: block-id);

        /// Joins the session and tells what happens in it, starting with
        /// `joined` or `refused`.
        join: func() -> stream<session-event>;

        /// Claims the lease of `generation` once its owner left.
        claim-ownership: async func(generation: u64) -> result<session-state, error>;

        /// The owner's heartbeat, with the head it holds clean; answers the
        /// session's state either way.
        heartbeat: async func(generation: u64, clean-at: option<commit-id>) -> result<session-state, error>;

        /// Relays a sealed message to one participant, or to every other one
        /// with no `to`.
        relay: async func(to: option<client-id>, payload: list<u8>) -> result<_, error>;

        /// The owner of `generation` appends operations it sequenced to the
        /// block's journal, written by the build `tag` names, and with `relay`
        /// relays each entry's payload to every other participant. Entries at
        /// or below the journal's last sequence number are dropped as already
        /// held. Entries from anyone but the owner of `generation` are relayed
        /// and not kept. Refused while the journal is another `tag`'s: the
        /// owner rebases first.
        append: async func(generation: u64, tag: hash, entries: list<journal-entry>, relay: bool) -> result<_, error>;

        /// The journal starts over from `base`, dropping every entry: the
        /// owner of `generation` rebases after each commit, and on taking the
        /// session before it appends.
        rebase-journal: async func(generation: u64, tag: hash, base: journal-base) -> result<_, error>;
    }
}
