package be3:server@0.1.0;

/// The content-addressed objects of the organization this connection opened.
interface objects {
    use types.{block-id, error, hash};

    /// An object to upload: its SHA-256 and its length in bytes, or none when
    /// the caller does not hold it (a part it reuses by its ref alone), which
    /// asks only whether the server holds it for the caller.
    record object-length {
        hash: hash,
        length: option<u64>,
    }

    /// A header a presigned request is sent with, exactly as given.
    record header {
        name: string,
        value: string,
    }

    /// Where to upload one object: a presigned S3 PUT that takes only that
    /// object's bytes, sent with `headers`, until it expires.
    record upload-url {
        url: string,
        headers: list<header>,
    }

    /// How long `hold-objects` keeps objects for a block. Either way the
    /// block's payer is charged for them, and whoever may view the block may
    /// read them.
    enum hold {
        /// For as long as the block exists: a repository's snapshots, which
        /// no commit of it takes.
        lasting,
        /// Until a commit of the block that holds them publishes, or
        /// `ServerConfig::upload_grace` passes: a part an operation names by
        /// its hash before any commit uses it (`put-part` in
        /// `be3:block-type`).
        until-committed,
    }
}

/// The blocks of the organization this connection opened.
interface blocks {
    use types.{
        access-level, account-id, block-id, block-parent, block-summary, commit-id,
        content-type-id, error, hash, journal, journal-seal, key-id, key-set, listing,
        organization-role,
    };

    variant publish-outcome {
        /// The head moved to this commit.
        published(commit-id),
        /// `expected` was not the head; this is.
        rejected(option<commit-id>),
    }

    /// The objects a commit holds besides itself, as a change from those
    /// its expected head holds: those in `removed` go, then `added` join.
    record object-change {
        added: list<hash>,
        removed: list<hash>,
    }

    /// A reference that joins a list at `index` of the new list.
    record placed-reference {
        index: u32,
        block: block-id,
    }

    /// A commit's references as a change from its expected head's: those
    /// in `removed` go, then each of `added`, in order, goes in at its index.
    /// A reference that moves is removed and added.
    record reference-change {
        removed: list<block-id>,
        added: list<placed-reference>,
    }

    /// A place in the order of an organization's changes: the changes after it
    /// are those with a larger `changed`, or the same `changed` and a larger
    /// `block` (ids compared as bytes).
    record change-cursor {
        changed: u64,
        block: block-id,
    }

    /// A page of what changed in a tree after a cursor, oldest change first.
    record changed-page {
        /// Blocks in the tree now that the caller may view and that changed.
        summaries: list<block-summary>,
        /// Blocks that moved (or were deleted for good) since, and are not in
        /// the tree now: ids only, for a reader to keep out of what it indexes.
        removed: list<block-id>,
        /// Where the next page starts, when this one was full.
        next: option<change-cursor>,
        /// The organization's change sequence when this page was made: the
        /// cursor of everything up to now, once the pages end.
        sequence: u64,
    }

    record history-entry {
        commit: commit-id,
        parents: list<commit-id>,
        time: s64,
        pinned: bool,
        /// The block's head when the history was read: read in the same step,
        /// so a publish that prunes the head before can't leave none marked.
        head: bool,
    }

    /// The summaries of the first blocks asked for that fit in a sixteenth of
    /// a frame, and as many of the objects of their heads as fit in half a
    /// frame, in order; a client asks again for the rest.
    record contents {
        blocks: list<block-summary>,
        objects: list<list<u8>>,
        /// Each block's journal, in the order of `blocks`; none when it has
        /// nothing past its base.
        journals: list<option<journal>>,
    }

    /// A listing's blocks, and the organization's change sequence when the server
    /// read them: a block that changes after the answer does so at a larger
    /// sequence (`block-summary.changed`).
    record listed {
        sequence: u64,
        /// The listing's first blocks in the order of their ids (after
        /// `after`), as many as fit in an eighth of a frame and at least one.
        blocks: list<block-summary>,
        /// The listing's next blocks after those, as many ids as fit in a
        /// sixteenth of a frame: the ids are as of `sequence`, and a client
        /// reads their summaries with `query.blocks`, which are as of when
        /// it reads them.
        rest: list<block-id>,
        /// The last block of the page when the listing goes on past it: a
        /// client lists again after it.
        next: option<block-id>,
    }


    record access-entry {
        account: account-id,
        email: string,
        display-name: string,
        role: organization-role,
        author: bool,
        granted: option<access-level>,
        inherited: access-level,
        effective: access-level,
        source: option<block-id>,
        contact: bool,
        waiting: bool,
    }

    record access-list {
        entries: list<access-entry>,
        company: bool,
        set-inside: u32,
    }
}

/// Live sessions on blocks. The server orders each session's submissions,
/// keeping them in the block's journal, writes who joins, leaves, gains or
/// loses edit access and claims the lease between them, and relays what its
/// connections send each other. The lease holder, derived from that order,
/// seals with `blocks.publish`.
interface sessions {
    use types.{block-id, client-id, commit-id, error, hash, journal, journal-entry, joiner-change, membership-entry, session-host, session-state};

    record relayed {
        %from: client-id,
        payload: list<u8>,
        /// When the server took it, in milliseconds since the Unix epoch by
        /// the server's clock.
        received: s64,
    }

    /// A publish with a journal seal moved the head to `commit`, which holds
    /// the order through `through` in its `run` (`journal-seal.run`): the
    /// journal starts from it. A trim with no new commit is not told.
    record sealed {
        commit: commit-id,
        through: u64,
        run: u64,
    }

    /// What happens in a session (`event.session`).
    variant session-event {
        /// The server wrote a membership entry.
        membership(membership-entry),
        /// A participant relayed a message to this one, or to all.
        relayed(relayed),
        /// The order numbered a submission, this connection's own included:
        /// every participant hears each one, in order.
        sequenced(journal-entry),
        /// A seal moved the head and trimmed the journal.
        sealed(sealed),
        /// A message on the host channel (`session-send.host`): from the
        /// lease holder to this member, or to the holder from a member.
        hosted(relayed),
        /// Who holds the lease now, or none: told to every member, Join
        /// members included, as it changes.
        host(option<session-host>),
        /// A Join member came or went: told to the lease holder alone.
        joiner(joiner-change),
    }
}
