package be3:manifest@0.1.0;

/// What an app's manifest declares of its editors and block types, which the
/// app protocol (`be3:app`) carries too. The Rust in
/// `be-sdk-manifest` is generated from this.
interface types {
    use be3:shared/ids@0.1.0.{block-type-id};

    /// How an editor takes input where it is shown.
    enum interaction-mode {
        live,
        preview,
        playback,
    }

    /// Which gestures over a pan-and-zoom editor's content move the host's camera.
    enum pan-mode {
        /// The wheel, a pinch or two-finger drag, and a middle- or space-drag.
        two-finger,
        /// No gesture: only the editor's own controls move the view.
        none,
        /// Also a plain drag or one finger. The press goes to the editor, which calls
        /// `pan_drag` when it pressed on nothing of its own.
        one-finger,
    }

    record editor-capabilities {
        rotation: bool,
        preserve-aspect-ratio: bool,
        /// The content has a view of its own, a camera the host owns.
        pan-and-zoom: bool,
        /// How far past its fitted size the host lets the view zoom; 32 when none.
        max-zoom: option<u32>,
        pan: pan-mode,
    }

    enum resize-mode {
        both,
        none,
        horizontal,
        vertical,
    }

    record child-operations {
        add: bool,
        delete: bool,
        replace: bool,
    }

    /// What pressing a block in a container does.
    enum press {
        open,
        zoom,
    }

    /// A colour's red, green and blue.
    type rgb = tuple<u8, u8, u8>;

    record block-type-descriptor {
        block-type: block-type-id,
        display-name: string,
        color: option<rgb>,
        icon-codepoint: string,
        children: child-operations,
        press: press,
        plain-file: bool,
    }

    /// Where a picker lists a template: among every block, among the ones
    /// offered first, or as a template to start from.
    enum template-category {
        regular,
        important,
        template,
    }

    variant edits {
        %type(block-type-id),
        any,
        nothing,
    }

    record app-identity {
        id: string,
        name: string,
        version: string,
    }

    /// The views of an instance its placer places: its main view, where it
    /// is edited, its preview and its artifact settings. A manifest lists the
    /// ones its editor draws (`views`), the main view always.
    enum parent-view {
        main,
        preview,
        artifact-settings,
    }
}

world manifest {
    import types;
}
