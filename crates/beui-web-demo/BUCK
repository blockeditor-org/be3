load("@root//buck/cargo:defs.bzl", "cargo_package")
load("@root//buck/wasm:defs.bzl", "web_library", "web_program")

cargo_package()

# beui's demo (crates/beui-demo) in a browser, drawn with wgpu:
# `./scripts/buck run //crates/beui-web-demo:web`, which serves it with Caddy
# on http://127.0.0.1:8070, or on the address given as `-- --addr HOST:PORT`.
web_library(
    role = "program",
    target_compatible_with = ["prelude//cpu/constraints:cpu[wasm32]"],
)

web_program(
    name = "web",
    files = [
        "//crates/be-tool-local:demo-index",
    ],
    module = "beui_web_demo",
    role = "program",
    serve = "127.0.0.1:8070",
)
