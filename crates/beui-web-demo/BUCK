load("@root//buck/app:defs.bzl", "app")
load("@root//buck/cargo:defs.bzl", "cargo_library")
load("@root//buck/wasm:defs.bzl", "wasi_app_flags", "wasi_app_module")

# beui's demo (crates/beui-demo) in a browser, drawn with wgpu:
# `./scripts/buck run //crates/beui-web-demo:web`, which serves it with Caddy
# on http://127.0.0.1:8070, or on the address after `--`.
cargo_library(
    rustc_flags = wasi_app_flags,
    target_compatible_with = ["prelude//cpu/constraints:cpu[wasm32]"],
)

wasi_app_module(
    name = "web-module",
    library = ":beui-web-demo",
    module = "beui_web_demo",
)

app(
    name = "web",
    bindgen = [":web-module"],
    files = [
        "//crates/local-tools:demo-index",
        "//crates/block-app:wasi.js",
        "//crates/block-app:threads.js",
        "//crates/block-app:thread.js",
        "//crates/block-app:dylink.js",
        "//crates/block-app:env.js",
    ],
    manifests = [],
    modules = [],
    run_with = [
        "sh",
        "$(location :serve.sh)",
        "$(location //buck/tools:caddy)",
        "$(location :Caddyfile)",
    ],
    wasm_bindgen = "//buck/cargo:wasm-bindgen",
)

export_file(
    name = "serve.sh",
    src = "web/serve.sh",
)

export_file(
    name = "Caddyfile",
    src = "web/Caddyfile",
)
