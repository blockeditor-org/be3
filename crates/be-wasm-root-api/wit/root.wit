package be3:root@0.1.0;

/// What the host serves the root guest beside the sandbox
/// (plans/host_as_platform_adapter.md, The root guest).
interface host {
    use be3:shared/ids@0.1.0.{block-id, block-type-id, organization-id, uuid};

    /// Answers once the frame being drawn reaches its deadline: the display's
    /// next present less the time the host's own work after the frame takes.
    /// Until then the root waits for its children's answers; after it, it
    /// draws what it has. The root's own calls have no deadline. Called
    /// outside a frame, it answers at once.
    deadline: async func();

    /// The fonts the host bundles, which the root draws its text in and tells
    /// the apps it embeds: the app protocol's `fonts` record (be-sdk-api's
    /// `Fonts`, with `replace` set) as a host tells an app, in be-wasm-ops'
    /// encoding (`be_wasm_ops::encode`), as the layer list is bytes. The same
    /// faces every call: a root asks once.
    fonts: async func() -> list<u8>;

    /// Something the host tells the person of its own: that something failed,
    /// or why something they asked for was refused, with what they may do
    /// about it beside dismissing it. The root shows it however it shows such
    /// things (a toast) until the person answers it (`answer-notice`).
    record notice {
        /// Its id, which `answer-notice` names: the same while it is shown.
        id: u64,
        /// What it says, as one line or a few.
        message: string,
        /// Whether it says something failed, which reads as an alert and
        /// stays until it is answered, rather than why something was
        /// refused, which may go by itself after a while.
        failure: bool,
        /// What the person may do about it, which the host does once the root
        /// answers with its key: copying a report, opening a link.
        actions: list<notice-action>,
    }

    /// Something a notice offers the person to do.
    record notice-action {
        /// What `answer-notice` answers with.
        key: string,
        /// What it reads as.
        label: string,
    }

    /// The host's notices at one time.
    record shown-notices {
        /// Which change of the notices they are, which the next `notices`
        /// call names as `seen`: never 0.
        generation: u64,
        /// Every notice shown, oldest first.
        shown: list<notice>,
    }

    /// The host's notices, once they differ from those of the generation
    /// `seen`: at once for any other generation, such as 0, which no
    /// notices are, so a root asks with 0 first and then with the generation
    /// each answer gave, and hears each change as it happens rather than
    /// asking again for it.
    notices: async func(seen: u64) -> shown-notices;

    /// The person answered the notice `id`: with one of its actions' keys,
    /// which the host does, or with none, dismissing it, which ends it. A
    /// notice already gone, or a key it does not offer, changes nothing. It
    /// answers at once; the change reaches `notices`.
    answer-notice: async func(id: u64, action: option<string>);

    /// The clipboard calls below are the root's alone: the host trusts its
    /// own root with the person's clipboard, as it never trusts an app (an
    /// app reads a paste only as the input the host delivers it). A root never
    /// relays them for an app it embeds.
    ///
    /// Puts `items` on the platform's clipboard in place of what it held:
    /// representations of the same content, richest first, each the app
    /// protocol's `clip-item` (be-lib-ui-types' `ClipItem`: a format, its data
    /// and the blocks it names) in be-wasm-ops' encoding, as `fonts` is. The
    /// root copies only what it has rendered: the host never asks it back for
    /// a representation. It answers at once.
    copy: async func(items: list<list<u8>>);

    /// The first of `formats` the platform's clipboard holds, as a
    /// `clip-item` in be-wasm-ops' encoding, or none when it holds none of
    /// them: what a paste brings, which the root hands the field that asked.
    /// It answers once the platform has read it, which may take frames.
    paste: async func(formats: list<string>) -> option<list<u8>>;

    /// Whether the host delivers the paste shortcut (Ctrl+V, Cmd+V) as a
    /// paste itself, as input (be-lib-ui-types' `Input::Paste`), as a web
    /// page does from the browser's paste event: then the root does not also
    /// ask `paste` for it, or it would paste twice. The same every call: a
    /// root asks once.
    paste-shortcut: async func() -> bool;

    /// One row of the host's statistics, as its debug panels show them: a
    /// heading naming the rows under it, or a measurement's latest value,
    /// its average and its peak, each as the host words it ("4.2 ms",
    /// "180 MB"), or empty or "-" where it has none.
    record statistic-row {
        heading: bool,
        name: string,
        current: string,
        average: string,
        peak: string,
    }

    /// The host's read-only statistics at one time (plans/host_as_platform_adapter.md,
    /// What the host keeps).
    record host-statistics {
        /// Which change of the statistics they are, which the next
        /// `statistics` call names as `seen`: never 0.
        generation: u64,
        /// Its frames and steps: the full frame, and each group the host
        /// times (frame pacing, each app's steps), with how long each took.
        performance: list<statistic-row>,
        /// Its process's memory: resident, anonymous, file-backed and shared,
        /// the heap, and wasm memory in all and by guest. Empty where the
        /// host cannot measure it, or until it has.
        memory: list<statistic-row>,
        /// The file the host writes its memory statistics to, if it does: its
        /// whole path, which the host trusts its own root with (an app is never
        /// told it).
        memory-file: option<string>,
    }

    /// Whether the root shows the host's statistics now. The host measures
    /// what only they need (its memory, sampled every few seconds) only while
    /// the root watches, and wakes the root for each sample. It answers at
    /// once; turning the watch off answers a `statistics` call still waiting
    /// with the statistics as they are.
    watch-statistics: async func(watching: bool);

    /// The host's statistics, once they differ from those of the generation
    /// `seen`, as `notices` answers: at once for any other generation, such
    /// as 0. They change only while the root watches them
    /// (`watch-statistics`).
    statistics: async func(seen: u64) -> host-statistics;

    /// What the person may do from the lock screen besides unlocking it.
    enum power-action {
        suspend,
        restart,
        power-off,
        log-out,
    }

    /// A password as the person typed it: its bytes, which the host zeroes
    /// once checked (be-wasm-password's `Password`, never printed).
    type password = list<u8>;

    /// The session's screen lock, which is the host's: the platform's (a
    /// login session's) to engage and to check a password against. The root
    /// only shows it.
    record lock-state {
        /// Which change of the lock this is, which the next `lock` call names
        /// as `seen`: never 0.
        generation: u64,
        /// Whether this host can lock its session at all; when it cannot, it
        /// is never locked.
        available: bool,
        /// Whether the session is locked: the root shows its lock screen over
        /// everything, takes no other input, and shows nothing it would not
        /// show a stranger.
        locked: bool,
        /// Whether a password handed over (`unlock`) is being checked.
        checking: bool,
        /// Why the last unlock was refused, in words for the person, until
        /// they try again.
        refused: option<string>,
        /// The name of the person whose session it is.
        user: string,
        /// What the lock screen offers besides unlocking.
        power: list<power-action>,
        /// While the host makes the person wait after failed passwords, the
        /// frame clock's time, in nanoseconds, the wait ends at, which the root
        /// counts down to itself. Until the host shows the lock again with none,
        /// once the wait is over, a password handed over is dropped unchecked,
        /// whatever the time.
        retry-at: option<u64>,
    }

    /// The screen lock, once it differs from the generation `seen`, as
    /// `notices` answers: at once for any other generation, such as 0.
    lock: async func(seen: u64) -> lock-state;

    /// Locks the session now, as the person asked (a shortcut, a menu); a host
    /// that cannot lock changes nothing. It answers at once; the change
    /// reaches `lock`.
    lock-session: async func();

    /// Hands the host what the person typed into the lock screen to check
    /// against the platform (PAM in a login session). How the check went
    /// reaches the root only through `lock`: unlocked, or refused with why.
    /// The host takes one at a time: while one is being checked (`checking`),
    /// one is handed over and not yet taken, the session is not locked, or
    /// the lock has a `retry-at` (until the host shows it again with none,
    /// once its wait is over), it drops one handed over unchecked. The host rate-limits failed
    /// checks with a growing wait, as the login session's lock does, which is
    /// the guard against guessing, since a root can always lock the session
    /// itself. The host zeroes its decoded copy once checked and nothing of
    /// it crosses back; the buffers it crossed in (the root's text field, the
    /// encoded call and its frame) are not scrubbed, so a root clears its
    /// field as it hands it over and keeps no copy of its own. It answers at
    /// once.
    unlock: async func(password: password);

    /// The person chose `action` on the lock screen, which the host does if
    /// the session is locked and offers it.
    lock-power: async func(action: power-action);

    /// How the block stack's sync stands.
    variant sync-state {
        /// Everything is saved and sent.
        saved,
        /// It is connecting to its server.
        connecting,
        /// It is sending and receiving changes.
        syncing,
        /// It is offline, with this many changes waiting to be sent.
        offline(u32),
        /// It stopped syncing, for this reason, in words for the person.
        failed(string),
    }

    /// Whether the person's changes are saved: what the root shows while they
    /// are not, and when saving takes long (the slow save's toast). It changes
    /// at the rate the person types, so it is a watch of its own rather than a
    /// field of anything slower.
    record saving-state {
        /// Which change of it this is, which the next `saving` call names as
        /// `seen`: never 0.
        generation: u64,
        /// Whether some change is not saved to this device yet.
        unsaved: bool,
        /// Counts the saves finished so far: a save that finishes while others
        /// are still unsaved still moves it, so a wait for saving starts afresh.
        saves: u64,
        /// How many saved changes are not sent to the server yet; a host with
        /// more says as many as fit.
        unsent: u32,
        /// How the block stack's sync with its server stands.
        sync: sync-state,
    }

    /// Whether the person's changes are saved, once it differs from the
    /// generation `seen`, as `notices` answers: at once for any other
    /// generation, such as 0.
    saving: async func(seen: u64) -> saving-state;

    /// Display settings that just changed, which the person keeps or reverts:
    /// the platform's, so a capability of its own.
    record display-question {
        /// Which change it is, which `answer-display` names, so an answer to an
        /// earlier one changes nothing.
        round: u64,
        /// When the host reverts the settings unless the person kept them, on
        /// the frame clock `frame-request`'s `time` reads, in nanoseconds: the
        /// host reverts then whether or not the root answered, and the root
        /// counts down to it.
        revert-at: u64,
    }

    /// Whether the host asks the person to keep display settings.
    record display-state {
        /// Which change of it this is, which the next `displays` call names
        /// as `seen`: never 0.
        generation: u64,
        /// The question, while the host asks it.
        asking: option<display-question>,
    }

    /// Whether the host asks the person to keep display settings, once it
    /// differs from the generation `seen`, as `notices` answers: at once for
    /// any other generation, such as 0.
    displays: async func(seen: u64) -> display-state;

    /// The person kept (`keep`) or reverted the display settings of `round`,
    /// or the time to answer ran out (not kept), which the host does; an
    /// answer to a round it does not ask now is dropped. It answers at once;
    /// the change reaches `displays`.
    answer-display: async func(round: u64, keep: bool);

    /// Why the server refused a change, which the root words for the person.
    enum refusal {
        /// It would go over a limit.
        over-quota,
        /// The server could not take it as it is.
        invalid,
        /// The person's organization does not allow it.
        policy,
        /// The person may not make it there.
        not-permitted,
        /// The server would not say why.
        unexplained,
    }

    /// Why a block's changes were set aside rather than sent, when it was not
    /// that the person lost access to it.
    variant set-aside {
        /// The server refused them.
        refused(refusal),
        /// They were locked offline with a key someone who lost access to the
        /// block may hold: only discarding them lets the person edit it again.
        key-outdated,
        /// They were locked offline under a folder the block is not really
        /// in: only discarding them lets the person edit it again.
        misplaced,
    }

    /// A block whose changes made on this device could not be sent, which
    /// stay until the person restores or discards them.
    record unsent-edit {
        block: block-id,
        /// The block's name, if it has one.
        name: option<string>,
        /// Whether the person may edit it again, so restoring sends them.
        offerable: bool,
        /// Why they were set aside, or none when access to it was lost.
        aside: option<set-aside>,
        /// How many of its changes on this device never became a commit; a
        /// host with more says as many as fit.
        kept-edits: u32,
    }

    /// An account this device keeps, which the person can open.
    record account-row {
        /// The host's name for it, which `core-command`s name it by.
        key: string,
        name: string,
        email: string,
        /// Its server's address, or none for an account kept on this device
        /// alone, whose blocks go when it is removed.
        server: option<string>,
        /// Whether it remembers the organization it was in last, which opening
        /// it goes back to.
        has-last-organization: bool,
        /// Whether it is the account open now.
        current: bool,
        /// The organizations it belongs to, by name.
        organizations: list<string>,
    }

    /// A sign-in the person finishes in their browser.
    record browser-sign-in {
        /// The page the person signs in on.
        url: string,
        /// The code that page asks for, which the root shows.
        code: string,
    }

    /// Adding an account, while the host is at it.
    record signing-in {
        /// The browser sign-in, once the server gave one.
        browser: option<browser-sign-in>,
    }

    /// What the block stack waits for the person to do before it opens an
    /// organization's blocks.
    enum core-wait {
        /// Open or add an account.
        account,
        /// Choose, join or create an organization.
        organization,
        /// Choose a session in the organization.
        session,
    }

    /// An organization the account belongs to.
    record organization-row {
        id: organization-id,
        name: string,
    }

    /// Whether the account's organizations are listed yet.
    variant organizations-listed {
        /// Asked of the server, not answered yet.
        loading,
        /// The organizations, as the server answered.
        loaded(list<organization-row>),
        /// The server could not list them, which `reload-organizations` asks
        /// again.
        failed,
    }

    /// An invitation into an organization, opened from its link.
    record invitation {
        /// The organization's name.
        organization: string,
        /// Who invited the person, as their card says.
        inviter: string,
        /// Why this account cannot take it (already a member, say), or why
        /// nobody can (it expired), in words; none while it can be joined.
        problem: option<string>,
        /// Whether the account open may join it now.
        can-join: bool,
    }

    /// The account's organizations, and joining or creating one.
    record organizations-area {
        listed: organizations-listed,
        /// The invitation opened, until it is joined or put aside.
        joining: option<invitation>,
        /// Whether joining, creating or listing is under way.
        busy: bool,
        /// Why joining, creating or listing failed last, in words.
        error: option<string>,
    }

    /// A session of the organization: the blocks the person had open, as
    /// they left them.
    record session-row {
        id: uuid,
        name: string,
        /// The type of session it is, which the editor it opens in names.
        session-type: block-type-id,
        /// Whether it is the session the person used last.
        current: bool,
    }

    /// A type a new session can be, with its name.
    record session-kind {
        id: block-type-id,
        name: string,
    }

    /// A profile: which settings this device uses.
    record profile-row {
        id: uuid,
        name: string,
        /// Whether this device uses it now.
        current: bool,
    }

    /// The organization's sessions and this device's profiles.
    record sessions-area {
        /// Whether the sessions and profiles are read yet.
        loaded: bool,
        /// The organization's sessions, of every type.
        sessions: list<session-row>,
        /// The types a new session can be.
        session-kinds: list<session-kind>,
        /// The type of session this device opens, which a new session is
        /// unless the person picks another.
        session-type: block-type-id,
        profiles: list<profile-row>,
    }

    /// An account whose sign-in ended, which the person signs in to again.
    record reauthenticating {
        /// The account's key, which `forget-account` names it by.
        key: string,
        name: string,
        /// Whether its sign-in is under way.
        busy: bool,
        /// Why signing in again failed, in words.
        error: option<string>,
    }

    /// What discarding the changes not saved to this device yet would be for,
    /// which the host asks the person to confirm before it does it.
    enum discard-reason {
        /// Switching organizations.
        switch-organization,
        /// Closing the host.
        close,
    }

    /// How an invitation into the organization stands.
    enum invitation-state {
        /// Made, not opened yet.
        waiting,
        /// Opened by someone, not accepted yet.
        opened,
        accepted,
        expired,
        revoked,
    }

    /// An invitation into the organization, without its link, a secret that
    /// `invitation-link` hands over.
    record invitation-row {
        id: uuid,
        state: invitation-state,
        /// Who made it.
        inviter: string,
        /// Who accepted it, once someone did.
        accepter: option<string>,
        /// When it was made, opened, expires and ended (accepted or revoked),
        /// in milliseconds since the Unix epoch.
        created: s64,
        opened: option<s64>,
        expires: s64,
        ended: option<s64>,
        /// Whether its link can be had again (one of the person's own, still
        /// open).
        has-link: bool,
    }

    /// The organization's invitations, once the root asked for them.
    record invitations-area {
        /// Whether they are listed yet since `list-invitations` last asked.
        listed: bool,
        rows: list<invitation-row>,
        /// Whether inviting, listing or revoking is under way.
        busy: bool,
        /// Why it failed last, in words.
        error: option<string>,
    }

    /// A secret the host hands the person once, as the answer to the command
    /// that made it, never in `core-view`: the root holds it only while it
    /// shows it.
    variant core-secret {
        /// An invitation's link, which whoever holds it may join by.
        link(password),
    }

    /// What the block stack shows the person, a field per area, each the
    /// plain data its area shows; the root words it, and holds what is open
    /// and what is being asked itself. It changes at the rate its slowest
    /// areas do; saving, which is fast, is `saving`.
    record core-view {
        /// Which change of it this is, which the next `core` call names as
        /// `seen`: never 0.
        generation: u64,
        /// The blocks whose changes could not be sent, oldest first.
        unsent: list<unsent-edit>,
        /// What the block stack waits for the person to do, which the root
        /// shows its area for; none once an organization's blocks are open.
        waits-for: option<core-wait>,
        /// The accounts this device keeps.
        accounts: list<account-row>,
        /// Adding an account, while the host is at it.
        signing-in: option<signing-in>,
        /// Why adding, opening or removing an account failed last, in words,
        /// until the next attempt.
        account-error: option<string>,
        /// The account's organizations.
        organizations: organizations-area,
        /// The organization's sessions.
        sessions: sessions-area,
        /// An account whose sign-in ended, while the host asks the person to
        /// sign in to it again.
        reauthenticating: option<reauthenticating>,
        /// What discarding unsaved changes would be for, while the host asks
        /// the person to confirm it.
        discarding: option<discard-reason>,
        /// The organization's invitations.
        invitations: invitations-area,
    }

    /// What the block stack shows the person, once it differs from the
    /// generation `seen`, as `notices` answers: at once for any other
    /// generation, such as 0.
    core: async func(seen: u64) -> core-view;

    /// A new account on the server at `url`, which the person signs in to in
    /// their browser.
    record server-account {
        url: string,
        /// The gateway token the server's address needs, if it needs one: a
        /// secret, zeroed once the host decoded it, as `unlock`'s password is.
        gateway: option<password>,
    }

    /// Where a new account is kept.
    variant new-account {
        /// On this device alone, under this name.
        local(string),
        /// On a server.
        server(server-account),
    }

    /// What the person asked of the block stack, a case per area's request.
    variant core-command {
        /// Send a block's unsent changes again.
        restore-unsent(block-id),
        /// Drop a block's unsent changes for good, which the root asks the
        /// person to confirm first.
        discard-unsent(block-id),
        /// Open the account of this key, in the organization it was in last.
        open-account(string),
        /// Open the account of this key, choosing its organization afresh.
        choose-organization(string),
        /// Sign out of the account of this key and forget it on this device;
        /// one kept on this device alone takes its blocks with it, which the
        /// root asks the person to confirm first.
        forget-account(string),
        /// Add an account, which `signing-in` shows until it is added or
        /// fails, unless one is being added already.
        add-account(new-account),
        /// Open the browser sign-in's page in the person's browser.
        open-sign-in-page,
        /// Ask the server now whether the browser sign-in finished, rather
        /// than at its next turn.
        check-sign-in,
        /// Stop adding an account, and forget why the last attempt failed.
        cancel-sign-in,
        /// Leave the account open for the accounts, keeping it on this device.
        switch-account,
        /// List the account's organizations again.
        reload-organizations,
        /// Open the organization, in the session the person used last.
        open-organization(organization-id),
        /// Open the organization, choosing its session.
        choose-session-in(organization-id),
        /// Create an organization of this name.
        create-organization(string),
        /// Open the invitation of the link the person pasted: a bearer
        /// secret, so a `password`, zeroed once decoded.
        open-invitation(password),
        /// Join the organization of the invitation opened.
        join-invited,
        /// Put the invitation opened aside.
        cancel-join,
        /// Choose another session of the organization open.
        choose-session,
        /// Stop choosing a session, back in the one open.
        close-sessions,
        /// Open the session of this id.
        open-session(uuid),
        /// Open a new session of this type.
        new-session(block-type-id),
        /// Use the profile of this id on this device.
        use-profile(uuid),
        /// Make a new profile, and use it on this device.
        new-profile,
        /// Sign in again to the account `reauthenticating` names, which
        /// `signing-in` shows until it is done.
        reauthenticate,
        /// Choose another organization, which the host may first ask to
        /// discard unsaved changes for (`discarding`).
        switch-organization,
        /// Discard the unsaved changes, and do what `discarding` named.
        confirm-discard,
        /// Keep the unsaved changes, and do nothing.
        cancel-discard,
        /// List the organization's invitations.
        list-invitations,
        /// Make an invitation into the organization, answered with its link.
        invite-member,
        /// Hand over the link of the invitation of this id again, answered
        /// with it while it is one of the person's own and still open.
        invitation-link(uuid),
        /// Revoke the invitation of this id.
        revoke-invitation(uuid),
    }

    /// The person asked `command` of the block stack, which the host does. It
    /// answers at once; what changes reaches `core`. A command naming a block
    /// or an account the view no longer lists (it went while the person was
    /// asked) changes nothing. A secret in it (`add-account`'s gateway token)
    /// is zeroed once decoded, as `unlock`'s password is. It answers once the
    /// command is taken, with nothing, but for a command making a secret
    /// (`invite-member`, `invitation-link`), which it answers once made: with
    /// the secret, or nothing if it failed, why reaching `core`.
    ask-core: async func(command: core-command) -> option<core-secret>;
}

/// The window's input, which the host hands the root inline on its frame thread
/// (plans/host_as_platform_adapter.md, Input).
interface input {
    /// The window's input since the last call, in order, in the window's
    /// points: be-lib-ui-types' `Timed` inputs, each with the frame clock's
    /// time it was sampled at when the platform said, in its encoding
    /// (`input::encode`), as the layer list is be-lib-layers'. A pointer's
    /// moves within a frame are merged to the last unless the root asked for
    /// every sample (`frame-done`'s `every-sample`). A sample's time is real
    /// time measured from the frame clock's origin, so while the host's clock
    /// is stopped (drive's) it can be later than the frame's `time`.
    /// `window` names the window as the
    /// layer list does: none for the host's one window. The root routes each
    /// event to the surface it is for, by the layers it drew last, and answers
    /// as soon as it has routed, not once its children heard: the host keeps
    /// each call until it is answered. The host calls it ahead of the frame it
    /// is input for, and steps the root through it with that frame, or with
    /// the frame being drawn if one is.
    deliver: async func(window: option<u64>, events: list<u8>);
}

/// The root's frame entry, which the host calls inline on its frame thread.
interface frames {
    /// What the host asks a frame for.
    record frame-request {
        /// The frame clock's time, in nanoseconds: what the frame is drawn
        /// for. It moves only when the host's clock does, so a stopped clock
        /// (drive's) draws every frame for the same time.
        time: u64,
        /// The wall clock at `time`, in nanoseconds since the Unix epoch: the
        /// host's, which a driver may pin (drive's pinned wall clock), so a
        /// root reads neither clock of its own.
        wall-clock: u64,
    }

    /// A drawn frame.
    record frame-done {
        /// Its layer list, each window's surfaces in z-order
        /// (plans/host_as_platform_adapter.md, The layer list), in
        /// be-lib-layers' encoding (`LayerList::encode`).
        layers: list<u8>,
        /// The frame clock's time, in nanoseconds, the root wants its next frame drawn for:
        /// at once if it is not after this frame's, and none while it wants no frame until its
        /// input or something it spawned wakes it, which wakes its host too. A host that draws
        /// only on demand draws that frame; one that draws every frame may ignore it. Wanting a
        /// frame is not owing one (`owed`).
        next: option<u64>,
        /// Whether the root owes work now: something it spawned is starting, or has a frame
        /// due or in flight. A frame it wants only later, or for an animation, is not owed, so
        /// a host waiting for its root to settle waits only while this is set.
        owed: bool,
        /// The input method's area in the host's one window, in its points: the field
        /// the focused surface edits, as be-lib-ui-types' `ImeArea` in its encoding
        /// (`ImeArea::encode`). None while no surface edits text; the host shows the
        /// platform's input method there.
        ime: option<list<u8>>,
        /// Whether the host's one window hands the root every sample of a
        /// pointer's moves, each with its time, rather than merging a frame's
        /// moves into the last: while a surface it shows asks for them, as a
        /// canvas drawing a pen stroke does.
        every-sample: bool,
        /// The cursor shape the host's one window shows, by its CSS name
        /// (be-lib-ui-types' `CursorIcon::name`): the surface's under the
        /// pointer. One the host does not know shows the default arrow.
        cursor: string,
        /// Whether the pointer is locked to the host's one window, hidden and
        /// held in place with its moves reported as motion: while the focused
        /// surface holds the lock.
        pointer-locked: bool,
    }

    /// Draws a frame. The host steps the root until it answers: between
    /// steps it waits for the calls the root waits on (its children's
    /// frames, `deadline`), so the frame may await its children as ordinary
    /// async code, and answers within one host frame.
    frame: async func(request: frame-request) -> frame-done;
}

/// What the host's tests ask of the root, beside the frames (an extension, as
/// `be3:debug`'s `paintings` is beside the app protocol): a host without
/// those tests never calls it.
interface paintings {
    /// What the root's own surfaces painted, in beui-paint-format's encoding
    /// of screen paintings (`ScreenPaintings`), each under its surface's id
    /// (`Surface::Root`), in its pixels; a surface it paints no painting of is
    /// left out, and none at all may be answered as no bytes. The host places each where the layer list drawn last shows
    /// its surface.
    paintings: async func() -> list<u8>;
}

/// The root guest: be-host's own module, which the host calls synchronously
/// and serves the sandbox (`be3:sandbox/spawner`) and `host`.
world root {
    import host;
    export input;
    export frames;
    export paintings;
}
