package be3:root@0.1.0;

/// What the host serves the root guest beside the sandbox
/// (plans/host_as_platform_adapter.md, The root guest).
interface host {
    /// Answers once the frame being drawn reaches its deadline: the display's
    /// next present less the time the host's own work after the frame takes.
    /// Until then the root waits for its children's answers; after it, it
    /// draws what it has. The root's own calls have no deadline. Called
    /// outside a frame, it answers at once.
    deadline: async func();

    /// The fonts the host bundles, which the root draws its text in and tells
    /// the apps it embeds: the app protocol's `fonts` record (be-sdk-api's
    /// `Fonts`, with `replace` set) as a host tells an app, in be-wasm-ops'
    /// encoding (`be_wasm_ops::encode`), as the layer list is bytes. The same
    /// faces every call: a root asks once.
    fonts: async func() -> list<u8>;
}

/// The window's input, which the host hands the root inline on its frame thread
/// (plans/host_as_platform_adapter.md, Input).
interface input {
    /// The window's input since the last call, in order, in the window's
    /// points: be-lib-ui-types' `Timed` inputs, each with the frame clock's
    /// time it was sampled at when the platform said, in its encoding
    /// (`input::encode`), as the layer list is be-lib-layers'. A pointer's
    /// moves within a frame are merged to the last unless the root asked for
    /// every sample (`frame-done`'s `every-sample`). A sample's time is real
    /// time measured from the frame clock's origin, so while the host's clock
    /// is stopped (drive's) it can be later than the frame's `time`.
    /// `window` names the window as the
    /// layer list does: none for the host's one window. The root routes each
    /// event to the surface it is for, by the layers it drew last, and answers
    /// as soon as it has routed, not once its children heard: the host keeps
    /// each call until it is answered. The host calls it ahead of the frame it
    /// is input for, and steps the root through it with that frame, or with
    /// the frame being drawn if one is.
    deliver: async func(window: option<u64>, events: list<u8>);
}

/// The root's frame entry, which the host calls inline on its frame thread.
interface frames {
    /// What the host asks a frame for.
    record frame-request {
        /// The frame clock's time, in nanoseconds: what the frame is drawn
        /// for. It moves only when the host's clock does, so a stopped clock
        /// (drive's) draws every frame for the same time.
        time: u64,
        /// The wall clock at `time`, in nanoseconds since the Unix epoch: the
        /// host's, which a driver may pin (drive's pinned wall clock), so a
        /// root reads neither clock of its own.
        wall-clock: u64,
    }

    /// A drawn frame.
    record frame-done {
        /// Its layer list, each window's surfaces in z-order
        /// (plans/host_as_platform_adapter.md, The layer list), in
        /// be-lib-layers' encoding (`LayerList::encode`).
        layers: list<u8>,
        /// The frame clock's time, in nanoseconds, the root wants its next frame drawn for:
        /// at once if it is not after this frame's, and none while it wants no frame until its
        /// input or something it spawned wakes it, which wakes its host too. A host that draws
        /// only on demand draws that frame; one that draws every frame may ignore it. Wanting a
        /// frame is not owing one (`owed`).
        next: option<u64>,
        /// Whether the root owes work now: something it spawned is starting, or has a frame
        /// due or in flight. A frame it wants only later, or for an animation, is not owed, so
        /// a host waiting for its root to settle waits only while this is set.
        owed: bool,
        /// The input method's area in the host's one window, in its points: the field
        /// the focused surface edits, as be-lib-ui-types' `ImeArea` in its encoding
        /// (`ImeArea::encode`). None while no surface edits text; the host shows the
        /// platform's input method there.
        ime: option<list<u8>>,
        /// Whether the host's one window hands the root every sample of a
        /// pointer's moves, each with its time, rather than merging a frame's
        /// moves into the last: while a surface it shows asks for them, as a
        /// canvas drawing a pen stroke does.
        every-sample: bool,
        /// The cursor shape the host's one window shows, by its CSS name
        /// (be-lib-ui-types' `CursorIcon::name`): the surface's under the
        /// pointer. One the host does not know shows the default arrow.
        cursor: string,
        /// Whether the pointer is locked to the host's one window, hidden and
        /// held in place with its moves reported as motion: while the focused
        /// surface holds the lock.
        pointer-locked: bool,
    }

    /// Draws a frame. The host steps the root until it answers: between
    /// steps it waits for the calls the root waits on (its children's
    /// frames, `deadline`), so the frame may await its children as ordinary
    /// async code, and answers within one host frame.
    frame: async func(request: frame-request) -> frame-done;
}

/// What the host's tests ask of the root, beside the frames (an extension, as
/// `be3:debug`'s `paintings` is beside the app protocol): a host without
/// those tests never calls it.
interface paintings {
    /// What the root's own surfaces painted, in beui-paint-format's encoding
    /// of screen paintings (`ScreenPaintings`), each under its surface's id
    /// (`Surface::Root`), in its pixels; a surface it paints no painting of is
    /// left out, and none at all may be answered as no bytes. The host places each where the layer list drawn last shows
    /// its surface.
    paintings: async func() -> list<u8>;
}

/// The root guest: be-host's own module, which the host calls synchronously
/// and serves the sandbox (`be3:sandbox/spawner`) and `host`.
world root {
    import host;
    export input;
    export frames;
    export paintings;
}
