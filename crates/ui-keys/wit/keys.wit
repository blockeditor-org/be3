package be3:keys@0.1.0;

/// The keys and modifiers beui, the plugin protocol and the terminal share.
/// The Rust in `ui-keys` is generated from this. None of it is frozen
/// (guides/frozen_formats.md), so a shape may change like any other.
interface types {
    enum key {
        arrow-down,
        arrow-left,
        arrow-right,
        arrow-up,
        backspace,
        bracket-left,
        bracket-right,
        delete,
        end,
        enter,
        escape,
        home,
        minus,
        page-down,
        page-up,
        plus,
        space,
        tab,
        zero,
        one,
        two,
        three,
        four,
        five,
        six,
        seven,
        eight,
        nine,
        backtick,
        a,
        b,
        c,
        d,
        e,
        f,
        g,
        h,
        i,
        j,
        k,
        l,
        m,
        n,
        o,
        p,
        q,
        r,
        s,
        t,
        u,
        v,
        w,
        x,
        y,
        z,
        insert,
        comma,
        period,
        slash,
        backslash,
        semicolon,
        quote,
        browser-back,
        f1,
        f2,
        f3,
        f4,
        f5,
        f6,
        f7,
        f8,
        f9,
        f10,
        f11,
        f12,
        f13,
        f14,
        f15,
        f16,
        f17,
        f18,
        f19,
        f20,
        f21,
        f22,
        f23,
        f24,
        volume-up,
        volume-down,
        volume-mute,
        mic-mute,
        brightness-up,
        brightness-down,
        media-play-pause,
        media-next,
        media-previous,
        media-stop,
        shift,
        ctrl,
        alt,
        logo,
        unidentified,
    }

    record modifiers {
        alt: bool,
        ctrl: bool,
        shift: bool,
        logo: bool,
    }

    record key-press {
        key: key,
        pressed: bool,
        repeat: bool,
        modifiers: modifiers,
    }

    record key-chord {
        key: key,
        modifiers: modifiers,
        tap: bool,
    }
}

world keys {
    import types;
}
