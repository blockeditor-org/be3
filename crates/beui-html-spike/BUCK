load("@root//buck/cargo:defs.bzl", "cargo_binary", "cargo_test")
load("@root//buck/program:defs.bzl", "prerendered_page")
load("@root//buck/program:drive.bzl", "web_drive_test")
load("@root//buck/wasm:defs.bzl", "web_library", "web_program")

# be-host's account picker (crates/be-host-accounts-ui) on beui's HTML core,
# with fixture accounts: :ssr renders the page on the host, and :web's module
# hydrates it in the browser. `./scripts/buck run //crates/beui-html-spike:web`
# serves it with Caddy on http://127.0.0.1:8060, or on the address after `--`.
web_library(
    role = "html",
    target_compatible_with = ["root//buck/constraints:html"],
)

cargo_binary(
    name = "ssr",
    default_target_platform = "root//buck/platforms:linux_x86_64_html",
    target_compatible_with = ["root//buck/constraints:html"],
)

# A painting of the page as :ssr renders it, before any script runs:
# `./scripts/test //crates/beui-html-spike:html-test`.
cargo_test(
    name = "html-test",
    default_target_platform = "root//buck/platforms:linux_x86_64_html",
    paints = True,
    target_compatible_with = ["root//buck/constraints:html"],
)

prerendered_page(
    name = "index",
    renderer = ":ssr",
)

web_program(
    name = "web",
    module = "beui_html_spike",
    role = "html",
    files = [
        ":index",
        "web/start.js",
        "//crates/beui-fonts:Inter-Regular.ttf",
        "//crates/beui-fonts:Hack-Regular.ttf",
        "//crates/beui-fonts:NotoEmoji-Regular.ttf",
        "//crates/beui-fonts:lucide.ttf",
    ],
    serve = "127.0.0.1:8060",
)

# src/drive/accounts.drive in Chromium against :web, and the page's checks()
# (web/start.js): it arrives prerendered and hydration keeps every element.
web_drive_test(
    name = "web-test",
    bundle = ":web",
    checks = True,
    scripts = glob(["src/drive/*.drive"]),
)
