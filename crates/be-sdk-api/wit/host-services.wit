package be3:app@0.1.0;

/// What an editor asks of its host and waits for: files and their dialogs, a
/// block's revisions, who it is shared with, and blocks to import. An editor
/// makes every call for itself, its `editor` the call's parent, so closing the
/// editor cancels whatever it still waits on: the host drops that work (an
/// import or export not yet made) and answers `canceled`.
interface host-services {
    use be3:shared/ids@0.1.0.{account-id, block-id, block-type-id, commit-id};
    use be3:shared/access@0.1.0.{access-level};
    use types.{block-location, failure};
    use account.{notify-mode};
    use be3:ui/types@0.1.0.{file-filter, file-pick, saved-file, file-save};

    /// What the instance that draws the window does for a block it shows:
    /// shows its sharing dialog, or closes it (the editor showing the block
    /// asked to close itself).
    variant shell-dialog {
        share,
        close,
    }

    /// A saved revision of a block: its commit, when it was saved in
    /// milliseconds since the epoch, and whether it is the block's head.
    record revision {
        commit: commit-id,
        time: s64,
        current: bool,
    }

    /// Who has access to a block: what they were granted, if anything, and
    /// what they may do once their organization and the block's parents count.
    record access-grant {
        account: account-id,
        email: string,
        display-name: string,
        administrator: bool,
        author: bool,
        granted: option<access-level>,
        /// What reaches the block from above, without its own grant.
        inherited: access-level,
        effective: access-level,
        /// The block whose grant or authorship gave `effective`.
        source: option<block-id>,
        waiting: bool,
    }

    /// Who has access to a block, whether its organization is a company, and
    /// how many blocks inside it set access of their own.
    record access-listing {
        grants: list<access-grant>,
        company: bool,
        set-inside: u32,
    }

    /// A block a file was imported into.
    record imported-block {
        block-id: block-id,
        block-type: block-type-id,
    }

    /// The block's saved revisions, newest first.
    list-revisions: async func(block: block-id) -> result<list<revision>, failure>;

    /// Opens a read-only block showing `block` as it was at `commit`, which the
    /// editor shows until it releases it.
    preview-revision: async func(block: block-id, commit: commit-id) -> result<block-id, failure>;

    /// Makes `commit`'s content the block's newest revision.
    restore-revision: async func(block: block-id, commit: commit-id) -> result<_, failure>;

    /// Closes a preview `preview-revision` opened.
    release-revision: async func(preview: block-id);

    /// Asks the user for a file to open.
    pick-file: async func(filter: file-filter) -> file-pick;

    /// Asks the user where to save `file`.
    save-file: async func(file: saved-file) -> file-save;

    /// Saves a block and everything inside it as a block file the user places.
    export-block: async func(block: block-id) -> file-save;

    /// The block as the plain file its type writes it as.
    read-plain-file: async func(block: block-id) -> result<saved-file, failure>;

    /// Asks the user for a block file and imports it into `parent`, none when
    /// they cancel.
    import-blocks: async func(parent: block-location) -> result<option<imported-block>, failure>;

    /// A block a paste of `be3/blocks` placed (`paste-blocks`).
    record pasted-block {
        block-id: block-id,
        block-type: block-type-id,
        /// Whether the paste moved the block here, from the parent it was
        /// cut from; otherwise the editor adds a reference to it.
        moved: bool,
    }

    /// The editor cut references to `blocks` that it holds in `holder`, and
    /// removes them from its content as a delete does. The host records the
    /// cut, not the clip: the first paste of a block whose parent `holder` was
    /// moves it there (`paste-blocks`).
    cut-blocks: async func(blocks: list<block-id>, holder: block-id);

    /// The editor pastes `be3/blocks` into `parent`. The host answers with the
    /// blocks the editor may view, which it adds references to; a block cut
    /// from its parent and not yet pasted moves to `parent`. Every paste
    /// uses up the cut, so later ones add references.
    paste-blocks: async func(blocks: list<block-id>, parent: block-location) -> result<list<pasted-block>, failure>;

    /// Copies `source` and everything inside it into `parent`.
    copy-blocks: async func(source: block-id, parent: block-location) -> result<option<imported-block>, failure>;

    /// Everyone who has access to the block or could be given it.
    list-access: async func(block: block-id) -> result<access-listing, failure>;

    /// Grants `account` `access` to the block.
    set-access: async func(block: block-id, account: account-id, access: access-level);

    /// A contact link whose taker is granted `access` to the block.
    make-contact-link: async func(block: block-id, access: access-level) -> result<string, failure>;

    /// An agent bound to one block (`create-block-agent`): its account, and
    /// the credentials `be` signs in as it with, the JSON object
    /// `BE3_AGENT_CREDENTIALS` holds, recovery phrase and token included.
    record block-agent {
        agent: account-id,
        credentials: string,
    }

    /// Makes an agent named `name` that reaches `block` and the blocks under
    /// it with Edit, and nothing else, for a program that hosts the block
    /// from a machine trusted less than the person's devices. Needs Manage on
    /// the block, which is the editor's own or one below it, and is denied
    /// unless the app's manifest sets `block_agents`. The app hands the
    /// credentials to the machine itself.
    create-block-agent: async func(block: block-id, name: string) -> result<block-agent, failure>;

    /// A new token for an agent `create-block-agent` made, answered alone;
    /// every older token stops signing it in.
    rotate-agent-token: async func(agent: account-id) -> result<string, failure>;

    /// Deletes an agent `create-block-agent` made.
    remove-agent: async func(agent: account-id) -> result<_, failure>;

    /// Where a `be` of the host's own build comes from (`terminal-host-binary`).
    record terminal-host-download {
        /// The deployment's copy of `be`, under its `data/{build}/be-{triple}/be`.
        url: string,
        /// Its SHA-256, lower-case hex, to check once downloaded.
        sha256: string,
    }

    /// A deployed build's `be` is downloaded; a development build's is its
    /// bytes, built on this machine.
    variant terminal-host-source {
        download(terminal-host-download),
        bytes(list<u8>),
    }

    /// The `be` of the host's own build for one architecture, and the
    /// `build-info.json` to put beside it, which names the build to the
    /// server.
    record terminal-host-be {
        source: terminal-host-source,
        build-info: string,
    }

    /// Where to get `be` of the host's own build for a Linux machine of `arch`
    /// (`x86_64` or `arm64`), for a terminal host the app installs on a
    /// machine of its own (guides/terminal.md). A development build without
    /// one built fails naming what to build. Denied unless the app's manifest
    /// sets `block_agents`.
    terminal-host-binary: async func(arch: string) -> result<terminal-host-be, failure>;

    /// The `build-info.json` a `be` of the host's own build carries, which
    /// names the build: what an app compares with the `be` a machine of its
    /// own runs, without `terminal-host-binary`'s bytes. Denied unless the
    /// app's manifest sets `block_agents`.
    terminal-host-build: async func() -> result<string, failure>;

    /// Notifies the block's members who are not connected, on their other
    /// devices: `text` (at most about 1 KiB), sealed with the block and the
    /// time so only members read it; each device names the sender and the
    /// block itself. `mentions` names accounts the text mentions, which a
    /// member who chose `mentions` is notified for, and urgently. Needs Edit on
    /// the block; the host drops it when it is offline.
    notify: async func(block: block-id, text: string, mentions: list<account-id>);

    /// Sets how the signed-in account is notified about the block
    /// (`account.notify-modes-watch` follows every block's).
    set-notify-mode: async func(block: block-id, mode: notify-mode) -> result<_, failure>;

    /// Turns pushes to this device on or off (`account.push-device-watch`
    /// follows them). Turning them on asks the person's permission, so it must
    /// follow their press; a refusal answers a failure.
    set-push-device: async func(on: bool) -> result<_, failure>;

    /// Who signed bytes, as far as this device can tell
    /// (plans/authorship.md).
    enum signer {
        /// The account's own key, or a contact's, verified out of band.
        verified,
        /// The key the server named the first time this device asked, never
        /// verified.
        unverified,
        /// A key the server names now in place of the one this device first
        /// took: the account took a new recovery phrase, or the server lies.
        changed,
        /// Not the account's signature: forged, or the bytes changed since.
        bad,
    }

    /// The block signatures bind to in the block the editor shows: the block
    /// itself, or in a revision preview the block the revision is of. A record
    /// that names its block inside what it signs names this one.
    signing-block: async func() -> result<block-id, failure>;

    /// Signs `bytes` as the person, with a key the app never holds. The
    /// signature covers the block the editor shows, so it verifies only
    /// there, and the host also binds the asking app, so another app's `verify`
    /// never accepts it. At most 64 KiB. Denied in a revision preview.
    sign: async func(bytes: list<u8>) -> result<list<u8>, failure>;

    /// Whether `account` signed `bytes` in the block the editor shows, through
    /// the same app (the host binds the asking app, so a signature another app
    /// made answers `bad`, which is not a verdict that it was forged), and
    /// how far its key is trusted. `unavailable` while the answer needs the
    /// server and it cannot be reached.
    verify: async func(
        account: account-id,
        bytes: list<u8>,
        signature: list<u8>,
    ) -> result<signer, failure>;

    /// The files the app ships in its data directory.
    list-data: async func() -> result<list<string>, failure>;

    /// One file of the app's data directory.
    read-data: async func(path: string) -> result<list<u8>, failure>;
}
