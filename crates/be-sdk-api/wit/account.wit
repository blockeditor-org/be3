package be3:app@0.1.0;

/// What the host knows of the account it is signed in as and of itself,
/// watched by any editor.
interface account {
    use be3:preferences/types@0.1.0.{preference-layer};
    use be3:shared/ids@0.1.0.{block-id};

    /// Where the preferences an editor is drawn with come from, below the
    /// user's own: the system's and the developer's.
    record host-preference-sources {
        system: preference-layer,
        developer: preference-layer,
    }

    /// Whether the account administers the company it belongs to.
    resource administrator-watch {
        constructor();
        next: async func() -> bool;
    }

    /// The base links to blocks are made from, empty on a local server.
    resource link-base-watch {
        constructor();
        next: async func() -> string;
    }

    /// The system's and the developer's preference layers.
    resource preference-sources-watch {
        constructor();
        next: async func() -> host-preference-sources;
    }

    /// What the server keeps for the account against its quota, in bytes.
    record account-storage {
        /// Held by the blocks the account pays for.
        held: u64,
        /// Uploaded and not yet held by any block.
        pending: u64,
        /// None when there is no limit.
        quota: option<u64>,
    }

    /// The account's storage, none until the server has said (or on a host
    /// with no server).
    resource storage-usage-watch {
        constructor();
        next: async func() -> option<account-storage>;
    }

    /// Which notifications about a block reach the signed-in account.
    enum notify-mode {
        all,
        /// Only those that mention the account.
        mentions,
        off,
    }

    /// A block whose notifications the account set to other than `all`.
    record block-notify-mode {
        block: block-id,
        mode: notify-mode,
    }

    /// Whether this device shows notifications pushed to it.
    enum push-device {
        off,
        on,
        /// The person refused the permission to show notifications; only the
        /// browser's own settings undo that.
        denied,
    }

    /// This device's state, which `host-services.set-push-device` changes; none
    /// on a host that cannot receive pushes (no browser push service).
    resource push-device-watch {
        constructor();
        next: async func() -> option<push-device>;
    }

    /// Every block whose mode the account set to other than `all`, which
    /// every other block is; none until the server has said (or on a host with
    /// no server). Changes made on other devices arrive as the server tells
    /// the host.
    resource notify-modes-watch {
        constructor();
        next: async func() -> option<list<block-notify-mode>>;
    }
}

/// The account's contacts, watched only by the shell's editor.
interface contacts {
    use be3:shared/ids@0.1.0.{account-id};

    record host-contact {
        account: account-id,
        display-name: string,
        email: string,
        verified: bool,
    }

    resource contacts-watch {
        constructor();
        next: async func() -> list<host-contact>;
    }
}
