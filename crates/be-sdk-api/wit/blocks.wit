package be3:app@0.1.0;

/// The blocks an editor reads and changes through its host: the block graph,
/// a block's content, history and version control, and asks to open blocks.
interface blocks {
    use types.{block-location, editor-id, export-request, failure, host-panel};
    use be3:shared/ids@0.1.0.{
        account-id, block-id, block-type-id, commit-id, content-type-id, uuid,
    };
    use be3:shared/access@0.1.0.{access-level};

    variant block-query {
        roots,
        detached,
        shared,
        /// What is in the account's own Unfiled, whose id the editor never
        /// learns: each such block reads back with the parent `unfiled`.
        unfiled,
        children(block-id),
        references(block-id),
        backrefs(block-id),
        parents(block-id),
        block(block-id),
        /// The nearest kind of each type, above the block, that is open to
        /// anyone who views a block inside its owner.
        open-settings(block-id),
    }

    /// Metadata keyed by the uuid of its kind, each value its encoded bytes.
    type metadata-entries = list<tuple<uuid, list<u8>>>;

    record block-metadata {
        defined: metadata-entries,
        derived: metadata-entries,
    }

    record block-info {
        block-id: block-id,
        block-type: block-type-id,
        author: option<account-id>,
        parent: option<block-location>,
        references: list<block-id>,
        access: access-level,
        metadata: block-metadata,
        locked: bool,
        deleted: bool,
        /// The block has a grant of its own to an account.
        sets-access: bool,
        /// Bytes the server keeps for this block alone, history included.
        size: u64,
        /// `size` plus each child's `tree-size`, as the server counts them.
        tree-size: u64,
        /// The host is offline and holds no version of the block's content whole, so the block
        /// can be neither opened nor changed until it reconnects.
        out-of-reach: bool,
        /// How many things in the block's content this account has not read, for a type
        /// that counts them (a chat's new messages); zero otherwise.
        unread: u32,
    }

    enum artifact-action {
        regenerate,
        unlink,
    }

    record artifact-state {
        block-id: block-id,
        source-type: uuid,
        source: block-id,
        summary: option<string>,
        error: option<string>,
        regenerating: bool,
    }

    record stored-head {
        commit: commit-id,
        content-type: content-type-id,
        bytes: list<u8>,
    }

    record artifact-command {
        action: artifact-action,
    }

    record unlink-command {
        container: block-id,
    }

    record delete-command {
        block-type: block-type-id,
        source: block-location,
    }

    record move-command {
        block-type: block-type-id,
        source: block-location,
        destination: block-id,
        is-reference: bool,
    }

    /// Moves the block among the children of `parent`: after the child
    /// `after`, or first when it is none.
    record reorder-command {
        parent: block-id,
        after: option<block-id>,
    }

    record place-command {
        block-type: block-type-id,
        parent: block-id,
        linked: bool,
    }

    /// Sets or, with no value, clears one metadata entry the block defines.
    record define-command {
        key: uuid,
        value: option<list<u8>>,
    }

    /// What an editor asks the host to do with a block: undo or redo it, show
    /// its version history (at a commit when named), act on its artifact,
    /// unlink, delete, move, reorder, place or restore it, act on the
    /// checkout or repository it shows (its own block only), share it, leave
    /// it, close its editor, set its parent or define its metadata.
    ///
    /// `move` takes the block out of one container's content and into
    /// another's, through their editors, and sets its parent unless it moves
    /// a link; `set-parent` only sets the parent in the graph, for a block the
    /// editor already holds in content of its own. An editor renames a block
    /// or shows the host's menu by placing a `child-content.rename` or
    /// `host(menu)` child in a view it anchored.
    variant block-command {
        undo,
        redo,
        history(option<commit-id>),
        artifact(artifact-command),
        unlink(unlink-command),
        delete(delete-command),
        move(move-command),
        reorder(reorder-command),
        place(place-command),
        restore,
        version(version-command),
        share,
        /// Shows the block's Export dialog, from the instance that draws the
        /// window (`shell-dialog.export`).
        %export(export-request),
        leave,
        close-editor,
        set-parent(block-location),
        define(define-command),
        /// Sends a member of the block's host channel `payload`, sealed on its
        /// channel (guides/blocks/hosted.md, "Hosting"). Only a host component
        /// of the block, while this device hosts it, and only to a member it
        /// heard join (`member-event.joined`).
        tell-member(member-said),
        /// Sends the block's host `payload`, sealed on this device's channel to
        /// it (guides/blocks/hosted.md, "Hosting"). Only an editor opened as a
        /// Join member (`opening-kind.join`), and only while the channel is
        /// open (`channel-event.open`): what is told while it is not is lost.
        tell-host(list<u8>),
        /// Keeps this device hosting the block after its last editor here
        /// closes (`true`), or no longer (guides/blocks/hosted.md, "Hosting"):
        /// the shell lists it among what this device hosts, with Stop. Kept in
        /// memory only, so quitting the host stops it.
        keep-hosting(bool),
    }

    /// Whether this device hosts an editor's block: runs its host component
    /// (guides/blocks/hosted.md, "Hosting"), and whether it keeps hosting it
    /// once its editors here close (`block-command.keep-hosting`).
    enum hosting-here {
        no,
        yes,
        kept,
    }

    /// The host channel of the block an editor opened as a Join member
    /// (`opening-kind.join`; guides/blocks/hosted.md, "Hosting"): what the host
    /// says on it, and whether it is open.
    variant channel-event {
        /// A host answered: the channel is open to the account that hosts.
        /// Told again, after `closed`, when another account's device takes the
        /// lease or the channel is made again.
        open(account-id),
        /// No host is online, or the channel broke and is being made again:
        /// what was told on it and not answered may be lost.
        closed,
        said(list<u8>),
    }

    /// A member of the host channel of the block a host component runs on came,
    /// spoke or went (guides/blocks/hosted.md, "Hosting"). The host admits a
    /// member once the signed logs give its account Join or above and it proves
    /// its key; one whose access ends, or that leaves, goes.
    variant member-event {
        joined(joined-member),
        said(member-said),
        left(u64),
    }

    /// A member admitted to the channel: the number the host calls it by while
    /// it stays, its account, and the level the signed logs give it, as the host
    /// checked them.
    record joined-member {
        member: u64,
        account: account-id,
        level: access-level,
    }

    /// What a member said, or what is said to it.
    record member-said {
        member: u64,
        payload: list<u8>,
    }

    enum conflict-side {
        base,
        ours,
        theirs,
        merged,
    }

    record adopt-command {
        block-id: block-id,
    }

    record finish-command {
        description: string,
    }

    record branch-command {
        branch: string,
    }

    record create-branch-command {
        name: string,
    }

    record resolve-command {
        block-id: block-id,
        take: conflict-side,
    }

    record undo-operation-command {
        operation: uuid,
    }

    /// What a version control editor asks of the checkout or repository it
    /// shows.
    variant version-command {
        adopt(adopt-command),
        finish(finish-command),
        update,
        switch(branch-command),
        create-branch(create-branch-command),
        merge(branch-command),
        new-checkout(branch-command),
        resolve(resolve-command),
        undo(undo-operation-command),
        fork,
        pull-upstream,
        push-upstream,
    }

    record version-operation {
        id: uuid,
        time: s64,
        author: account-id,
        description: string,
        undone: bool,
    }

    record version-branch {
        name: string,
        head: commit-id,
    }

    enum version-change-kind {
        added,
        removed,
        modified,
        moved,
    }

    record version-change {
        block-id: block-id,
        block-type: block-type-id,
        name: option<string>,
        kind: version-change-kind,
    }

    record version-commit {
        id: commit-id,
        change: uuid,
        parents: list<commit-id>,
        author: account-id,
        time: s64,
        message: string,
        conflicted: bool,
    }

    record version-status {
        busy: bool,
        error: option<string>,
        behind: bool,
        branches: list<version-branch>,
        changes: list<version-change>,
        working: option<version-commit>,
        log: list<version-commit>,
        operations: list<version-operation>,
    }

    record block-history {
        head: option<commit-id>,
        can-undo: bool,
        can-redo: bool,
        /// Undo stopped at the session restart that committed this: steps made
        /// before it no longer apply, and version history holds what they did.
        restarted-at: option<commit-id>,
        /// Edits made with another build of the block's type were lost when
        /// it opened, since this build cannot replay them.
        lost-edits: bool,
    }

    /// Where in a block a search found something (`search-hit`): the document
    /// within it, empty for a block that is one document, and the words of its
    /// first match (a phrase's words in a row), which is where the document's text
    /// first matches the query. The editor that shows the block selects the
    /// first place they occur, where it supports a location (`editor-event.reveal`).
    /// The words alone are enough: the first match is the first place in the
    /// text the query matches, so no earlier place holds the same words in text
    /// the editor shows as the index read it.
    record search-location {
        key: string,
        text: string,
    }

    /// A block to open or show, through which block and with which editor
    /// when the request names them, and where in it when it names that.
    record open-request {
        block-id: block-id,
        block-type: block-type-id,
        via: option<block-id>,
        editor: option<editor-id>,
        at: option<search-location>,
    }

    /// A block's version history, at a commit when named.
    record history-request {
        block-id: block-id,
        commit: option<commit-id>,
    }

    /// What the host asks a shell editor to show.
    variant show-request {
        block(open-request),
        panel(host-panel),
        history(history-request),
    }

    /// Asks the host to open a block for the user.
    open-block: async func(request: open-request);

    /// Asks the host to act on a block. The host refuses what the editor may
    /// not do.
    act: async func(block: block-id, command: block-command);

    /// Creates a block with the id the editor chose, so it can name the block
    /// before the host has seen it. With `owner-only`, only this account
    /// reads it, on any of its devices: a settings kind whose type says
    /// `KindVisibility::Owner`, whose key is never escrowed.
    create-block: async func(
        block: block-id,
        block-type: block-type-id,
        parent: block-location,
        defined: metadata-entries,
        content: option<list<u8>>,
        owner-only: bool,
    );

    /// Gives a block content. With `replace`, replaces the content of a block
    /// the editor may edit; without, seeds a block the editor holds, unless it
    /// already has content.
    write-content: async func(block: block-id, content-type: content-type-id, bytes: list<u8>, replace: bool);

    /// The editor's link to the replica of a block's content: its own block's,
    /// or one it watches. Opening it holds the block; dropping it lets go.
    resource replica {
        constructor(block: block-id, content-type: content-type-id);
        /// Every frame the replica sends the editor, in order, no further
        /// ahead than the editor's credit allows.
        frames: func() -> stream<list<u8>>;
        /// A frame for the replica, in order with the editor's others. The
        /// host answers once it has taken the frame in; an editor sends no
        /// more than a stream window (items and bytes) of frames ahead of
        /// those answers, and keeps the rest until they come.
        send: async func(frame: list<u8>);
    }

    /// An account that may view the editor's own block, or its author, and
    /// the name to show for it (`block-subject.members`). `verified` when the
    /// name is the one on the account's contact card, which this device
    /// verified, or the signed-in account's own; otherwise it is the name the
    /// account gave the server, which the server could have changed, and the
    /// editor marks it as unverified.
    record block-member {
        account: account-id,
        name: string,
        verified: bool,
    }

    /// What a `block-watch` follows: the blocks a query lists, a block's undo
    /// history, the content stored at its head, an artifact block's state, or,
    /// of the editor's own block, its version control status (for a block that
    /// has one) or its members.
    variant block-subject {
        blocks(block-query),
        history(block-id),
        head(block-id),
        artifact(block-id),
        version,
        members,
    }

    /// The latest value of a `block-subject`, the variant of the same name.
    /// `head` is none for a block without content; `artifact` none while the
    /// host knows no state for it. `members` is answered again as who may view
    /// the block or the contacts' names change; it fails while the host cannot
    /// ask the server (offline, or a host with none).
    variant block-value {
        blocks(result<list<block-info>, failure>),
        history(block-history),
        head(result<option<stored-head>, failure>),
        artifact(option<artifact-state>),
        version(version-status),
        members(result<list<block-member>, failure>),
    }

    /// Follows a subject. `next` answers with its latest value once it differs
    /// from what it last answered, so the first answer is the current one; so
    /// does `search-watch`.
    resource block-watch {
        constructor(subject: block-subject);
        next: async func() -> block-value;
    }

    /// A document full-text search found (guides/blocks/host.md, "Search").
    record search-hit {
        block-id: block-id,
        /// The document within the block; empty for a block that is one document.
        key: string,
        /// The stretch of its text around the first match, or its start when only the
        /// block's name matched.
        snippet: string,
        /// The matched words, as byte ranges of `snippet` in order: a phrase where its
        /// words occur in a row is one range, and a word of it alone is none.
        matches: list<tuple<u32, u32>>,
    }

    record search-results {
        /// The best first.
        hits: list<search-hit>,
        /// Every edit this device made is indexed.
        complete: bool,
    }

    /// Full-text search over names and content, of everything the account views in the
    /// open organization or of `within`'s tree: words, `"quoted phrases"`, the last word
    /// a prefix. `next` answers again whenever an index it read changes.
    resource search-watch {
        constructor(text: string, within: option<block-id>);
        next: async func() -> search-results;
    }

    /// What the host asks the editor to show. `next` answers with every
    /// request since the last answer, in order; a request already waiting
    /// moves to the end instead of waiting twice.
    resource show-requests {
        constructor();
        next: async func() -> list<show-request>;
    }
}
