package be3:app@0.1.0;

/// What the shell around an editor and the editor share: its menus, the
/// actions of its bar and the children it places.
interface shell-types {
    use be3:manifest/types@0.1.0.{interaction-mode, editor-capabilities, resize-mode, block-type-descriptor, template-category, edits};
    use types.{block-pick, child-id, editor-id, editor-instance-id, menu-check, menu-command, menu-heading, menu-item, menu-ask, menu-item-kind, menu-pin, picture, size, view-id, web-view-id};
    use be3:shared/ids@0.1.0.{block-id, block-type-id, image-id};
    use be3:ui/types@0.1.0.{clip-item, key-chord, pos2, rect, vec2};

    /// An action of the bar the host draws above a frame or a child.
    enum bar-action {
        details,
    }

    /// A representation an editor copies: its data, or none when it renders
    /// it on request.
    record offered-clip-item {
        format: string,
        data: option<list<u8>>,
    }

    /// How a drop places what is dragged. The host picks it from what is
    /// dragged and the modifiers held: a block moves by default, Ctrl (or
    /// Option) copies it and Ctrl+Shift adds a reference; files from
    /// outside are always copied in.
    enum drop-action {
        move,
        copy,
        reference,
    }

    /// Something dragged over the editor, where, and whether it was dropped
    /// there. What is dragged is a clip like a paste's, richest first:
    /// `be3/blocks` for blocks from the host, `be3/files` for files from
    /// outside it, whose data comes only with the drop.
    record drag-over {
        view: view-id,
        pos: pos2,
        items: list<clip-item>,
        action: drop-action,
        dropped: bool,
    }

    variant stopped {
        closed,
        failed(string),
    }

    variant fit-area {
        %world,
        centre,
        rect(rect),
    }

    record view-zoom {
        factor: f32,
        anchor: option<pos2>,
    }

    variant view-change {
        pan(vec2),
        zoom(view-zoom),
        keep-fitted(option<fit-area>),
        fit,
        pan-drag,
    }

    /// What an artifact's settings say it is made from, or why they cannot be read.
    variant artifact-description {
        described(string),
        unreadable(string),
    }

    /// How far a creation dialog shown as a child got: still asking, since
    /// its editor accepts it itself (`close-dialog`), or making its block.
    variant creation-progress {
        options,
        working,
        created(block-id),
        failed(string),
    }

    /// A picture of a child the host painted, offered to the app as a texture.
    record preview-image {
        image: image-id,
        width: u32,
        height: u32,
    }

    variant child-preview {
        hosted,
        waiting,
        label,
        image(preview-image),
    }

    /// How an editor shown as a dialog asks to be closed.
    enum dialog-answer {
        /// Without doing anything: Cancel, the close button, or a dismissal.
        dismissed,
        /// Doing what it shows: a creation dialog then makes its block, and
        /// closes once it is made.
        accepted,
    }

    /// What a child shown as a dialog says about closing.
    record dialog-status {
        /// Whether the child answers a dismissal itself. Until it says so, the
        /// host answers a `dismiss-child` for it at once, with `dismissed`.
        handles-dismiss: bool,
        /// How the child asked to be closed, once it has.
        answer: option<dialog-answer>,
    }

    /// What the host knows of a child an editor placed.
    record child-status {
        instance: editor-instance-id,
        view: view-id,
        child: child-id,
        available: bool,
        intrinsic: option<size>,
        aspect-ratio: option<f32>,
        active: bool,
        interaction: interaction-mode,
        capabilities: editor-capabilities,
        resize: resize-mode,
        error: option<string>,
        menu: list<menu-item>,
        creation: option<creation-progress>,
        preview: child-preview,
        dialog: dialog-status,
        /// What a picker child answered, once it has.
        picked: option<block-pick>,
        /// Whether a picker child shows a card its placer frames.
        card: bool,
        /// The child's own name for its tab, chip and header. For a program
        /// window, the host's name for it.
        title: option<string>,
        /// The child's icon. For a program window, the program's icon.
        icon: option<picture>,
        /// Which children are one app's: the placer cycles a group's
        /// children together. For a program window, its program id.
        group: option<string>,
        /// Counts up each time the child asks to be brought forward (a
        /// program activating its window, a press on it). The placer shows
        /// the child's tab.
        raised: u64,
        /// Counts up each time the child asks for attention (a program's
        /// bell). The placer flashes its tab and chip.
        rung: u64,
        /// Counts up each time the child asks to be hidden (a program
        /// minimizing its window). The placer hides the child's window.
        minimized: u64,
        /// Whether the child asks to be shown full screen. The placer shows
        /// its tab full screen while it is set.
        fullscreen: bool,
        /// What the host wants said about the child right now; the placer
        /// shows it with the tab's title.
        notice: option<string>,
        /// The child's last ask for its tab's menu. The placer opens the
        /// tab's menu there.
        menu-asked: option<menu-ask>,
    }

    record template-descriptor {
        editor: editor-id,
        template: string,
        block-type: block-type-id,
        name: string,
        icon-codepoint: string,
        category: template-category,
        dialog: bool,
    }

    record editor-descriptor {
        editor: editor-id,
        edits: edits,
        name: string,
        icon-codepoint: string,
        /// The file extensions, without the dot, a program editor opens: a
        /// block whose file name ends in one opens in it. Empty for an app.
        extensions: list<string>,
    }

    /// The block types, templates and editors the host has.
    record catalog {
        types: list<block-type-descriptor>,
        templates: list<template-descriptor>,
        editors: list<editor-descriptor>,
    }

    record audio-source {
        media-type: string,
        bytes: list<u8>,
    }

    variant audio-command {
        load(audio-source),
        toggle,
        reset,
    }

    record audio-status {
        playing: bool,
        position-micros: u64,
        duration-micros: option<u64>,
        error: option<string>,
    }

    variant web-view-event {
        navigate(string),
        finished(string),
        push(string),
        replace(string),
        title(string),
        history(s32),
        new-window(string),
        address(string),
        failed(string),
    }

    /// What an editor asks of the host around it for a block it draws: to share
    /// it, leave it, or close the editor. An editor renames a block or shows
    /// the host's menu by placing a `child-content.rename` or
    /// `host(menu)` child in a view it anchored.
    variant shell-command {
        share,
        leave,
        close-editor,
    }

    /// The block an editor's focus is in, and the blocks it is shown through.
    record focus {
        block-id: option<block-id>,
        block-type: block-type-id,
        /// The editor the block is shown with when one was asked for by id
        /// (`open-block-with`); none for its default editor.
        editor: option<editor-id>,
        via: list<block-id>,
    }
}

/// What an editor tells the shell around it.
interface shell {
    use types.{block-location, block-pick, child-id, editor-instance-id, size, view-id, web-view-id};
    use be3:shared/ids@0.1.0.{block-id, block-type-id};
    use be3:ui/types@0.1.0.{rect};
    use shell-types.{
        artifact-description, audio-command, audio-status, bar-action, catalog,
        child-status, dialog-answer, focus, menu-item, offered-clip-item, shell-command, stopped,
        view-change, web-view-event,
    };

    /// The status of the audio the editor plays, watched like preferences once
    /// it plays any.
    resource audio-status-watch {
        constructor(instance: editor-instance-id);
        next: async func() -> audio-status;
    }

    /// A web view the editor shows at a child it places; dropping it closes it.
    resource web-view {
        constructor(instance: editor-instance-id, id: web-view-id, url: string);
        load: async func(url: string);
        reload: async func();
        focus-host: async func();
        /// The events since the last answer, in order. A title, address or
        /// failure right after one of its own kind replaces it, and at most
        /// 256 events wait: past that the oldest goes.
        next-events: async func() -> list<web-view-event>;
    }

    /// The statuses of the children an editor placed. `next` answers with every
    /// status that changed since the last answer, the latest of each child.
    resource child-statuses-watch {
        constructor(instance: editor-instance-id);
        next: async func() -> list<child-status>;
    }

    /// The host's catalog of block types, templates and editors, watched like
    /// preferences.
    resource block-types-watch {
        constructor();
        next: async func() -> catalog;
    }

    /// The menu of one of the editor's views, replacing the one it sent for
    /// that view before. The menu of the view that holds the editor's
    /// content is its frame's (a placer reads it as `child-status.menu`);
    /// a dock view's is its tab's, which the host gives the root as that
    /// tab's `dock-tab.menu`. A pick from any of them arrives as the
    /// editor's `menu-pick` of that view.
    menu: async func(instance: editor-instance-id, view: view-id, items: list<menu-item>);

    /// The editor asks the host to run an action of its bar.
    run-bar-action: async func(instance: editor-instance-id, action: bar-action);

    /// The editor picked a command of a child's menu. `anchor`, in host
    /// coordinates, is what the menu belongs to (the child's tab, or the
    /// child), which the host passes on as the child's `menu-pick` anchor.
    child-menu-pick: async func(instance: editor-instance-id, child: child-id, id: string, anchor: option<rect>);

    /// The editor copied: representations of the same content, richest
    /// first. One without data the editor renders only when a paste asks for
    /// it (`editor.render-clip` with this `serial`); those end with the
    /// instance, while the host keeps the rest as long as the clip.
    copy: async func(instance: editor-instance-id, serial: u64, items: list<offered-clip-item>);

    /// The editor asks for the clipboard; it arrives as input.
    paste: async func(instance: editor-instance-id);

    /// The editor starts dragging a block out of itself.
    drag-block: async func(instance: editor-instance-id, block-id: block-id, block-type: block-type-id);

    /// Whether the editor takes the block dragged over it.
    drag-accepted: async func(instance: editor-instance-id, accepted: bool);

    /// The width over height the editor keeps, when it keeps one.
    aspect-ratio: async func(instance: editor-instance-id, ratio: option<f32>);

    /// The size the editor's content wants, when it has one: a hint to a
    /// placer that chooses the child's size, such as a canvas card. A child
    /// placed sized to its content (`child-placement.fit`) reports the size it
    /// took as its view's `view-size` instead, and the host ignores this.
    intrinsic-size: async func(instance: editor-instance-id, size: option<size>);

    /// Asks the host around the editor to act for a block the editor draws.
    act: async func(instance: editor-instance-id, block: block-id, command: shell-command);

    /// The editor asks to leave the frame it is shown in.
    leave-frame: async func(instance: editor-instance-id);

    /// The editor stopped drawing a view, closed or failed.
    view-stopped: async func(instance: editor-instance-id, view: view-id, stopped: stopped);

    /// The editor asks to be presented full screen, or no longer.
    present: async func(instance: editor-instance-id, presenting: bool);

    /// The editor asks the host to move its view.
    change-view: async func(instance: editor-instance-id, change: view-change);

    /// Loads, plays or pauses, or stops the editor's audio.
    play-audio: async func(instance: editor-instance-id, command: audio-command);

    /// Where the editor's focus is now.
    focused: async func(instance: editor-instance-id, focus: focus);

    /// Whether the editor, shown as a dialog, answers a dismissal itself
    /// (the app's `dismiss`) by asking to close with `close-dialog`.
    handles-dismiss: async func(instance: editor-instance-id, handles: bool);

    /// The editor, shown as a dialog, asks to be closed.
    close-dialog: async func(instance: editor-instance-id, answer: dialog-answer);

    /// The user asked to dismiss a child the editor shows as a dialog: pressed
    /// Escape or back, or outside it. The host passes it to the child, whose
    /// answer arrives as its `dialog-status`, and answers at once for a child
    /// that does not handle dismissal.
    dismiss-child: async func(instance: editor-instance-id, child: child-id);

    /// Gives a child the editor placed the keyboard, as the person opening
    /// it or bringing it forward would: the view that shows the child takes
    /// the keyboard once the child shows. It only moves the keyboard within
    /// the editor: while the keyboard is outside the editor's views and the
    /// children they show, or a view that takes the keyboard (a dialog, a
    /// popover) is open, it does nothing.
    focus-child: async func(instance: editor-instance-id, child: child-id);

    /// The person asked to close a child the editor placed, as closing its
    /// tab. For a program window the host asks its program to close it (or
    /// force-closes one that does not respond); the window leaves the list
    /// when it closes. For any other child it does nothing yet.
    close-child: async func(instance: editor-instance-id, child: child-id);

    /// The user created the block of a creation dialog the editor placed as a child.
    commit-child: async func(
        instance: editor-instance-id,
        child: child-id,
        parent: block-location,
        name: option<string>,
    );

    /// The editor, opened as a picker, answers its pick: the block chosen, or
    /// none when the user cancelled.
    picked: async func(instance: editor-instance-id, pick: block-pick);

    /// The editor, opened as a picker, says whether it shows a card, which the
    /// editor that placed it frames, rather than a menu that draws its own
    /// surface. It arrives as the child's `child-status.card`.
    show-card: async func(instance: editor-instance-id, card: bool);

    /// What the artifact settings the editor was opened on say.
    artifact-described: async func(instance: editor-instance-id, description: artifact-description);

    /// The user changed the artifact settings the editor shows.
    artifact-edited: async func(instance: editor-instance-id, data: list<u8>);
}
