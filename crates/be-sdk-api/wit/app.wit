package be3:app@0.1.0;

/// What an app offers its host.
interface app {
    use types.{child-id, opening, present-commit, screen-id, screen-request, size, view-id};
    use be3:shared/ids@0.1.0.{block-id};
    use accessibility.{action-request};
    use shell-types.{drag-over, focus};
    use be3:ui/types@0.1.0.{clip-body, rect};
    use host-services.{shell-dialog};
    use types.{failure};

    /// The user picked command `id` of the menu of the editor's view `view`
    /// (`shell-message.menu`), wherever the menu was shown. `anchor`, in host
    /// coordinates, is what the menu belongs to: the tab that shows the view,
    /// or the rect a parent placed the editor at when it has no tab; `none`
    /// when nothing of it is visible. A dialog the command opens points at it.
    record menu-choice {
        view: view-id,
        id: string,
        anchor: option<rect>,
    }

    /// The part of the editor's world its frame shows, and at what scale.
    record view-frame {
        view: rect,
        scale: f32,
    }

    /// A dialog the instance that draws the window draws.
    record dialog-request {
        block: block-id,
        dialog: shell-dialog,
    }

    /// Something that happened around an editor.
    variant editor-event {
        menu-pick(menu-choice),
        /// The user asked for the details of a child the editor placed, from
        /// the child's bar.
        child-details(child-id),
        /// The user focused a child the editor placed.
        child-focused(child-id),
        /// Whether the user may edit what the editor shows.
        set-editable(bool),
        view-changed(view-frame),
        /// Whether the editor is presented full screen.
        presenting-changed(bool),
        /// Whether the editor shows its user's presence to others.
        presence(bool),
        /// Where the focus of the host is.
        focus-changed(focus),
        /// The user resized the editor.
        resized(size),
        /// A block or files are dragged over the editor, or dropped on it; none
        /// when what was dragged over it left without being dropped.
        drag(option<drag-over>),
        /// The artifact settings the editor shows, saved.
        artifact-settings(list<u8>),
        /// The user asked to dismiss the dialog the editor is shown as: pressed
        /// Escape or back, or outside it. Sent only once the editor said it
        /// handles dismissal; it answers with `close-dialog`.
        dismiss,
        /// Shows one of the dialogs the instance that draws the window draws.
        show-dialog(dialog-request),
    }

    /// An editor instance. Dropping it closes it.
    resource editor {
        constructor(opening: opening);

        /// What happened around the editor, in the order it happened. Nothing
        /// answers: the editor takes each in turn.
        hear: async func(events: list<editor-event>);

        /// Creates the block of the creation dialog the editor shows.
        commit-creation: async func() -> result<block-id, failure>;

        /// Generates the artifact the settings describe again.
        regenerate-artifact: async func(data: list<u8>) -> result<_, failure>;

        /// Puts a block in place of a child block; false when the editor cannot.
        replace-child: async func(old: block-id, new: block-id) -> bool;

        /// Renders representation `format` of the editor's copy `serial`
        /// (`shell-message.copy`), which a paste asked for; none once the editor
        /// copied something else or cannot.
        render-clip: async func(serial: u64, format: string) -> option<clip-body>;
    }

    /// Whether the host wants screens described to assistive technology.
    describe: async func(on: bool);

    /// Runs an action a screen described.
    run-action: async func(screen: screen-id, id: string);

    /// Runs an action assistive technology asks of a node a screen described.
    node-action: async func(screen: screen-id, request: action-request);

    /// The screens the host shows, replacing the ones it showed before.
    screens: async func(screens: list<screen-request>);

    /// Numbers the screens and views sent since the last configure; the frame
    /// that shows them carries the serial back.
    configure: async func(serial: u64);

    /// Draws a frame of every screen: the app lays it out, sends the host
    /// its `laid-out` commit, paints it, and answers with what it presented.
    /// `wall-micros` is the host's wall clock at `now-micros`, in
    /// microseconds since the Unix epoch: the app's wall clock, so a host
    /// that pins its own (a test) pins every app's too.
    draw: async func(now-micros: u64, wall-micros: u64, seen: bool) -> present-commit;

    /// Stops the app; it answers once it saved what it holds.
    shutdown: async func();
}

/// Everything an app and its host say to each other: the gpu it
/// draws with (answered inside the app's own worker or thread), what it asks
/// of the host, and what it offers. The `be3:desktop` interfaces are an
/// extension an app uses only when its manifest names it.
world editor-app {
    import be3:gpu/device@0.1.0;
    import host;
    import blocks;
    import shell;
    import host-services;
    import network;
    import account;
    import contacts;
    import dock;
    import be3:desktop/windows@0.1.0;
    import be3:desktop/input@0.1.0;
    import be3:desktop/displays@0.1.0;
    import be3:desktop/power@0.1.0;
    import be3:desktop/media@0.1.0;
    import be3:desktop/wifi@0.1.0;
    import be3:desktop/epaper@0.1.0;
    import be3:desktop/notifications@0.1.0;
    import be3:desktop/screen-lock@0.1.0;
    import be3:desktop/programs@0.1.0;
    import be3:desktop/tray@0.1.0;
    import be3:debug/debug@0.1.0;
    export app;
    export be3:debug/paintings@0.1.0;
}
