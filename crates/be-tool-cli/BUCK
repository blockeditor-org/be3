load("@root//buck/cargo:defs.bzl", "app_packages", "cargo_binary", "cargo_library", "cargo_package", "cargo_test")
load("@root//buck/program:defs.bzl", "program", "type_bundle")

cargo_package()

cargo_library()

# The tests' host apps, staged as be-host stages its apps: `be` downloads a host app
# from its release when it runs one (`host_apps`), and the tests point it at this
# directory instead (BE_BUNDLE), so they use no network.
TEST_HOST_APPS = ["//crates/be-app-example-counter"]

program(
    name = "test-host-apps",
    app_types = ["{}:types".format(app) for app in TEST_HOST_APPS],
    index = True,
    manifests = ["{}:manifest".format(app) for app in TEST_HOST_APPS],
    modules = ["{}:module".format(app) for app in TEST_HOST_APPS],
)

# The tests name block types from the editors' manifests, as be does from the
# bundle it carries.
cargo_test(
    env = {
        "BE_BUNDLE": "$(location :test-host-apps)",
        # be-host-runtime links ALSA for apps' audio, from the sysroot it was linked against.
        "LD_LIBRARY_PATH": "$(location //buck/sysroot:amd64)/usr/lib/x86_64-linux-gnu:$(location //buck/sysroot:amd64-test)/usr/lib/x86_64-linux-gnu",
        "EDITOR_MANIFESTS": "$(location //crates/be-sdk-manifest:editor-manifests)",
    },
)

# be carries every app's manifest and type module in its executable, so a
# release is one file (guides/type_modules.md, "Hosts").
type_bundle(
    name = "app-types",
    app_types = ["//{}:types".format(package) for package in app_packages()],
    manifests = ["//{}:manifest".format(package) for package in app_packages()],
)

cargo_binary(
    env = {
        "APP_TYPES": "$(location :app-types)",
        "APP_HASHES": "$(location //crates/be-host:app-hashes)",
    },
)

# be with its build-info.json file beside it, which it greets the server with:
# `./scripts/buck run //crates/be-tool-cli:native -- ARGS`.
program(
    name = "native",
    binary = ":bin",
    executable_name = "be",
    files = ["//buck/program:build-info.json"],
    manifests = [],
    modules = [],
    visibility = ["//crates/be-tool-local:"],
)
