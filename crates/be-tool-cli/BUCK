load("@root//buck/cargo:defs.bzl", "app_packages", "cargo_binary", "cargo_library", "cargo_test")
load("@root//buck/program:defs.bzl", "program", "type_bundle")

cargo_library()

# The tests name block types from the editors' manifests, as be does from the
# bundle it carries.
cargo_test(
    env = {"EDITOR_MANIFESTS": "$(location //crates/be-sdk-manifest:editor-manifests)"},
)

# be carries every app's manifest and type module in its executable, so a
# release is one file (guides/type_modules.md, "Hosts").
type_bundle(
    name = "app-types",
    app_types = ["//{}:types".format(package) for package in app_packages()],
    manifests = ["//{}:manifest".format(package) for package in app_packages()],
)

cargo_binary(
    env = {
        "APP_TYPES": "$(location :app-types)",
    },
)

# be with its build-info.json file beside it, which it greets the server with:
# `./scripts/buck run //crates/be-tool-cli:native -- ARGS`.
program(
    name = "native",
    binary = ":bin",
    executable_name = "be",
    files = ["//buck/program:build-info.json"],
    manifests = [],
    modules = [],
    visibility = ["//crates/be-tool-local:"],
)
