load("@root//buck/cargo:defs.bzl", "cargo_library")
load("@root//buck/wasm:defs.bzl", "plugin_tests")

srcs = glob(["src/**/*.rs"])

cargo_library(srcs = srcs)

# Paintings of every page of beui's demo (crates/beui/examples/demo.rs), taken
# the way a plugin's are: compiled to wasm with the fonts beui carries, and run
# here so they can read and write snapshots/.
plugin_tests(
    env = {"BEUI_DEMO": "$(location //crates/beui:demo.rs)"},
    srcs = srcs,
)
