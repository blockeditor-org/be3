# The web bundle, with /api passed through to be-server. BE3_SITE is the site
# address: a domain for a deployment, which Caddy gets a certificate for, or
# http://:8080 on this machine. Caddy listens on every interface unless told
# otherwise, whatever host the site address names, so default_bind names the
# interface, BE3_BIND, and falls back to loopback (guides/hosting.md,
# "Listening"); serve.sh beside this sets both from --domain or --addr.
# BE3_WEB_ROOT is the web bundle, and BE3_BACKEND_URL where be-server listens.
{
	default_bind {$BE3_BIND:127.0.0.1}
}

{$BE3_SITE} {
	@backend path /api* /auth /auth/*
	handle @backend {
		reverse_proxy {$BE3_BACKEND_URL}
	}
	handle {
		# The module's memory is shared, which a browser only hands out to a
		# cross-origin isolated page. Without these two headers the host cannot
		# start at all, and index.html says so rather than failing obscurely.
		header {
			Cross-Origin-Opener-Policy same-origin
			Cross-Origin-Embedder-Policy require-corp
		}
		file_server {
			root {$BE3_WEB_ROOT}
		}
	}
}
