    name = "Inter-Regular.ttf",
    src = "src/assets/fonts/Inter-Regular.ttf",
    visibility = ["PUBLIC"],
)

export_file(
    name = "Hack-Regular.ttf",
    src = "src/assets/fonts/Hack-Regular.ttf",
    visibility = ["PUBLIC"],
)

