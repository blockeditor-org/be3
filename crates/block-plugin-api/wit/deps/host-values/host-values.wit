package be3:host-values@0.1.0;

/// An extension beside the core plugin protocol, not part of it: values a
/// particular host publishes and actions it carries out, each under a string
/// key with bytes block-plugin-api's `HostValue` and `HostAction` for that key
/// encode. The Linux desktop session's windows, devices, power, sound,
/// notifications, programs and tray (block-plugin-api's linux.rs) travel this
/// way, as do a few values only the shell's own editors read (the link base,
/// whether the account administers, its contacts, where preferences come
/// from). A host that offers none of them answers no watch and ignores every
/// action; which keys a host offers and to which editor is its own policy.
/// Every call is made under the editor resource it is for.
interface host-values {
    /// The value published under `key`. `next` answers with the latest once it
    /// changed.
    resource watch {
        constructor(key: string);
        next: async func() -> list<u8>;
    }

    /// Asks the host to act under `key`.
    act: func(key: string, action: list<u8>);
}
