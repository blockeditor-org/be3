package be3:plugin@0.1.0;

/// The blocks an editor reads and changes through its host: the block graph,
/// a block's content, history and version control, and asks to open blocks.
interface blocks {
    use types.{host-panel, uuid};
    use be3:ui/types@0.1.0.{rect};

    /// A commit of a block's history: the hash of its content, as its 32 bytes.
    type commit-id = tuple<u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8>;

    enum access-level {
        none,
        know-exists,
        view,
        edit,
    }

    /// Where a block is listed: at the root, detached from every parent, or
    /// inside a block.
    variant block-location {
        root,
        detached,
        block(uuid),
    }

    variant block-query {
        roots,
        detached,
        shared,
        children(uuid),
        references(uuid),
        backrefs(uuid),
        parents(uuid),
        block(uuid),
    }

    /// Metadata keyed by the uuid of its kind, each value its encoded bytes.
    type metadata-entries = list<tuple<uuid, list<u8>>>;

    record block-metadata {
        defined: metadata-entries,
        derived: metadata-entries,
    }

    record block-info {
        block-id: uuid,
        block-type: uuid,
        author: option<uuid>,
        parent: option<block-location>,
        references: list<uuid>,
        access: access-level,
        metadata: block-metadata,
        locked: bool,
        deleted: bool,
    }

    enum artifact-action {
        regenerate,
        unlink,
    }

    record artifact-state {
        block-id: uuid,
        source-type: uuid,
        source: option<uuid>,
        summary: string,
        error: option<string>,
        regenerating: bool,
    }

    record stored-head {
        commit: commit-id,
        content-type: uuid,
        bytes: list<u8>,
    }

    record rename-command {
        anchor: option<rect>,
    }

    record artifact-command {
        action: artifact-action,
    }

    record simulate-access-command {
        access: access-level,
    }

    record unlink-command {
        container: uuid,
    }

    record delete-command {
        block-type: uuid,
        source: block-location,
    }

    record move-command {
        block-type: uuid,
        source: block-location,
        destination: uuid,
        is-reference: bool,
    }

    record place-command {
        block-type: uuid,
        parent: uuid,
        linked: bool,
    }

    record app-menu-command {
        anchor: option<rect>,
    }

    /// What an editor asks the host to do with a block it draws.
    variant block-command {
        share,
        leave,
        rename(rename-command),
        undo,
        redo,
        artifact(artifact-command),
        simulate-access(simulate-access-command),
        close-editor,
        unlink(unlink-command),
        delete(delete-command),
        move(move-command),
        place(place-command),
        restore,
        app-menu(app-menu-command),
    }

    enum conflict-side {
        base,
        ours,
        theirs,
        merged,
    }

    record adopt-command {
        block-id: uuid,
    }

    record finish-command {
        description: string,
    }

    record branch-command {
        branch: string,
    }

    record create-branch-command {
        name: string,
    }

    record resolve-command {
        block-id: uuid,
        take: conflict-side,
    }

    record undo-operation-command {
        operation: uuid,
    }

    /// What a version control editor asks of the checkout or repository it
    /// shows.
    variant version-command {
        adopt(adopt-command),
        finish(finish-command),
        update,
        switch(branch-command),
        create-branch(create-branch-command),
        merge(branch-command),
        new-checkout(branch-command),
        resolve(resolve-command),
        undo(undo-operation-command),
        fork,
        pull-upstream,
        push-upstream,
    }

    record version-operation {
        id: uuid,
        time: s64,
        author: uuid,
        description: string,
        undone: bool,
    }

    record version-branch {
        name: string,
        head: commit-id,
    }

    enum version-change-kind {
        added,
        removed,
        modified,
        moved,
    }

    record version-change {
        block-id: uuid,
        block-type: uuid,
        name: option<string>,
        kind: version-change-kind,
    }

    record version-commit {
        id: commit-id,
        change: uuid,
        parents: list<commit-id>,
        author: uuid,
        time: s64,
        message: string,
        conflicted: bool,
    }

    record version-status {
        busy: bool,
        error: option<string>,
        behind: bool,
        branches: list<version-branch>,
        changes: list<version-change>,
        working: option<version-commit>,
        log: list<version-commit>,
        operations: list<version-operation>,
    }

    record block-history {
        head: option<commit-id>,
        can-undo: bool,
        can-redo: bool,
    }

    /// A block to open or show, and through which block and with which
    /// editor when the request names them.
    record open-request {
        block-id: uuid,
        block-type: uuid,
        via: option<uuid>,
        editor: option<uuid>,
    }

    /// What the host asks a shell editor to show.
    variant show-request {
        block(open-request),
        panel(host-panel),
    }

    /// Asks the host to open a block for the user.
    open-block: func(request: open-request);

    /// Asks the host to act on a block the editor draws.
    act: func(block: uuid, command: block-command);

    /// Asks the host to act on the checkout or repository the editor shows.
    version: func(block: uuid, command: version-command);

    /// Creates a block with the id the editor chose, so it can name the block
    /// before the host has seen it.
    create-block: func(
        block: uuid,
        block-type: uuid,
        parent: block-location,
        defined: metadata-entries,
        content: option<list<u8>>,
    );

    set-parent: func(block: uuid, parent: block-location);

    /// Sets or, with no value, clears one metadata entry the block defines.
    define: func(block: uuid, key: uuid, value: option<list<u8>>);

    /// Gives a block the editor holds content, unless it already has some.
    seed-content: func(block: uuid, content-type: uuid, bytes: list<u8>);

    /// Replaces the content of a block the editor may edit.
    replace-content: func(block: uuid, content-type: uuid, bytes: list<u8>);

    /// The editor's link to the replica of a block's content: its own block's,
    /// or one it watches. Opening it holds the block; dropping it lets go.
    resource replica {
        constructor(block: uuid, content-type: uuid);
        /// Every frame the replica sends the editor, in order.
        frames: func() -> stream<list<u8>>;
        /// A frame for the replica, in order with the editor's others.
        send: func(frame: list<u8>);
    }

    /// The blocks a query lists. `next` answers with the latest listing once
    /// it differs from what it last answered, so the first answer is the
    /// current one; so do the other watches here.
    resource blocks-watch {
        constructor(query: block-query);
        next: async func() -> result<list<block-info>, string>;
    }

    resource history-watch {
        constructor(block: uuid);
        next: async func() -> block-history;
    }

    /// The content stored at a block's head, or none for a block without one.
    resource head-watch {
        constructor(block: uuid);
        next: async func() -> result<option<stored-head>, string>;
    }

    /// The state of an artifact block, or none while the host knows none.
    resource artifact-watch {
        constructor(block: uuid);
        next: async func() -> option<artifact-state>;
    }

    /// The version control status of the editor's own block, for a block that
    /// has one.
    resource version-watch {
        constructor();
        next: async func() -> version-status;
    }

    /// What the host asks the editor to show. `next` answers with every
    /// request since the last answer, in order.
    resource show-requests {
        constructor();
        next: async func() -> list<show-request>;
    }
}
