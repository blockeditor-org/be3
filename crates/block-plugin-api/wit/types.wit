package be3:plugin@0.1.0;

/// What the host and an editor plugin share.
interface types {
    use accessibility.{description};
    use be3:ui/types@0.1.0.{
        modifiers, pos2, rect, input, preferences, window-requests, window-role,
    };

    use be3:shared/ids@0.1.0.{
        account-id, block-id, block-type-id, organization-id, surface-id, uuid,
    };

    /// An editor a plugin's manifest declares.
    type editor-id = uuid;

    /// An installation of the app, as the id it keeps across restarts.
    type installation-id = uuid;

    /// Why one side did not do what the other asked of it: the host, a call an
    /// editor made, or an editor, a call of the host's.
    variant failure {
        /// The asker may not see or change what it asked about.
        denied,
        /// The other side does not offer this, or not now: it has no such
        /// service, nothing open to do it with, or it closed first.
        unavailable,
        /// It tried and could not; the message says why, for the user.
        failed(string),
    }

    /// An open editor instance, numbered by the host.
    type editor-instance-id = u64;

    /// A screen the host asked a plugin to draw, numbered by the host.
    type screen-id = u64;

    record size {
        width: f32,
        height: f32,
    }

    record plugin-identity {
        id: string,
        name: string,
        version: string,
    }

    enum surface-support {
        none,
        texture,
    }

    enum surface-format {
        rgba8-unorm,
        rgba8-unorm-srgb,
        bgra8-unorm,
        bgra8-unorm-srgb,
    }

    record surface-spec {
        format: surface-format,
        render: bool,
    }

    record hello {
        plugin: plugin-identity,
        surface: surface-support,
    }

    record hello-accepted {
        host-name: string,
        surface: option<surface-spec>,
        preferences: preferences,
    }

    enum font-role {
        text,
        monospace,
        fallback,
        icons,
    }

    record font-face {
        role: font-role,
        index: u32,
        data: list<u8>,
    }

    /// Faces to add, or with `replace` the whole set.
    record fonts {
        replace: bool,
        faces: list<font-face>,
    }

    /// Where an instance is shown. `display(n)` is a further display of a host
    /// that shows the frame on its first display and one region on each of
    /// the others, numbered from 1 in the order the host lists its displays.
    /// `window(w)` is a window the plugin asked for with
    /// `window-request.open` and the host shows as one of its own.
    variant editor-region {
        frame,
        preview,
        artifact-settings,
        display(u32),
        window(u64),
    }

    enum frame-chrome {
        none,
        drawn,
    }

    enum top-bar {
        hidden,
        shown,
        phone,
    }

    record frame-spec {
        chrome: frame-chrome,
        content: option<rect>,
        top-bar: top-bar,
    }

    record viewport-metrics {
        logical: size,
        visible: pos2,
        pixel-width: u32,
        pixel-height: u32,
        /// Pixels per logical point the screen is laid out at.
        scale-factor: f32,
        /// Pixels per logical point the screen is drawn at, which the pixel
        /// size counts. It differs from the scale factor where the host shows
        /// the screen at another size than it lays it out at, as a panel in VR
        /// does; a change of raster alone needs no new layout, only a painting.
        raster: f32,
    }

    /// `windows` says the host shows the windows the plugin opens from this
    /// screen as windows of its own (`window-request`); otherwise the plugin
    /// draws them inside the screen. `placement` is, for a `window` region,
    /// where the host last put it, a value only the host reads, which the
    /// plugin keeps and hands back to open the window there again.
    record screen-request {
        screen: screen-id,
        instance: editor-instance-id,
        region: editor-region,
        metrics: viewport-metrics,
        frame: option<frame-spec>,
        windows: bool,
        placement: option<string>,
    }

    record screen-placement {
        screen: screen-id,
        instance: editor-instance-id,
        region: editor-region,
        surface: surface-id,
        width: u32,
        height: u32,
        scale-factor-millis: u32,
        raster-millis: u32,
    }

    record screen-layout {
        screens: list<screen-placement>,
    }

    /// `over` names another screen of the plugin the pointer is over while a
    /// press made in this screen holds it; the event's position is then in that
    /// screen's coordinates. While a press holds it and the pointer is over none
    /// of the plugin's screens, the host sends `pointer-left` and goes on with
    /// positions in this screen's coordinates.
    record timed-input {
        input: input,
        time-micros: option<u64>,
        over: option<screen-id>,
    }

    /// Input for one screen. Batches waiting for the plugin merge: pointer moves
    /// and pixel scrolls fold into the last of a run unless `every-sample`, and
    /// everything else stays, in order.
    record input-batch {
        screen: screen-id,
        events: list<timed-input>,
        every-sample: bool,
    }

    record region-size {
        screen: screen-id,
        logical: size,
    }

    record press-claim {
        modifiers: modifiers,
        rect: rect,
    }


    /// A panel of the host's own that an editor can show or place.
    enum host-panel {
        block-stack,
        performance,
        plugins,
    }

    /// A child an editor placed, numbered by the editor.
    type child-id = u64;

    /// A web view an editor shows, numbered by the editor.
    type web-view-id = u32;

    /// A window of another program the host shows, numbered by the host.
    type host-window-id = u64;

    enum child-layer {
        below,
        above,
    }

    enum child-mode {
        passive,
        preview,
        active,
        live,
        in-place,
    }

    record block-child {
        block-id: block-id,
        block-type: block-type-id,
        view-block: option<block-id>,
        editor: option<editor-id>,
    }

    record creation-child {
        editor: editor-id,
        template: string,
    }

    record artifact-settings-child {
        block-id: block-id,
    }

    /// What a child an editor placed shows.
    variant child-content {
        block(block-child),
        web-view(web-view-id),
        host(host-panel),
        window(host-window-id),
        creation(creation-child),
        artifact-settings(artifact-settings-child),
    }

    record child-placement {
        child: child-id,
        content: child-content,
        rect: rect,
        clip: rect,
        own-frame: bool,
        top-bar: top-bar,
        corner-radius: f32,
        layer: child-layer,
        mode: child-mode,
        intrinsic: option<size>,
        rotation: f32,
        opacity: f32,
        follows-view: bool,
    }

    /// A rectangle that hides the children placed before it.
    record occluder {
        after: u32,
        rect: rect,
    }

    /// The children an instance placed in a region.
    record child-placements {
        instance: editor-instance-id,
        region: editor-region,
        children: list<child-placement>,
        occluders: list<occluder>,
    }

    record frame-report {
        screen: screen-id,
        content: rect,
        painted: list<rect>,
        floating: list<rect>,
        drawing: list<rect>,
        every-sample: bool,
        claims: list<press-claim>,
        description: option<description>,
    }

    record screen-window {
        screen: screen-id,
        window: window-requests,
    }

    record surface-rect {
        x: u32,
        y: u32,
        width: u32,
        height: u32,
    }

    record screen-damage {
        screen: screen-id,
        rect: surface-rect,
    }

    record presented-frame {
        sequence: u64,
        damage: list<screen-damage>,
    }

    /// A region of the plugin: an instance and where it is shown.
    record region-ref {
        instance: editor-instance-id,
        region: editor-region,
    }

    record window-over {
        region: region-ref,
        at: pos2,
    }

    /// Where a window opens: at the pointer, with its corner at `at` in a
    /// region's points, or where a `placement` the host gave says.
    variant window-placement {
        at-pointer,
        over(window-over),
        host(string),
    }

    /// `role` says what the window is for, as beui's own windows do: a host
    /// that shows windows in space never focuses a keyboard or a popup.
    record window-open {
        window: u64,
        opener: region-ref,
        placement: window-placement,
        size: size,
        role: window-role,
    }

    enum window-edge {
        top,
        bottom,
        left,
        right,
        top-left,
        top-right,
        bottom-left,
        bottom-right,
    }

    record window-resize-begin {
        window: u64,
        edge: window-edge,
    }

    record window-resize {
        window: u64,
        size: size,
    }

    /// What the plugin asks of the host about a window it shows: to open it
    /// (as a `window` region of the instance it opened from), move or resize it
    /// with the pointer as a window manager does, give it another size, or
    /// close it. The host answers through the window's screen: its size and
    /// scale, its `placement`, focus as input, and closing as the screen going.
    variant window-request {
        open(window-open),
        begin-move(u64),
        begin-resize(window-resize-begin),
        resize(window-resize),
        close(u64),
    }

    /// What a plugin drew: the frame the host composites, with what each
    /// screen asks of its window and the children it placed.
    record frame-commit {
        serial: u64,
        sizes: list<region-size>,
        reports: list<frame-report>,
        windows: list<screen-window>,
        children: list<child-placements>,
        repaint-after-micros: option<u64>,
        animating: bool,
        presented: option<presented-frame>,
        window-requests: list<window-request>,
    }

    record open-block {
        instance: editor-instance-id,
        editor: editor-id,
        block-id: block-id,
        block-type: block-type-id,
        view-block: option<block-id>,
        account-id: account-id,
        organization-id: organization-id,
        client-id: installation-id,
        editable: bool,
    }

    record open-creation {
        instance: editor-instance-id,
        editor: editor-id,
        template: string,
        account-id: account-id,
        organization-id: organization-id,
        client-id: installation-id,
    }

    record open-artifact {
        instance: editor-instance-id,
        editor: editor-id,
        block-id: block-id,
        block-type: block-type-id,
        /// The block the artifact is made from.
        source: block-id,
        account-id: account-id,
        organization-id: organization-id,
        client-id: installation-id,
        data: list<u8>,
    }

    /// How an editor instance opens: on a block, as a creation dialog, or on
    /// an artifact's settings.
    variant opening {
        block(open-block),
        creation(open-creation),
        artifact(open-artifact),
    }
}
