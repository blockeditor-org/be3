load("@root//buck/cargo:defs.bzl", "cargo_library", "cargo_package", "cargo_test")

cargo_package()

cargo_library()

# The tests link ALSA, which the worker's image does not have, so they load it
# from the sysroot it was linked against. The tests that draw go
# through lavapipe, as the renderer's do.
test_environment = {
    "LD_LIBRARY_PATH": "$(location //buck/sysroot:amd64)/usr/lib/x86_64-linux-gnu:$(location //buck/sysroot:amd64-test)/usr/lib/x86_64-linux-gnu",
    "VK_ICD_FILENAMES": "$(location //buck/sysroot:lavapipe_icd.json)",
}

# Each test file runs as a process of its own (run_apart): the host stack is one
# per process (`be_host_stack::stack()`), and a test that drives editors, with
# or without be_host_testing's Harness, wants listings on it as the same
# editor instance as another test's, so in one process they changed each
# other's wants.
cargo_test(
    env = test_environment,
    run_apart = True,
    run_env = {
        # The triangle linked against its library and standalone, which a test loads
        # and paints side by side.
        "BASE_LIBRARY_WASM": "$(location //crates/be-sdk-library-base:module)",
        "TRIANGLE_STANDALONE_WASM": "$(location //crates/be-app-example-triangle:standalone)",
        "TRIANGLE_WASM": "$(location //crates/be-app-example-triangle:module)",
    },
)
