load("@root//buck/cargo:defs.bzl", "cargo_library", "cargo_package", "cargo_test")
load("@root//buck/program:defs.bzl", "precompiled_module")

cargo_package()

cargo_library()

# The tests link ALSA, which the worker's image does not have, so they load it
# from the sysroot it was linked against. The tests that draw go
# through lavapipe, as the renderer's do.
test_environment = {
    "LD_LIBRARY_PATH": "$(location //buck/sysroot:amd64)/usr/lib/x86_64-linux-gnu:$(location //buck/sysroot:amd64-test)/usr/lib/x86_64-linux-gnu",
    "VK_ICD_FILENAMES": "$(location //buck/sysroot:lavapipe_icd.json)",
}

# The triangle linked against its library and standalone, which the tests
# load and paint side by side. Each is compiled for wasmtime once, here, and
# the test reads the result (compiling the 22 MB library takes ten seconds).
precompiled_module(
    name = "base-library-compiled",
    module = "//crates/be-sdk-library-base:module",
    precompiler = "//crates/be-sdk-test-runner:precompiler",
)

precompiled_module(
    name = "triangle-compiled",
    module = "//crates/be-app-example-triangle:module",
    precompiler = "//crates/be-sdk-test-runner:precompiler",
)

precompiled_module(
    name = "triangle-standalone-compiled",
    module = "//crates/be-app-example-triangle:standalone",
    precompiler = "//crates/be-sdk-test-runner:precompiler",
)

cargo_test(
    env = test_environment,
    run_env = {
        "BASE_LIBRARY_CWASM": "$(location :base-library-compiled)",
        "TRIANGLE_CWASM": "$(location :triangle-compiled)",
        "TRIANGLE_STANDALONE_CWASM": "$(location :triangle-standalone-compiled)",
    },
)
