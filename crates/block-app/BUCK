load("@root//buck/android:defs.bzl", "android_apk", "signed_apk")
load("@root//buck/app:defs.bzl", "app")
load("@root//buck/app:drive.bzl", "headless")
load("@root//buck/cargo:defs.bzl", "cargo_binary", "cargo_library", "cargo_test", "editor_packages")
load("@root//buck/platforms:cross.bzl", "cross_triple", "per_cross_platform")
load("@root//buck/wasm:defs.bzl", "wasi_app_flags", "wasi_app_module")

# The app, with its full features (the embedded browser), which buckify.bxl
# turns on for every platform.
#
# BLOCK_APP_COMMIT is what cargo's build script asks git for; a worker has no
# checkout, so a release build takes `-c be3.commit=SHA`. A dev build says
# unknown whatever the command passes, so a new commit does not rebuild it, and
# a build that asks for both profiles leaves the dev half the cache a person's
# machine hits.
commit = {
    "BLOCK_APP_COMMIT": select({
        "DEFAULT": "unknown",
        "root//buck/constraints:release": read_config("be3", "commit", "unknown"),
    })
}

app_srcs = glob(["src/**/*.rs", "src/**/*.wgsl", "src/**/*.desktop", "src/**/*.pam", "assets/**/*"])

# On Android the app is this library, loaded by MainActivity under cargo's
# name for it; on the web it is the module :web runs wasm-bindgen over.
cargo_library(
    env = commit,
    rustc_flags = select({
        "DEFAULT": [],
        "root//buck/platforms:wasi_setting": wasi_app_flags,
    }),
    soname = "libblock_app_lib.so",
    srcs = app_srcs,
)

# The app links system libraries the worker's image does not have - ALSA, and
# GTK and WebKitGTK when the browser is built - so its tests load them from the
# sysroot it was linked against. The plugin surface presenter's tests draw
# through lavapipe, as the renderer's do, and the Wayland compositor's build a
# keyboard from the test runtime's keymaps, as be-wayland's do.
cargo_test(
    env = commit
    | {
        "LD_LIBRARY_PATH": "$(location //buck/sysroot:amd64)/usr/lib/x86_64-linux-gnu:$(location //buck/sysroot:amd64-test)/usr/lib/x86_64-linux-gnu",
        "VK_ICD_FILENAMES": "$(location //buck/sysroot:lavapipe_icd.json)",
        "XKB_CONFIG_ROOT": "$(location //buck/sysroot:amd64-test)/usr/share/X11/xkb",
    },
    srcs = app_srcs,
)

cargo_binary(env = commit, srcs = app_srcs)

# The app with every plugin beside it: `./scripts/buck run //crates/block-app:app`
# runs it. buck/app says how it is laid out.
app(
    name = "app",
    binary = ":block-app-bin",
    data = ["//{}:data".format(package) for package in editor_packages()],
    executable_name = "block-app",
    manifests = ["//{}:manifest".format(package) for package in editor_packages()],
    modules = ["//{}:module".format(package) for package in editor_packages()],
    precompile_target = per_cross_platform("x86_64-unknown-linux-gnu", cross_triple),
    precompiler = "//crates/plugin-test-runner:precompiler",
)

# The plugins alone: every editor's manifest and module, for CI to ship once
# beside every platform's app. Not precompiled, since a .cwasm is only good for
# the machine it was compiled for.
app(
    name = "plugins",
    data = ["//{}:data".format(package) for package in editor_packages()],
    manifests = ["//{}:manifest".format(package) for package in editor_packages()],
    modules = ["//{}:module".format(package) for package in editor_packages()],
    precompile = False,
    precompiler = "//crates/plugin-test-runner:plugin-test-runner-bin",
)

# What CI ships per platform: the app and server under cargo's names; the
# plugins ship once, from :plugins.
app(
    name = "dist",
    binary = ":block-app-bin",
    executable_name = "block-app",
    extra_binaries = {"be-server": "//crates/be-server:be-server-bin"},
    manifests = [],
    modules = [],
    precompile = False,
    precompiler = "//crates/plugin-test-runner:plugin-test-runner-bin",
)

# The web bundle: the app for wasi and the gpu shim for wasm32, each through
# wasm-bindgen, the page and shims in web/, and the plugins with the
# plugins.json a browser finds them through. :web-dist is CI's, without them.
wasi_app_module(
    name = "web-module",
    library = ":block-app",
    module = "block_app_lib",
)

web_files = glob(["web/*.html", "web/*.js"])

# The WASI and wasi-threads shims, which beui-web-demo needs too.
[
    export_file(
        name = shim,
        src = "web/" + shim,
        visibility = ["//crates/beui-web-demo:"],
    )
    for shim in ["wasi.js", "threads.js", "thread.js"]
]

app(
    name = "web",
    bindgen = [":web-module", "//crates/block-gpu-shim:module"],
    data = ["//{}:data".format(package) for package in editor_packages()],
    files = web_files,
    index = True,
    manifests = ["//{}:manifest".format(package) for package in editor_packages()],
    modules = ["//{}:module".format(package) for package in editor_packages()],
    precompile = False,
    precompiler = "//crates/plugin-test-runner:plugin-test-runner-bin",
    wasm_bindgen = "//buck/cargo:wasm-bindgen",
)

# What CI publishes: the bundle without the plugins, which :plugins builds once
# for every platform, and with an index of none, since a bundle whose
# plugins.json cannot be fetched is an error where one with no plugins is not.
app(
    name = "web-dist",
    bindgen = [":web-module", "//crates/block-gpu-shim:module"],
    files = web_files,
    index = True,
    manifests = [],
    modules = [],
    precompile = False,
    precompiler = "//crates/plugin-test-runner:plugin-test-runner-bin",
    wasm_bindgen = "//buck/cargo:wasm-bindgen",
)

# The bundle served here by Caddy, with be-server behind it (web/serve.sh).
command_alias(
    name = "web-serve",
    args = [
        "sh",
        "$(location :serve.sh)",
        "$(location //buck/tools:caddy)",
        "$(location :Caddyfile)",
        "$(location :web)",
        "$(location //crates/be-server:be-server-bin)",
    ],
)

# The web app served here and open in a headless Chromium for an agent to
# drive, signed in with a workspace open: guides/running/web.md.
command_alias(
    name = "web-dev",
    args = [
        "sh",
        "$(location //buck/app:web-dev.sh)",
        "$(location //buck/tools:caddy)",
        "$(location :Caddyfile)",
        "$(location :web)",
        "$(location //crates/be-server:be-server-bin)",
        "$(location //buck/app:web-drive.mjs)",
    ],
)

export_file(
    name = "Caddyfile",
    src = "web/Caddyfile",
)

export_file(
    name = "serve.sh",
    src = "web/serve.sh",
)

# The Android app: the APK is built unsigned on a worker, with the plugins
# precompiled for the device, and :android signs it here into
# target/android/block-app.apk (`-- --install` installs and starts it).
# CI's APK carries the same plugins, since an APK has nowhere else to find
# them, and has an id and label of its own, so that it installs beside a local
# build rather than colliding with it: sharing the package name, it would
# either overwrite a local install signed with the same key or fail to install
# over one signed with another.
app(
    name = "android-assets",
    compiled_only = True,
    data = ["//{}:data".format(package) for package in editor_packages()],
    index = True,
    manifests = ["//{}:manifest".format(package) for package in editor_packages()],
    modules = ["//{}:module".format(package) for package in editor_packages()],
    precompile_target = "aarch64-linux-android",
    precompiler = "//crates/plugin-test-runner:precompiler",
)

[
    android_apk(
        name = name,
        application_id = application_id,
        assets = assets,
        java = glob(["android/java/**/*.java"]) + ["//crates/beui-adapter-android:android-java"],
        label = label,
        library = ":block-app",
        manifest = "android/AndroidManifest.xml",
        min_sdk = 23,
        package = "com.be3.block",
        resources = "android/res",
        target_sdk = 35,
        version_code = 1,
        version_name = "0.1.0",
    )
    for name, assets, application_id, label in [
        ("apk", ":android-assets", "com.be3.block", "Block"),
        ("apk-dist", ":android-assets", "com.be3.block.ci", "Block (CI)"),
    ]
]

command_alias(
    name = "android",
    args = [
        "sh",
        "$(location //buck/android:sign.sh)",
        "$(location //buck/android:jdk)",
        "$(location //buck/android:build-tools)",
        "$(location //buck/android:platform-tools)",
        "$(location :apk)",
        "block-app",
        "com.be3.block.MainActivity",
    ],
)

# What CI ships, signed on a worker with CI's keystore, so the runner downloads
# only the APK: `./scripts/buck build :android-dist --out block-app.apk`.
signed_apk(
    name = "android-dist",
    apk = ":apk-dist",
)

export_file(
    name = "android-res",
    src = "android/res",
    visibility = ["//crates/be-launcher:"],
)

# The native startup smoke check: the app for ten seconds in a virtual display,
# and :smoke-desktop the same with the desktop shell in its window.
[
    command_alias(
        name = name,
        args = [
            "sh",
            "$(location //buck/app:smoke.sh)",
            "$(location :app)/block-app",
            "$(location //buck/sysroot:amd64)/usr/lib/x86_64-linux-gnu",
        ]
        + flags,
    )
    for name, flags in [("smoke", []), ("smoke-desktop", ["--desktop"])]
]

# The app with its plugins installed under /usr/local (or the prefix given after
# `--`), with a wayland-sessions entry that runs it with --session, for a
# display manager to offer on its login screen: guides/linux_desktop.md.
command_alias(
    name = "install-session",
    args = [
        "$(location :app)/block-app",
        "--install-session",
    ],
)

# The app headless for an agent to drive, signed in with a workspace open:
# guides/running/drive.md.
headless(
    name = "dev",
    app_name = "dev",
    args = ["--dev-workspace"],
    data = True,
    program = "$(location :app)/block-app",
)
