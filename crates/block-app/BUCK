load("@root//buck/cargo:defs.bzl", "cargo_binary", "cargo_library", "cargo_test")

# The desktop app, with the terminal and without the embedded browser. Both are
# features because what they need is not a Rust dependency. The terminal's is
# libghostty-vt, which crates/ghostty-vt builds on a worker. The browser's is
# WebKitGTK and the GTK stack under it, which the worker's container does not
# have and which is far too large to hand it the way ALSA is handed; cargo
# still builds and lints that half. Which of the two is on is decided where
# buck/cargo/crates.bzl is generated: buck/cargo/buckify.bxl asks cargo to
# plan the host build with block-app/terminal.
#
# BLOCK_APP_COMMIT is what build.rs asks git for under cargo. A worker has no
# checkout to ask, so this says what build.rs says when git cannot answer.
commit = {"BLOCK_APP_COMMIT": "unknown"}

app_srcs = glob(["src/**/*.rs", "src/**/*.wgsl", "assets/**/*"])

cargo_library(env = commit, srcs = app_srcs)

# The app links system libraries the worker's image does not have - ALSA, and
# GTK and WebKitGTK when the browser is built - so its tests load them from the
# sysroot it was linked against.
cargo_test(
    env = commit | {"LD_LIBRARY_PATH": "$(location //buck/sysroot:amd64)/usr/lib/x86_64-linux-gnu"},
    srcs = app_srcs,
)

cargo_binary(env = commit, srcs = app_srcs)
