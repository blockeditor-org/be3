# The desktop app, with the terminal and without the embedded browser. Both are
# features because what they need is not a Rust dependency. The terminal's is
# libghostty-vt, which crates/ghostty-vt builds on a worker. The browser's is
# WebKitGTK and the GTK stack under it, which the worker's container does not
# have and which is far too large to hand it the way ALSA is handed; cargo
# still builds and lints that half.
#
# BLOCK_APP_COMMIT is what build.rs asks git for under cargo. A worker has no
# checkout to ask, so this says what build.rs says when git cannot answer.
rust_library(
    name = "block-app",
    crate = "block_app_lib",
    crate_root = "src/main.rs",
    deps = [
        "//crates/be-block:be-block",
        "//crates/be-client:be-client",
        "//crates/be-graph:be-graph",
        "//crates/be-protocol:be-protocol",
        "//crates/be-store:be-store",
        "//crates/block:block",
        "//crates/block-client:block-client",
        "//crates/block-plugin-api:block-plugin-api",
        "//crates/block-server:block-server",
        "//crates/block-ui:block-ui",
        "//crates/block-wasm-host:block-wasm-host",
        "//crates/ghostty-vt:ghostty-vt",
        "//crates/logicgame:logicgame",
        "//crates/tabletop_games/host:game-host",
        "//crates/wasi-threads:wasi-threads",
        "//third-party/rust:arboard",
        "//third-party/rust:bytemuck",
        "//third-party/rust:eframe",
        "//third-party/rust:egui_material_icons",
        "//third-party/rust:flate2",
        "//third-party/rust:futures-util",
        "//third-party/rust:image",
        "//third-party/rust:libc",
        "//third-party/rust:rfd",
        "//third-party/rust:rodio",
        "//third-party/rust:rusqlite",
        "//third-party/rust:serde",
        "//third-party/rust:serde_json",
        "//third-party/rust:tokio",
        "//third-party/rust:ureq",
        "//third-party/rust:uuid",
    ],
    edition = "2024",
    env = {
        "BLOCK_APP_COMMIT": "unknown",
        "CARGO_CRATE_NAME": "block_app_lib",
        "CARGO_MANIFEST_DIR": "crates/block-app",
        "CARGO_PKG_NAME": "block-app",
        "CARGO_PKG_VERSION": "0.1.0",
    },
    features = ["terminal"],
    srcs = glob(["src/**/*.rs", "src/**/*.wgsl", "assets/**/*"]),
    visibility = ["PUBLIC"],
)

