load("@root//buck/android:defs.bzl", "android_apk")
load("@root//buck/app:defs.bzl", "app")
load("@root//buck/cargo:defs.bzl", "cargo_binary", "cargo_library", "cargo_test", "editor_packages")
load("@root//buck/platforms:cross.bzl", "per_cross_platform")
load("@root//buck/tools:defs.bzl", "tool")
load("@root//buck/wasm:defs.bzl", "wasi_app_flags", "wasi_app_module")
load("@root//third-party/pdfium:defs.bzl", "pdfium_library")

# The desktop app, with both of the features that are more than Rust: the
# terminal, whose libghostty-vt crates/ghostty-vt builds on a worker, and the
# embedded browser, whose WebKitGTK and GTK come from the sysroot in
# buck/sysroot. Which features are on is decided where the dependencies are
# generated: reindeer.toml turns on block-app's full on every platform the app
# is built for, the browser's included, and buck/cargo/buckify.bxl asks cargo
# to plan the same builds.
#
# The commit the app says it was built from, which cargo's build script asks git
# for and a worker has no checkout to ask. CI's release builds pass it as
# `-c be3.commit=...`; every other build says unknown, so that a new commit
# does not recompile the app.
commit = {"BLOCK_APP_COMMIT": read_config("be3", "commit", "unknown")}

app_srcs = glob(["src/**/*.rs", "src/**/*.wgsl", "assets/**/*"])

# On Android the app is this library, as the shared object the APK carries and
# its NativeActivity loads by cargo's name for it.
# On the web it is this library again, as the module wasm-bindgen writes the
# browser's JavaScript for: :web below.
cargo_library(
    env = commit,
    rustc_flags = select({
        "DEFAULT": [],
        "root//buck/platforms:wasi_setting": wasi_app_flags,
    }),
    soname = "libblock_app_lib.so",
    srcs = app_srcs,
)

# The app links system libraries the worker's image does not have - ALSA, and
# GTK and WebKitGTK when the browser is built - so its tests load them from the
# sysroot it was linked against.
cargo_test(
    env = commit | {"LD_LIBRARY_PATH": "$(location //buck/sysroot:amd64)/usr/lib/x86_64-linux-gnu"},
    srcs = app_srcs,
)

cargo_binary(env = commit, srcs = app_srcs)

# The app with every plugin beside it: `./scripts/buck run //crates/block-app:app`
# runs it. buck/app says how it is laid out.
app(
    name = "app",
    binary = ":block-app-bin",
    executable_name = "block-app",
    files = pdfium_library(),
    manifests = ["//{}:manifest".format(package) for package in editor_packages()],
    modules = ["//{}:module".format(package) for package in editor_packages()],
    precompile = per_cross_platform(True, lambda _: False),
    precompiler = "//crates/plugin-test-runner:plugin-test-runner-bin",
)

# The plugins alone: every editor's manifest and module, for CI to ship once
# beside every platform's app. Not precompiled, since a .cwasm is only good for
# the machine it was compiled for.
app(
    name = "plugins",
    manifests = ["//{}:manifest".format(package) for package in editor_packages()],
    modules = ["//{}:module".format(package) for package in editor_packages()],
    precompile = False,
    precompiler = "//crates/plugin-test-runner:plugin-test-runner-bin",
)

# What CI ships for a platform: the app and the server, under cargo's names,
# and PDFium, without the plugins, which :plugins builds once for every
# platform. `-c be3.profile=release` makes it a release build, and
# `-c be3.commit=SHA` says which commit it is:
#
#   ./scripts/buck build --target-platforms root//buck/platforms:macos_arm64 \
#       -c be3.profile=release -c be3.commit="$(git rev-parse HEAD)" \
#       //crates/block-app:dist --out dist
app(
    name = "dist",
    binary = ":block-app-bin",
    executable_name = "block-app",
    extra_binaries = {"block-server": "//crates/block-server:block-server-bin"},
    files = pdfium_library(),
    manifests = [],
    modules = [],
    precompile = False,
    precompiler = "//crates/plugin-test-runner:plugin-test-runner-bin",
)

# The web bundle: the app as a WASI module, and the gpu shim, each with the
# JavaScript wasm-bindgen writes for it, beside the page and the shims in web/
# that stand in for WASI and for threads, and every plugin with the plugins.json
# the browser finds them through. Any static file server that sends the two
# cross-origin isolation headers web/Caddyfile does can serve it, and
# :web-serve below does, on this machine:
#
#   ./scripts/buck build //crates/block-app:web --out dist/web
wasi_app_module(
    name = "web-module",
    library = ":block-app",
    module = "block_app_lib",
)

web_files = glob(["web/*.html", "web/*.js"])

app(
    name = "web",
    bindgen = [":web-module", "//crates/block-gpu-shim:module"],
    files = web_files,
    index = True,
    manifests = ["//{}:manifest".format(package) for package in editor_packages()],
    modules = ["//{}:module".format(package) for package in editor_packages()],
    precompile = False,
    precompiler = "//crates/plugin-test-runner:plugin-test-runner-bin",
    wasm_bindgen = "//buck/cargo:wasm-bindgen",
)

# What CI publishes: the bundle without the plugins, which :plugins builds once
# for every platform, and with an index of none, since a bundle whose
# plugins.json cannot be fetched is an error where one with no plugins is not.
app(
    name = "web-dist",
    bindgen = [":web-module", "//crates/block-gpu-shim:module"],
    files = web_files,
    index = True,
    manifests = [],
    modules = [],
    precompile = False,
    precompiler = "//crates/plugin-test-runner:plugin-test-runner-bin",
    wasm_bindgen = "//buck/cargo:wasm-bindgen",
)

# The bundle served on this machine, with block-server behind it: web/serve.py.
#
#   ./scripts/buck run //crates/block-app:web-serve
tool(
    name = "web-serve",
    command = [
        "python3",
        "$(location :serve.py)",
        "$(location :web)",
        "$(location //crates/block-server:block-server-bin)",
    ],
)

export_file(
    name = "serve.py",
    src = "web/serve.py",
)

# The Android app: the library above, built for Android, in an APK with every
# plugin precompiled for the device's wasmtime. The APK is built unsigned on a
# worker, and :android signs it here with this machine's key and writes it to
# target/android/block-app.apk; --install puts it on the device adb sees and
# starts it:
#
#   ./scripts/buck run //crates/block-app:android -- --install
#
# CI's builds install beside a developer's, under their own id and label:
# `-c be3.android_id=com.be3.block.ci -c "be3.android_label=Block (CI)"`.
app(
    name = "android-assets",
    index = True,
    manifests = ["//{}:manifest".format(package) for package in editor_packages()],
    modules = ["//{}:module".format(package) for package in editor_packages()],
    precompile = per_cross_platform(True, lambda _: False),
    precompile_target = "aarch64-linux-android",
    precompiler = "//crates/plugin-test-runner:plugin-test-runner-bin",
)

# What CI ships: no plugins, which :plugins builds once for every platform, and
# an index of none.
app(
    name = "android-dist-assets",
    index = True,
    manifests = [],
    modules = [],
    precompile = False,
    precompiler = "//crates/plugin-test-runner:plugin-test-runner-bin",
)

[
    android_apk(
        name = name,
        application_id = read_config("be3", "android_id", "com.be3.block"),
        assets = assets,
        java = glob(["android/java/**/*.java"]),
        label = read_config("be3", "android_label", "Block"),
        library = ":block-app",
        manifest = "android/AndroidManifest.xml",
        min_sdk = 23,
        package = "com.be3.block",
        target_sdk = 35,
        version_code = 1,
        version_name = "0.1.0",
    )
    for name, assets in [("apk", ":android-assets"), ("apk-dist", ":android-dist-assets")]
]

[
    tool(
        name = name,
        command = [
            "python3",
            "$(location //buck/android:sign.py)",
            "--jdk",
            "$(location //buck/android:jdk)",
            "--build-tools",
            "$(location //buck/android:build-tools)",
            "--platform-tools",
            "$(location //buck/android:platform-tools)",
            "--unsigned",
            "$(location {})".format(apk),
        ],
    )
    for name, apk in [("android", ":apk"), ("android-dist", ":apk-dist")]
]

# The native startup smoke check: the app for ten seconds in a virtual display.
tool(
    name = "smoke",
    command = [
        "$(location //buck/app:smoke.sh)",
        "$(location :app)/block-app",
        "$(location //buck/sysroot:amd64)/usr/lib/x86_64-linux-gnu",
    ],
)
