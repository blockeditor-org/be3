load("@root//buck/app:defs.bzl", "app")
load("@root//buck/app:drive.bzl", "page_test")
load("@root//buck/cargo:defs.bzl", "cargo_binary", "cargo_example", "cargo_library", "cargo_test")

cargo_library()

cargo_test(
    env = {
        "COUNTER_TYPES_WASM": "$(location //crates/editors/counter/types:module)",
        "GUEST_ECHO_WASM": "$(location //crates/block-guest-echo:module)",
        "TLS_DIAMOND_BASE_WASM": "$(location //crates/tls-diamond/base:module)",
        "TLS_DIAMOND_LEFT_WASM": "$(location //crates/tls-diamond/left:module)",
        "TLS_DIAMOND_PLUGIN_WASM": "$(location //crates/tls-diamond/plugin:module)",
        "TLS_DIAMOND_RIGHT_WASM": "$(location //crates/tls-diamond/right:module)",
    }
)

cargo_binary()

# The examples: `./scripts/buck run //crates/block-wasm-host:example-<example>`.

cargo_example("gpu-calls")

cargo_example("instantiate")

# The standalone guest (src/tests/standalone.wat, which the tests above run on
# wasmtime) in Chromium: assembled into a module, and booted by block-app's
# plugin.js against block-gpu-shim, which wasm-bindgen prepares as the web
# bundle does, in a page that checks what it painted (web/standalone.js).
genrule(
    name = "standalone.wasm",
    cmd = "$(exe //buck/tools:wasm-as) --enable-bulk-memory $SRCS -o $OUT",
    out = "standalone.wasm",
    srcs = ["src/tests/standalone.wat"],
)

app(
    name = "standalone-bundle",
    bindgen = ["//crates/block-gpu-shim:module"],
    files = [
        "//crates/block-app:dylink.js",
        "//crates/block-app:env.js",
        "//crates/block-app:plugin.js",
        "//crates/block-app:thread.js",
        "//crates/block-app:threads.js",
        "//crates/block-app:wasi.js",
    ],
    manifests = [],
    modules = [],
    wasm_bindgen = "//buck/cargo:wasm-bindgen",
)

page_test(
    name = "standalone-web-test",
    files = {
        "bundle": ":standalone-bundle",
        "index.html": "web/index.html",
        "standalone.js": "web/standalone.js",
        "standalone.wasm": ":standalone.wasm",
    },
)
