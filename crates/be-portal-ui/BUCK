load("@root//buck/app:defs.bzl", "app")
load("@root//buck/cargo:defs.bzl", "cargo_library", "cargo_test")
load("@root//buck/wasm:defs.bzl", "wasi_app_flags", "wasi_html_module")

# be-server's account portal on beui's HTML core (guides/hosting.md): be-server
# renders each page on the host with render(), and :assets, which be-server's
# executable embeds and serves under /auth/assets/, hydrates it in the browser.
cargo_library(
    rustc_flags = select({
        "DEFAULT": [],
        "prelude//cpu/constraints:cpu[wasm32]": wasi_app_flags,
    }),
    target_compatible_with = ["root//buck/constraints:html"],
)

# Paintings of every page as be-server renders it, before any script runs:
# `./scripts/test //crates/be-portal-ui:test`.
cargo_test(
    default_target_platform = "root//buck/platforms:linux_x86_64_html",
    paints = True,
    target_compatible_with = ["root//buck/constraints:html"],
)

wasi_html_module(
    name = "web-module",
    library = ":be-portal-ui",
    module = "be_portal_ui",
)

app(
    name = "assets",
    bindgen = [":web-module"],
    files = [
        "web/start.js",
        "//crates/beui-fonts:Inter-Regular.ttf",
        "//crates/beui-fonts:Hack-Regular.ttf",
        "//crates/beui-fonts:NotoEmoji-Regular.ttf",
        "//crates/beui-fonts:lucide.ttf",
        "//crates/block-app:wasi.js",
        "//crates/block-app:threads.js",
        "//crates/block-app:thread.js",
        "//crates/block-app:dylink.js",
        "//crates/block-app:env.js",
    ],
    manifests = [],
    modules = [],
    wasm_bindgen = "//buck/cargo:wasm-bindgen",
    visibility = ["//crates/be-server-bin:"],
)
