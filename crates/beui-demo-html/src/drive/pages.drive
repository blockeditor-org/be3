# Every page of the demo opens from the catalog on the HTML core, each the next
# tab stop after the one before, and takes the place of the one shown in the
# dock's page tab.
clock stop
click '#demo.catalog.Docking'
key Tab Enter
wait 'focused #demo.catalog.Nested docks'
wait 'Tab "Outline"'
wait 'Tab "Preview"'
key Tab Enter
wait 'focused #demo.catalog.Dock bars'
wait '#bars.tools'
key Tab Enter
wait 'focused #demo.catalog.Text'
wait 'Tab "Text" selected'
key Tab Enter
wait 'focused #demo.catalog.Buttons'
wait 'Tab "Buttons" selected'
key Tab Enter
wait 'focused #demo.catalog.Inputs'
wait 'Tab "Inputs" selected'
key Tab Enter
wait 'focused #demo.catalog.Choices'
wait 'Tab "Choices" selected'
key Tab Enter
wait 'focused #demo.catalog.Pickers'
wait 'Tab "Pickers" selected'
key Tab Enter
wait 'focused #demo.catalog.Colors'
wait 'Tab "Colors" selected'
key Tab Enter
wait 'focused #demo.catalog.Menus'
wait 'Tab "Menus" selected'
key Tab Enter
wait 'focused #demo.catalog.Overlays'
wait 'Tab "Overlays" selected'
key Tab Enter
wait 'focused #demo.catalog.Rows'
wait 'Tab "Rows" selected'
key Tab Enter
wait 'focused #demo.catalog.Tree'
wait 'Tab "Tree" selected'
key Tab Enter
wait 'focused #demo.catalog.Layout'
