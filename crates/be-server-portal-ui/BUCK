load("@root//buck/cargo:defs.bzl", "cargo_test")
load("@root//buck/wasm:defs.bzl", "web_library", "web_program")

# be-server's account portal on beui's HTML core (guides/hosting.md): be-server
# renders each page on the host with render(), and :assets, which be-server's
# executable embeds and serves under /auth/assets/, hydrates it in the browser.
web_library(
    role = "html",
    target_compatible_with = ["root//buck/constraints:html"],
)

# Paintings of every page as be-server renders it, before any script runs:
# `./scripts/test //crates/be-server-portal-ui:test`.
cargo_test(
    default_target_platform = "root//buck/platforms:linux_x86_64_html",
    paints = True,
    target_compatible_with = ["root//buck/constraints:html"],
)

web_program(
    name = "assets",
    module = "be_portal_ui",
    role = "html",
    files = [
        "web/start.js",
        "//crates/beui-fonts:Inter-Regular.ttf",
        "//crates/beui-fonts:Hack-Regular.ttf",
        "//crates/beui-fonts:NotoEmoji-Regular.ttf",
        "//crates/beui-fonts:lucide.ttf",
    ],
    visibility = ["//crates/be-server-bin:"],
)
