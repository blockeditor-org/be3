# Caddyfile with the whole site behind a key: requests carrying
# `Be3-Gateway-Authorization: Bearer KEY` (the native app, be, the build server's clients)
# or the `be3_gate` cookie holding KEY get through. A browser cannot put a
# header on a websocket, so anything else is answered with a page that asks for
# the key and keeps it in that cookie, which the browser then sends with every
# request, the web app's websocket included; the key never goes in a URL.
# Replace notes.example.com and KEY.
notes.example.com {
	@authorized expression `{http.request.header.Be3-Gateway-Authorization} == "Bearer KEY" || {http.request.cookie.be3_gate} == "KEY"`

	handle @authorized {
		handle /api* {
			reverse_proxy 127.0.0.1:9090
		}
		handle {
			header {
				Cross-Origin-Opener-Policy same-origin
				Cross-Origin-Embedder-Policy require-corp
				Cache-Control no-cache
			}
			root * /srv/be3-web
			file_server
		}
	}

	handle {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control no-store
		respond <<HTML
			<!doctype html>
			<html lang="en">
			<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>Block</title>
			<style>
			body { font: 16px system-ui, sans-serif; display: grid; place-items: center; min-height: 100vh; margin: 0; background: #16181d; color: #e6e6e6; }
			form { display: grid; gap: 12px; width: min(320px, 90vw); }
			input, button { font: inherit; padding: 8px 10px; border-radius: 6px; border: 1px solid #3a3f4b; background: #22252c; color: inherit; }
			button { cursor: pointer; }
			p { margin: 0; color: #f08a8a; }
			</style>
			</head>
			<body>
			<form id="gate">
			<label for="key">Access key</label>
			<input id="key" name="password" type="password" autocomplete="current-password" required autofocus>
			<button>Continue</button>
			<p id="refused" hidden>That key was not accepted.</p>
			</form>
			<script>
			if (document.cookie.split("; ").some((cookie) => cookie.startsWith("be3_gate="))) {
			  document.getElementById("refused").hidden = false;
			}
			document.getElementById("gate").addEventListener("submit", (event) => {
			  event.preventDefault();
			  const key = document.getElementById("key").value.trim();
			  document.cookie = `be3_gate=${key}; Path=/; Max-Age=31536000; Secure; SameSite=Lax`;
			  location.reload();
			});
			</script>
			</body>
			</html>
			HTML 401
	}
}
