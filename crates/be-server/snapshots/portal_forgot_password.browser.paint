    "<style>",
    "\nbody {\n    font-size: 1rem;\n    font-family: system-ui, sans-serif;\n    margin: 3rem auto;\n    padding: 0 1rem;\n    max-width: 28rem;\n    color: #202124;\n    background: #fafafa;\n}\nlabel {\n    display: block;\n    margin: 1rem 0;\n}\ninput {\n    display: block;\n    box-sizing: border-box;\n    width: 100%;\n    padding: .7rem;\n    font: inherit;\n}\nbutton {\n    padding: .7rem;\n    margin: .4rem .4rem .4rem 0;\n    font: inherit;\n    cursor: pointer;\n}\n[role=alert] {\n    color: #a00;\n}\n</style>",
