    "Block account</a>",
    "</header>",
    "<main>",
    "<h1>",
    "Reset your password</h1>",
    "<p>",
    "This resets your sign-in password. Encrypted data still requires your recovery phrase or another unlocked device in Block.</p>",
    "<form action=\"/auth/forgot\" method=\"post\" novalidate=\"\">",
    "<input type=\"hidden\" name=\"csrf\" value=\"snapshot-form-token\">",
    "<input type=\"hidden\" name=\"code\" value=\"\">",
