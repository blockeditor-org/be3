{
  "size": [
    390,
    1000
  ],
  "document": [
    "<!doctype html>",
    "<html lang=\"en\">",
    "<head>",
    "<meta charset=\"utf-8\">",
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
    "<title>",
    "Block account</title>",
    "<style>",
    "\nbody {\n    font-size: 1rem;\n    font-family: system-ui, sans-serif;\n    margin: 3rem auto;\n    padding: 0 1rem;\n    max-width: 28rem;\n    color: #202124;\n    background: #fafafa;\n}\nlabel {\n    display: block;\n    margin: 1rem 0;\n}\ninput {\n    display: block;\n    box-sizing: border-box;\n    width: 100%;\n    padding: .7rem;\n    font: inherit;\n}\nbutton {\n    padding: .7rem;\n    margin: .4rem .4rem .4rem 0;\n    font: inherit;\n    cursor: pointer;\n}\n[role=alert] {\n    color: #a00;\n}\n</style>",
    "</head>",
    "<body>",
    "<header>",
    "<a href=\"/auth\">",
    "Block account</a>",
    "</header>",
    "<main>",
    "<p role=\"alert\">",
    "This sign-in code expired. Start sign-in again in Block.</p>",
    "<h1>",
    "Sign in</h1>",
    "<form action=\"/auth/login\" method=\"post\" novalidate=\"\">",
    "<input type=\"hidden\" name=\"csrf\" value=\"snapshot-form-token\">",
    "<input type=\"hidden\" name=\"code\" value=\"expired-code\">",
    "<label>",
    "Email<input type=\"email\" name=\"email\" value=\"\" autocomplete=\"username\" aria-invalid=\"false\">",
    "</label>",
    "<label>",
    "Password<input type=\"password\" name=\"password\" value=\"\" autocomplete=\"current-password\" aria-invalid=\"false\">",
    "</label>",
    "<button>",
    "Sign in</button>",
    "</form>",
    "<p>",
    "<a href=\"/auth/forgot?code=expired-code\">",
    "Forgot your password?</a>",
    "</p>",
    "<a href=\"/auth/register?code=expired-code\">",
    "Create an account</a>",
    "<h2>",
    "Have a sign-in code?</h2>",
    "<form action=\"/auth/code\" method=\"post\" novalidate=\"\">",
    "<input type=\"hidden\" name=\"csrf\" value=\"snapshot-form-token\">",
    "<input type=\"hidden\" name=\"code\" value=\"\">",
    "<label>",
    "Code shown in Block<input type=\"text\" name=\"code\" value=\"expired-code\" autocomplete=\"off\" aria-invalid=\"false\">",
    "</label>",
    "<button>",
    "Continue with code</button>",
    "</form>",
    "</main>",
    "</body>",
    "</html>"
  ],
  "files": {}
}
