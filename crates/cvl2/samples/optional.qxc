#builtin.build .= () => std.Folder[
  "found.txt" .= std.File: describe(find(letters(), "b"))
  "missing.txt" .= std.File: describe(find(letters(), "z"))
  "forced.txt" .= std.File: kw.string.from_int(find(letters(), "c").?)
  "flag.txt" .= std.File: flag(std.Option(kw.bool): .true)
]

letters :: () => kw.list(kw.string): ("a", "b", "c")

find :: (xs: kw.list(kw.string), target: kw.string) => std.Option(kw.int): :return {
  kw.for (i := kw.range(0, xs.len)) {
    kw.if (xs.get(i) == target) {
      return: i
    }
  }
  -> kw.null
}

describe :: (index: std.Option(kw.int)) => kw.string: :return {
  kw.if (i := index) {
    return: "found at " + kw.string.from_int(i)
  } .else {
    return: "not found"
  }
}

flag :: (value: std.Option(kw.bool)) => kw.string: :return {
  kw.if (value.? == std.Option(kw.bool).true) {
    return: "set"
  }
  -> "unset"
}
std :: #builtin.std
kw :: std.kw
