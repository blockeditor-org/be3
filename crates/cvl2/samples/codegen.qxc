#builtin.build .= () => std.Folder[
  "sum.c" .= std.File: emit_sum(std.kw.list(std.kw.int): (1, 2, 3))
]

emit_sum :: (terms: std.kw.list(std.kw.int)) => std.kw.text: :done {
  lines := std.kw.mut(std.kw.list(std.kw.text): ())
  acc := std.kw.mut(std.kw.text.fresh("t"))
  lines = lines.*.push("int \(acc.*) = 0;")
  i := std.kw.mut(std.kw.int: 0)
  std.kw.loop {
    std.kw.if (i.* == terms.len) {
      done: lines.*.join("\n") + "\nreturn \(acc.*);\n"
    }
    next := std.kw.text.fresh("t")
    lines = lines.*.push("int \(next) = \(acc.*) + \(terms.get(i.*));")
    acc = next
    i = i.* + 1
  }
}
std :: #builtin.std
