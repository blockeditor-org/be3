std :: #builtin.std
kw :: std.kw

target :: std.Target: "mc"

Line :: std.Enum["command" .= kw.string, "value" .= kw.int]

Result :: std.Type[
  .statics .= [
    std.literal.number .= (n: kw.int) => std.emit(Result, Line.value(n), ())
  ]
]

runCommand :: (cmd :: kw.string) #inline => Result: std.emit(Result, Line.command(cmd), ())

Names :: std.Struct[
  "order" .= kw.list(std.reflect.Fn)
  "ids" .= kw.map(std.reflect.Fn, kw.string)
  "internal" .= kw.int
]

name :: (names: Names, f: std.reflect.Fn) => Names: :return {
  kw.if (_ := names.ids.get(f)) {
    return: names
  }
  -> Names[
    "order" .= names.order.push(f)
    "ids" .= names.ids.set(f, "_0:_" + kw.string.from_int(names.internal))
    "internal" .= names.internal + 1
  ]
}

Pending :: std.Struct["command" .= kw.string, "at" .= kw.int]

Body :: std.Struct["names" .= Names, "text" .= kw.string]

body :: (f: std.reflect.Function, start: Names) => Body: :return {
  names := kw.mut(Names).new: start
  commands := kw.mut(kw.list(kw.string)).new: ()
  pending := kw.mut(std.Option(Pending)).new: kw.null
  kw.for (i := kw.range(0, f.lines.len)) {
    command := kw.mut(std.Option(kw.string)).new: kw.null
    kw.match (f.lines.get(i)) [
      .call .= (c) => {
        callee := c.callee.constant.?.fn.?
        names = name(names.*, callee)
        command = kw.string: "function " + names.ids.*.get(callee).?
      }
      .emit .= (e) => {
        kw.if (cmd := e.data.as(Line).?.command) {
          command = cmd
        }
      }
      .break .= (b) => {
        _ = std.reflect.fail(b.at, "break is not supported in a datapack")
      }
      .other .= (o) => {
        _ = std.reflect.fail(o.at, o.name + " is not supported in a datapack")
      }
      .else .= () => { }
    ]
    kw.if (cmd := command.*) {
      kw.if (p := pending.*) {
        commands = commands.*.push(p.command)
      }
      pending = Pending["command" .= cmd, "at" .= i]
    }
  }
  result := f.result.value.?
  kw.if (e := f.lines.get(result.index).emit) {
    kw.if (n := e.data.as(Line).?.value) {
      kw.if (p := pending.*) {
        commands = commands.*.push(p.command)
      }
      return: Body["names" .= names.*, "text" .= commands.*.push("return " + kw.string.from_int(n)).join("\n")]
    }
  }
  kw.if (p := pending.*) {
    kw.if (p.at == result.index) {
      return: Body["names" .= names.*, "text" .= commands.*.push("return run " + p.command).join("\n")]
    }
  }
  -> std.reflect.fail(result, "this result was lost")
}

compile :: (exports: kw.map(kw.string, std.reflect.Fn)) => std.Folder: {
  names := kw.mut(Names).new: Names[
    "order" .= exports.values
    "ids" .= kw.map(std.reflect.Fn, kw.string): []
    "internal" .= 0
  ]
  kw.for ((id, f) := exports) {
    names.ids = names.ids.*.set(f, id)
  }
  -> files(names.*)
}

files :: (start: Names) => kw.map(kw.string, kw.string): :return {
  names := kw.mut(Names).new: start
  out := kw.mut(kw.map(kw.string, kw.string)).new: []
  done := kw.mut(kw.int).new: 0
  kw.loop {
    kw.if (done.* == names.order.*.len) {
      return: out.*
    }
    f := names.order.*.get(done.*)
    id := names.ids.*.get(f).?.split(":")
    result := body(std.reflect.function(target, f), names.*)
    names = result.names
    out = out.*.set("data/" + id.get(0) + "/functions/" + id.get(1) + ".mcfunction", result.text)
    done += 1
  }
}

"target" .= target
"Result" .= Result
"runCommand" .= runCommand
"Datapack" .= std.Type[.statics .= ["compile" .= compile]]
