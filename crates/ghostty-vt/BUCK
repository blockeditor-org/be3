load("@root//buck/cargo:defs.bzl", "cargo_library", "cargo_test")
load("@root//buck/platforms:cross.bzl", "cross_triple", "per_cross_platform")

# libghostty-vt, block-app's terminal emulator: Zig, built on a worker by
# scripts/internal/build-ghostty-vt.sh, which downloads Zig and Ghostty pinned
# by hash and commit - the one action that needs the network. Zig
# cross-compiles, so every platform's archive comes from the same worker;
# Windows gets buck/tools' MSVC runtime and SDK through a libc file, and Android
# buck/tools' NDK.
genrule(
    name = "libghostty-vt.a",
    cmd = "triple="
    + per_cross_platform(
        "x86_64-unknown-linux-gnu",
        cross_triple,
        {"root//buck/platforms:wasi_setting": "wasm32-wasip1-threads"},
    )
    + "\nwindows_sdk="
    + per_cross_platform(
        "",
        lambda name: (
            "$(location //buck/tools:windows-sdk-{})".format("aarch64" if name == "windows_arm64" else "x86_64") if name.startswith("windows") else None
        ),
    )
    + "\nandroid_ndk="
    + per_cross_platform("", lambda name: "$(location //buck/tools:android-ndk)" if name.startswith("android") else None)
    + """
        set -eu
        repository=`mktemp -d`
        if [ -n "$android_ndk" ]; then
            ANDROID_NDK_HOME="$repository/ndk"
            export ANDROID_NDK_HOME
            mkdir -p "$ANDROID_NDK_HOME/toolchains/llvm/prebuilt/linux-x86_64"
            ln -s "`cd "$android_ndk" && pwd`/sysroot" "$ANDROID_NDK_HOME/toolchains/llvm/prebuilt/linux-x86_64/sysroot"
        fi
        if [ -n "$windows_sdk" ]; then
            sdk=`cd "$windows_sdk" && pwd`
            arch="${triple%%-*}"
            GHOSTTY_ZIG_LIBC="$repository/libc.txt"
            export GHOSTTY_ZIG_LIBC
            {
                echo "include_dir=$sdk/sdk/include/ucrt"
                echo "sys_include_dir=$sdk/crt/include"
                echo "crt_dir=$sdk/sdk/lib/ucrt/$arch"
                echo "msvc_lib_dir=$sdk/crt/lib/$arch"
                echo "kernel32_lib_dir=$sdk/sdk/lib/um/$arch"
                echo "gcc_dir="
            } > "$GHOSTTY_ZIG_LIBC"
        fi
        cp -RL "$SRCDIR/scripts" "$repository/" || { ls -laR "$SRCDIR" >&2; exit 1; }
        bash "$repository/scripts/internal/build-ghostty-vt.sh" \\
            --triple "$triple" > /dev/null
        cp "$repository/target/ghostty-vt/$triple/"*ghostty-vt*.* "$OUT"
        rm -rf "$repository"
    """,
    out = "libghostty-vt.a",
    srcs = {
        "scripts/internal/build-ghostty-vt.sh": "//scripts/internal:build-ghostty-vt.sh",
        "scripts/internal/common.sh": "//scripts/internal:common.sh",
        "scripts/internal/ghostty-vt.patch": "//scripts/internal:ghostty-vt.patch",
    },
)

prebuilt_cxx_library(
    name = "libghostty-vt",
    preferred_linkage = "static",
    static_lib = ":libghostty-vt.a",
)

cargo_library(extra_deps = [":libghostty-vt"])

cargo_test(extra_deps = [":libghostty-vt"])
