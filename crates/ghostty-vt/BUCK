load("@root//buck/cargo:defs.bzl", "cargo_library", "cargo_test")
load("@root//buck/platforms:cross.bzl", "cross_triple", "per_cross_platform")

# libghostty-vt, the terminal emulator behind block-app's debug terminal.
#
# It is Zig rather than Rust. scripts/internal/build-ghostty-vt.sh is what
# builds it for cargo, and it is what builds it here too: this runs the script
# on a worker, in a copy of the three files it reads laid out the way it
# expects to find them, and keeps the archive. The script downloads Zig and
# Ghostty itself, pinned by hash and by commit, and Zig fetches Ghostty's own
# dependencies, so this is the one action that needs the network. Its inputs
# pin everything it downloads, which is what makes its result safe to cache.
#
# Zig cross-compiles, so every platform's archive is built on the same Linux
# worker; the triple is the only thing that differs.
genrule(
    name = "libghostty-vt.a",
    cmd = "triple="
    + per_cross_platform("x86_64-unknown-linux-gnu", cross_triple)
    + """
        set -eu
        repository=`mktemp -d`
        cp -RL "$SRCDIR/scripts" "$repository/" || { ls -laR "$SRCDIR" >&2; exit 1; }
        BE3_NO_SCCACHE=1 bash "$repository/scripts/internal/build-ghostty-vt.sh" \\
            --triple "$triple" > /dev/null
        cp "$repository/target/ghostty-vt/$triple/libghostty-vt.a" "$OUT"
        rm -rf "$repository"
    """,
    out = "libghostty-vt.a",
    srcs = {
        "scripts/internal/build-ghostty-vt.sh": "//scripts/internal:build-ghostty-vt.sh",
        "scripts/internal/common.sh": "//scripts/internal:common.sh",
        "scripts/internal/ghostty-vt.patch": "//scripts/internal:ghostty-vt.patch",
    },
)

prebuilt_cxx_library(
    name = "libghostty-vt",
    preferred_linkage = "static",
    static_lib = ":libghostty-vt.a",
)

cargo_library(extra_deps = [":libghostty-vt"])

cargo_test(extra_deps = [":libghostty-vt"])
