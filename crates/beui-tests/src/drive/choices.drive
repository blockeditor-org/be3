# Radio groups, segments and tabs choose by pointer and move their choice with
# the arrow keys.
clock stop
wait 'value="Mode Automatic period Week tab Overview"'
click 'RadioButton "Manual"'
wait 'value="Mode Manual period Week tab Overview"'
key down
wait 'value="Mode Scheduled period Week tab Overview"'
click 'RadioButton "Month"'
wait 'value="Mode Scheduled period Month tab Overview"'
key left
wait 'value="Mode Scheduled period Week tab Overview"'
click 'Tab "Details"'
wait 'value="Mode Scheduled period Week tab Details"'
wait 'Tab "Details" selected'
key left
wait 'value="Mode Scheduled period Week tab Overview"'
