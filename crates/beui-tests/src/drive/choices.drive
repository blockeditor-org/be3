# Radio groups, segments and tabs choose by pointer and move their choice with
# the arrow keys.
clock stop
wait 'value="Mode Some(0) period 1 tab 0"'
click 'RadioButton "Manual"'
wait 'value="Mode Some(1) period 1 tab 0"'
key down
wait 'value="Mode Some(2) period 1 tab 0"'
click 'RadioButton "Month"'
wait 'value="Mode Some(2) period 2 tab 0"'
key left
wait 'value="Mode Some(2) period 1 tab 0"'
click 'Tab "Details"'
wait 'value="Mode Some(2) period 1 tab 1"'
wait 'Tab "Details" selected'
key left
wait 'value="Mode Some(2) period 1 tab 0"'
