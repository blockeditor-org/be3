# An indeterminate progress bar moves for as long as it's shown, yet the page
# settles with the clock running, as it does around a blinking caret; once it
# has a value it rests.
settle
wait 'ProgressIndicator "Upload"'
# A pause on a running clock replies once its time has passed, though the bar repaints forever.
pause 100
wait 'value="Uploading"'
click 'Button "Finish"'
wait 'value="Upload done"'
settle
