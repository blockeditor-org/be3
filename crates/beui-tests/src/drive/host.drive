# Control flow held by a host node is placed as its child would be: a third and two thirds of
# a 300 wide row less 10 of spacing, and two of three grid columns. It swaps while its child
# is pressed (and so focused and hovered) and while it is dragged, and the swapped child is
# placed the same way.
clock stop
wait 'Row 97x20 193x20 Grid 100x20 200x20 Swaps 0'
click '#host.first'
wait 'Swaps 1'
wait 'Row 97x20 193x20 Grid 100x20 200x20 Swaps 1'
drag '#host.second' '#host.second+60,0' 6
wait 'Swaps 2'
find '#host.first'
