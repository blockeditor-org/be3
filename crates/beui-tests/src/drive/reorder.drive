# An item dragged down a reorderable list passes the items whose middles it
# crosses and lands where it is let go.
clock stop
wait 'value="Order: apple banana cherry date"'
drag '#reorder.apple' '#reorder.cherry+0,4' 6
wait 'value="Order: banana cherry apple date"'
pause 1000
pause 16
# An item no other list takes stays in its list however far it is dragged,
# and lands in the slot it is shown in.
down '#reorder.banana'
move '#reorder.report+0,240'
wait '#reorder.banana'
up
wait 'value="Order: cherry apple date banana"'
pause 1000
pause 16
# Carried towards a list that takes it, an item folds out of its own list,
# and the gap it leaves closes over time rather than at once.
down '#shelf.kale+10,2'
move '#shelf.1+60,120'
wait 'value="Shelf full"'
pause 40
wait 'value="Shelf closing"'
pause 1000
pause 16
wait 'value="Shelf closed"'
# Its row folded away, the list draws the carried item's preview under the
# pointer, where it was pressed: once, so a screen reader finds it once.
wait '#shelf.preview' over '#shelf.1+60,120'
find '#shelf.preview'
find 'Label value="kale"'
move '#shelf.corn+10,25'
up
wait 'value="Shelves: leek okra | corn kale"'
# Taken by the other list, the item is drawn there as its row, and its
# preview is gone.
pause 1000
pause 16
find 'Label value="kale"'
wait not '#shelf.preview'
# Held at the edge of the scroll it is in, a carried item scrolls it, and
# lands where it is let go among the rows that scrolled into view.
pause 1000
pause 16
wait 'value="Long list at the start, row 1 above the fold"'
down '#long.1+10,10'
move '#long.view+60,80'
move '#long.view+60,156'
pause 3000
wait 'value="Long list at the end, row 1 above the fold"'
# Carried on past the end of the scroll, the item it holds does not let the
# scroll reach any further.
move '#long.view+60,260'
pause 100
wait 'value="Long list at the end, row 1 above the fold"'
up
wait 'value="Long list at the end, row 1 below the fold"'
