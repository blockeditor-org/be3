# A popover opens from its button and closes from inside; a tooltip shows
# after the pointer dwells on what it describes.
wait 'value="Starred false"'
click 'Button "Filters"'
wait 'CheckBox "Only starred"'
click 'CheckBox "Only starred"'
wait 'value="Starred true"'
click 'Button "Done"'
wait not 'CheckBox "Only starred"'
key Enter
wait 'CheckBox "Only starred"'
key Escape
wait not 'CheckBox "Only starred"'
wait not 'Says more'
move '#popups.hint'
wait 'Says more'
move '#popups.filters'
wait not 'Says more'
# The keyboard's focus shows a tooltip at once, Escape hides it, and its label describes
# what it wraps.
#web attribute '[aria-description]' aria-description 'Says more'
click '#popups.filters'
key Escape
wait not 'CheckBox "Only starred"'
key Tab
wait 'Says more'
# Escape hides it, and it stays hidden while the focus stays.
key Escape
wait not 'Says more'
key shift+Tab
key Tab
wait 'Says more'
key shift+Tab
wait not 'Says more'
