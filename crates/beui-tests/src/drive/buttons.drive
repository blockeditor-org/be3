# A button clicks by pointer and by the keyboard once focused, a disabled one
# never does, and a toggle button flips its state. A heading's text reads as a
# heading.
clock stop
wait 'Heading "Actions"'
wait 'value="Clicked 0"'
click '#buttons.save'
wait 'value="Clicked 1"'
key Enter
wait 'value="Clicked 2"'
key space
wait 'value="Clicked 3"'
click '#buttons.off'
wait 'value="Clicked 3"'
click 'Button "Pin"'
wait 'value="Pinned true"'
wait 'Button "Pin" toggled=True'
key space
wait 'value="Pinned false"'
