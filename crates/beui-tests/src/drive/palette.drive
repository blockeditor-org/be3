# A command palette narrows its list as a query is typed and launches the
# highlighted item on Enter, or the one clicked.
clock stop
click 'Button "Launch"'
wait '#palette.item.files'
type 'ter'
wait not '#palette.item.files'
wait '#palette.item.terminal'
key Enter
wait not '#palette.search'
wait 'value="Launched terminal"'
click 'Button "Launch"'
wait '#palette.item.files'
click '#palette.item.files'
wait not '#palette.search'
wait 'value="Launched files"'
click 'Button "Launch"'
wait '#palette.search'
key Escape
wait not '#palette.search'
