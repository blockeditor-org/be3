# Clicks, keys and typed text reach the Interactive that should have them, and a press arms its
# Interactive before `on_press`.
clock stop
wait 'value="Clicked 0"'
click '#interactive.count'
wait 'value="Clicked 1"'
click '#interactive.count'
wait 'value="Clicked 2"'
click '#interactive.keys'
key Enter
wait 'value="Pressed Enter"'
click '#interactive.typing'
type 'abc'
wait 'value="Typed abc"'
click '#interactive.order'
wait 'value="Heard armed press-active released"'
