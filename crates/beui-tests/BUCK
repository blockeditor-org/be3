load("@root//buck/cargo:defs.bzl", "cargo_binary", "cargo_test")
load("@root//buck/program:drive.bzl", "headless", "web_drive_test")
load("@root//buck/wasm:defs.bzl", "web_library", "web_program")

# Screens built for both of beui's cores, and src/drive/*.drive, scripts both
# cores must answer the same way (guides/testing_a_gui.md, 7). The script's
# file name is the screen it drives.
web_library(
    role = "html",
)

# The native core: a screen headless, named by its argument
# (`--delay-measurement` delays every measurement by a frame).
cargo_binary()

# Each script against :bin under be_drive::Driven, once as it is and once
# with delayed measurement. No GPU: BEUI_RENDERER=none.
cargo_test(
    paints = True,
    run_env = {
        "BEUI_RENDERER": "none",
        "FIXTURES": "$(location :bin)",
        "HOST_LIBRARIES": "$(location //buck/sysroot:amd64-test)/usr/lib/x86_64-linux-gnu:$(location //buck/sysroot:amd64)/usr/lib/x86_64-linux-gnu",
        "XKB_CONFIG_ROOT": "$(location //buck/sysroot:amd64-test)/usr/share/X11/xkb",
    },
    target_compatible_with = ["prelude//os:linux", "prelude//cpu:x86_64"],
)

# A screen headless for an agent to drive: `./scripts/buck run
# //crates/beui-tests:dev -- frame`.
headless(
    name = "dev",
    program = "$(location :bin)",
    program_name = "beui-shared-tests",
)

# The HTML core: the same screens in the browser, ?fixture=NAME.
web_program(
    name = "web",
    module = "beui_shared_tests",
    role = "html",
    files = [
        "web/index.html",
        "//crates/beui-fonts:Inter-Regular.ttf",
        "//crates/beui-fonts:Hack-Regular.ttf",
        "//crates/beui-fonts:NotoEmoji-Regular.ttf",
        "//crates/beui-fonts:lucide.ttf",
    ],
)

# Each script in Chromium against :web, and the live DOM checks of
# beui-html (src/web/live.rs).
web_drive_test(
    name = "web-test",
    bundle = ":web",
    checks = True,
    scripts = glob(["src/drive/*.drive"]),
)
