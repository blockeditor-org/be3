load("@root//buck/program:defs.bzl", "program")
load("@root//buck/program:drive.bzl", "page_test")

cargo_library()

cargo_test(
    env = {
        "COUNTER_TYPES_WASM": "$(location //crates/be-type-example-counter:module)",
        "GUEST_ECHO_WASM": "$(location //crates/be-wasm-guest-echo:module)",
