        "TLS_DIAMOND_BASE_WASM": "$(location //crates/be-tool-tls-diamond-base:module)",
        "TLS_DIAMOND_LEFT_WASM": "$(location //crates/be-tool-tls-diamond-left:module)",
        "TLS_DIAMOND_RIGHT_WASM": "$(location //crates/be-tool-tls-diamond-right:module)",
    }
