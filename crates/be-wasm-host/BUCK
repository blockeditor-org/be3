cargo_binary()

# The examples: `./scripts/buck run //crates/be-wasm-host:example-<example>`.

cargo_example("gpu-calls")

cargo_example("instantiate")

# The standalone guest (src/tests/standalone.wat, which the tests above run on
# wasmtime) in Chromium: assembled into a module, and run by be-wasm-guest-host's
# guest.js with block-app's app.js against be-wasm-gpu-shim, which
# wasm-bindgen prepares as the web bundle does, in a page that checks what it
# painted (web/standalone.js).
genrule(
    name = "standalone.wasm",
    cmd = "$(exe //buck/tools:wasm-as) --enable-bulk-memory $SRCS -o $OUT",
    out = "standalone.wasm",
    srcs = ["src/tests/standalone.wat"],
)

program(
    name = "standalone-bundle",
    bindgen = ["//crates/be-wasm-gpu-shim:module"],
    files = [
        "//crates/be-host:dylink.js",
        "//crates/be-wasm-guest-host:guest.js",
        "//crates/be-host:env.js",
        "//crates/be-host:app.js",
        "//crates/be-host:thread.js",
        "//crates/be-host:threads.js",
        "//crates/be-host:wasi.js",
    ],
    manifests = [],
    modules = [],
    wasm_bindgen = "//buck/cargo:wasm-bindgen",
)

page_test(
    name = "standalone-web-test",
    files = {
        "bundle": ":standalone-bundle",
        "index.html": "web/index.html",
        "standalone.js": "web/standalone.js",
        "standalone.wasm": ":standalone.wasm",
    },
)
