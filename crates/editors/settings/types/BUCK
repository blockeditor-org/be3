load("@root//buck/cargo:defs.bzl", "cargo_library")
load("@root//buck/wasm:defs.bzl", "wasm32_module")

# The settings plugin's block type, the default editors layer: the content as a
# plain library, which the editor and block-shell depend on, and :module, the
# type module the app runs it in (guides/type_modules.md), which only the module
# feature exports.
cargo_library()

cargo_library(
    name = "wasm",
    extra_features = ["module"],
    preferred_linkage = "shared",
    target_compatible_with = ["prelude//cpu/constraints:cpu[wasm32]"],
)

wasm32_module(
    name = "module",
    library = ":wasm",
    module = "settings_types",
    visibility = ["PUBLIC"],
)
