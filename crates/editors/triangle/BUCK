load("@root//buck/wasm:defs.bzl", "editor", "editor_module")

# Triangle draws with plain wgpu and no ui framework, so it needs base alone.
editor(
    libraries = ["//crates/plugin-library-base:module"],
    module = "triangle",
    types = "//crates/editors/triangle/types:module",
)

# The same triangle with every crate it uses linked into it, a standalone
# plugin (guides/plugin_libraries.md, "The raw plugin interface"), which
# block-wasm-host's tests load and paint beside :module.
editor_module(
    name = "standalone",
    libraries = [],
    module = "triangle",
)
