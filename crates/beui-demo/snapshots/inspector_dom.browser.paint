    "<div style=\"left:0px;top:0px;width:36px;height:16px;font:normal 400 14px Inter, system-ui, -apple-system, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;color:rgba(230,235,243,1);\">",
    "<div style=\"left:0px;top:0px;height:16px;line-height:16px;\">",
    "Code</div>",
