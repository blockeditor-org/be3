load("@root//buck/cargo:defs.bzl", "cargo_binary", "cargo_example", "cargo_library", "cargo_package")
load("@root//buck/program:drive.bzl", "headless", "web_drive_test")
load("@root//buck/wasm:defs.bzl", "app_tests", "web_program")

cargo_package()

cargo_library()

# The demo in a window: `./scripts/buck run //crates/beui-demo:native`.
cargo_binary(name = "native")

# The demo's tests paint its pages the way an app's tests do: compiled to
# wasm with the fonts beui carries, and run here so they can read and write
# snapshots/.
app_tests()

# Headless for an agent to drive: guides/running/drive.md.
headless(
    name = "dev",
    program = "$(location :native)",
    program_name = "beui-demo",
)

# Times opening each page: `./scripts/buck run -m release //crates/beui-demo:example-open-bench`.
cargo_example("open-bench")

# Times the space cursor's icon and resizing a space panel: `./scripts/buck run -m release //crates/beui-demo:example-space-bench -- [cursor|resize]`.
cargo_example("space-bench")

# The demo in a browser, from src/main.rs as natively: `./scripts/buck run //crates/beui-demo:web`
# draws it with wgpu on http://127.0.0.1:8070, and `:web-html` shows it on beui's HTML core
# on http://127.0.0.1:8075, either on the address given as `-- --addr HOST:PORT`.
web_program(
    name = "web",
    entry = "src/main.rs",
    module = "beui_demo",
    role = "program",
    serve = "127.0.0.1:8070",
)

web_program(
    name = "web-html",
    entry = "src/main.rs",
    module = "beui_demo",
    role = "html",
    serve = "127.0.0.1:8075",
)

# drive/*.drive in Chromium against :web-html: every page opens, the long modal
# sheet opens and closes, only Selectable text selects, and controls carry
# their ARIA roles and states, each overlay reads once, as what it is, and an
# anchored overlay near the window's corner flips and shifts as natively.
web_drive_test(
    name = "web-html-test",
    bundle = ":web-html",
    scripts = glob(["drive/*.drive"]),
)
