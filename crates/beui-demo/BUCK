load("@root//buck/app:drive.bzl", "headless")
load("@root//buck/cargo:defs.bzl", "cargo_binary", "cargo_example", "cargo_library")
load("@root//buck/wasm:defs.bzl", "plugin_tests")

cargo_library()

# The demo in a window: `./scripts/buck run //crates/beui-demo:native`.
cargo_binary(name = "native")

# The demo's tests paint its pages the way a plugin's tests do: compiled to
# wasm with the fonts beui carries, and run here so they can read and write
# snapshots/.
plugin_tests()

# Headless for an agent to drive: guides/running/drive.md.
headless(
    name = "dev",
    app_name = "beui-demo",
    program = "$(location :native)",
)

# Times opening each page: `./scripts/buck run -m release //crates/beui-demo:example-open-bench`.
cargo_example("open-bench")

# Times the space cursor's icon and resizing a space panel: `./scripts/buck run -m release //crates/beui-demo:example-space-bench -- [cursor|resize]`.
cargo_example("space-bench")

# The demo's pages on beui's HTML core, in a browser (crates/beui-demo-html):
# `./scripts/buck run //crates/beui-demo:web-html`.
alias(
    name = "web-html",
    actual = "//crates/beui-demo-html:web",
)
