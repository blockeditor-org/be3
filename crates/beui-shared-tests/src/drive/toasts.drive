# Toasts stack in their area, close from their dismiss button and run an
# action; a plain toast goes by itself after eight seconds.
clock stop
wait 'value="Toasts 0 chose nothing"'
click 'Button "Toast"'
wait '#toast.1'
click 'Button "Message"'
wait '#toast.2'
wait 'value="Toasts 2 chose nothing"'
click '#toast.1.dismiss'
gone '#toast.1'
wait 'value="Toasts 1 chose nothing"'
click '#toast.2.action.reply'
gone '#toast.2'
wait 'value="Toasts 0 chose reply 2"'
click 'Button "Toast"'
wait '#toast.3'
pause 7000
wait '#toast.3'
pause 1500
gone '#toast.3'
wait 'value="Toasts 0 chose reply 2"'
