# A text field takes typing over its placeholder, a number input opens a field
# for a typed number on a click, and a slider moves with the keys.
clock stop
wait 'value="Name \"\" seats 4 load 0.5"'
click '#fields.name'
type 'Ada'
wait 'value="Name \"Ada\" seats 4 load 0.5"'
click 'SpinButton "Seats"'
wait 'TextInput "Seats" value="4"'
type '3'
key Enter
wait 'value="Name \"Ada\" seats 3 load 0.5"'
gone 'TextInput "Seats"'
click 'Slider "Load"'
key Home
wait 'value="Name \"Ada\" seats 3 load 0.0"'
key End
wait 'value="Name \"Ada\" seats 3 load 1.0"'
