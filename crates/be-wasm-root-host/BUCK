load("@root//buck/cargo:defs.bzl", "cargo_library", "cargo_package", "cargo_test")

cargo_package()

cargo_library()

# ROOT_GUEST_WASM is the root the tests run, which spawns the echo guest as a
# staged app by its id: GUEST_ECHO_APP_WASM, linked against
# BASE_LIBRARY_WASM. The painter it spawns is src/tests/painter.wat.
cargo_test(
    env = {
        "BASE_LIBRARY_WASM": "$(location //crates/be-sdk-library-base:module)",
        "GUEST_ECHO_APP_WASM": "$(location //crates/be-wasm-guest-echo:app)",
        "ROOT_GUEST_WASM": "$(location //crates/be-wasm-root-testing:module)",
    }
)
