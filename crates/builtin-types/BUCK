load("@root//buck/cargo:defs.bzl", "cargo_library", "cargo_test")
load("@root//buck/wasm:defs.bzl", "wasm32_module")

# The app's first-party type module: every block type the app does not apply
# itself and no plugin provides yet, as one pure guest (guides/type_modules.md).
# The library is plain; only :wasm, with the module feature, exports the guest,
# so other crates can depend on it on wasm32. host() is the types the app
# applies itself, which it runs in process.
cargo_library()

# Every block type a plugin declares without a module of its own must be one
# this module has, and every one it has must be declared: the test reads the
# editors' manifests the way block-plugin-api's every_editor_manifest_parses
# does.
cargo_test(
    env = {"EDITOR_MANIFESTS": "$(location //crates/block-plugin-api:editor-manifests)"},
)

cargo_library(
    name = "wasm",
    extra_features = ["module"],
    preferred_linkage = "shared",
    target_compatible_with = ["prelude//cpu/constraints:cpu[wasm32]"],
)

wasm32_module(
    name = "module",
    library = ":wasm",
    visibility = ["PUBLIC"],
)
