package be3:library@0.1.0;

interface shelf {
    record book {
        title: string,
        pages: u32,
    }

    record scan {
        title: string,
        pages: list<list<u8>>,
    }

    variant shelf-error {
        missing(string),
        full,
    }

    find: async func(title: string) -> result<book, shelf-error>;

    hold: async func(title: string);

    books: func(first: u32) -> stream<book>;

    cover: async func(title: string) -> result<list<u8>, shelf-error>;

    pages: func(title: string) -> stream<list<u8>>;

    bind: async func(scan: scan, loose: list<tuple<string, list<u8>>>) -> option<list<list<u8>>>;

    resource reading {
        constructor(title: string);
        page: async func() -> u32;
        turns: func() -> stream<u32>;
    }
}

world library {
    import shelf;
}
