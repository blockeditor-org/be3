BE3BROWSER 1
{
  "size": [
    390,
    1600
  ],
  "document": [
    "<!doctype html>",
    "<html lang=\"en\">",
    "<head>",
    "<meta charset=\"utf-8\">",
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
    "<title>",
    "Block account</title>",
    "<style>",
    ".bht-90c5d34d37ec5721{font-size:1rem;}.bht-90c5d34d37ec5721{font-family:system-ui,sans-serif;}.bht-90c5d34d37ec5721{margin-top:3rem;margin-bottom:3rem;}.bht-90c5d34d37ec5721{margin-left:auto;margin-right:auto;}.bht-90c5d34d37ec5721{padding-left:1rem;padding-right:1rem;}.bht-90c5d34d37ec5721{max-width:28rem;}.bht-90c5d34d37ec5721{color:var(--bht-ink,#202124);}.bht-90c5d34d37ec5721{background:var(--bht-paper,#fafafa);}.bht-90c5d34d37ec5721 label{display:block;}.bht-90c5d34d37ec5721 label{margin-top:1rem;margin-bottom:1rem;}.bht-90c5d34d37ec5721 input{display:block;}.bht-90c5d34d37ec5721 input{box-sizing:border-box;}.bht-90c5d34d37ec5721 input{width:100%;}.bht-90c5d34d37ec5721 input{padding:.7rem;}.bht-90c5d34d37ec5721 input{font:inherit;}.bht-90c5d34d37ec5721 button{padding:.7rem;}.bht-90c5d34d37ec5721 button{margin:.4rem .4rem .4rem 0;}.bht-90c5d34d37ec5721 button{font:inherit;}.bht-90c5d34d37ec5721 button{cursor:pointer;}.bht-90c5d34d37ec5721 [role=alert]{color:var(--bht-danger,#a00);}</style>",
    "</head>",
    "<body class=\"bht-90c5d34d37ec5721\">",
    "<header>",
    "<a href=\"/auth\">",
    "Block account</a>",
    "</header>",
    "<main>",
    "<p>",
    "Signed in as Alex (alex@example.com)</p>",
    "<nav>",
    "<a href=\"/auth/settings\">",
    "Account settings</a>",
    " · <a href=\"/auth/sessions\">",
    "Sessions</a>",
    "</nav>",
    "<h1>",
    "Account settings</h1>",
    "<p role=\"status\">",
    "Changes saved.</p>",
    "<h2>",
    "Display name</h2>",
    "<form action=\"/auth/settings/name\" method=\"post\" novalidate=\"\">",
    "<input type=\"hidden\" name=\"csrf\" value=\"snapshot-form-token\">",
    "<input type=\"hidden\" name=\"code\" value=\"\">",
    "<label>",
    "Display name<input type=\"text\" name=\"display_name\" value=\"Alex\" autocomplete=\"nickname\" aria-invalid=\"false\">",
    "</label>",
    "<button>",
    "Save display name</button>",
    "</form>",
    "<h2>",
    "Email address</h2>",
    "<p>",
    "Your address changes after you verify the new address.</p>",
    "<form action=\"/auth/settings/email\" method=\"post\" novalidate=\"\">",
    "<input type=\"hidden\" name=\"csrf\" value=\"snapshot-form-token\">",
    "<input type=\"hidden\" name=\"code\" value=\"\">",
    "<label>",
    "New email<input type=\"email\" name=\"email\" value=\"alex@example.com\" autocomplete=\"email\" aria-invalid=\"false\">",
    "</label>",
    "<label>",
    "Current password<input type=\"password\" name=\"current_password\" value=\"\" autocomplete=\"current-password\" aria-invalid=\"false\">",
    "</label>",
    "<button>",
    "Verify new email</button>",
    "</form>",
    "<h2>",
    "Password</h2>",
    "<p>",
    "Changing your password signs out all other sessions.</p>",
    "<form action=\"/auth/settings/password\" method=\"post\" novalidate=\"\">",
    "<input type=\"hidden\" name=\"csrf\" value=\"snapshot-form-token\">",
    "<input type=\"hidden\" name=\"code\" value=\"\">",
    "<label>",
    "Current password<input type=\"password\" name=\"current_password\" value=\"\" autocomplete=\"current-password\" aria-invalid=\"false\">",
    "</label>",
    "<label>",
    "New password (at least 8 characters)<input type=\"password\" name=\"password\" value=\"\" autocomplete=\"new-password\" aria-invalid=\"false\">",
    "</label>",
    "<label>",
    "Confirm password<input type=\"password\" name=\"confirmation\" value=\"\" autocomplete=\"new-password\" aria-invalid=\"false\">",
    "</label>",
    "<button>",
    "Change password</button>",
    "</form>",
    "<form action=\"/auth/logout\" method=\"post\" novalidate=\"\">",
    "<input type=\"hidden\" name=\"csrf\" value=\"snapshot-form-token\">",
    "<input type=\"hidden\" name=\"code\" value=\"\">",
    "<button>",
    "Sign out / use another account</button>",
    "</form>",
    "</main>",
    "</body>",
    "</html>"
  ],
  "files": {}
}
