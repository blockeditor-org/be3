# What buck2 builds here, and what it needs told to do it. guides/buck2.md is
# the prose; this is the part buck2 reads.

[cells]
root = .
prelude = prelude
toolchains = buck/toolchains
none = none

[cell_aliases]
config = prelude
ovr_config = prelude
fbcode = none
fbsource = none
buck = none

# The prelude comes out of the buck2 binary rather than out of a submodule, so
# there is no second thing to check out and no prelude version to keep in step
# with the binary: the commit scripts/internal/common.sh pins pins both.
[external_cells]
prelude = bundled

# Linux on x86_64, whichever machine asks: buck/platforms/BUCK says why.
[parser]
target_platform_detector_spec = target:root//...->root//buck/platforms:linux_x86_64

# Where actions run: on BuildBuddy's workers. buck/platforms/BUCK is the
# platform, and buck/tools the compilers it runs.
[build]
execution_platforms = root//buck/platforms:default

[buck2]
# The digest BuildBuddy is spoken to in. buck2 defaults to SHA1, and this is
# not something to leave to a default: it is the key space every cached action
# lives in.
digest_algorithms = SHA256

# Remember which artifacts are already on disk across daemon restarts, and skip
# writing a file whose content is already there. Both are what the deferred
# materializer wants: most of what a build "produces" is a digest in
# BuildBuddy's CAS that buck2 never downloads, and this is what stops it
# downloading one twice.
defer_write_actions = true
sqlite_materializer_state = true

# BuildBuddy: its remote executor, and the action cache and CAS beside it.
#
# Three things about this are not guessable, and none of them announces itself
# when it is wrong, because buck2 treats a cache it cannot use as one that is
# empty. The address is a bare host:port: buck2 parses it itself and rejects
# both grpcs:// and https:// with "Invalid URI". http_headers separates name
# from value with a colon, not an equals sign. And there is no instance name.
#
# The key is named rather than written: buck2 expands $BUILDBUDDY_API_KEY from
# the environment the daemon was started in, so a daemon started without it,
# or with a different one, has to be restarted with ./scripts/buck killall.
# ./scripts/buck refuses to start one without it.
[buck2_re_client]
action_cache_address = remote.buildbuddy.io:443
cas_address = remote.buildbuddy.io:443
engine_address = remote.buildbuddy.io:443
http_headers = x-buildbuddy-api-key:$BUILDBUDDY_API_KEY
tls = true
