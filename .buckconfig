# What buck2 builds here, and what it needs told to do it. guides/buck2.md is
# the prose; this is the part buck2 reads.

[cells]
root = .
prelude = prelude
toolchains = buck/toolchains
none = none

[cell_aliases]
config = prelude
ovr_config = prelude
fbcode = none
fbsource = none
buck = none

# The prelude comes out of the buck2 binary rather than out of a submodule, so
# there is no second thing to check out and no prelude version to keep in step
# with the binary: the commit scripts/internal/common.sh pins pins both.
[external_cells]
prelude = bundled

[parser]
target_platform_detector_spec = target:root//...->prelude//platforms:default

# Where actions run. The prelude's default platform runs everything locally and
# consults no cache; this one is the same platform with the shared cache wired
# in. buck/platforms/BUCK says how it is turned on.
[build]
execution_platforms = root//buck/platforms:default

[buck2]
# The digest the shared cache speaks. buck2 defaults to SHA1, and this is not
# something to leave to a default: it is the key space every cached action
# lives in, so a machine that disagrees shares nothing with the others. It is
# set here rather than beside the cache credential so that it is the same
# whether or not a checkout has one.
digest_algorithms = SHA256

# Remember which artifacts are already on disk across daemon restarts, and skip
# writing a file whose content is already there. Both are what the deferred
# materializer wants: with the cache on, most of what a build "produces" is a
# digest buck2 never downloads, and this is what stops it downloading one twice.
defer_write_actions = true
sqlite_materializer_state = true

# Whether an action that ran locally may be written to the cache. It is a
# per-action setting the rules in the prelude never pass, so without this
# default nothing is ever uploaded, however the executor is configured. What
# decides whether uploads actually happen is allow_cache_uploads on the
# execution platform, which is off unless ./scripts/buck was given the write
# credential; this only says the rules do not object.
default_allow_cache_upload = true
