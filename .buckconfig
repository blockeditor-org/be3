# What buck2 builds here, and what it needs told to do it. guides/buck2.md is
# the prose; this is the part buck2 reads.

[cells]
root = .
prelude = prelude
toolchains = buck/toolchains
none = none

[cell_aliases]
config = prelude
ovr_config = prelude
fbcode = none
fbsource = none
buck = none

# The prelude comes out of the buck2 binary rather than out of a submodule, so
# there is no second thing to check out and no prelude version to keep in step
# with the binary: the release scripts/internal/pins names pins both.
[external_cells]
prelude = bundled

# Linux on x86_64, whichever machine asks: buck/platforms/BUCK says why. The
# root PACKAGE says why this is not a modifier.
[parser]
target_platform_detector_spec = target:root//...->root//buck/platforms:linux_x86_64

# Where actions run: on our build server's worker. buck/platforms/BUCK is the
# platform, and buck/tools the compilers it runs. A local build names
# :execution_platforms_local instead (guides/running/local_buck2.md).
[build]
execution_platforms = root//buck/platforms:execution_platforms

[buck2]
# The digest the build server is spoken to in. buck2 defaults to SHA1, and this is
# not something to leave to a default: it is the key space every cached action
# lives in.
digest_algorithms = SHA256

# Remember what is already on disk across daemon restarts, and skip writing a
# file whose content is already there, so the deferred materializer never
# downloads a digest twice.
defer_write_actions = true
sqlite_materializer_state = true

# Delete outputs no build has used for three days, once a day while the daemon
# runs. Every change to a crate leaves its old outputs under their content hash,
# and nothing else ever removes them.
clean_stale_enabled = true
clean_stale_artifact_ttl_hours = 72
clean_stale_period_hours = 24

# Where the remote execution cluster is: not here, but in the file included at
# the end. Namespace shuts it down when it has been idle, so ./scripts/buck asks
# the waker for its hosts and writes them, with the header that authenticates to
# them, into that file (crates/be-tool-bootstrap/src/server.rs). The address is a bare
# host:port (buck2 rejects grpcs:// and https://), http_headers uses a colon,
# and there is no instance name.
#
# Before an action runs remotely, buck2 asks the server which of its inputs it
# lacks, one FindMissingBlobs call at a time, and remembers the answer only
# for as long as the daemon lives. A crate's test links against the toolchain,
# the sysroot and every dependency's rlib, tens of thousands of files, so at
# buck2's default of 100 a call, be-host's first test after a daemon starts
# waited half a minute on hundreds of round trips through the proxy before it
# compiled. The answer lists every digest the server lacks, about 72 bytes
# each, and a gRPC message is at most 128 KiB: at 10000 a call, a cold cache's
# first macOS SDK upload got back 183 KB and failed, so 1500 keeps the worst
# answer under the limit.
[buck2_re_client]
find_missing_blobs_batch_size = 1500

# What buck2 does not watch or read as part of the workspace: git's own
# directory, whose every fetch would otherwise be a file change, and the
# directories cargo, the web bundle and buck2 itself write into, and the
# worktrees Claude Code checks out under .claude.
[project]
ignore = .git, .claude, target, dist, buck-out

# What ./scripts/buck generates: the build server's hosts and key, above. It is
# not written when buck2 builds on this machine (guides/running/local_buck2.md),
# and .buckconfig.local, a person's own, is read after it.
<?file:target/build-server.buckconfig>
