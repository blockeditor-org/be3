# The root package. It is BUCK.v2 rather than BUCK, which buck2 reads the same
# way, because a filesystem that ignores case - Windows', and macOS's by
# default - cannot hold a file named BUCK beside the buck/ directory.

load("//buck/tools:defs.bzl", "tool")

# clippy.toml reaches the rust toolchain as a file, so it needs a target.
export_file(
    name = "clippy.toml",
    src = "clippy.toml",
    visibility = ["PUBLIC"],
)

# The commands a person runs: scripts in buck/dev, started from the root once
# buck2 has built what each names.
#
#   ./scripts/buck run //:verify [-- --check] [-- --lint|--tests|--plugin-tests]
#   ./scripts/buck run //:check
#   ./scripts/buck run //:lock-sysroot
#   ./scripts/buck run //:rust-project
tool(
    name = "verify",
    command = [
        "python3",
        "$(location //buck/dev:verify.py)",
        # verify.py imports it from beside itself. The formatters and
        # fix-rust-source are not named here: it builds them itself when it
        # lints, so a run of the tests alone never downloads them.
        "--clippy-module",
        "$(location //buck/dev:clippy.py)",
    ],
)

tool(
    name = "check",
    command = [
        "python3",
        "$(location //buck/dev:check.py)",
    ],
)

tool(
    name = "lock-sysroot",
    command = [
        "sh",
        "$(location //buck/sysroot:lock.sh)",
    ],
)

tool(
    name = "rust-project",
    command = [
        "python3",
        "$(location //buck/dev:rust_project.py)",
        "$(location //buck/cargo:rust-project)",
        "$(location //buck/cargo:analyzer-sysroot)",
    ],
)
