# The root package. It is BUCK.v2 rather than BUCK, which buck2 reads the same
# way, because a filesystem that ignores case - Windows', and macOS's by
# default - cannot hold a file named BUCK beside the buck/ directory.

load("//buck/cargo:buckify.bzl", "cargo_plan")
load("//buck/cargo:crates.bzl", "crates")
load("//buck/dev:verify.bzl", "package_fix")

# The root's own Starlark; every other package's :fix is its own.
package_fix(starlark = ["BUCK.v2", "PACKAGE"])

# buck/cargo/crates.bzl and Cargo.lock generated from the Cargo.toml files of
# the crates it names (buck/cargo/buckify.bzl).
cargo_plan(
    name = "cargo-plan",
    crates = ["//{}:cargo-inputs".format(path) for path in crates],
    lock = "Cargo.lock",
    manifest = "Cargo.toml",
)

# The formatter's settings, for every package's :fix (buck/dev/verify.bzl).
export_file(
    name = "starlark_fmt.json",
    src = "buck/starlark_fmt.json",
    visibility = ["PUBLIC"],
)

# clippy.toml reaches the rust toolchain as a file, so it needs a target.
export_file(
    name = "clippy.toml",
    src = "clippy.toml",
    visibility = ["PUBLIC"],
)

# The commands a person runs, started from the root once buck2 has built what
# each names. ./scripts/verify and ./scripts/ci are one buck2 command each,
# buck/dev/verify.bxl, then crates/be-tool-verify, which reads what it built.
#
#   ./scripts/buck run //:fuzz
#   ./scripts/buck run //:buckify [-- --check]
#   ./scripts/buck run //:pdfium -- REVISION
#   ./scripts/buck run //:rust-project

# Every fuzz target, taking turns, until it is stopped (crates/be-tool-local).
command_alias(
    name = "fuzz",
    args = ["$(location //crates/be-tool-local:bin)", "fuzz", "--all"],
)

command_alias(
    name = "buckify",
    args = [
        "sh",
        "$(location //buck/cargo:update.sh)",
    ],
)

# third-party/pdfium/sources.bzl, from PDFium's GN build at REVISION
# (crates/be-tool-buck/src/pdfium.rs).
command_alias(
    name = "pdfium",
    args = [
        "$(exe //crates/be-tool-buck:bin)",
        "pdfium",
    ],
)

command_alias(
    name = "rust-project",
    args = [
        "$(exe //crates/be-tool-buck:bin)",
        "rust-project",
        "$(location //buck/cargo:rust-project)",
        "$(location //buck/cargo:analyzer-sysroot)",
    ],
)
