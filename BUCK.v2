# The root package. It is BUCK.v2 rather than BUCK, which buck2 reads the same
# way, because a filesystem that ignores case - Windows', and macOS's by
# default - cannot hold a file named BUCK beside the buck/ directory.

load("//buck/wasm:defs.bzl", "plugin_test_inputs")

# clippy.toml reaches the rust toolchain as a file, so it needs a target.
export_file(
    name = "clippy.toml",
    src = "clippy.toml",
    visibility = ["PUBLIC"],
)

# What the plugin tests read as an action (buck/wasm/defs.bzl), where they
# read it: the manifest that tells them where the workspace is, and the
# accepted paintings.
plugin_test_inputs(
    name = "plugin_test_inputs",
    srcs = ["Cargo.toml"] + glob(["snapshots/*.paint"]),
    visibility = ["PUBLIC"],
)

# The commands a person runs, started from the root once buck2 has built what
# each names.
#
#   ./scripts/buck run //:verify [-- --check] [--lint] [--tests] [--plugin-tests]
#   ./scripts/buck run //:ci [-- --check] [--android DIR] [--previews BASE OUT]
#   ./scripts/buck run //:check
#   ./scripts/buck run //:lock-sysroot
#   ./scripts/buck run //:rust-project

# The lint pass's tools are not named here: verify.sh builds them when it lints,
# so a run of the tests alone never fetches them.
command_alias(
    name = "verify",
    args = [
        "sh",
        "$(location //buck/dev:verify.sh)",
    ],
)

# Everything CI runs, in the one command its job runs: buck/dev/ci.sh.
command_alias(
    name = "ci",
    args = [
        "sh",
        "$(location //buck/dev:ci.sh)",
    ],
)

# rustc's check pass over every first-party target in every configuration.
command_alias(
    name = "check",
    args = [
        "sh",
        "-c",
        "exec ./scripts/buck bxl //buck/dev/workspace.bxl:subtarget -- --subtarget check > /dev/null",
    ],
)

command_alias(
    name = "lock-sysroot",
    args = [
        "sh",
        "$(location //buck/sysroot:lock.sh)",
    ],
)

command_alias(
    name = "rust-project",
    args = [
        "$(exe //crates/buck-tools:buck-tools-bin)",
        "rust-project",
        "$(location //buck/cargo:rust-project)",
        "$(location //buck/cargo:analyzer-sysroot)",
    ],
)
